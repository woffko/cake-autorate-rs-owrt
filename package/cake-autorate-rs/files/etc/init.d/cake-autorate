#!/bin/sh /etc/rc.common

START=97
STOP=4
USE_PROCD=1
# @variant full begin
EXTRA_COMMANDS="native_apply_register_instance"
EXTRA_HELP="\tnative_apply_register_instance <instance>\tInternal native Apply procd registration bridge"
# @variant full end
# @variant lite begin
EXTRA_COMMANDS=""
EXTRA_HELP=""
# @variant lite end

CONFIG="cake-autorate"
SQM_CONFIG="sqm"
DAEMON="/usr/sbin/cake-autorated"
# @variant full begin
RUNTIME_LOCK_LIB="${CAKE_AUTORATE_RUNTIME_LOCK_LIB:-/usr/libexec/cake-autorate-rs/runtime-lock}"
RUNTIME_LOCK_AVAILABLE=0
# @variant full end
# @variant full begin
SERVICE_RUNTIME_LOCK_HELD=0
SERVICE_RUNTIME_LOCK_BORROWED=0
SERVICE_RUNTIME_STOP_RELEASE_PENDING=0
SERVICE_START_CONFIRM_PENDING=0
SERVICE_START_CONFIRM_DEFERRED=0
# @variant full end
# @variant full begin
if [ -r "$RUNTIME_LOCK_LIB" ]; then
	# shellcheck source=/usr/libexec/cake-autorate-rs/runtime-lock
	. "$RUNTIME_LOCK_LIB"
	RUNTIME_LOCK_AVAILABLE=1
fi

service_runtime_lock_acquire_or_exit() {
	local operation="$1"
	local rc

	[ "$SERVICE_RUNTIME_LOCK_HELD" -eq 0 ] || return 0
	if [ "$RUNTIME_LOCK_AVAILABLE" -ne 1 ]; then
		logger -t cake-autorate "refusing to $operation: shared runtime-lock helper is unavailable"
		exit 1
	fi

	if [ "${CAKE_AUTORATE_RUNTIME_GLOBAL_LOCK_BORROW:-0}" = 1 ]; then
		if runtime_lock_borrow_global_exclusive; then
			SERVICE_RUNTIME_LOCK_BORROWED=1
			rc=0
		else
			rc=$?
		fi
	elif runtime_lock_acquire_global_exclusive; then
		rc=0
	else
		rc=$?
	fi
	if [ "$rc" -ne 0 ]; then
		case "$rc" in
			75)
				logger -t cake-autorate "deferring $operation: Auto-Tune, rating, speed test, or recovery currently owns a managed interface"
				;;
			*)
				logger -t cake-autorate "refusing to $operation: global runtime lock could not be acquired (error $rc)"
				;;
		esac
		# rc.common does not stop after a non-zero stop_service() return.  Exit
		# here so a busy lock can never be followed by procd_kill().
		exit 1
	fi

	SERVICE_RUNTIME_LOCK_HELD=1
}

service_runtime_lock_release_or_exit() {
	local operation="$1"

	[ "$SERVICE_RUNTIME_LOCK_HELD" -eq 1 ] || return 0
	if ! runtime_lock_release_global; then
		logger -t cake-autorate "failed to release global runtime lock after $operation"
		# Exiting closes the kernel-held descriptor even if explicit unlock
		# failed, and prevents any later mutation in this shell.
		exit 1
	fi

	SERVICE_RUNTIME_LOCK_HELD=0
	SERVICE_RUNTIME_LOCK_BORROWED=0
}
# @variant full end

service_add_instance() {
	procd_open_instance "$1"
	procd_set_param command "$DAEMON" --instance "$1"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# @variant full begin
service_add_mqtt_instance() {
	procd_open_instance "mqtt_$1"
	procd_set_param command "$DAEMON" --mqtt-publisher "$1"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
# @variant full end

validate_service_instance_list() {
	local instances="$1" old_ifs instance seen=""

	[ "$instances" != - ] || return 0
	case "$instances" in
		''|,*|*,|*,,*|*[!A-Za-z0-9_,]*) return 1 ;;
	esac
	old_ifs="$IFS"
	IFS=,
	set -- $instances
	IFS="$old_ifs"
	for instance in "$@"; do
		case "$instance" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
		[ "${#instance}" -le 64 ] || return 1
		case ",$seen," in *",$instance,"*) return 1 ;; esac
		seen="${seen:+$seen,}$instance"
	done
}

add_controller_instances() {
	local instances="$1" old_ifs instance

	[ "$instances" != - ] || return 0
	old_ifs="$IFS"
	IFS=,
	set -- $instances
	IFS="$old_ifs"
	for instance in "$@"; do
		service_add_instance "$instance" || return 1
	done
}

# @variant full begin
add_mqtt_instances() {
	local instances="$1" old_ifs instance

	[ "$instances" != - ] || return 0
	old_ifs="$IFS"
	IFS=,
	set -- $instances
	IFS="$old_ifs"
	for instance in "$@"; do
		service_add_mqtt_instance "$instance" || return 1
	done
}
# @variant full end

service_prepare_start() {
	# @variant full begin
	CAKE_AUTORATE_SERVICE_LOCK_BORROW=1 \
		CAKE_AUTORATE_RUNTIME_GLOBAL_LOCK_FD=8 \
		"$DAEMON" --service-lifecycle prepare-start
	# @variant full end
	# @variant lite begin
	"$DAEMON" --service-lifecycle prepare-start
	# @variant lite end
}

# @variant full begin
native_apply_add_selected_instance() {
	service_add_instance "$1"
}

native_apply_register_instance() {
	[ "$#" -eq 1 ] || return 1
	case "$1" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	[ "${#1}" -le 64 ] || return 1
	[ "${CAKE_AUTORATE_NATIVE_APPLY_RECOVERY:-0}" = 1 ] || return 1
	[ "${CAKE_AUTORATE_RUNTIME_GLOBAL_LOCK_BORROW:-0}" = 1 ] || return 1
	[ "${CAKE_AUTORATE_RUNTIME_GLOBAL_LOCK_FD:-}" = 8 ] || return 1
	rc_procd native_apply_add_selected_instance "$1" >/dev/null
}
# @variant full end

start_service_locked() {
	local result marker controller_instances
	# @variant full begin
	local remainder mqtt_instances
	# @variant full end

	SERVICE_START_CONFIRM_DEFERRED=0
	if ! result="$(service_prepare_start)"; then
		logger -t cake-autorate "native service start preparation failed"
		return 1
	fi
	if [ "$result" = service-start-deferred-v1 ]; then
		SERVICE_START_CONFIRM_DEFERRED=1
		return 0
	fi
	marker="${result%% *}"
	[ "$marker" != "$result" ] || {
		logger -t cake-autorate "native service start returned a malformed response"
		return 1
	}
	# @variant full begin
	remainder="${result#* }"
	controller_instances="${remainder%% *}"
	[ "$controller_instances" != "$remainder" ] || {
		logger -t cake-autorate "native service start returned a truncated response"
		return 1
	}
	mqtt_instances="${remainder#* }"
	[ "$marker" = service-start-v2 ] || {
		logger -t cake-autorate "native service start returned an unsupported response"
		return 1
	}
	case "$mqtt_instances" in *' '*) return 1 ;; esac
	# @variant full end
	# @variant lite begin
	controller_instances="${result#* }"
	[ "$marker" = service-start-v1 ] || {
		logger -t cake-autorate "native service start returned an unsupported response"
		return 1
	}
	case "$controller_instances" in *' '*) return 1 ;; esac
	# @variant lite end
	validate_service_instance_list "$controller_instances" || {
		logger -t cake-autorate "native service start returned an unsafe controller list"
		return 1
	}
	# @variant full begin
	validate_service_instance_list "$mqtt_instances" || {
		logger -t cake-autorate "native service start returned an unsafe MQTT list"
		return 1
	}
	# @variant full end
	add_controller_instances "$controller_instances" || {
		logger -t cake-autorate "unable to construct the complete native controller set"
		# rc.common unconditionally serializes the accumulated JSON after
		# start_service returns. Exit the child so a partial set cannot reach procd.
		exit 1
	}
	# @variant full begin
	add_mqtt_instances "$mqtt_instances" || {
		logger -t cake-autorate "unable to construct the complete native MQTT set"
		exit 1
	}
	# @variant full end
}

# @variant full begin
service_confirm_started() {
	local result

	if ! result="$("$DAEMON" --service-lifecycle confirm-started 2>/dev/null)"; then
		logger -t cake-autorate "native controller lifecycle readiness confirmation failed"
		return 1
	fi
	[ "$result" = "service-started-v1 ready" ] || {
		logger -t cake-autorate "native controller lifecycle returned an invalid readiness confirmation"
		return 1
	}
}

service_started() {
	[ "$SERVICE_START_CONFIRM_DEFERRED" -eq 0 ] || return 0
	# A native Apply caller owns the borrowed descriptor until its Rust
	# transaction returns and performs the post-lock readiness proof.
	[ "${CAKE_AUTORATE_RUNTIME_GLOBAL_LOCK_BORROW:-0}" != 1 ] || return 0
	if [ "$SERVICE_RUNTIME_LOCK_HELD" -eq 1 ]; then
		SERVICE_START_CONFIRM_PENDING=1
		return 0
	fi
	service_confirm_started
}
# @variant full end

# @variant full begin
start_service() {
	local lock_was_held="$SERVICE_RUNTIME_LOCK_HELD"
	local rc

	service_runtime_lock_acquire_or_exit "start CAKE Autorate"
	if start_service_locked; then
		rc=0
	else
		rc=$?
	fi
	if [ "$lock_was_held" -eq 0 ]; then
		service_runtime_lock_release_or_exit "starting CAKE Autorate"
	fi

	return "$rc"
}
# @variant full end
# @variant lite begin
start_service() {
	start_service_locked
}
# @variant lite end

# @variant full begin
reload_service() {
	local lock_was_held="$SERVICE_RUNTIME_LOCK_HELD"
	local rc=0

	service_runtime_lock_acquire_or_exit "reload CAKE Autorate"
	stop "$@" || rc=$?
	if [ "$rc" -eq 0 ]; then
		start "$@" || rc=$?
	fi
	if [ "$lock_was_held" -eq 0 ]; then
		service_runtime_lock_release_or_exit "reloading CAKE Autorate"
	fi
	if [ "$rc" -eq 0 ] && [ "$lock_was_held" -eq 0 ] && \
		[ "$SERVICE_START_CONFIRM_PENDING" -eq 1 ]; then
		SERVICE_START_CONFIRM_PENDING=0
		if service_confirm_started; then
			:
		else
			rc=$?
		fi
	fi

	return "$rc"
}
# @variant full end
# @variant lite begin
reload_service() {
	local rc=0

	stop "$@" || rc=$?
	if [ "$rc" -eq 0 ]; then
		start "$@" || rc=$?
	fi
	return "$rc"
}
# @variant lite end

# rc.common's stock restart() releases all service-local state between stop
# and start. Route it through the same explicit reload transaction.
restart() {
	local rc

	trap '' TERM
	if reload_service "$@"; then
		rc=0
	else
		rc=$?
	fi
	trap - TERM

	return "$rc"
}

# @variant full begin
stop_service() {
	local lock_was_held="$SERVICE_RUNTIME_LOCK_HELD" result

	service_runtime_lock_acquire_or_exit "stop CAKE Autorate"
	if [ "$lock_was_held" -eq 0 ]; then
		# rc.common calls procd_kill() only after this hook returns.  Keep the
		# exclusive descriptor open until service_stopped() has run.
		SERVICE_RUNTIME_STOP_RELEASE_PENDING=1
	fi
	if ! result="$(CAKE_AUTORATE_SERVICE_LOCK_BORROW=1 \
		CAKE_AUTORATE_RUNTIME_GLOBAL_LOCK_FD=8 \
		"$DAEMON" --service-lifecycle execute-stop)"; then
		logger -t cake-autorate "native service stop transaction failed"
		exit 1
	fi
	[ "$result" = "service-stop-v1 ok" ] || {
		logger -t cake-autorate "native service stop returned a malformed response"
		exit 1
	}
}
# @variant full end
# @variant lite begin
stop_service() {
	local result

	if ! result="$("$DAEMON" --service-lifecycle execute-stop)"; then
		logger -t cake-autorate "native service stop transaction failed"
		exit 1
	fi
	[ "$result" = "service-stop-v1 ok" ] || {
		logger -t cake-autorate "native service stop returned a malformed response"
		exit 1
	}
}
# @variant lite end

# @variant full begin
service_stopped() {
	if [ "$SERVICE_RUNTIME_STOP_RELEASE_PENDING" -eq 1 ]; then
		SERVICE_RUNTIME_STOP_RELEASE_PENDING=0
		service_runtime_lock_release_or_exit "stopping CAKE Autorate"
	fi
}
# @variant full end
# @variant lite begin
service_stopped() {
	:
}
# @variant lite end

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
	procd_add_reload_trigger "$SQM_CONFIG"
}
