#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1
DAEMON="${CAKE_AUTORATE_DAEMON:-/usr/sbin/cake-autorated}"
NATIVE_SCHEDULER_STORE="/etc/cake-autorate-rs-scheduler"
CALIBRATION_START_DEFERRED=0

start_service() {
	local plan expected deferred
	expected="$(printf 'cake-autorate-calibration-service\t1\tcoordinator')"
	deferred="$(printf 'cake-autorate-calibration-service\t1\tdeferred')"
	plan="$("$DAEMON" --calibration-service prepare-start 2>/dev/null)" || {
		logger -t cake-autorate-autotune "native calibration lifecycle preparation failed; calibration services remain stopped"
		return 1
	}
	if [ "$plan" = "$deferred" ]; then
		CALIBRATION_START_DEFERRED=1
		return 0
	fi
	[ "$plan" = "$expected" ] || {
		logger -t cake-autorate-autotune "native calibration lifecycle returned an invalid start plan"
		return 1
	}

	procd_open_instance coordinator
	procd_set_param command "$DAEMON" --calibrationd --native-rating --native-speedtest --native-autotune \
		--native-scheduler --scheduler-store-dir "$NATIVE_SCHEDULER_STORE"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	local plan expected
	expected="$(printf 'cake-autorate-calibration-service\t1\tstop-ready')"
	plan="$("$DAEMON" --calibration-service prepare-stop 2>/dev/null)" || {
		logger -t cake-autorate-autotune "calibration stop deferred while native Apply is active"
		# rc.common continues to procd_kill() after a non-zero return.  Exit so
		# the state-driven Rust refusal cannot be followed by process mutation.
		exit 1
	}
	[ "$plan" = "$expected" ] || {
		logger -t cake-autorate-autotune "native calibration lifecycle returned an invalid stop plan"
		exit 1
	}
}

service_started() {
	local result expected
	[ "$CALIBRATION_START_DEFERRED" -eq 0 ] || return 0
	expected="$(printf 'cake-autorate-calibration-service\t1\tready')"
	result="$("$DAEMON" --calibration-service confirm-started 2>/dev/null)" || {
		logger -t cake-autorate-autotune "native calibration lifecycle readiness confirmation failed"
		return 1
	}
	[ "$result" = "$expected" ] || {
		logger -t cake-autorate-autotune "native calibration lifecycle returned an invalid readiness confirmation"
		return 1
	}
}

service_stopped() {
	local result expected
	expected="$(printf 'cake-autorate-calibration-service\t1\tstopped')"
	result="$("$DAEMON" --calibration-service confirm-stopped 2>/dev/null)" || {
		logger -t cake-autorate-autotune "native calibration lifecycle stop confirmation failed"
		exit 1
	}
	[ "$result" = "$expected" ] || {
		logger -t cake-autorate-autotune "native calibration lifecycle returned an invalid stop confirmation"
		exit 1
	}
}
