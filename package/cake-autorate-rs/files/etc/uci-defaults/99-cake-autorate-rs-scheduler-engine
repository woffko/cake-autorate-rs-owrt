#!/bin/sh

# This file is sourced by OpenWrt default_postinst on an on-device install and
# by the boot service for an image-root installation. It makes one durable
# event-driven ownership decision; no timer or delayed retry is involved.

DAEMON="/usr/sbin/cake-autorated"
CONFIG="cake-autorate"
GLOBALS="cake-autorate.globals"
ENGINE_OPTION="cake-autorate.globals.autotune_scheduler_engine"
NATIVE_SCHEDULER_STORE="/etc/cake-autorate-rs-scheduler"
CALIBRATION_CAPABILITIES_V3="cake-autorate-calibration-capabilities 3 native-autotune native-rating native-scheduler native-speedtest"

# Presence, including an explicitly empty or invalid value, means an owner was
# already selected or edited. Preserve it verbatim; the strict init reader will
# reject invalid values instead of silently changing ownership.
if uci -q get "$ENGINE_OPTION" >/dev/null 2>&1; then
	exit 0
fi

engine="legacy"
reason="upgrade-compatibility"
prior_configuration=0
if [ "${PKG_UPGRADE:-0}" = 1 ] || [ -d "$NATIVE_SCHEDULER_STORE" ]; then
	prior_configuration=1
elif uci -q show "$CONFIG" 2>/dev/null |
	grep -Eq '^cake-autorate\.[^=]+=cake_autorate$'; then
	prior_configuration=1
fi

if [ "$prior_configuration" -eq 0 ]; then
	capabilities="$("$DAEMON" --calibration-capabilities 2>/dev/null)" || capabilities=""
	if [ "$capabilities" = "$CALIBRATION_CAPABILITIES_V3" ]; then
		engine="native"
		reason="exact-native-capability"
	else
		reason="native-capability-unavailable"
	fi
fi

created_globals=0
if ! uci -q get "$GLOBALS" >/dev/null 2>&1; then
	uci -q set "$GLOBALS=globals" || exit 1
	created_globals=1
fi

rollback_staged_owner() {
	uci -q revert "$ENGINE_OPTION" >/dev/null 2>&1 || true
	[ "$created_globals" -eq 0 ] || uci -q revert "$GLOBALS" >/dev/null 2>&1 || true
}

if ! uci -q set "$ENGINE_OPTION=$engine"; then
	rollback_staged_owner
	exit 1
fi
if ! uci -q commit "$CONFIG"; then
	rollback_staged_owner
	exit 1
fi
logger -t cake-autorate "selected $engine Auto-Tune scheduler ownership ($reason)"
exit 0
