+	"net/url"
+	"strings"
+	"testing"
+)
+
+// Listed HTTP endpoint redirects to another host, as Ookla-hosted servers do.
+func TestCakeUploadFollowsResolvedRedirect(t *testing.T) {
+	const listed = "http://listed.local:8080/speedtest/upload.php"
+	const final = "https://server-1.hosts.local:8080/speedtest/upload.php"
+	var posts []string
+	client := New(WithDoer(&http.Client{Transport: cakeTransport(func(r *http.Request) (*http.Response, error) {
+		if r.Body != nil {
+			_, _ = io.Copy(io.Discard, r.Body)
+			_ = r.Body.Close()
+		}
+		if r.Method == http.MethodPost {
+			posts = append(posts, r.URL.String())
+		}
+		if r.URL.Host == "listed.local:8080" {
+			header := make(http.Header)
+			header.Set("Location", final)
+			return &http.Response{StatusCode: 307, Body: io.NopCloser(strings.NewReader("")), Header: header, Request: r}, nil
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("ok")), Header: make(http.Header), Request: r}, nil
+	})}))
+	dm := client.Manager.(*DataManager)
+	dm.running = true
+
+	// Without resolution a streamed POST cannot follow 307 and fails.
+	direct := Server{URL: listed, Context: client}
+	if err := uploadRequest(context.Background(), &direct, 0); err == nil {
+		t.Fatal("unresolved redirected upload unexpectedly succeeded")
+	}
+
+	server := Server{URL: listed, Context: client}
+	server.resolveUploadURL(context.Background())
+	if server.resolvedUploadURL != final {
+		t.Fatalf("resolved %q, want %q", server.resolvedUploadURL, final)
+	}
+	if server.URL != listed {
+		t.Fatalf("reported URL changed to %q", server.URL)
+	}
+	posts = nil
+	if err := uploadRequest(context.Background(), &server, 0); err != nil {
+		t.Fatalf("resolved upload failed: %v", err)
+	}
+	if len(posts) != 1 || posts[0] != final {
+		t.Fatalf("upload targets %v, want only the resolved endpoint", posts)
+	}
+}
+
+func TestCakeUploadResolutionKeepsListedURLWithoutRedirect(t *testing.T) {
+	client := New(WithDoer(&http.Client{Transport: cakeTransport(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header), Request: r}, nil
+	})}))
+	server := Server{URL: "http://listed.local/upload.php", Context: client}
+	server.resolveUploadURL(context.Background())
+	if server.resolvedUploadURL != "" {
+		t.Fatalf("unexpected resolution %q", server.resolvedUploadURL)
+	}
+	failing := New(WithDoer(&http.Client{Transport: cakeTransport(func(r *http.Request) (*http.Response, error) {
+		return nil, &url.Error{Op: "Get", URL: r.URL.String(), Err: io.ErrUnexpectedEOF}
+	})}))
+	broken := Server{URL: "http://listed.local/upload.php", Context: failing}
+	broken.resolveUploadURL(context.Background())
+	if broken.resolvedUploadURL != "" {
+		t.Fatal("a failed probe must keep the listed URL")
+	}
+}
