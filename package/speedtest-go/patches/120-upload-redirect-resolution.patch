+// Speedtest servers may redirect the listed HTTP endpoint to another host,
+// for example HTTPS. A streamed upload body cannot be replayed across 307/308,
+// so every upload would fail. Resolve the final endpoint once with a body-less
+// GET that follows redirects, before any timed transfer. Failure keeps the
+// listed URL; the upload itself then reports the real error.
+func (s *Server) resolveUploadURL(ctx context.Context) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, s.URL, nil)
+	if err != nil {
+		return
+	}
+	resp, err := s.Context.doer.Do(req)
+	if err != nil {
+		return
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 64<<10))
+	if resp.Request == nil || resp.Request.URL == nil {
+		return
+	}
+	final := resp.Request.URL
+	if (final.Scheme != "http" && final.Scheme != "https") || final.Host == "" {
+		return
+	}
+	if final.String() != s.URL {
+		dbg.Printf("Upload endpoint redirected: %s -> %s\n", s.URL, final)
+		s.resolvedUploadURL = final.String()
+	}
+}
