+package speedtest
+
+import (
+	"net"
+	"testing"
+)
+
+// The packet loss analyzer must use --source like the rest of the test: the
+// daemon accounts only for IPv4 flows of the backend on the measured uplink,
+// so an IPv6 or unbound socket aborts the measurement.
+func TestCakeLossAnalyzerBindsTheSourceAddress(t *testing.T) {
+	for _, source := range []string{"192.0.2.10", "tcp://192.0.2.10"} {
+		analyzer := NewPacketLossAnalyzer(&PacketLossAnalyzerOptions{SourceInterface: source})
+		tcp, ok := analyzer.options.TCPDialer.LocalAddr.(*net.TCPAddr)
+		if !ok || !tcp.IP.Equal(net.ParseIP("192.0.2.10")) || tcp.Port != 0 {
+			t.Fatalf("%s: TCP sampler is bound to %v", source, analyzer.options.TCPDialer.LocalAddr)
+		}
+		udp, ok := analyzer.options.UDPDialer.LocalAddr.(*net.UDPAddr)
+		if !ok || !udp.IP.Equal(net.ParseIP("192.0.2.10")) || udp.Port != 0 {
+			t.Fatalf("%s: UDP sender is bound to %v", source, analyzer.options.UDPDialer.LocalAddr)
+		}
+	}
+}
+
+func TestCakeLossAnalyzerWithoutAnAddressStaysUnbound(t *testing.T) {
+	for _, source := range []string{"", "not an address"} {
+		analyzer := NewPacketLossAnalyzer(&PacketLossAnalyzerOptions{SourceInterface: source})
+		if analyzer.options.TCPDialer.LocalAddr != nil || analyzer.options.UDPDialer.LocalAddr != nil {
+			t.Fatalf("%q: dialers are bound to %v and %v", source,
+				analyzer.options.TCPDialer.LocalAddr, analyzer.options.UDPDialer.LocalAddr)
+		}
+	}
+}
+
+func TestCakeLossAnalyzerDialersKeepAnIPv4SourceOffIPv6(t *testing.T) {
+	analyzer := NewPacketLossAnalyzer(&PacketLossAnalyzerOptions{SourceInterface: "127.0.0.1"})
+	v4, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer v4.Close()
+	conn, err := analyzer.options.TCPDialer.Dial("tcp", v4.Addr().String())
+	if err != nil {
+		t.Fatalf("IPv4 sampler connection: %v", err)
+	}
+	conn.Close()
+	v6, err := net.Listen("tcp6", "[::1]:0")
+	if err != nil {
+		t.Skipf("no IPv6 loopback here: %v", err)
+	}
+	defer v6.Close()
+	if conn, err := analyzer.options.TCPDialer.Dial("tcp", v6.Addr().String()); err == nil {
+		conn.Close()
+		t.Fatal("the TCP sampler connected over IPv6 despite an IPv4 source")
+	}
+	if conn, err := analyzer.options.UDPDialer.Dial("udp", v6.Addr().String()); err == nil {
+		conn.Close()
+		t.Fatal("the UDP sender opened an IPv6 socket despite an IPv4 source")
+	}
+}
