+// lossSourceAddrs binds the analyzer's TCP sampler and UDP sender to the
+// --source address, as every other socket of the test is bound. Upstream
+// resolved the bare address as a "udp" host:port, which fails without a
+// port, and never bound the TCP sampler, so on a dual-stack host both
+// connected to the server over IPv6 (preferred by RFC 6724), or left
+// through another uplink, whatever --source said. With an IPv4 source the
+// dialers only consider the server's IPv4 addresses. A source that is not an
+// IP address keeps the unbound dialers; nothing is looked up here.
+func lossSourceAddrs(source string) (net.Addr, net.Addr) {
+	_, address := parseAddr(source)
+	ip := net.ParseIP(address)
+	if ip == nil {
+		return nil, nil
+	}
+	return &net.TCPAddr{IP: ip}, &net.UDPAddr{IP: ip}
+}
