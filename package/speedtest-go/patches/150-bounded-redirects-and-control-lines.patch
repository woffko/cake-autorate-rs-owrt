+// A server may redirect the listed endpoint, typically to HTTPS, but a
+// redirect is server-controlled input: it must stay on a public address and
+// must not drop from HTTPS to HTTP.
+func checkRedirect(req *http.Request, via []*http.Request) error {
+	if len(via) >= 10 {
+		return errors.New("stopped after 10 redirects")
+	}
+	if req.URL.Scheme != "http" && req.URL.Scheme != "https" {
+		return fmt.Errorf("redirect to unsupported scheme %q", req.URL.Scheme)
+	}
+	if len(via) > 0 && via[0].URL.Scheme == "https" && req.URL.Scheme == "http" {
+		return errors.New("redirect downgrades https to http")
+	}
+	host := req.URL.Hostname()
+	if host == "" {
+		return errors.New("redirect without a host")
+	}
+	// The listed host was chosen by the operator or the server directory;
+	// staying on it (for example http -> https) needs no address check.
+	if len(via) > 0 && strings.EqualFold(host, via[0].URL.Hostname()) {
+		return nil
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		if !isPublicIP(ip) {
+			return fmt.Errorf("redirect to non-public address %s", host)
+		}
+		return nil
+	}
+	addrs, err := net.DefaultResolver.LookupIPAddr(req.Context(), host)
+	if err != nil {
+		return err
+	}
+	for _, addr := range addrs {
+		if !isPublicIP(addr.IP) {
+			return fmt.Errorf("redirect to %s resolving to non-public address %s", host, addr.IP)
+		}
+	}
+	return nil
+}
