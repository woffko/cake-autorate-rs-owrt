+func recordRequestFailure(ctx context.Context, td *TestDirection, count *int64, err error) {
+	if ctx.Err() != nil {
+		td.closeFunc()
+		return
+	}
+	if err == nil {
+		return
+	}
+	if atomic.AddInt64(count, 1) >= maxRequestFailures {
+		td.closeFunc()
+		return
+	}
+	timer := time.NewTimer(50 * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+	case <-timer.C:
+	}
+}
