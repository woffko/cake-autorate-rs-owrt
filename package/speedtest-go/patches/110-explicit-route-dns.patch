+++ b/cake_route_dns.go
@@ -0,0 +1,40 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"time"
+)
+
+// This opt-in CLI resolver never consults the system DNS endpoint. The owning
+// process supplies source routing and egress enforcement; DNS uses TCP/IPv4 only.
+func newRouteDNSResolver(source, server string) (*net.Resolver, error) {
+	parse := func(value string) net.IP {
+		ip := net.ParseIP(value)
+		if ip == nil || ip.To4() == nil || ip.String() != value {
+			return nil
+		}
+		ip = ip.To4()
+		if ip[0] == 0 || ip[0] >= 224 || ip.IsLoopback() || ip.IsLinkLocalUnicast() {
+			return nil
+		}
+		return ip
+	}
+	local, remote := parse(source), parse(server)
+	if local == nil || remote == nil {
+		return nil, fmt.Errorf("--route-dns-ipv4 requires canonical unicast IPv4 source and DNS addresses")
+	}
+	dialer := &net.Dialer{
+		Timeout: 5 * time.Second,
+		LocalAddr: &net.TCPAddr{IP: local},
+	}
+	endpoint := net.JoinHostPort(remote.String(), "53")
+	return &net.Resolver{
+		PreferGo: true,
+		StrictErrors: true,
+		Dial: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return dialer.DialContext(ctx, "tcp4", endpoint)
+		},
+	}, nil
+}
