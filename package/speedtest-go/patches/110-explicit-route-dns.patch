@@ -0,0 +1,31 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestCakeRouteDNSValidation(t *testing.T) {
+	for _, value := range []string{"", "localhost", "192.0.2.53:53", " 192.0.2.53",
+		"::1", "::ffff:192.0.2.53", "0.0.0.0", "0.1.2.3", "127.0.0.1",
+		"169.254.1.2", "224.0.0.1", "255.255.255.255"} {
+		if _, err := newRouteDNSResolver("192.0.2.1", value); err == nil {
+			t.Fatalf("accepted DNS %q", value)
+		}
+		if _, err := newRouteDNSResolver(value, "192.0.2.53"); err == nil {
+			t.Fatalf("accepted source %q", value)
+		}
+	}
+	resolver, err := newRouteDNSResolver("192.0.2.1", "192.0.2.53")
+	if err != nil || !resolver.PreferGo || !resolver.StrictErrors || resolver.Dial == nil {
+		t.Fatalf("valid resolver: %v, %v", resolver, err)
+	}
+	// A cancelled operation must fail without falling back to a system endpoint.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	conn, err := resolver.Dial(ctx, "udp6", "[::1]:53")
+	if conn != nil || !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled resolver: %v, %v", conn, err)
+	}
+}
