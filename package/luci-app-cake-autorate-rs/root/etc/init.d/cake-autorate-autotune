#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1
DAEMON="${CAKE_AUTORATE_DAEMON:-/usr/sbin/cake-autorated}"
NATIVE_SCHEDULER_STORE="/etc/cake-autorate-rs-scheduler"
CALIBRATION_CAPABILITIES_V3="cake-autorate-calibration-capabilities 3 native-autotune native-rating native-scheduler native-speedtest"

read_scheduler_engine() {
	local engine
	config_load cake-autorate || return 1
	config_get engine globals autotune_scheduler_engine
	[ -n "$engine" ] || {
		logger -t cake-autorate-autotune "autotune_scheduler_engine is missing; refusing ambiguous scheduler ownership"
		return 1
	}
	case "$engine" in
		legacy|native) printf '%s\n' "$engine" ;;
		*)
			logger -t cake-autorate-autotune "invalid autotune_scheduler_engine: $engine"
			return 1
			;;
	esac
}

start_service() {
	local scheduler_engine capabilities native_capable=0
	# Recover an interrupted native Apply transaction before either the
	# coordinator or the normal CAKE service can admit new work.  The recovery
	# command is idempotent and returns success when no durable transaction is
	# pending.  A failure leaves the main init service fail-closed on its own
	# matching recovery-directory guard.
	"$DAEMON" --native-apply-recover >/dev/null 2>&1 || {
		logger -t cake-autorate-autotune "native Apply recovery failed; calibration services remain stopped"
		return 1
	}
	scheduler_engine="$(read_scheduler_engine)" || {
		logger -t cake-autorate-autotune "unable to read the scheduler engine; calibration services remain stopped"
		return 1
	}
	capabilities="$("$DAEMON" --calibration-capabilities 2>/dev/null)" || capabilities=""
	[ "$capabilities" != "$CALIBRATION_CAPABILITIES_V3" ] || native_capable=1

	# Interactive Rating, Speed Test and Full Auto-Tune for an already configured uplink are
	# owned by the native Rust coordinator. Unsupported bootstrap/backends remain
	# on their explicitly selected legacy path only when LuCI rejects them before
	# native admission; an attempted native start is never replayed through shell.
	if [ "$scheduler_engine" = native ]; then
		if [ "$native_capable" != 1 ]; then
			logger -t cake-autorate-autotune "daemon has no production native scheduler capability; refusing split scheduler ownership"
			return 1
		fi
	fi

	procd_open_instance coordinator
	if [ "$scheduler_engine" = native ]; then
		procd_set_param command "$DAEMON" --calibrationd --native-rating --native-speedtest --native-autotune \
			--native-scheduler --scheduler-store-dir "$NATIVE_SCHEDULER_STORE"
	elif [ "$native_capable" = 1 ]; then
		procd_set_param command "$DAEMON" --calibrationd --native-rating --native-speedtest --native-autotune
	else
		logger -t cake-autorate-autotune "daemon has no production native Auto-Tune capability; starting a passive compatibility coordinator"
		procd_set_param command "$DAEMON" --calibrationd
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ "$scheduler_engine" = legacy ]; then
		procd_open_instance scheduler
		procd_set_param command /usr/libexec/cake-autorate-rs/autotune-scheduler run
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	# procd keeps this process outside every Full Auto-Tune worker process
	# group.  It is the durable fallback when both a worker and its optional
	# detached fast-path watcher are killed without running EXIT traps.
	procd_open_instance recovery
	procd_set_param command /usr/libexec/cake-autorate-rs/autotune-recover monitor /tmp/cake-autorate-autotune/recovery
	procd_set_param respawn 60 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
