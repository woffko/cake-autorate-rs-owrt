{
	"luci-app-cake-autorate-rs": {
		"description": "Grant access to CAKE Autorate RS LuCI app",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/var/run/sqm/available_qdiscs": [ "list" ],
				"/usr/lib/sqm/*.qos.help": [ "read" ],
				"/var/run/cake-autorate/*/status.json": [ "read" ],
				"/var/run/cake-autorate/*/history.csv": [ "read" ],
				"/etc/init.d/cake-autorate status": [ "exec" ],
				"/etc/init.d/sqm status": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/package-versions": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/runtime-health": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/autotune-scheduler status *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/traffic-classifier presets": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/traffic-classifier status": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/traffic-classifier status *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/graph-history *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/mwan3-info": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/log-bundle *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl summary": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl rating-current *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl rating-status *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl rating-result *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl speedtest-current *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl speedtest-status *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl speedtest-result *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl autotune-current *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl autotune-status *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl autotune-result *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl autotune-apply-check *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl scheduler-status": [ "exec" ]
			},
			"ubus": {
				"file": [ "read", "list" ],
				"luci": [ "getInitList" ]
			},
			"uci": [ "cake-autorate", "sqm", "mwan3", "network" ]
		},
		"write": {
			"cgi-io": [ "exec" ],
			"file": {
				"/etc/init.d/cake-autorate enable": [ "exec" ],
				"/etc/init.d/cake-autorate disable": [ "exec" ],
				"/etc/init.d/cake-autorate start": [ "exec" ],
				"/etc/init.d/cake-autorate stop": [ "exec" ],
				"/etc/init.d/cake-autorate restart": [ "exec" ],
				"/etc/init.d/cake-autorate reload": [ "exec" ],
				"/etc/init.d/cake-autorate-mqtt enable": [ "exec" ],
				"/etc/init.d/cake-autorate-mqtt disable": [ "exec" ],
				"/etc/init.d/cake-autorate-mqtt start": [ "exec" ],
				"/etc/init.d/cake-autorate-mqtt stop": [ "exec" ],
				"/etc/init.d/cake-autorate-mqtt restart": [ "exec" ],
				"/etc/init.d/cake-autorate-mqtt reload": [ "exec" ],
				"/etc/init.d/sqm enable": [ "exec" ],
				"/etc/init.d/sqm start": [ "exec" ],
				"/etc/init.d/sqm restart": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper speedtest-job-start *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper speedtest-job-status *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper speedtest-status *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper speedtest-install *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper autotune-start *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper autotune-start-conservative *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper autotune-status-summary *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper autotune-result *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper autotune-cancel *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper autotune-status *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper autotune-attest *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper apply-guard-arm *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper apply-guard-abort *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper apply-guard-verify-rollback *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper apply-guard-finalize *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper apply-guard-reconcile *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/rpcd-helper apply-guard-status *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/pinger-plan *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/log-bundle *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/mqtt-status *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/graph-history *": [ "exec" ],
				"/usr/libexec/cake-autorate-rs/status-columns *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl autotune-start *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl autotune-bootstrap-start *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl autotune-cancel *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl autotune-apply *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl rating-start *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl rating-cancel *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl speedtest-start *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl speedtest-cancel *": [ "exec" ],
				"/usr/sbin/cake-autorated --calibrationctl scheduler-acknowledge-accounting *": [ "exec" ]
			},
			"ubus": {
				"luci": [ "setInitAction" ],
				"uci": [ "revert" ]
			},
			"uci": [ "cake-autorate", "sqm" ]
		}
	}
}
