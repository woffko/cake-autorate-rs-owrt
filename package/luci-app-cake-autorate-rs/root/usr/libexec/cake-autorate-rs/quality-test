#!/bin/sh

section="$1"
requested_mode="${2:-status}"
capture_mode="${3:-client}"
backend="${4:-auto}"

job_root="${CAKE_AUTORATE_QUALITY_DIR:-/tmp/cake-autorate-quality}"
runtime_root="${CAKE_AUTORATE_RUNTIME_DIR:-/var/run/cake-autorate}"
speedtest_bin="${CAKE_AUTORATE_SPEEDTEST:-/usr/libexec/cake-autorate-rs/speedtest}"
runtime_lock_lib="${CAKE_AUTORATE_RUNTIME_LOCK_LIB:-/usr/libexec/cake-autorate-rs/runtime-lock}"
jsonfilter_bin="${CAKE_AUTORATE_JSONFILTER:-$(command -v jsonfilter 2>/dev/null)}"
uci_bin="${CAKE_AUTORATE_UCI:-uci}"
procd_job_bin="${CAKE_AUTORATE_PROCD_JOB:-/usr/libexec/cake-autorate-rs/procd-job}"
quality_self="${CAKE_AUTORATE_QUALITY_SELF:-$0}"
flock_bin="${CAKE_AUTORATE_RUNTIME_FLOCK:-flock}"
timeout_s="${CAKE_AUTORATE_QUALITY_TIMEOUT_S:-180}"
runtime_ready_timeout_s="${CAKE_AUTORATE_QUALITY_READY_TIMEOUT_S:-90}"
max_automatic_runs="${CAKE_AUTORATE_QUALITY_MAX_RUNS:-3}"
capture_phase="AUTO"
background_dl_kbps="0"
background_ul_kbps="0"
quiet_window_s="5"
quiet_timeout_s="30"
quiet_ratio="0.05"
quiet_min_kbps="1000"
readiness_retryable=0
readiness_code=""

case "$runtime_ready_timeout_s" in
	''|*[!0-9]*) runtime_ready_timeout_s=90 ;;
esac
[ "$runtime_ready_timeout_s" -ge 5 ] 2>/dev/null || runtime_ready_timeout_s=5
[ "$runtime_ready_timeout_s" -le "$timeout_s" ] 2>/dev/null || runtime_ready_timeout_s="$timeout_s"

if [ -r "$runtime_lock_lib" ]; then
	# shellcheck source=/usr/libexec/cake-autorate-rs/runtime-lock
	. "$runtime_lock_lib"
fi

json_escape() {
	printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_error() {
	printf '{"error":"%s"}\n' "$(json_escape "$1")"
	exit 1
}

worker_fail() {
	message="$1"
	atomic_write "$error_file" "{\"state\":\"error\",\"error\":\"$(json_escape "$message")\"}"
	exit 1
}

safe_name() {
	case "$1" in
		''|*[!A-Za-z0-9_]*) return 1 ;;
	esac
}

safe_interface() {
	case "$1" in
		''|*[!A-Za-z0-9_.:@-]*) return 1 ;;
	esac
}

is_pid() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -gt 1 ] 2>/dev/null
}

process_starttime() {
	[ -r "/proc/$1/stat" ] || return 1
	sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk 'NF >= 20 { print $20; exit }'
}

process_group() {
	[ -r "/proc/$1/stat" ] || return 1
	sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk 'NF >= 4 { print $3; exit }'
}

process_session() {
	[ -r "/proc/$1/stat" ] || return 1
	sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk 'NF >= 4 { print $4; exit }'
}

# Fractional sleep is not guaranteed by OpenWrt BusyBox. Prefer it (or
# usleep) when present, otherwise use a bounded whole-second wait rather than
# silently spinning through identity and cancellation checks.
handshake_sleep_mode=""
handshake_usleep_bin=""
handshake_sleep() {
	case "$handshake_sleep_mode" in
		fractional) sleep 0.05 ;;
		usleep) "$handshake_usleep_bin" 50000 ;;
		whole) sleep 1 ;;
		'')
			if sleep 0.05 2>/dev/null; then
				handshake_sleep_mode=fractional
				return 0
			fi
			handshake_usleep_bin="$(command -v usleep 2>/dev/null || true)"
			if [ -n "$handshake_usleep_bin" ] &&
			   "$handshake_usleep_bin" 50000 2>/dev/null; then
				handshake_sleep_mode=usleep
				return 0
			fi
			handshake_sleep_mode=whole
			sleep 1
			;;
		*) return 1 ;;
	esac
}

quality_cmdline_matches() {
	pid="$1"
	expected_mode="$2"
	expected_backend="$3"
	[ -r "/proc/$pid/cmdline" ] || return 1
	tr '\000' '\n' < "/proc/$pid/cmdline" | awk \
		-v self="$quality_self" -v section="$section" -v mode="$expected_mode" -v backend="$expected_backend" '
		$0 == self { state = 1; next }
		state == 1 && $0 == section { state = 2; next }
		state == 2 && $0 == "worker" { state = 3; next }
		state == 3 && $0 == mode { state = 4; next }
		state == 4 && $0 == backend { state = 5; exit }
		END { exit !(state == 5) }'
}

quality_identity_matches() {
	pid="$1"
	start="$2"
	expected_mode="$3"
	expected_backend="$4"
	is_pid "$pid" && is_pid "$start" || return 1
	[ "$(process_starttime "$pid" 2>/dev/null)" = "$start" ] &&
		quality_cmdline_matches "$pid" "$expected_mode" "$expected_backend"
}

read_worker_identity() {
	worker_pid=""
	worker_start=""
	worker_section=""
	worker_mode=""
	worker_backend=""
	[ -f "$pid_file" ] && [ ! -L "$pid_file" ] || return 1
	worker_pid="$(sed -n '1p' "$pid_file" 2>/dev/null)"
	worker_start="$(sed -n '2p' "$pid_file" 2>/dev/null)"
	worker_section="$(sed -n '3p' "$pid_file" 2>/dev/null)"
	worker_mode="$(sed -n '4p' "$pid_file" 2>/dev/null)"
	worker_backend="$(sed -n '5p' "$pid_file" 2>/dev/null)"
	case "$worker_mode" in automatic|client) ;; *) return 1 ;; esac
	case "$worker_backend" in ''|*[!A-Za-z0-9_.-]*) return 1 ;; esac
	[ "$worker_section" = "$section" ] &&
		quality_identity_matches "$worker_pid" "$worker_start" "$worker_mode" "$worker_backend"
}

wait_for_launched_worker() {
	pid="$1"
	start="$2"
	attempt=0
	# Fractional sleep is not enabled in every OpenWrt BusyBox build.  Bound
	# the RPC-side exec transition without allowing a failed sleep to spin.
	# procd may publish the isolated setsid process before its small launcher
	# has exec'd the final worker.  A 250 ms budget was too short during boot,
	# when netifd, ModemManager, firewall and SQM hotplug all compete for CPU.
	# Keep the transition bounded, but tolerate up to three seconds of scheduler
	# jitter before treating the identity as invalid.
	while [ "$attempt" -lt 60 ]; do
		[ "$(process_starttime "$pid" 2>/dev/null)" = "$start" ] || return 1
		if [ "$(process_group "$pid" 2>/dev/null)" = "$pid" ] &&
		   [ "$(process_session "$pid" 2>/dev/null)" = "$pid" ] &&
		   quality_cmdline_matches "$pid" "$capture_mode" "$backend"; then
			return 0
		fi
		attempt=$((attempt + 1))
		# The portable fallback sleeps a whole second, so three attempts are
		# already the full bounded budget in that mode.
		[ "$handshake_sleep_mode" != whole ] || [ "$attempt" -lt 4 ] || return 1
		handshake_sleep
	done
	return 1
}

verified_launch_identity() {
	pid="$1"
	start="$2"
	is_pid "$pid" && is_pid "$start" || return 1
	[ "$(process_starttime "$pid" 2>/dev/null)" = "$start" ] &&
		[ "$(process_group "$pid" 2>/dev/null)" = "$pid" ] &&
		[ "$(process_session "$pid" 2>/dev/null)" = "$pid" ]
}

terminate_verified_launch() {
	pid="$1"
	start="$2"
	verified_launch_identity "$pid" "$start" || return 0
	kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
}

now_epoch() {
	date +%s
}

numeric_or_default() {
	value="$1"
	fallback="$2"
	awk -v value="$value" -v fallback="$fallback" 'BEGIN {
		if (value ~ /^[0-9]+([.][0-9]+)?$/) print value; else print fallback
	}'
}

uci_default() {
	name="$1"
	fallback="$2"
	value="$("$uci_bin" -q get "cake-autorate.$section.$name" 2>/dev/null)"
	numeric_or_default "$value" "$fallback"
}

job_paths() {
	job_dir="$job_root/$section"
	pid_file="$job_dir/pid"
	status_file="$job_dir/status.json"
	result_file="$job_dir/result.json"
	error_file="$job_dir/error.json"
	cancel_file="$job_dir/cancelled"
	log_file="$job_dir/job.log"
	runtime_dir="$runtime_root/$section"
	daemon_status="$runtime_dir/status.json"
	capture_file="$runtime_dir/rating-capture"
}

ensure_private_directory() {
	directory="$1"
	if [ ! -e "$directory" ]; then
		(umask 077; mkdir "$directory") 2>/dev/null || [ -e "$directory" ] || return 1
	fi
	[ -d "$directory" ] && [ ! -L "$directory" ] || return 1
	# Establish ownership before chmod.  In a sticky shared parent such as
	# /tmp, a directory owned by this effective UID cannot be replaced by an
	# unprivileged peer between this check and chmod; an attacker-owned path is
	# rejected without ever changing its mode or following a swapped symlink.
	directory_listing="$(LC_ALL=C ls -ldn "$directory" 2>/dev/null)" || return 1
	set -- $directory_listing
	case "${1:-}" in d?????????|d?????????[.+]) ;; *) return 1 ;; esac
	effective_uid="$(id -u)" || return 1
	[ "${3:-}" = "$effective_uid" ] || return 1
	chmod 700 "$directory" 2>/dev/null || return 1
	# Confirm the same object class, owner, and final mode after chmod.  Accept
	# the optional GNU ls ACL/SELinux suffix while remaining BusyBox-compatible.
	directory_listing="$(LC_ALL=C ls -ldn "$directory" 2>/dev/null)" || return 1
	set -- $directory_listing
	case "${1:-}" in drwx------|drwx------[.+]) ;; *) return 1 ;; esac
	[ "${3:-}" = "$effective_uid" ]
}

acquire_start_lock() {
	ensure_private_directory "$job_root" || return 1
	ensure_private_directory "$job_dir" || return 1
	command -v "$flock_bin" >/dev/null 2>&1 || return 1
	[ ! -L "$job_dir/start.lock" ] || return 1
	exec 6>>"$job_dir/start.lock" || return 1
	"$flock_bin" -x 6 || return 1
}

release_start_lock() {
	"$flock_bin" -u 6 || return 1
	exec 6>&-
}

atomic_write() {
	file="$1"
	shift
	tmp="$file.$$"
	printf '%s\n' "$*" > "$tmp" && mv "$tmp" "$file"
}

status_value() {
	[ -n "$jsonfilter_bin" ] && [ -s "$daemon_status" ] || return 0
	"$jsonfilter_bin" -i "$daemon_status" -e "@$1" 2>/dev/null | sed -n '1p'
}

write_running_status() {
	message="$1"
	atomic_write "$status_file" "{\"state\":\"running\",\"mode\":\"$(json_escape "$capture_mode")\",\"message\":\"$(json_escape "$message")\"}"
}

write_capture() {
	mkdir -p "$runtime_dir" || return 1
	chmod 700 "$runtime_dir" 2>/dev/null || true
	atomic_write "$capture_file" "$token|$capture_mode|$deadline|$capture_phase|$background_dl_kbps|$background_ul_kbps"
}

clear_capture() {
	current="$(sed -n '1p' "$capture_file" 2>/dev/null)"
	case "$current" in
		"$token|"*) rm -f "$capture_file" ;;
	esac
}

resolve_target() {
	target_if="$("$uci_bin" -q get "cake-autorate.$section.sqm_interface" 2>/dev/null)"
	[ -n "$target_if" ] || target_if="$("$uci_bin" -q get "cake-autorate.$section.ul_if" 2>/dev/null)"
	[ -n "$target_if" ] || target_if="$(status_value '.route_device')"
	safe_interface "$target_if"
}

static_preflight() {
	readiness_retryable=0
	readiness_code=""
	[ "$("$uci_bin" -q get "cake-autorate.$section.enabled" 2>/dev/null)" = 1 ] || {
		failure="Autorate instance is disabled."
		readiness_code="instance_disabled"
		return 1
	}
	[ "$("$uci_bin" -q get "cake-autorate.$section.sqm_enabled" 2>/dev/null)" = 1 ] || {
		failure="Managed SQM must be enabled for a loaded rating."
		readiness_code="sqm_disabled"
		return 1
	}
	[ "$("$uci_bin" -q get "cake-autorate.$section.transport_latency_enabled" 2>/dev/null)" = 1 ] || {
		failure="Transport-aware latency must be enabled."
		readiness_code="transport_disabled"
		return 1
	}
	[ -n "$jsonfilter_bin" ] || {
		failure="jsonfilter is required."
		readiness_code="jsonfilter_missing"
		return 1
	}
	if [ "$capture_mode" = automatic ] && [ ! -x "$speedtest_bin" ]; then
		failure="Speed test helper is unavailable."
		readiness_code="speedtest_missing"
		return 1
	fi
	return 0
}

runtime_preflight() {
	uplink_state="$(status_value '.uplink_state')"
	route_test_ready="$(status_value '.route_test_ready')"
	readiness_retryable=0
	readiness_code=""
	[ -s "$daemon_status" ] || {
		failure="Runtime status is unavailable."
		readiness_retryable=1
		readiness_code="runtime_status_unavailable"
		return 1
	}
	case "$uplink_state" in
		ACTIVE|STANDBY) ;;
		RECHECKING)
			failure="Selected uplink route is being rechecked after a temporary routing error."
			readiness_retryable=1
			readiness_code="route_rechecking"
			return 1
			;;
		LEARNING)
			failure="Selected uplink is still learning its idle baseline."
			readiness_retryable=1
			readiness_code="route_learning"
			return 1
			;;
		OFFLINE)
			failure="Selected uplink is offline."
			readiness_retryable=1
			readiness_code="route_offline"
			return 1
			;;
		'') ;; # Compatibility with a status fixture or an older daemon.
		*)
			failure="Selected uplink state is unknown: $uplink_state."
			readiness_retryable=1
			readiness_code="route_unknown"
			return 1
			;;
	esac
	if [ "$capture_mode" = automatic ]; then
		if [ "$route_test_ready" != true ] &&
		   ! { [ -z "$route_test_ready" ] && [ "$(status_value '.route_active')" = true ]; }; then
			# Older status producers expose only route_active. Never use this
			# fallback when the explicit route_test_ready field is present.
			failure="Selected uplink cannot currently prove an isolated test route."
			readiness_retryable=1
			readiness_code="forced_route_not_ready"
			return 1
		fi
	elif [ "$(status_value '.route_active')" != true ]; then
		failure="Guided client mode requires client traffic to be routed through this uplink. Use Automatic mode or select an mwan3 client rule first."
		readiness_retryable=0
		readiness_code="client_route_not_active"
		return 1
	fi
	if [ "$(status_value '.sqm_runtime_managed')" = true ] && \
	   [ "$(status_value '.sqm_runtime_healthy')" != true ]; then
		failure="Managed SQM runtime is unhealthy: $(status_value '.sqm_runtime_reason')"
		case "$(status_value '.sqm_runtime_state')" in
			WAITING_LINK|WAITING_EXTERNAL_SQM|WAITING_SQM|WAITING_OPERATION|RECOVERING)
				readiness_retryable=1 ;;
		esac
		readiness_code="sqm_runtime_unhealthy"
		return 1
	fi
	[ "$(status_value '.transport_probe_trusted')" = true ] || {
		failure="A trusted native transport backend is required."
		readiness_retryable=1
		readiness_code="transport_not_ready"
		return 1
	}
	[ "$(status_value '.quality_grade_baseline_ready')" = true ] || {
		failure="Idle RTT baseline is not ready yet."
		readiness_retryable=1
		readiness_code="baseline_not_ready"
		return 1
	}
	failure=""
	return 0
}

route_status_value() {
	[ -n "${route_status_payload:-}" ] || return 0
	printf '%s\n' "$route_status_payload" | "$jsonfilter_bin" -e "@$1" 2>/dev/null | sed -n '1p'
}

attest_automatic_route() {
	route_status_payload="$($speedtest_bin "$section" "$target_if" route-status "$backend" "" \
		"$route_mode" "$mwan3_member" 2>/dev/null)" || {
		failure="Unable to attest the selected route for automatic load generation."
		return 1
	}
	[ "$(route_status_value '.state')" = ready ] || {
		failure="The selected route did not return a ready attestation."
		return 1
	}
	[ "$(route_status_value '.resolved_interface')" = "$target_if" ] || {
		failure="The attested test route no longer matches $target_if."
		return 1
	}
	[ "$(route_status_value '.member_status')" = online ] || {
		failure="The selected mwan3 member is not online."
		return 1
	}
	[ -n "$(route_status_value '.external_ip')" ] || {
		failure="The selected route did not prove an external IP."
		return 1
	}
	return 0
}

start_preflight() {
	static_preflight || return 1
	if runtime_preflight; then
		return 0
	fi
	[ "$readiness_retryable" = 1 ]
}

wait_for_runtime_ready() {
	ready_deadline="$((job_started + runtime_ready_timeout_s))"
	while [ "$(now_epoch)" -lt "$ready_deadline" ]; do
		[ -f "$cancel_file" ] && {
			failure="Rating capture cancelled."
			return 1
		}
		static_preflight || return 1
		if runtime_preflight; then
			return 0
		fi
		[ "$readiness_retryable" = 1 ] || return 1
		write_running_status "Waiting for link/SQM readiness: $failure"
		sleep 1
	done
	failure="Timed out waiting for link/SQM readiness: ${failure:-runtime did not become ready}."
	readiness_code="runtime_ready_timeout"
	readiness_retryable=0
	return 1
}

acquire_ready_interface() {
	while [ "$(now_epoch)" -lt "$((job_started + runtime_ready_timeout_s))" ]; do
		wait_for_runtime_ready || return 1
		resolve_target || {
			failure="Unable to resolve the target interface."
			readiness_code="target_unresolved"
			return 1
		}
		acquire_interface_lock || return 1
		# Close the preflight-to-lock TOCTOU window.  A native netifd/SQM
		# hotplug may reset the queue after the first readiness sample but
		# before the lock.  Never arm capture from that stale observation.
		if runtime_preflight; then
			return 0
		fi
		postlock_failure="$failure"
		if ! release_interface_lock; then
			failure="Unable to release the rating interface lock after runtime changed. Last runtime state: $postlock_failure"
			readiness_retryable=0
			return 1
		fi
		[ "$readiness_retryable" = 1 ] || return 1
		write_running_status "Runtime changed while starting; waiting again: $failure"
	done
	failure="Timed out while revalidating link/SQM readiness after locking. Last runtime state: ${failure:-unknown}."
	return 1
}

runtime_guard() {
	context="$1"
	if runtime_preflight; then
		return 0
	fi
	failure="Runtime became unready during $context: $failure"
	return 1
}

load_capture_policy() {
	quiet_window_s="$(uci_default rating_capture_quiet_s 5)"
	quiet_timeout_s="$(uci_default rating_capture_quiet_timeout_s 30)"
	quiet_ratio="$(uci_default rating_capture_quiet_ratio 0.05)"
	quiet_min_kbps="$(uci_default rating_capture_quiet_min_kbps 1000)"
}

quiet_limit_for() {
	reference="$1"
	awk -v reference="$reference" -v ratio="$quiet_ratio" -v minimum="$quiet_min_kbps" 'BEGIN {
		limit = reference * ratio
		if (limit < minimum) limit = minimum
		printf "%.3f", limit
	}'
}

measure_quiet_background() {
	load_capture_policy
	reference_dl="$(status_value '.cake_dl_rate_kbps')"
	reference_ul="$(status_value '.cake_ul_rate_kbps')"
	reference_dl="$(numeric_or_default "$reference_dl" 0)"
	reference_ul="$(numeric_or_default "$reference_ul" 0)"
	sqm_direction_mode="$("$uci_bin" -q get "cake-autorate.$section.sqm_direction_mode" 2>/dev/null)"
	[ -n "$sqm_direction_mode" ] || sqm_direction_mode="both"
	awk -v dl="$reference_dl" -v ul="$reference_ul" -v mode="$sqm_direction_mode" 'BEGIN {
		if (mode == "upload_only") exit !(ul > 0)
		if (mode == "download_only") exit !(dl > 0)
		exit !(dl > 0 && ul > 0)
	}' || {
		failure="Current CAKE rate references are unavailable."
		return 1
	}
	limit_dl="$(quiet_limit_for "$reference_dl")"
	limit_ul="$(quiet_limit_for "$reference_ul")"
	quiet_needed="$(awk -v value="$quiet_window_s" 'BEGIN { value = int(value + 0); if (value < 2) value = 2; print value }')"
	wait_limit="$(awk -v value="$quiet_timeout_s" 'BEGIN { value = int(value + 0); if (value < 5) value = 5; print value }')"
	quiet_count=0
	sum_dl="0"
	sum_ul="0"
	start_wait="$(now_epoch)"

	while [ "$(( $(now_epoch) - start_wait ))" -lt "$wait_limit" ]; do
		runtime_guard "background measurement" || return 1
		current_dl="$(numeric_or_default "$(status_value '.dl_achieved_rate_kbps')" 0)"
		current_ul="$(numeric_or_default "$(status_value '.ul_achieved_rate_kbps')" 0)"
		if awk -v dl="$current_dl" -v ul="$current_ul" -v dlmax="$limit_dl" -v ulmax="$limit_ul" \
			-v mode="$sqm_direction_mode" \
			'BEGIN {
				if (mode == "upload_only") exit !(ul <= ulmax)
				if (mode == "download_only") exit !(dl <= dlmax)
				exit !(dl <= dlmax && ul <= ulmax)
			}'; then
			quiet_count=$((quiet_count + 1))
			sum_dl="$(awk -v sum="$sum_dl" -v value="$current_dl" 'BEGIN { printf "%.3f", sum + value }')"
			sum_ul="$(awk -v sum="$sum_ul" -v value="$current_ul" 'BEGIN { printf "%.3f", sum + value }')"
			if [ "$quiet_count" -ge "$quiet_needed" ]; then
				background_dl_kbps="$(awk -v sum="$sum_dl" -v count="$quiet_count" 'BEGIN { printf "%.3f", sum / count }')"
				background_ul_kbps="$(awk -v sum="$sum_ul" -v count="$quiet_count" 'BEGIN { printf "%.3f", sum / count }')"
				return 0
			fi
		else
			quiet_count=0
			sum_dl="0"
			sum_ul="0"
		fi
		write_running_status "Waiting for a quiet link ($quiet_count/$quiet_needed s; DL ${current_dl}/${limit_dl}, UL ${current_ul}/${limit_ul} kbit/s)."
		sleep 1
	done

	failure="Background traffic stayed above the quiet limits (DL $limit_dl, UL $limit_ul kbit/s). Stop heavy traffic or use passive rating."
	return 1
}

lock_path_for_target() {
	runtime_lock_interface_paths "$target_if" || return 1
	interface_lock="$runtime_interface_lock_record"
}

acquire_interface_lock() {
	command -v runtime_lock_acquire_interface >/dev/null 2>&1 || {
		failure="The shared CAKE/SQM runtime-lock helper is unavailable."
		return 1
	}
	lock_path_for_target || return 1
	runtime_lock_acquire_global_shared || {
		failure="CAKE/SQM service mutation is already in progress."
		return 1
	}
	runtime_lock_acquire_interface "$target_if" rating "" || {
		lock_rc="$?"
		runtime_lock_release_global >/dev/null 2>&1 || true
		case "$lock_rc" in
			75) failure="Another speed test, Auto-Tune, or rating job is using $target_if." ;;
			76) failure="Full Auto-Tune recovery is pending for $target_if." ;;
			*) failure="Unable to establish an atomic rating interface lock." ;;
		esac
		return 1
	}
}

release_interface_lock() {
	[ -n "${interface_lock:-}" ] || return 0
	release_rc=0
	runtime_lock_release_interface || release_rc=1
	runtime_lock_release_global || release_rc=1
	interface_lock=""
	return "$release_rc"
}

emit_live_status() {
	state="idle"
	[ -s "$status_file" ] && state="running"
	job_mode="$("$jsonfilter_bin" -i "$status_file" -e '@.mode' 2>/dev/null | sed -n '1p')"
	[ -n "$job_mode" ] || job_mode="$capture_mode"
	phase="$(status_value '.rating_load_phase')"
	candidate="$(status_value '.rating_load_candidate')"
	baseline="$(status_value '.quality_grade_baseline_samples')"
	baseline_required="$(status_value '.quality_grade_baseline_required_samples')"
	dl="$(status_value '.quality_grade_dl_samples')"
	ul="$(status_value '.quality_grade_ul_samples')"
	required="$(status_value '.quality_grade_required_samples')"
	finalize="$(status_value '.quality_grade_finalize_remaining_s')"
	dl_load="$(status_value '.rating_load_smoothed_dl_percent')"
	ul_load="$(status_value '.rating_load_smoothed_ul_percent')"
	aggregate_dl="$(status_value '.rating_load_aggregate_dl_kbps')"
	aggregate_ul="$(status_value '.rating_load_aggregate_ul_kbps')"
	effective_dl="$(status_value '.rating_load_effective_dl_kbps')"
	effective_ul="$(status_value '.rating_load_effective_ul_kbps')"
	reference_dl="$(status_value '.rating_load_reference_dl_kbps')"
	reference_ul="$(status_value '.rating_load_reference_ul_kbps')"
	enter_dl="$(status_value '.rating_load_enter_dl_kbps')"
	enter_ul="$(status_value '.rating_load_enter_ul_kbps')"
	requested_phase="$(status_value '.rating_capture_requested_phase')"
	background_dl="$(status_value '.rating_capture_background_dl_kbps')"
	background_ul="$(status_value '.rating_capture_background_ul_kbps')"
	contaminated="$(status_value '.rating_capture_contaminated')"
	contamination_reason="$(status_value '.rating_capture_contamination_reason')"
	last_reject="$(status_value '.transport_probe_last_rejected_reason')"
	message="$(status_value '.quality_grade_state')"
	printf '{"state":"%s","mode":"%s","phase":"%s","candidate":"%s","requested_phase":"%s","message":"%s","baseline_samples":%s,"baseline_required":%s,"dl_samples":%s,"ul_samples":%s,"required_samples":%s,"finalize_remaining_s":%s,"smoothed_dl_percent":%s,"smoothed_ul_percent":%s,"aggregate_dl_kbps":%s,"aggregate_ul_kbps":%s,"effective_dl_kbps":%s,"effective_ul_kbps":%s,"reference_dl_kbps":%s,"reference_ul_kbps":%s,"enter_dl_kbps":%s,"enter_ul_kbps":%s,"background_dl_kbps":%s,"background_ul_kbps":%s,"contaminated":%s,"contamination_reason":"%s","last_rejected_reason":"%s"}\n' \
		"$state" "$(json_escape "$job_mode")" "$(json_escape "${phase:-IDLE}")" \
		"$(json_escape "${candidate:-IDLE}")" "$(json_escape "${requested_phase:-AUTO}")" "$(json_escape "${message:-waiting}")" \
		"${baseline:-0}" "${baseline_required:-20}" "${dl:-0}" "${ul:-0}" \
		"${required:-20}" "${finalize:-null}" "${dl_load:-0}" "${ul_load:-0}" \
		"${aggregate_dl:-0}" "${aggregate_ul:-0}" "${effective_dl:-0}" "${effective_ul:-0}" \
		"${reference_dl:-0}" "${reference_ul:-0}" "${enter_dl:-0}" "${enter_ul:-0}" \
		"${background_dl:-0}" "${background_ul:-0}" "${contaminated:-false}" \
		"$(json_escape "$contamination_reason")" \
		"$(json_escape "$last_reject")"
}

result_is_complete() {
	grade="$(status_value '.quality_grade_current.grade')"
	partial="$(status_value '.quality_grade_current.partial')"
	incomplete="$(status_value '.quality_grade_current.incomplete')"
	started="$(status_value '.quality_grade_current.started_at')"
	awk -v started="${started:-0}" -v job="$job_started" 'BEGIN { exit !(started + 0 >= job + 0) }' || return 1
	[ -n "$grade" ] && \
		[ "$grade" != LEARNING ] && [ "$partial" != true ] && [ "$incomplete" != true ]
}

write_final_result() {
	grade="$(status_value '.quality_grade_current.grade')"
	increase="$(status_value '.quality_grade_current.increase_ms')"
	dl_grade="$(status_value '.quality_grade_current.dl.grade')"
	ul_grade="$(status_value '.quality_grade_current.ul.grade')"
	dl_samples="$(status_value '.quality_grade_current.dl_samples')"
	ul_samples="$(status_value '.quality_grade_current.ul_samples')"
	atomic_write "$result_file" "{\"state\":\"complete\",\"mode\":\"$(json_escape "$capture_mode")\",\"grade\":\"$(json_escape "$grade")\",\"increase_ms\":${increase:-0},\"dl_grade\":\"$(json_escape "$dl_grade")\",\"ul_grade\":\"$(json_escape "$ul_grade")\",\"dl_samples\":${dl_samples:-0},\"ul_samples\":${ul_samples:-0},\"message\":\"Rating completed without changing CAKE limits.\"}"
}

worker_cleanup() {
	clear_capture
	release_interface_lock
	if read_worker_identity && [ "$worker_pid" = "$$" ]; then
		rm -f "$pid_file"
		rm -f "$status_file"
	fi
}

worker_signal() {
	atomic_write "$error_file" '{"state":"cancelled","error":"Rating capture cancelled."}'
	exit 0
}

direction_samples_ready() {
	direction="$1"
	required="$(status_value '.quality_grade_required_samples')"
	case "$direction" in
		download) samples="$(status_value '.quality_grade_dl_samples')" ;;
		upload) samples="$(status_value '.quality_grade_ul_samples')" ;;
		*) return 1 ;;
	esac
	awk -v samples="${samples:-0}" -v required="${required:-20}" \
		'BEGIN { exit !(samples + 0 >= required + 0) }'
}

capture_is_contaminated() {
	[ "$(status_value '.rating_capture_contaminated')" = true ]
}

set_capture_phase() {
	capture_phase="$1"
	write_capture
}

wait_capture_phase() {
	expected="$1"
	attempt=0
	while [ "$attempt" -lt 10 ]; do
		runtime_guard "rating-capture handshake" || return 1
		active="$(status_value '.rating_capture_active')"
		observed="$(status_value '.rating_capture_requested_phase')"
		# Older daemons and the isolated shell fixtures do not expose the
		# handshake fields. Keep one short compatibility delay in that case.
		if [ -z "$active" ]; then
			sleep 1
			return 0
		fi
		if [ "$active" = true ] && [ "${observed:-AUTO}" = "$expected" ]; then
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

run_automatic_direction() {
	direction="$1"
	failure=""
	case "$direction" in
		download) phase_name="DL" ;;
		upload) phase_name="UL" ;;
		*) return 1 ;;
	esac
	run=1
	while [ "$run" -le "$max_automatic_runs" ]; do
		runtime_guard "$direction load preparation" || return 1
		direction_samples_ready "$direction" && return 0
		write_running_status "Generating shaped $direction load (pass $run/$max_automatic_runs)."
		set_capture_phase "$phase_name" || worker_fail "Unable to arm the $direction rating phase."
		wait_capture_phase "$phase_name" ||
			worker_fail "${failure:-The daemon did not acknowledge the $direction rating phase.}"
		if ! "$speedtest_bin" "$section" "$target_if" run "$backend" shaped "$route_mode" "$mwan3_member" "$direction" >> "$log_file" 2>&1; then
			set_capture_phase IDLE 2>/dev/null || true
			worker_fail "Automatic $direction load generator failed; SQM and rates were left unchanged."
		fi
		runtime_guard "$direction load" || return 1
		set_capture_phase IDLE || worker_fail "Unable to close the $direction rating phase."
		sleep 3
		if capture_is_contaminated; then
			reason="$(status_value '.rating_capture_contamination_reason')"
			worker_fail "Automatic rating was contaminated by background traffic: ${reason:-opposite direction active}."
		fi
		direction_samples_ready "$direction" && return 0
		run=$((run + 1))
	done
	failure=""
	return 1
}

worker() {
	registration_attempt=0
	# Wait portably for the parent to publish the authenticated PID record.
	while [ "$registration_attempt" -lt 60 ]; do
		read_worker_identity && [ "$worker_pid" = "$$" ] && break
		registration_attempt=$((registration_attempt + 1))
		[ "$handshake_sleep_mode" != whole ] || [ "$registration_attempt" -lt 4 ] || exit 1
		handshake_sleep
	done
	read_worker_identity && [ "$worker_pid" = "$$" ] || exit 1
	job_started="$(now_epoch)"
	token="$job_started-$$"
	deadline="$((job_started + timeout_s))"
	trap worker_cleanup EXIT
	trap worker_signal INT TERM
	static_preflight || worker_fail "$failure"
	route_mode="$("$uci_bin" -q get "cake-autorate.$section.route_mode" 2>/dev/null)"
	mwan3_member="$("$uci_bin" -q get "cake-autorate.$section.mwan3_member" 2>/dev/null)"
	acquire_ready_interface || worker_fail "${failure:-Unable to establish a ready rating runtime.}"
	if [ "$capture_mode" = automatic ]; then
		attest_automatic_route || worker_fail "$failure"
	fi
	write_running_status "Waiting for a quiet link before measuring background traffic."
	measure_quiet_background || worker_fail "$failure"
	if [ "$capture_mode" = automatic ]; then
		capture_phase="IDLE"
	else
		capture_phase="AUTO"
	fi
	write_capture || worker_fail "Unable to arm rating capture."
	wait_capture_phase "$capture_phase" ||
		worker_fail "${failure:-The daemon did not acknowledge the rating capture.}"
	write_running_status "Rating capture armed; background is DL $background_dl_kbps / UL $background_ul_kbps kbit/s."

	if [ "$capture_mode" = automatic ]; then
		if [ "$sqm_direction_mode" != "upload_only" ]; then
			run_automatic_direction download ||
				worker_fail "${failure:-Automatic download did not collect enough clean samples.}"
		fi
		if [ "$sqm_direction_mode" != "download_only" ]; then
			run_automatic_direction upload ||
				worker_fail "${failure:-Automatic upload did not collect enough clean samples.}"
		fi
		set_capture_phase IDLE || worker_fail "Unable to close the automatic rating phases."
		write_running_status "Load generation finished; waiting for the rating window to finalize."
	else
		capture_phase="AUTO"
		write_capture || worker_fail "Unable to arm guided direction detection."
		write_running_status "Run a sequential download/upload test from a LAN client."
	fi

	while [ "$(now_epoch)" -lt "$deadline" ]; do
		[ -f "$cancel_file" ] && {
			atomic_write "$error_file" '{"state":"cancelled","error":"Rating capture cancelled."}'
			exit 0
		}
		runtime_guard "rating collection" || worker_fail "$failure"
		if result_is_complete; then
			write_final_result
			exit 0
		fi
		sleep 1
	done
	partial="$(status_value '.quality_grade_current.partial')"
	incomplete="$(status_value '.quality_grade_current.incomplete')"
	dl="$(status_value '.quality_grade_dl_samples')"
	ul="$(status_value '.quality_grade_ul_samples')"
	atomic_write "$error_file" "{\"state\":\"incomplete\",\"error\":\"Rating did not collect both directions before timeout.\",\"partial\":${partial:-false},\"incomplete\":${incomplete:-true},\"dl_samples\":${dl:-0},\"ul_samples\":${ul:-0}}"
}

start_job() {
	launch_start=""
	case "$capture_mode" in automatic|client) ;; *) json_error "Unknown rating mode." ;; esac
	[ -x "$procd_job_bin" ] || json_error "The procd job launcher is required."
	acquire_start_lock || json_error "Unable to establish a private rating job directory and start lock."
	if [ -s "$pid_file" ]; then
		if read_worker_identity; then
			[ "$worker_mode" = "$capture_mode" ] && [ "$worker_backend" = "$backend" ] ||
				json_error "A different rating request is already running for this instance."
			printf '{"state":"running","mode":"%s","message":"Rating capture is already starting or running."}\n' \
				"$(json_escape "$worker_mode")"
			release_start_lock
			return 0
		fi
	fi
	start_preflight || json_error "$failure"
	rm -f "$pid_file" "$status_file" "$result_file" "$error_file" "$cancel_file" "$log_file"
	launch_result="$($procd_job_bin launch "cake-autorate-quality-$section" worker "$log_file" \
		"$quality_self" "$section" worker "$capture_mode" "$backend" 2>/dev/null)" || {
		launch_error="$(printf '%s\n' "$launch_result" | "$jsonfilter_bin" -e '@.error' 2>/dev/null | sed -n '1p')"
		json_error "${launch_error:-Unable to register the rating worker with procd.}"
	}
	pid="$(printf '%s\n' "$launch_result" | "$jsonfilter_bin" -e '@.pid' 2>/dev/null | sed -n '1p')"
	launch_start="$(printf '%s\n' "$launch_result" | "$jsonfilter_bin" -e '@.starttime' 2>/dev/null | sed -n '1p')"
	if ! is_pid "$pid" || ! is_pid "$launch_start" || ! wait_for_launched_worker "$pid" "$launch_start"; then
		terminate_verified_launch "$pid" "$launch_start"
		json_error "The rating worker did not publish a verified isolated identity."
	fi
	atomic_write "$pid_file" "$pid
$launch_start
$section
$capture_mode
$backend" || {
		terminate_verified_launch "$pid" "$launch_start"
		json_error "Unable to publish the rating worker identity."
	}
	printf '{"state":"running","mode":"%s","message":"Starting rating capture."}\n' "$(json_escape "$capture_mode")"
	release_start_lock
}

show_status() {
	if [ -s "$result_file" ]; then cat "$result_file"; return 0; fi
	if [ -s "$error_file" ]; then cat "$error_file"; return 0; fi
	if [ -s "$pid_file" ]; then
		if read_worker_identity; then emit_live_status; return 0; fi
	fi
	printf '{"state":"idle","message":"No rating job is running."}\n'
}

cancel_job() {
	cancel_pid=""
	cancel_start=""
	acquire_start_lock || json_error "Unable to establish a private rating job directory and start lock."
	touch "$cancel_file" || json_error "Unable to record rating cancellation."
	if [ -s "$pid_file" ]; then
		if read_worker_identity; then
			cancel_pid="$worker_pid"
			cancel_start="$worker_start"
			kill -TERM "-$cancel_pid" 2>/dev/null || kill -TERM "$cancel_pid" 2>/dev/null || true
			cancel_attempt=0
			while quality_identity_matches "$cancel_pid" "$cancel_start" "$worker_mode" "$worker_backend" &&
			      [ "$cancel_attempt" -lt 5 ]; do
				cancel_attempt=$((cancel_attempt + 1))
				handshake_sleep
			done
			if ! quality_identity_matches "$cancel_pid" "$cancel_start" "$worker_mode" "$worker_backend" &&
			   [ "$(sed -n '1p' "$pid_file" 2>/dev/null)" = "$cancel_pid" ] &&
			   [ "$(sed -n '2p' "$pid_file" 2>/dev/null)" = "$cancel_start" ]; then
				rm -f "$pid_file"
			fi
		fi
	fi
	rm -f "$capture_file"
	release_start_lock || json_error "Unable to release the rating start lock."
	printf '{"state":"cancelled","message":"Rating capture cancelled."}\n'
}

safe_name "$section" || json_error "Invalid instance name."
job_paths

case "$requested_mode" in
	start) start_job ;;
	status) show_status ;;
	cancel) cancel_job ;;
	worker) worker ;;
	*) json_error "Unknown quality-test operation." ;;
esac
