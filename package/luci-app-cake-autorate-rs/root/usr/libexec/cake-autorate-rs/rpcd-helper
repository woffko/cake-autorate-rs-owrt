#!/bin/sh

# rpcd's file ACL matches one flattened command string, so wildcards cannot
# safely pin a verb which follows caller-controlled positional arguments.  LuCI
# reaches migration helpers only through this dispatcher: the ACL pins
# operation as argv[1], and this file verifies the exact argv shape before
# executing a fixed internal target. Internal procd recovery operations do not
# pass through rpcd and remain direct root calls.

umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
IFS='
	 '
export PATH IFS

operation="${1:-}"
shift 2>/dev/null || true

speedtest_bin="/usr/libexec/cake-autorate-rs/speedtest"
autotune_bin="/usr/libexec/cake-autorate-rs/autotune"
apply_guard_bin="/usr/libexec/cake-autorate-rs/apply-guard"

json_error() {
	printf '{"error":"%s"}\n' "$1"
	exit 1
}

safe_section_name() {
	case "$1" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	[ "${#1}" -le 64 ] 2>/dev/null
}

safe_interface_name() {
	case "$1" in ''|*[!A-Za-z0-9_.:@-]*) return 1 ;; esac
	[ "${#1}" -le 64 ] 2>/dev/null
}

safe_optional_member() {
	case "$1" in *[!A-Za-z0-9_.:@-]*) return 1 ;; esac
	[ "${#1}" -le 64 ] 2>/dev/null
}

safe_backend() {
	case "$1" in auto|librespeed-cli|speedtest-go|iperf3|builtin-http) return 0 ;; esac
	return 1
}

safe_route_mode() {
	case "$1" in ''|auto|main|mwan3) return 0 ;; esac
	return 1
}

safe_autotune_profile() {
	case "$1" in gaming|gaming_extreme|best_overall|variable_link|fair) return 0 ;; esac
	return 1
}

safe_optional_uint() {
	case "$1" in ''|*[!0-9]*) [ -z "$1" ] ;; *) return 0 ;; esac
}

safe_fixed_hex() {
	local value="$1" expected_length="$2"
	case "$value" in ''|*[!0-9a-f]*) return 1 ;; esac
	[ "${#value}" -eq "$expected_length" ] 2>/dev/null
}

validate_rpcd_arguments() {
	local argument
	for argument in "$@"; do
		[ "${#argument}" -le 256 ] 2>/dev/null ||
			json_error "Oversized rpcd helper argument."
		case "$argument" in
			*[[:space:]]*) json_error "Whitespace is not allowed in rpcd helper arguments." ;;
		esac
	done
}

validate_autotune_context() {
	safe_autotune_profile "${7:-}" || json_error "Invalid rpcd helper calibration profile."
	case "${8:-}" in 0|1) ;; *) json_error "Invalid rpcd helper conservative flag." ;; esac
	case "${11:-}" in shaped_only|full_raw|reuse_trusted) ;;
		*) json_error "Invalid rpcd helper calibration strategy." ;;
	esac
	case "${12:-}" in cellular|leo_satellite|geo_satellite|fixed_wireless|shared_wired|unknown) ;;
		*) json_error "Invalid rpcd helper access medium." ;;
	esac
	case "${13:-}" in user_selected|network_protocol|device_type|interface_name|auto_inconclusive|legacy_default) ;;
		*) json_error "Invalid rpcd helper access source." ;;
	esac
	case "${14:-}" in ''|*[!0-9]*) json_error "Invalid rpcd helper access confidence." ;; esac
	[ "${14:-101}" -le 100 ] 2>/dev/null || json_error "Invalid rpcd helper access confidence."
	case "${15:-}" in ''|verified_only|passive_bounded|scheduled_active|fixed_cap) ;;
		*) json_error "Invalid rpcd helper capacity policy." ;;
	esac
	safe_optional_uint "${16:-}" || json_error "Invalid rpcd helper download service cap."
	safe_optional_uint "${17:-}" || json_error "Invalid rpcd helper upload service cap."
}

validate_autotune_request_tail() {
	[ -z "${9:-}" ] || json_error "Unexpected rpcd helper worker identity."
	[ "${10:-}" = 0 ] || json_error "Unexpected rpcd helper traffic budget."
	validate_autotune_context "$@"
}

validate_common_request() {
	expected_count="$1"
	expected_mode="$2"
	[ "$#" -ge 2 ] || json_error "Invalid rpcd helper request."
	shift 2
	[ "$#" -eq "$expected_count" ] || json_error "Invalid rpcd helper argument count."
	[ "${3:-}" = "$expected_mode" ] || json_error "Mismatched rpcd helper operation."
	safe_section_name "${1:-}" || json_error "Invalid rpcd helper instance."
	safe_interface_name "${2:-}" || json_error "Invalid rpcd helper interface."
	safe_backend "${4:-}" || json_error "Invalid rpcd helper backend."
	validate_rpcd_arguments "$@"
}

validate_apply_guard_arm() {
	local fingerprint proposal
	[ "$#" -eq 10 ] || json_error "Invalid rpcd helper argument count."
	validate_rpcd_arguments "$@"
	safe_section_name "${1:-}" || json_error "Invalid rpcd helper instance."
	safe_interface_name "${2:-}" || json_error "Invalid rpcd helper interface."
	case "${3:-}" in auto|speedtest-go) ;; *) json_error "Invalid rpcd helper Apply Guard backend." ;; esac
	case "${4:-}" in
		main) [ -z "${5:-}" ] || json_error "Main routing cannot carry an mwan3 member." ;;
		mwan3)
			if ! safe_interface_name "${5:-}"; then
				json_error "Invalid rpcd helper mwan3 member."
			fi
			;;
		*) json_error "Invalid rpcd helper Apply Guard route mode." ;;
	esac
	case "${6:-}" in 0|1) ;; *) json_error "Invalid rpcd helper Apply Guard enabled flag." ;; esac
	case "${7:-}" in 0|1) ;; *) json_error "Invalid rpcd helper adaptive-disable flag." ;; esac
	case "${8:-}" in
		apply_sqm) [ "${6:-}" = 1 ] || json_error "Apply SQM requires an enabled proposal." ;;
		disable_sqm) [ "${6:-}" = 0 ] || json_error "Disable SQM requires a disabled proposal." ;;
		*) json_error "Invalid rpcd helper Apply Guard action." ;;
	esac
	case "${9:-}" in sha256:*) fingerprint="${9#sha256:}" ;; *) fingerprint= ;; esac
	safe_fixed_hex "$fingerprint" 64 || json_error "Invalid rpcd helper configuration fingerprint."
	case "${10:-}" in p-*) proposal="${10#p-}" ;; *) proposal= ;; esac
	safe_fixed_hex "$proposal" 24 || json_error "Invalid rpcd helper proposal identity."
}

validate_apply_guard_token() {
	[ "$#" -eq 1 ] || json_error "Invalid rpcd helper argument count."
	validate_rpcd_arguments "$@"
	safe_fixed_hex "${1:-}" 64 || json_error "Invalid rpcd helper Apply Guard token."
}

# The ACL deliberately permits trailing argv after a literal operation token.
# Every branch must validate the exact argv contract before reaching exec.
case "$operation" in
	speedtest-job-start)
		validate_common_request 7 job-start "$@"
		[ -z "${5:-}" ] || json_error "Unexpected rpcd helper speed-test job key."
		safe_route_mode "${6:-}" || json_error "Invalid rpcd helper route mode."
		safe_optional_member "${7:-}" || json_error "Invalid rpcd helper mwan3 member."
		exec "$speedtest_bin" "$@"
		;;
	speedtest-job-status)
		validate_common_request 4 job-status "$@"
		exec "$speedtest_bin" "$@"
		;;
	speedtest-status)
		validate_common_request 4 status "$@"
		exec "$speedtest_bin" "$@"
		;;
	speedtest-install)
		validate_common_request 4 install "$@"
		exec "$speedtest_bin" "$@"
		;;
	autotune-start)
		validate_common_request 17 start "$@"
		validate_autotune_request_tail "$@"
		safe_route_mode "${5:-}" || json_error "Invalid rpcd helper route mode."
		safe_optional_member "${6:-}" || json_error "Invalid rpcd helper mwan3 member."
		exec "$autotune_bin" "$@"
		;;
	autotune-start-conservative)
		validate_common_request 17 start-conservative "$@"
		validate_autotune_request_tail "$@"
		safe_route_mode "${5:-}" || json_error "Invalid rpcd helper route mode."
		safe_optional_member "${6:-}" || json_error "Invalid rpcd helper mwan3 member."
		exec "$autotune_bin" "$@"
		;;
	autotune-status-summary)
		validate_common_request 17 status-summary "$@"
		validate_autotune_request_tail "$@"
		safe_route_mode "${5:-}" || json_error "Invalid rpcd helper route mode."
		safe_optional_member "${6:-}" || json_error "Invalid rpcd helper mwan3 member."
		exec "$autotune_bin" "$@"
		;;
	autotune-result)
		validate_common_request 17 result "$@"
		validate_autotune_request_tail "$@"
		safe_route_mode "${5:-}" || json_error "Invalid rpcd helper route mode."
		safe_optional_member "${6:-}" || json_error "Invalid rpcd helper mwan3 member."
		exec "$autotune_bin" "$@"
		;;
	autotune-cancel)
		validate_common_request 7 cancel "$@"
		safe_route_mode "${5:-}" || json_error "Invalid rpcd helper route mode."
		safe_optional_member "${6:-}" || json_error "Invalid rpcd helper mwan3 member."
		safe_autotune_profile "${7:-}" || json_error "Invalid rpcd helper calibration profile."
		exec "$autotune_bin" "$@"
		;;
	autotune-status)
		validate_common_request 7 status "$@"
		safe_route_mode "${5:-}" || json_error "Invalid rpcd helper route mode."
		safe_optional_member "${6:-}" || json_error "Invalid rpcd helper mwan3 member."
		safe_autotune_profile "${7:-}" || json_error "Invalid rpcd helper calibration profile."
		exec "$autotune_bin" "$@"
		;;
	autotune-attest)
		validate_common_request 7 attest "$@"
		safe_route_mode "${5:-}" || json_error "Invalid rpcd helper route mode."
		safe_optional_member "${6:-}" || json_error "Invalid rpcd helper mwan3 member."
		safe_autotune_profile "${7:-}" || json_error "Invalid rpcd helper calibration profile."
		exec "$autotune_bin" "$@"
		;;
	apply-guard-arm)
		validate_apply_guard_arm "$@"
		exec "$apply_guard_bin" arm "$@"
		;;
	apply-guard-abort)
		validate_apply_guard_token "$@"
		exec "$apply_guard_bin" abort "$@"
		;;
	apply-guard-verify-rollback)
		validate_apply_guard_token "$@"
		exec "$apply_guard_bin" verify-rollback "$@"
		;;
	apply-guard-finalize)
		validate_apply_guard_token "$@"
		exec "$apply_guard_bin" finalize "$@"
		;;
	apply-guard-reconcile)
		validate_apply_guard_token "$@"
		exec "$apply_guard_bin" reconcile "$@"
		;;
	apply-guard-status)
		validate_apply_guard_token "$@"
		exec "$apply_guard_bin" status "$@"
		;;
	*) json_error "Unsupported rpcd helper operation." ;;
esac
