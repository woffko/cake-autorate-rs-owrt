#!/bin/sh

umask 077

mode="${1:-}"
ubus_bin="${CAKE_AUTORATE_PROCD_JOB_UBUS:-$(command -v ubus 2>/dev/null)}"
jsonfilter_bin="${CAKE_AUTORATE_PROCD_JOB_JSONFILTER:-$(command -v jsonfilter 2>/dev/null)}"
setsid_bin="${CAKE_AUTORATE_PROCD_JOB_SETSID:-$(command -v setsid 2>/dev/null)}"
proc_root="${CAKE_AUTORATE_PROCD_JOB_PROC_ROOT:-/proc}"

json_escape() {
	printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_error() {
	printf '{"error":"%s"}\n' "$(json_escape "$1")"
	exit 1
}

safe_service_name() {
	case "$1" in
		''|*[!A-Za-z0-9_-]*) return 1 ;;
	esac
	[ "${#1}" -le 96 ] 2>/dev/null
}

safe_instance_name() {
	case "$1" in
		''|*[!A-Za-z0-9_-]*) return 1 ;;
	esac
	[ "${#1}" -le 64 ] 2>/dev/null
}

safe_log_path() {
	case "$1" in
		/tmp/cake-autorate-autotune/*/job.log|\
		/tmp/cake-autorate-speedtest/*.log) ;;
		*) return 1 ;;
	esac
	log_parent="${1%/*}"
	[ -d "$log_parent" ] && [ ! -L "$log_parent" ] || return 1
	[ ! -e "$1" ] || { [ -f "$1" ] && [ ! -L "$1" ]; }
}

safe_worker_command() {
	case "$1" in
		/usr/libexec/cake-autorate-rs/autotune|\
		/usr/libexec/cake-autorate-rs/speedtest) return 0 ;;
	esac
	case "${CAKE_AUTORATE_PROCD_JOB_TEST_COMMAND_ROOT:-}" in
		'') return 1 ;;
		*) case "$1" in "${CAKE_AUTORATE_PROCD_JOB_TEST_COMMAND_ROOT%/}"/*) return 0 ;; esac ;;
	esac
	return 1
}

is_positive_uint() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -gt 1 ] 2>/dev/null
}

proc_stat_field() {
	pid="$1"
	field="$2"
	[ -r "$proc_root/$pid/stat" ] || return 1
	sed -n '1{s/^[0-9][0-9]* (.*) //;p;}' "$proc_root/$pid/stat" 2>/dev/null |
		awk -v field="$field" '{ print $field; exit }'
}

proc_starttime() {
	proc_stat_field "$1" 20
}

proc_group() {
	proc_stat_field "$1" 3
}

proc_session() {
	proc_stat_field "$1" 4
}

worker_main() {
	log_file="${2:-}"
	command_path="${3:-}"
	shift 3 || json_error "Invalid procd worker request."
	safe_log_path "$log_file" || json_error "Unsafe procd worker log path."
	safe_worker_command "$command_path" || json_error "Unsupported procd worker command."
	exec >>"$log_file" 2>&1
	exec "$command_path" "$@"
}

launch_main() {
	service_name="${2:-}"
	instance_name="${3:-}"
	log_file="${4:-}"
	command_path="${5:-}"
	shift 5 || json_error "Invalid procd launch request."

	safe_service_name "$service_name" || json_error "Invalid procd service name."
	safe_instance_name "$instance_name" || json_error "Invalid procd instance name."
	safe_log_path "$log_file" || json_error "Unsafe procd worker log path."
	safe_worker_command "$command_path" || json_error "Unsupported procd worker command."
	[ -n "$ubus_bin" ] && [ -x "$ubus_bin" ] || json_error "ubus is required for procd jobs."
	[ -n "$jsonfilter_bin" ] && [ -x "$jsonfilter_bin" ] || json_error "jsonfilter is required for procd jobs."
	[ -n "$setsid_bin" ] && [ -x "$setsid_bin" ] || json_error "setsid is required for procd jobs."
	case "$0" in /*) self="$0" ;; *) json_error "The procd job helper must be invoked by absolute path." ;; esac

	command_json="[\"$(json_escape "$setsid_bin")\",\"$(json_escape "$self")\",\"worker\",\"$(json_escape "$log_file")\",\"$(json_escape "$command_path")\""
	for argument in "$@"; do
		command_json="$command_json,\"$(json_escape "$argument")\""
	done
	command_json="$command_json]"
	delete_json="{\"name\":\"$(json_escape "$service_name")\"}"
	service_json="{\"name\":\"$(json_escape "$service_name")\",\"instances\":{\"$(json_escape "$instance_name")\":{\"command\":$command_json,\"term_timeout\":5}}}"

	"$ubus_bin" call service delete "$delete_json" >/dev/null 2>&1 || true
	"$ubus_bin" call service add "$service_json" >/dev/null 2>&1 ||
		json_error "procd rejected the worker instance."

	attempt=0
	while [ "$attempt" -lt 10 ]; do
		service_status="$("$ubus_bin" call service list "$delete_json" 2>/dev/null)"
		pid="$(printf '%s\n' "$service_status" |
			"$jsonfilter_bin" -e "@[\"$service_name\"].instances[\"$instance_name\"].pid" 2>/dev/null |
			sed -n '1p')"
		if is_positive_uint "$pid"; then
			starttime="$(proc_starttime "$pid" 2>/dev/null)"
			if is_positive_uint "$starttime" &&
			   [ "$(proc_group "$pid" 2>/dev/null)" = "$pid" ] &&
			   [ "$(proc_session "$pid" 2>/dev/null)" = "$pid" ]; then
				printf '{"pid":%s,"starttime":%s,"service":"%s","instance":"%s"}\n' \
					"$pid" "$starttime" "$(json_escape "$service_name")" \
					"$(json_escape "$instance_name")"
				return 0
			fi
		fi
		attempt=$((attempt + 1))
		sleep 1
	done

	"$ubus_bin" call service delete "$delete_json" >/dev/null 2>&1 || true
	json_error "procd did not publish an isolated worker identity."
}

case "$mode" in
	launch) launch_main "$@" ;;
	worker) worker_main "$@" ;;
	*) json_error "Unsupported procd job operation." ;;
esac
