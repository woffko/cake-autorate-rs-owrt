proc_stat_field() {
	proc_pid="$1"
	proc_field="$2"
	[ -r "/proc/$proc_pid/stat" ] || return 1
	# Fields after the final ") " start at the kernel's field 3.  Parsing the
	# tail avoids breaking on a command name containing spaces or parentheses.
	sed -n '1{s/^[0-9][0-9]* (.*) //;p;}' "/proc/$proc_pid/stat" 2>/dev/null |
		awk -v field="$proc_field" '{ print $field; exit }'
}

proc_starttime() {
	# Kernel field 22 is tail field 20 after stripping pid/comm.
	proc_stat_field "$1" 20
}

proc_state() {
	# Kernel field 3 is tail field 1.
	proc_stat_field "$1" 1
}

proc_group() {
	# Kernel field 5 is tail field 3.
	proc_stat_field "$1" 3
}

proc_session() {
	# Kernel field 6 is tail field 4.
	proc_stat_field "$1" 4
}

# Fractional sleep is optional in BusyBox. Use it where available so host
# tests stay fast, but never let a rejected value collapse a safety handshake
# into a CPU-spinning loop on OpenWrt.
handshake_sleep_mode=""
handshake_usleep_bin=""
handshake_sleep() {
	case "$handshake_sleep_mode" in
		fractional) sleep 0.05 ;;
		usleep) "$handshake_usleep_bin" 50000 ;;
		whole) sleep 1 ;;
		'')
			if sleep 0.05 2>/dev/null; then
				handshake_sleep_mode=fractional
				return 0
			fi
			handshake_usleep_bin="$(command -v usleep 2>/dev/null || true)"
			if [ -n "$handshake_usleep_bin" ] &&
			   "$handshake_usleep_bin" 50000 2>/dev/null; then
				handshake_sleep_mode=usleep
				return 0
			fi
			handshake_sleep_mode=whole
			sleep 1
			;;
		*) return 1 ;;
	esac
}

proc_cmdline_has_arg() {
	proc_pid="$1"
	expected_arg="$2"
	[ -r "/proc/$proc_pid/cmdline" ] || return 1
	cmdline_args="$(cat "/proc/$proc_pid/cmdline" 2>/dev/null | tr '\000' '\n')"
	[ -n "$cmdline_args" ] || return 1
	printf '%s\n' "$cmdline_args" | grep -F -x -- "$expected_arg" >/dev/null 2>&1
}

