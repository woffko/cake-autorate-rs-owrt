new_worker_token() {
	[ -r "$random_uuid_file" ] && [ ! -L "$random_uuid_file" ] || return 1
	IFS= read -r token_uuid < "$random_uuid_file" || return 1
	token="$(printf '%s' "$token_uuid" | tr -d '-')"
	safe_worker_token "$token" || return 1
	printf '%s\n' "$token" | tr 'A-F' 'a-f'
}

new_unique_worker_token() {
	token_attempt=0
	while [ "$token_attempt" -lt 8 ]; do
		token_candidate="$(new_worker_token)" || return 1
		token_ifb="catf$(printf '%s' "$token_candidate" | cut -c1-8)"
		[ "${#token_ifb}" -le 15 ] && safe_interface_name "$token_ifb" || return 1
		if [ ! -e "$sys_class_net/$token_ifb" ]; then
			printf '%s\n' "$token_candidate"
			return 0
		fi
		token_attempt=$((token_attempt + 1))
	done
	return 1
}

