rps_mask_selects_one_cpu() {
	rps_nonzero_nibbles="$(printf '%s' "$1" | tr -d ',0')"
	case "$rps_nonzero_nibbles" in 1|2|4|8) return 0 ;; esac
	return 1
}

collect_datapath_diagnostics() {
	datapath_json='{"available":false,"reason":"device-unresolved"}'
	[ "${CAKE_AUTORATE_AUTOTUNE_TEST_PREFLIGHT:-0}" != 1 ] || {
		datapath_json='{"available":false,"reason":"test-preflight"}'
		return 0
	}

	datapath_device=""
	# Prefer the physical device reported by the logical OpenWrt interface whose
	# L3 device is the calibrated target (for example wan: eth2 -> pppoe-wan).
	# This is diagnostic-only: inability to inspect netifd must never block a run.
	for datapath_object in $(ubus list 'network.interface.*' 2>/dev/null); do
		datapath_logical="${datapath_object#network.interface.}"
		safe_interface_name "$datapath_logical" || continue
		datapath_status="$(ubus call "$datapath_object" status 2>/dev/null)" || continue
		datapath_l3="$(printf '%s\n' "$datapath_status" | "$jsonfilter_bin" -e '@.l3_device' 2>/dev/null)"
		[ "$datapath_l3" = "$target_if" ] || continue
		datapath_candidate="$(printf '%s\n' "$datapath_status" | "$jsonfilter_bin" -e '@.device' 2>/dev/null)"
		safe_interface_name "$datapath_candidate" || continue
		[ -d "$sys_class_net/$datapath_candidate/queues" ] || continue
		datapath_device="$datapath_candidate"
		break
	done
	if [ -z "$datapath_device" ] && safe_interface_name "$target_if" &&
	   [ -d "$sys_class_net/$target_if/queues" ]; then
		datapath_device="$target_if"
	fi
	[ -n "$datapath_device" ] || return 0

	datapath_rx_queues=0
	datapath_masks_json=""
	datapath_first_mask=""
	datapath_same_mask=true
	for datapath_mask_file in "$sys_class_net/$datapath_device"/queues/rx-*/rps_cpus; do
		[ -f "$datapath_mask_file" ] || continue
		datapath_mask="$(sed -n '1p' "$datapath_mask_file" 2>/dev/null)"
		case "$datapath_mask" in ''|*[!A-Fa-f0-9,]*) continue ;; esac
		datapath_rx_queues=$((datapath_rx_queues + 1))
		if [ -z "$datapath_first_mask" ]; then
			datapath_first_mask="$datapath_mask"
		elif [ "$datapath_mask" != "$datapath_first_mask" ]; then
			datapath_same_mask=false
		fi
		[ -z "$datapath_masks_json" ] || datapath_masks_json="$datapath_masks_json,"
		datapath_masks_json="$datapath_masks_json\"$(json_escape "$datapath_mask")\""
	done
	[ "$datapath_rx_queues" -gt 0 ] 2>/dev/null || {
		datapath_json="{\"available\":false,\"reason\":\"rx-queues-unavailable\",\"ingress_device\":\"$(json_escape "$datapath_device")\"}"
		return 0
	}

	datapath_packet_steering="$(uci -q get network.globals.packet_steering 2>/dev/null)"
	case "$datapath_packet_steering" in ''|*[!0-9]*) datapath_packet_steering=0 ;; esac
	datapath_single_cpu_rps=false
	datapath_mask_selects_one_cpu=false
	rps_mask_selects_one_cpu "$datapath_first_mask" && datapath_mask_selects_one_cpu=true
	if [ "$datapath_rx_queues" -gt 1 ] && [ "$datapath_same_mask" = true ] &&
	   [ "$datapath_mask_selects_one_cpu" = true ]; then
		datapath_single_cpu_rps=true
	fi
	datapath_json="{\"available\":true,\"ingress_device\":\"$(json_escape "$datapath_device")\",\"rx_queues\":$datapath_rx_queues,\"packet_steering_mode\":\"$(json_escape "$datapath_packet_steering")\",\"rps_masks\":[$datapath_masks_json],\"single_cpu_rps\":$datapath_single_cpu_rps}"
}

check_background_traffic() {
	write_status quiet-check 27 "Checking background traffic before throughput calibration"
	measure_background_traffic
	prethroughput_background_dl_kbps="${background_dl_kbps:-0}"
	prethroughput_background_ul_kbps="${background_ul_kbps:-0}"
	prethroughput_background_reference_deferred="${background_reference_deferred:-false}"
	if [ "$background_blocked" = true ] && [ "${conservative_mode:-0}" != 1 ]; then
		stage_terminal_json error "{\"state\":\"background-blocked\",\"schema_version\":7,\"error\":\"Background traffic is above the strict calibration limit. Retry when quiet or explicitly continue conservatively.\",\"background_blocked\":true,\"retryable\":true,\"stage\":\"quiet-check\",\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":false,\"phase_contamination_seen\":false,\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"pinger_plan\":${pinger_plan:-null},\"configuration_written\":false}"
		exit 1
	fi
	if [ "${conservative_mode:-0}" = 1 ] && [ "$background_blocked" = true ]; then
		preflight_background_contaminated=true
	fi
}

cleanup_phase_background_counter() {
	if [ "${phase_counter_created:-0}" = 1 ] && [ -n "${nft_bin:-}" ]; then
		"$nft_bin" delete table inet "$phase_counter_table" >/dev/null 2>&1 || true
	fi
	phase_counter_created=0
}

active_nft_flowtable() {
	ruleset="$1"
	printf '%s\n' "$ruleset" | awk '
		$1 == "flowtable" && index($0, "{") { in_flowtable = 1 }
		in_flowtable && /hook[[:space:]]+ingress([[:space:]]|;)/ { found = 1 }
		in_flowtable && $1 == "}" { in_flowtable = 0 }
		END { exit(found ? 0 : 1) }
	'
}

preflight_phase_accounting() {
	nft_bin="$(command -v nft 2>/dev/null)"
	[ -n "$nft_bin" ] || fail "nft is required to prove that calibration phases are free of forwarded client traffic."
	phase_ruleset="$($nft_bin list ruleset 2>/dev/null)" ||
		fail "Unable to inspect nftables before calibration; forwarded-traffic evidence cannot be trusted."
	if active_nft_flowtable "$phase_ruleset"; then
		fail "Active nftables flowtable/offload bypasses the calibration forward counters. Disable software and hardware flow offloading before Full Auto-Tune."
	fi
}

cleanup_stale_phase_background_tables() {
	[ -n "${nft_bin:-}" ] || return 1
	table_listing="$($nft_bin list tables 2>/dev/null)" || return 1
	stale_tables="$(printf '%s\n' "$table_listing" | awk '$1 == "table" && $2 == "inet" { print $3 }')"
	for stale_table in $stale_tables; do
		case "$stale_table" in
			"cake_autotune_${job_name}_"*)
				stale_suffix="${stale_table#cake_autotune_${job_name}_}"
				case "$stale_suffix" in ''|*[!0-9]*) continue ;; esac
				"$nft_bin" delete table inet "$stale_table" >/dev/null 2>&1 || return 1
				;;
		esac
	done
	return 0
}

start_phase_background_counter() {
	phase_reference_dl_kbps="${1:-0}"
	phase_reference_ul_kbps="${2:-0}"
	phase_background_available=false
	phase_background_contaminated=false
	phase_background_dl_kbps=0
	phase_background_ul_kbps=0
	phase_counter_started="$(cut -d ' ' -f 1 /proc/uptime 2>/dev/null)"

	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_PREFLIGHT:-0}" = 1 ]; then
		phase_background_available=true
		return 0
	fi

	nft_bin="$(command -v nft 2>/dev/null)"
	[ -n "$nft_bin" ] || return 0
	# A PID suffix makes a stale table from a prior SIGKILL harmless.  The
	# current worker still removes only its own table during normal cleanup.
	phase_counter_table="cake_autotune_${job_name}_$$"
	cleanup_phase_background_counter
	recovery_nft_table="$phase_counter_table"
	write_recovery_journal || fail "Unable to journal the nftables counter before creating it."
	"$nft_bin" add table inet "$phase_counter_table" >/dev/null 2>&1 || return 0
	phase_counter_created=1
	"$nft_bin" add chain inet "$phase_counter_table" forward \
		'{ type filter hook forward priority -1; policy accept; }' >/dev/null 2>&1 || {
		cleanup_phase_background_counter
		return 0
	}
	"$nft_bin" add rule inet "$phase_counter_table" forward iifname "$target_if" counter \
		comment cake-autotune-dl >/dev/null 2>&1 || {
		cleanup_phase_background_counter
		return 0
	}
	"$nft_bin" add rule inet "$phase_counter_table" forward oifname "$target_if" counter \
		comment cake-autotune-ul >/dev/null 2>&1 || {
		cleanup_phase_background_counter
		return 0
	}
	phase_background_available=true
}

classify_phase_background() {
	phase_reference_dl_kbps="${1:-0}"
	phase_reference_ul_kbps="${2:-0}"
	phase_background_dl_reference_known=false
	phase_background_ul_reference_known=false
	phase_background_reference_deferred=false
	if is_positive_uint "$phase_reference_dl_kbps"; then
		phase_background_dl_reference_known=true
		phase_background_dl_limit="$(strict_background_limit "$phase_reference_dl_kbps" 0.02)"
	else
		phase_background_dl_limit=0
		phase_background_reference_deferred=true
	fi
	if is_positive_uint "$phase_reference_ul_kbps"; then
		phase_background_ul_reference_known=true
		phase_background_ul_limit="$(strict_background_limit "$phase_reference_ul_kbps" 0.02)"
	else
		phase_background_ul_limit=0
		phase_background_reference_deferred=true
	fi
	phase_background_contaminated=false
	if [ "${phase_background_available:-false}" != true ]; then
		phase_background_contaminated=true
		phase_evidence_complete=false
	fi
	[ "$phase_background_dl_reference_known" != true ] ||
		! background_rate_exceeds "${phase_background_dl_kbps:-0}" "$phase_background_dl_limit" ||
		phase_background_contaminated=true
	[ "$phase_background_ul_reference_known" != true ] ||
		! background_rate_exceeds "${phase_background_ul_kbps:-0}" "$phase_background_ul_limit" ||
		phase_background_contaminated=true
	phase_background_dl_share_percent="$(background_share_percent "${phase_background_dl_kbps:-0}" "$phase_reference_dl_kbps")"
	phase_background_ul_share_percent="$(background_share_percent "${phase_background_ul_kbps:-0}" "$phase_reference_ul_kbps")"
	if awk -v a="$phase_background_dl_share_percent" -v b="${observed_background_dl_max_share_percent:-0}" 'BEGIN { exit(a > b ? 0 : 1) }'; then
		observed_background_dl_max_share_percent="$phase_background_dl_share_percent"
	fi
	if awk -v a="$phase_background_ul_share_percent" -v b="${observed_background_ul_max_share_percent:-0}" 'BEGIN { exit(a > b ? 0 : 1) }'; then
		observed_background_ul_max_share_percent="$phase_background_ul_share_percent"
	fi
}

stop_phase_background_counter() {
	phase_counter_stopped="$(cut -d ' ' -f 1 /proc/uptime 2>/dev/null)"
	phase_duration_s="$(awk -v start="${phase_counter_started:-0}" -v stop="${phase_counter_stopped:-0}" 'BEGIN {
		d = stop - start; if (d < 0.01) d = 0.01; printf "%.2f", d
	}')"

	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_PREFLIGHT:-0}" = 1 ]; then
		if [ "${phase_background_kind:-}" = baseline ]; then
			test_phase_unavailable="${CAKE_AUTORATE_AUTOTUNE_TEST_BASELINE_BACKGROUND_UNAVAILABLE:-0}"
			if [ "${baseline_phase_attempt:-0}" = 1 ]; then
				test_phase_dl="${CAKE_AUTORATE_AUTOTUNE_TEST_BASELINE_BACKGROUND_FIRST_DL_KBPS:-${CAKE_AUTORATE_AUTOTUNE_TEST_BASELINE_BACKGROUND_DL_KBPS:-0}}"
				test_phase_ul="${CAKE_AUTORATE_AUTOTUNE_TEST_BASELINE_BACKGROUND_FIRST_UL_KBPS:-${CAKE_AUTORATE_AUTOTUNE_TEST_BASELINE_BACKGROUND_UL_KBPS:-0}}"
			else
				test_phase_dl="${CAKE_AUTORATE_AUTOTUNE_TEST_BASELINE_BACKGROUND_DL_KBPS:-0}"
				test_phase_ul="${CAKE_AUTORATE_AUTOTUNE_TEST_BASELINE_BACKGROUND_UL_KBPS:-0}"
			fi
		else
			test_phase_unavailable="${CAKE_AUTORATE_AUTOTUNE_TEST_PHASE_BACKGROUND_UNAVAILABLE:-0}"
			test_phase_dl="${CAKE_AUTORATE_AUTOTUNE_TEST_PHASE_BACKGROUND_DL_KBPS:-0}"
			test_phase_ul="${CAKE_AUTORATE_AUTOTUNE_TEST_PHASE_BACKGROUND_UL_KBPS:-0}"
		fi
		if [ "$test_phase_unavailable" = 1 ]; then
			phase_background_available=false
		else
			phase_background_dl_kbps="$test_phase_dl"
			phase_background_ul_kbps="$test_phase_ul"
		fi
	elif [ "${phase_background_available:-false}" = true ] && [ "${phase_counter_created:-0}" = 1 ]; then
		if phase_counter_dump="$($nft_bin list chain inet "$phase_counter_table" forward 2>/dev/null)"; then
			phase_background_dl_bytes="$(printf '%s\n' "$phase_counter_dump" | awk '
				/comment "?cake-autotune-dl"?/ { for (i = 1; i <= NF; i++) if ($i == "bytes") { print $(i + 1); exit } }')"
			phase_background_ul_bytes="$(printf '%s\n' "$phase_counter_dump" | awk '
				/comment "?cake-autotune-ul"?/ { for (i = 1; i <= NF; i++) if ($i == "bytes") { print $(i + 1); exit } }')"
			case "$phase_background_dl_bytes:$phase_background_ul_bytes" in
				*[!0-9:]*|:*|*:) phase_background_available=false ;;
				*)
					phase_background_dl_kbps="$(awk -v b="$phase_background_dl_bytes" -v s="$phase_duration_s" 'BEGIN { printf "%.0f", b * 8 / s / 1000 }')"
					phase_background_ul_kbps="$(awk -v b="$phase_background_ul_bytes" -v s="$phase_duration_s" 'BEGIN { printf "%.0f", b * 8 / s / 1000 }')"
					;;
			esac
		else
			phase_background_available=false
		fi
	fi
	cleanup_phase_background_counter

	classify_phase_background "${phase_reference_dl_kbps:-0}" "${phase_reference_ul_kbps:-0}"
}

phase_background_json() {
	printf '{"available":%s,"contaminated":%s,"reference_deferred":%s,"duration_s":%s,"download_kbps":%s,"upload_kbps":%s,"download_reference_kbps":%s,"upload_reference_kbps":%s,"download_reference_known":%s,"upload_reference_known":%s,"download_limit_kbps":%s,"upload_limit_kbps":%s,"download_share_percent":%s,"upload_share_percent":%s}' \
		"${phase_background_available:-false}" "${phase_background_contaminated:-false}" \
		"${phase_background_reference_deferred:-false}" \
		"${phase_duration_s:-0}" "${phase_background_dl_kbps:-0}" "${phase_background_ul_kbps:-0}" \
		"${phase_reference_dl_kbps:-0}" "${phase_reference_ul_kbps:-0}" \
		"${phase_background_dl_reference_known:-false}" "${phase_background_ul_reference_known:-false}" \
		"${phase_background_dl_limit:-0}" "${phase_background_ul_limit:-0}" \
		"${phase_background_dl_share_percent:-0}" "${phase_background_ul_share_percent:-0}"
}

resolve_interface_device() {
	name="$1"
	status=""
	device=""

	if [ -e "/sys/class/net/$name" ]; then
		printf '%s\n' "$name"
		return 0
	fi

	if [ -n "$jsonfilter_bin" ]; then
		status="$(ubus call "network.interface.$name" status 2>/dev/null)"
		device="$(printf '%s\n' "$status" | "$jsonfilter_bin" -e '@.l3_device' 2>/dev/null)"
		[ -n "$device" ] || device="$(printf '%s\n' "$status" | "$jsonfilter_bin" -e '@.device' 2>/dev/null)"
	fi

	[ -n "$device" ] && [ -e "/sys/class/net/$device" ] || return 1
	printf '%s\n' "$device"
}

source_ip_for() {
	ip -4 -o addr show dev "$1" scope global 2>/dev/null |
		awk '{ split($4, address, "/"); print address[1]; exit }'
}

route_device_for() {
	source_ip="$1"
	if [ -n "$source_ip" ]; then
		ip route get 1.1.1.1 from "$source_ip" 2>/dev/null |
			sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1
	else
		ip route get 1.1.1.1 2>/dev/null |
			sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1
	fi
}

route_device_for_mark() {
	source_ip="$1"
	mark="$2"
	ip -4 route get 1.1.1.1 from "$source_ip" mark "$mark" 2>/dev/null |
		sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1
}

route_exec() {
	if [ "${route_mode:-main}" = "mwan3" ]; then
		mwan3 use "$mwan3_member" exec "$@"
	else
		"$@"
	fi
}

route_rule_for_device() {
	device="$1"
	wrapper_mark="${2:-}"
	rules="$(ip -4 rule show 2>/dev/null)"
	discovered_table="$(printf '%s\n' "$rules" | awk -v device="$device" '
		{ for (i = 1; i <= NF; i++) if ($i == "iif" && $(i + 1) == device)
			for (j = 1; j <= NF; j++) if ($j == "lookup") { print $(j + 1); exit } }')"
	if [ -z "$discovered_table" ] && [ -n "$wrapper_mark" ]; then
		discovered_table="$(printf '%s\n' "$rules" | awk -v mark="$wrapper_mark" '
			{
				matched = 0
				for (i = 1; i <= NF; i++) if ($i == "fwmark") {
					split($(i + 1), value, "/")
					if (value[1] == mark) matched = 1
				}
				if (matched) for (i = 1; i <= NF; i++) if ($i == "lookup") { print $(i + 1); exit }
			}')"
	fi
	discovered_mark=""
	if [ -n "$discovered_table" ]; then
		discovered_mark="$(printf '%s\n' "$rules" | awk -v table="$discovered_table" '
			{ found = 0; for (i = 1; i <= NF; i++) if ($i == "lookup" && $(i + 1) == table) found = 1;
			  if (found) for (i = 1; i <= NF; i++) if ($i == "fwmark") { split($(i + 1), value, "/"); print value[1]; exit } }')"
	fi
	[ -n "$discovered_table" ] || return 1
	printf '%s|%s\n' "$discovered_mark" "$discovered_table"
}

valid_route_mark() {
	mark="$1"
	case "$mark" in
		0x*) digits="${mark#0x}"; case "$digits" in ''|*[!A-Fa-f0-9]*) return 1 ;; esac ;;
		*) case "$mark" in ''|*[!0-9]*) return 1 ;; esac ;;
	esac
}

valid_route_table() {
	table="$1"
	case "$table" in
		''|main|default|local|*[!A-Za-z0-9_.-]*) return 1 ;;
	esac
}

inspect_autotune_route() {
	route_mode_configured="$(uci -q get "cake-autorate.$job_name.route_mode" 2>/dev/null)"
	mwan3_member="$(uci -q get "cake-autorate.$job_name.mwan3_member" 2>/dev/null)"
	[ -n "$route_mode_override" ] && route_mode_configured="$route_mode_override"
	[ -n "$mwan3_member_override" ] && mwan3_member="$mwan3_member_override"
	[ -n "$route_mode_configured" ] || route_mode_configured=auto
	case "$route_mode_configured" in
		# A main-table override is a complete route identity.  Never retain an
		# mwan3 member inherited from the instance's persistent configuration;
		# doing so creates contradictory diagnostics such as mode=main/member=wanb
		# and can poison Review/attestation comparisons.
		main) route_mode=main; mwan3_member="" ;;
		mwan3) route_mode=mwan3 ;;
		auto) [ -n "$mwan3_member" ] && route_mode=mwan3 || route_mode=main ;;
		*) return 1 ;;
	esac

	if [ "$route_mode" = mwan3 ]; then
		case "$mwan3_member" in ''|*[!A-Za-z0-9_.:@-]*) return 1 ;; esac
		command -v mwan3 >/dev/null 2>&1 || return 1
		command -v nft >/dev/null 2>&1 && nft list table inet mwan3 >/dev/null 2>&1 || return 1
		member_status="$(ubus call mwan3 status "{\"interface\":\"$mwan3_member\"}" 2>/dev/null)" || return 1
		[ "$(printf '%s\n' "$member_status" | "$jsonfilter_bin" -e '@.interfaces.*.status' 2>/dev/null | sed -n '1p')" = online ] || return 1
		[ "$(printf '%s\n' "$member_status" | "$jsonfilter_bin" -e '@.interfaces.*.enabled' 2>/dev/null | sed -n '1p')" = true ] || return 1
		[ "$(printf '%s\n' "$member_status" | "$jsonfilter_bin" -e '@.interfaces.*.running' 2>/dev/null | sed -n '1p')" = true ] || return 1
		[ "$(printf '%s\n' "$member_status" | "$jsonfilter_bin" -e '@.interfaces.*.up' 2>/dev/null | sed -n '1p')" = true ] || return 1
		network_status="$(ubus call "network.interface.$mwan3_member" status 2>/dev/null)" || return 1
		[ "$(printf '%s\n' "$network_status" | "$jsonfilter_bin" -e '@.up' 2>/dev/null)" = true ] || return 1
		network_device="$(printf '%s\n' "$network_status" | "$jsonfilter_bin" -e '@.l3_device' 2>/dev/null)"
		[ -n "$network_device" ] || network_device="$(printf '%s\n' "$network_status" | "$jsonfilter_bin" -e '@.device' 2>/dev/null)"
		route_environment="$(mwan3 use "$mwan3_member" exec env 2>/dev/null)" || return 1
		route_if="$(printf '%s\n' "$route_environment" | sed -n 's/^DEVICE=//p' | sed -n '1p')"
		[ -n "$route_if" ] || route_if="$network_device"
		source_ip="$(printf '%s\n' "$route_environment" | sed -n 's/^SRCIP=//p' | sed -n '1p')"
		[ "$route_if" = "$target_if" ] && [ -n "$source_ip" ] || return 1
		route_mark="$(printf '%s\n' "$route_environment" | sed -n 's/^FWMARK=//p' | sed -n '1p')"
		route_mark="${route_mark%%/*}"
		route_rule="$(route_rule_for_device "$route_if" "$route_mark" 2>/dev/null)" || return 1
		discovered_mark="${route_rule%%|*}"
		route_table="${route_rule#*|}"
		[ -n "$discovered_mark" ] && route_mark="$discovered_mark"
		valid_route_mark "$route_mark" || return 1
		valid_route_table "$route_table" || return 1
		# mwan3 use applies its member policy to real sockets, but ip route get
		# is a netlink query and does not inherit that socket mark.  Query the
		# policy route with the independently discovered member mark instead.
		forced_route_if="$(route_device_for_mark "$source_ip" "$route_mark")" || return 1
		[ "$forced_route_if" = "$target_if" ] || return 1
		table_default="$(ip -4 route show table "$route_table" default 2>/dev/null)" || return 1
		printf '%s\n' "$table_default" | awk -v device="$target_if" '
			{ for (i = 1; i <= NF; i++) if ($i == "dev" && $(i + 1) == device) found = 1 }
			END { exit(found ? 0 : 1) }
		' || return 1
	else
		source_ip="$(source_ip_for "$target_if")"
		[ -n "$source_ip" ] || return 1
		route_if="$(route_device_for "$source_ip")"
		[ "$route_if" = "$target_if" ] || return 1
		default_route_if="$(ip -4 route show default 2>/dev/null | sed -n '1{s/.* dev \([^ ]*\).*/\1/p}')"
		[ "$default_route_if" = "$target_if" ] || return 1
		route_mark=""
		route_table="main"
	fi
	route_identity="$route_mode|$mwan3_member|$route_if|$source_ip|$route_mark|$route_table"
	return 0
}

autorate_cmdline_matches() {
	candidate_pid="$1"
	[ -r "/proc/$candidate_pid/cmdline" ] || return 1
	cmdline="$(tr '\000' '\n' < "/proc/$candidate_pid/cmdline")"
	[ "$(printf '%s\n' "$cmdline" | sed -n '1p')" = /usr/sbin/cake-autorated ] || return 1
	[ "$(printf '%s\n' "$cmdline" | sed -n '2p')" = --instance ] || return 1
	[ "$(printf '%s\n' "$cmdline" | sed -n '3p')" = "$job_name" ] || return 1
	[ -z "$(printf '%s\n' "$cmdline" | sed -n '4p')" ]
}

pause_job_autorate() {
	autorate_candidates="$(pgrep -f "^/usr/sbin/cake-autorated --instance $job_name\$" 2>/dev/null || true)"
	set -- $autorate_candidates
	[ "$#" -le 1 ] || fail "Multiple autorate processes exist for $job_name; refusing ambiguous calibration."
	[ "$#" -eq 1 ] || return 0
	autorate_pid="$1"
	autorate_starttime="$(proc_starttime "$autorate_pid" 2>/dev/null)"
	is_positive_uint "$autorate_starttime" && autorate_cmdline_matches "$autorate_pid" ||
		fail "Unable to verify the autorate process identity before calibration."
	case "$(proc_state "$autorate_pid" 2>/dev/null)" in
		T|t) fail "Autorate instance $job_name was already stopped before calibration." ;;
		Z|z|'') fail "Autorate instance $job_name is not a live controllable process." ;;
	esac
	recovery_autorate_pid="$autorate_pid"
	recovery_autorate_starttime="$autorate_starttime"
	write_recovery_journal || fail "Unable to journal the autorate identity before stopping it."
	[ "$(proc_starttime "$autorate_pid" 2>/dev/null)" = "$autorate_starttime" ] &&
		autorate_cmdline_matches "$autorate_pid" || fail "Autorate process identity changed before STOP."
	kill -STOP "$autorate_pid" 2>/dev/null || fail "Unable to stop autorate for deterministic calibration."
	stop_attempt=0
	while [ "$stop_attempt" -lt 3 ]; do
		[ "$(proc_starttime "$autorate_pid" 2>/dev/null)" = "$autorate_starttime" ] ||
			fail "Autorate process identity changed while waiting for STOP."
		[ "$(proc_state "$autorate_pid" 2>/dev/null)" = T ] && {
			autorate_paused=1
			return 0
		}
		stop_attempt=$((stop_attempt + 1))
		sleep 1
	done
	fail "Autorate instance did not enter the stopped state."
}

resume_job_autorate() {
	if [ "${autorate_paused:-0}" = 1 ] && is_positive_uint "${autorate_pid:-}"; then
		kill -CONT "$autorate_pid" >/dev/null 2>&1 || true
	fi
	autorate_paused=0
	autorate_pid=""
}

configure_autotune_interface_lock_path() {
	command -v runtime_lock_interface_paths >/dev/null 2>&1 || return 1
	runtime_lock_interface_paths "$target_if" || return 1
	autotune_interface_lock="$runtime_interface_lock_record"
}

acquire_autotune_interface_lock() {
	[ -n "${autotune_interface_lock:-}" ] ||
		configure_autotune_interface_lock_path || fail "Unable to derive a safe interface lock for $target_if."
	runtime_lock_acquire_global_shared || {
		lock_rc="$?"
		[ "$lock_rc" -eq 75 ] && fail "CAKE/SQM service mutation is already in progress."
		fail "Unable to acquire the global CAKE/SQM runtime lock."
	}
	runtime_lock_acquire_interface "$target_if" autotune "$recovery_journal" "$worker_token" || {
		lock_rc="$?"
		runtime_lock_release_global >/dev/null 2>&1 || true
		case "$lock_rc" in
			75) fail "Another speed test or Full Auto-Tune job is already using $target_if." ;;
			76) fail "Full Auto-Tune recovery is still pending for $target_if." ;;
			*) fail "Unable to establish an atomic interface lock for $target_if." ;;
		esac
	}
	[ "$runtime_interface_lock_starttime" = "$recovery_owner_starttime" ] ||
		fail "Interface-lock owner identity does not match the recovery journal."
}

release_autotune_interface_lock() {
	[ "${runtime_interface_lock_held:-0}" = 1 ] || return 0
	runtime_lock_release_interface || return 1
	runtime_lock_release_global || return 1
	autotune_interface_lock=""
	return 0
}

detect_link_kind() {
	device="$1"
	logical="$2"
	type="$(sed -n '1p' "/sys/class/net/$device/type" 2>/dev/null)"
	proto=""

	if [ -n "$jsonfilter_bin" ]; then
		proto="$(ubus call "network.interface.$logical" status 2>/dev/null |
			"$jsonfilter_bin" -e '@.proto' 2>/dev/null)"
	fi

	case "$proto:$device" in
		pppoe:*|*:pppoe-*) printf '%s' pppoe ;;
		qmi:*|mbim:*|ncm:*|3g:*|modemmanager:*|*:wwan*|*:rmnet*|*:lte*|*:modem*)
			printf '%s' cellular
			;;
		*)
			case "$type" in
				512) printf '%s' pppoe ;;
				1) printf '%s' ethernet ;;
				*) printf '%s' unknown ;;
			esac
			;;
	esac
}

autorate_conflict_for_target() {
	command -v uci >/dev/null 2>&1 || return 1
	sections="$(uci -q show cake-autorate 2>/dev/null |
		sed -n 's/^cake-autorate\.\([^.=]*\)=cake_autorate$/\1/p')"
	for section in $sections; do
		[ "$section" = "$job_name" ] && continue
		[ "$(uci -q get "cake-autorate.$section.enabled" 2>/dev/null)" = 1 ] || continue
		candidate="$(uci -q get "cake-autorate.$section.wan_if" 2>/dev/null)"
		[ -n "$candidate" ] || candidate="$(uci -q get "cake-autorate.$section.sqm_interface" 2>/dev/null)"
		candidate="$(resolve_interface_device "$candidate" 2>/dev/null)"
		if [ "$candidate" = "$target_if" ]; then
			printf '%s\n' "$section"
			return 0
		fi
	done
	return 1
}

sqm_state_dir() {
	(
		[ ! -r /etc/sqm/sqm.conf ] || . /etc/sqm/sqm.conf 2>/dev/null
		printf '%s' "${SQM_STATE_DIR:-/var/run/sqm}"
	)
}

inspect_sqm_ownership() {
	sqm_ownership_error=""
	preflight_managed_sqm_active=0
	command -v tc >/dev/null 2>&1 || {
		sqm_ownership_error="tc is required to inspect existing qdisc ownership."
		return 1
	}
	qdisc_state="$(tc qdisc show dev "$target_if" 2>/dev/null)" || {
		sqm_ownership_error="Unable to inspect qdisc state on $target_if; Full Auto-Tune will not assume the target is clean."
		return 1
	}
	root_kind="$(printf '%s\n' "$qdisc_state" | awk '$4 == "root" { print $2; exit }')"
	has_ingress=false
	printf '%s\n' "$qdisc_state" | grep -Eq ' ingress | clsact ' && has_ingress=true
	state_dir="$(sqm_state_dir)"
	state_present=false
	[ -f "$state_dir/$target_if.state" ] && state_present=true
	existing_instance="$(uci -q get "cake-autorate.$job_name" 2>/dev/null || true)"

	qdisc_clean=false
	case "$root_kind" in ''|noqueue|mq) [ "$has_ingress" = false ] && [ "$state_present" = false ] && qdisc_clean=true ;; esac
	if [ -z "$existing_instance" ]; then
		[ "$qdisc_clean" = true ] && return 0
		sqm_ownership_error="Target $target_if already has root qdisc ${root_kind:-unknown}, ingress/clsact state, or an SQM state file that is not owned by this new instance."
		return 1
	fi

	[ "$(uci -q get "cake-autorate.$job_name.manage_sqm" 2>/dev/null)" = 1 ] || {
		sqm_ownership_error="Existing instance $job_name does not manage SQM; Full Auto-Tune will not replace or snapshot an arbitrary qdisc."
		return 1
	}
	[ "$(uci -q get "cake-autorate.$job_name.sqm_enabled" 2>/dev/null)" = 1 ] || {
		sqm_ownership_error="Existing instance $job_name has managed SQM disabled; enable its matching queue before Full Auto-Tune."
		return 1
	}
	sqm_section="$(uci -q get "cake-autorate.$job_name.sqm_section" 2>/dev/null || true)"
	[ -n "$sqm_section" ] || sqm_section="cake_$job_name"
	safe_job_name "$sqm_section" || {
		sqm_ownership_error="Existing instance $job_name names an invalid managed SQM section."
		return 1
	}
	[ "$(uci -q get "sqm.$sqm_section._cake_autorate_managed" 2>/dev/null)" = "$job_name" ] || {
		sqm_ownership_error="SQM section $sqm_section is not marked as owned by instance $job_name."
		return 1
	}
	[ "$(uci -q get "sqm.$sqm_section.enabled" 2>/dev/null)" = 1 ] || {
		sqm_ownership_error="Managed SQM section $sqm_section is disabled."
		return 1
	}
	managed_sqm_if="$(uci -q get "sqm.$sqm_section.interface" 2>/dev/null || true)"
	resolved_managed_sqm_if="$(resolve_interface_device "$managed_sqm_if" 2>/dev/null)"
	[ "$resolved_managed_sqm_if" = "$target_if" ] || {
		sqm_ownership_error="Managed SQM section $sqm_section does not target $target_if."
		return 1
	}
	# Auto-preset aliases are convenience fields, not the ownership root. Older
	# LuCI forms could drop hidden aliases while leaving the canonical owned SQM
	# section intact. Accept a missing alias only after proving the section owner
	# and its target, then require every available fallback to resolve to the same
	# physical/L3 interface.
	auto_interface_preset="$(uci -q get "cake-autorate.$job_name.auto_interface_preset" 2>/dev/null || true)"
	if [ "$auto_interface_preset" = 0 ]; then
		configured_sqm_if="$(uci -q get "cake-autorate.$job_name.sqm_interface" 2>/dev/null || true)"
		[ -n "$configured_sqm_if" ] || configured_sqm_if="$(uci -q get "cake-autorate.$job_name.ul_if" 2>/dev/null || true)"
		[ -n "$configured_sqm_if" ] || configured_sqm_if="$(uci -q get "cake-autorate.$job_name.wan_if" 2>/dev/null || true)"
	else
		# In automatic mode wan_if is the user-selected identity. Prefer it over
		# retained aliases so a legitimate uplink change fails closed against the
		# owned section instead of reviving an old hidden DeviceSelect value.
		configured_sqm_if="$(uci -q get "cake-autorate.$job_name.wan_if" 2>/dev/null || true)"
		[ -n "$configured_sqm_if" ] || configured_sqm_if="$(uci -q get "cake-autorate.$job_name.sqm_interface" 2>/dev/null || true)"
		[ -n "$configured_sqm_if" ] || configured_sqm_if="$(uci -q get "cake-autorate.$job_name.ul_if" 2>/dev/null || true)"
	fi
	[ -n "$configured_sqm_if" ] || configured_sqm_if="$managed_sqm_if"
	resolved_sqm_if="$(resolve_interface_device "$configured_sqm_if" 2>/dev/null)"
	[ "$resolved_sqm_if" = "$target_if" ] || {
		sqm_ownership_error="Existing instance $job_name manages ${resolved_sqm_if:-no resolved SQM interface}, not $target_if."
		return 1
	}
	sqm_direction_mode="$(uci -q get "cake-autorate.$job_name.sqm_direction_mode" 2>/dev/null || true)"
	[ -n "$sqm_direction_mode" ] || sqm_direction_mode=both

	if [ "$sqm_direction_mode" = "upload_only" ]; then
		[ "$state_present" = true ] && [ "$root_kind" = cake ] || {
			sqm_ownership_error="Managed SQM for $job_name is not active as CAKE on $target_if."
			return 1
		}
	elif [ "$sqm_direction_mode" = "download_only" ]; then
		[ "$state_present" = true ] && [ "$has_ingress" = true ] || {
			sqm_ownership_error="Managed SQM for $job_name is not active with ingress on $target_if."
			return 1
		}
		dl_if="$(uci -q get "cake-autorate.$job_name.dl_if" 2>/dev/null || true)"
		[ -n "$dl_if" ] || dl_if="ifb4$target_if"
		safe_interface_name "$dl_if" || {
			sqm_ownership_error="Managed download IFB for $job_name is invalid."
			return 1
		}
		[ -e "/sys/class/net/$dl_if" ] &&
			[ "$(tc qdisc show dev "$dl_if" 2>/dev/null | awk '$4 == "root" { print $2; exit }')" = cake ] || {
			sqm_ownership_error="Managed download IFB $dl_if is missing or does not have CAKE."
			return 1
		}
	else
		[ "$state_present" = true ] && [ "$root_kind" = cake ] && [ "$has_ingress" = true ] || {
			sqm_ownership_error="Managed SQM for $job_name is not active as CAKE plus ingress on $target_if."
			return 1
		}
		dl_if="$(uci -q get "cake-autorate.$job_name.dl_if" 2>/dev/null || true)"
		[ -n "$dl_if" ] || dl_if="ifb4$target_if"
		safe_interface_name "$dl_if" || {
			sqm_ownership_error="Managed download IFB for $job_name is invalid."
			return 1
		}
		[ -e "/sys/class/net/$dl_if" ] &&
			[ "$(tc qdisc show dev "$dl_if" 2>/dev/null | awk '$4 == "root" { print $2; exit }')" = cake ] || {
			sqm_ownership_error="Managed download IFB $dl_if is missing or does not have CAKE."
			return 1
		}
	fi
	if [ "$sqm_direction_mode" != "upload_only" ]; then
		managed_redirect_state="$(tc filter show dev "$target_if" ingress 2>/dev/null)" || {
			sqm_ownership_error="Unable to inspect the managed ingress redirect on $target_if."
			return 1
		}
		printf '%s\n' "$managed_redirect_state" | grep -Fq "redirect dev $dl_if" ||
			printf '%s\n' "$managed_redirect_state" | grep -Fq "Redirect to device $dl_if)" || {
			sqm_ownership_error="Managed SQM ingress on $target_if does not redirect to the expected IFB $dl_if."
			return 1
		}
	fi
	preflight_managed_sqm_active=1
	return 0
}

preflight_sqm_ownership() {
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_PREFLIGHT:-0}" = 1 ] &&
	   [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SQM_OWNERSHIP:-0}" != 1 ]; then
		return 0
	fi
	inspect_sqm_ownership || fail "$sqm_ownership_error"
}

capture_recovery_sqm_snapshot() {
	recovery_sqm_was_active=0
	recovery_sqm_restore_mode=none
	recovery_sqm_section=""
	recovery_sqm_target_if=""
	recovery_sqm_ul_if=""
	recovery_sqm_dl_if=""
	recovery_sqm_config_fingerprint=""
	recovery_sqm_config_snapshot=""
	recovery_sqm_restore_required=0

	state_dir="$(sqm_state_dir)"
	if [ "${preflight_managed_sqm_active:-0}" != 1 ]; then
		[ ! -f "$state_dir/$target_if.state" ] || return 1
		return 0
	fi
	inspect_sqm_ownership || return 1
	[ "${preflight_managed_sqm_active:-0}" = 1 ] || return 1
	[ -f "$state_dir/$target_if.state" ] || return 1
	# Production preflight has already proved that this state file, target CAKE,
	# ingress redirect, and IFB are owned by this exact instance.  Persist the
	# immutable identity before the first unshaped speedtest is allowed to stop
	# SQM, so SIGKILL during that child cannot strand the link unshaped.
	[ -n "${sqm_section:-}" ] || return 1
	recovery_sqm_section="$sqm_section"
	recovery_sqm_target_if="$target_if"
	recovery_sqm_ul_if="$(uci -q get "cake-autorate.$job_name.ul_if" 2>/dev/null)"
	[ -n "$recovery_sqm_ul_if" ] || recovery_sqm_ul_if="$target_if"
	recovery_sqm_dl_if="${dl_if:-$(uci -q get "cake-autorate.$job_name.dl_if" 2>/dev/null)}"
	[ -n "$recovery_sqm_dl_if" ] || recovery_sqm_dl_if="ifb4$target_if"
	safe_job_name "$recovery_sqm_section" &&
		safe_interface_name "$recovery_sqm_target_if" &&
		safe_interface_name "$recovery_sqm_ul_if" &&
		safe_interface_name "$recovery_sqm_dl_if" || return 1
	fingerprint_before="$(managed_sqm_config_fingerprint "$recovery_sqm_section")" || return 1
	snapshot_candidate="$(capture_sqm_config_file)" || return 1
	snapshot_fingerprint="$(managed_sqm_snapshot_fingerprint "$snapshot_candidate" "$recovery_sqm_section")" || {
		rm -f "$snapshot_candidate" 2>/dev/null || true
		return 1
	}
	fingerprint_after="$(managed_sqm_config_fingerprint "$recovery_sqm_section")" || {
		rm -f "$snapshot_candidate" 2>/dev/null || true
		return 1
	}
	[ "$fingerprint_before" = "$snapshot_fingerprint" ] &&
		[ "$fingerprint_before" = "$fingerprint_after" ] || {
		rm -f "$snapshot_candidate" 2>/dev/null || true
		return 1
	}
	recovery_sqm_config_fingerprint="$fingerprint_before"
	recovery_sqm_config_snapshot="$snapshot_candidate"
	recovery_sqm_restore_required=1
	recovery_sqm_was_active=1
	recovery_sqm_restore_mode=managed
	return 0
}

replace_temporary_cake_qdisc() {
	qdisc_device="$1"
	qdisc_handle="$2"
	qdisc_rate_kbps="$3"
	qdisc_direction="$4"
	safe_interface_name "$qdisc_device" &&
		is_positive_uint "$qdisc_rate_kbps" || return 1
	case "$qdisc_direction" in download|upload) ;; *) return 1 ;; esac

	# Construct argv one token at a time.  The profile, direction, and link
	# compensation values are all selected from closed allowlists, so shaped
	# validation cannot drift from the exact SQM policy that will be proposed
	# later or turn a UCI value into shell syntax.
	set -- qdisc replace dev "$qdisc_device" root handle "$qdisc_handle" \
		cake bandwidth "${qdisc_rate_kbps}kbit"
	case "$autotune_profile" in
		gaming|gaming_extreme) set -- "$@" diffserv4 nat ;;
		best_overall|variable_link|fair)
			if [ "$qdisc_direction" = download ]; then
				# Native rules run before outbound enqueue, not before WAN
				# ingress is redirected to IFB. Keep untrusted download
				# markings in one best-effort tin and wash them afterwards.
				set -- "$@" besteffort nat wash
			else
				set -- "$@" diffserv4 nat
			fi
			;;
		*) return 1 ;;
	esac
	case "$link_kind" in
		pppoe) set -- "$@" ethernet overhead 44 mpu 84 ;;
		ethernet) set -- "$@" ethernet overhead 18 mpu 64 ;;
		*) set -- "$@" raw ;;
	esac
	tc "$@" >/dev/null 2>&1
}

configure_temp_shaper_identity() {
	safe_worker_token "$worker_token" || return 1
	identity_seed="$(printf '%s' "$worker_token" | cut -c1-8 | tr 'A-F' 'a-f')"
	handle_seed="$(printf '%s' "$identity_seed" | cut -c1-3 | tr 'A-F' 'a-f')"
	temp_ifb="catf$identity_seed"
	temp_ifb_alias="cake-autotune-$worker_token"
	temp_target_handle="a${handle_seed}:"
	temp_ifb_handle="b${handle_seed}:"
	temp_ingress_handle="ffff:"
	temp_redirect_pref="$((49152 + ($$ % 1024)))"
	[ "${#temp_ifb}" -le 15 ] && safe_interface_name "$temp_ifb" || return 1
	case "$temp_ifb_alias" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
	recovery_temp_ifb="$temp_ifb"
	recovery_temp_ifb_alias="$temp_ifb_alias"
	recovery_temp_ifb_ifindex=""
	recovery_temp_target_handle="$temp_target_handle"
	recovery_temp_ifb_handle="$temp_ifb_handle"
	recovery_temp_ingress_handle="$temp_ingress_handle"
	recovery_temp_redirect_pref="$temp_redirect_pref"
}

exact_root_qdisc() {
	qdisc_device="$1"
	qdisc_handle="$2"
	qdisc_expected_kbps="$3"
	qdisc_direction="$4"
	is_positive_uint "$qdisc_expected_kbps" || return 1
	case "$qdisc_direction" in download|upload) ;; *) return 1 ;; esac
	qdisc_output="$(tc qdisc show dev "$qdisc_device" 2>/dev/null)" || return 1
	printf '%s\n' "$qdisc_output" | awk -v handle="$qdisc_handle" -v expected="$qdisc_expected_kbps" '
		function rate_kbps(token, value, multiplier) {
			value = token
			if (value ~ /[Kk]bit$/) { sub(/[Kk]bit$/, "", value); multiplier = 1 }
			else if (value ~ /[Mm]bit$/) { sub(/[Mm]bit$/, "", value); multiplier = 1000 }
			else if (value ~ /[Gg]bit$/) { sub(/[Gg]bit$/, "", value); multiplier = 1000000 }
			else if (value ~ /[Tt]bit$/) { sub(/[Tt]bit$/, "", value); multiplier = 1000000000 }
			else if (value ~ /bit$/) { sub(/bit$/, "", value); multiplier = 0.001 }
			else return -1
			if (value !~ /^[0-9]+([.][0-9]+)?$/) return -1
			return value * multiplier
		}
		$1 == "qdisc" && $2 == "cake" && $3 == handle && $4 == "root" {
			found++
			for (i = 5; i < NF; i++) if ($i == "bandwidth") {
				actual = rate_kbps($(i + 1))
				delta = actual - expected
				if (delta < 0) delta = -delta
				if (actual >= 0 && delta < 0.5) rate_matches++
				break
			}
		}
		END { exit(found == 1 && rate_matches == 1 ? 0 : 1) }
	' || return 1
	qdisc_line="$(printf '%s\n' "$qdisc_output" |
		awk -v handle="$qdisc_handle" '
			$1 == "qdisc" && $2 == "cake" && $3 == handle && $4 == "root" {
				print
				found++
			}
			END { exit(found == 1 ? 0 : 1) }
		')" || return 1
	case "$autotune_profile" in
		gaming|gaming_extreme)
			printf '%s\n' "$qdisc_line" | grep -Eq '(^|[[:space:]])diffserv4([[:space:]]|$)' || return 1
			! printf '%s\n' "$qdisc_line" | grep -Eq '(^|[[:space:]])wash([[:space:]]|$)' || return 1
			;;
		best_overall|variable_link|fair)
			if [ "$qdisc_direction" = download ]; then
				printf '%s\n' "$qdisc_line" | grep -Eq '(^|[[:space:]])besteffort([[:space:]]|$)' || return 1
				printf '%s\n' "$qdisc_line" | grep -Eq '(^|[[:space:]])wash([[:space:]]|$)' || return 1
			else
				printf '%s\n' "$qdisc_line" | grep -Eq '(^|[[:space:]])diffserv4([[:space:]]|$)' || return 1
				! printf '%s\n' "$qdisc_line" | grep -Eq '(^|[[:space:]])wash([[:space:]]|$)' || return 1
			fi
			;;
		*) return 1 ;;
	esac
	printf '%s\n' "$qdisc_line" | grep -Eq '(^|[[:space:]])nat([[:space:]]|$)' || return 1
	# layer_cake.qos and piece_of_cake.qos attach CAKE to an IFB but do not
	# pass CAKE's separate `ingress` keyword. Validate that exact effective
	# qdisc rather than a superficially similar custom shaper.
	! printf '%s\n' "$qdisc_line" | grep -Eq '(^|[[:space:]])ingress([[:space:]]|$)' || return 1
}

exact_ingress_redirect() {
	qdisc_output="$(tc qdisc show dev "$target_if" 2>/dev/null)" || return 1
	printf '%s\n' "$qdisc_output" | awk -v handle="$temp_ingress_handle" '
		$1 == "qdisc" && $2 == "ingress" && $3 == handle { found++ }
		END { exit(found == 1 ? 0 : 1) }
	' || return 1
	filter_output="$(tc filter show dev "$target_if" ingress 2>/dev/null)" || return 1
	printf '%s\n' "$filter_output" | grep -Eq "(^|[[:space:]])pref[[:space:]]+$temp_redirect_pref([[:space:]]|$)" || return 1
	printf '%s\n' "$filter_output" | grep -Fq "redirect dev $temp_ifb" ||
		printf '%s\n' "$filter_output" | grep -Fq "Redirect to device $temp_ifb)" || return 1
}

no_ingress_redirect() {
	qdisc_output="$(tc qdisc show dev "$target_if" 2>/dev/null)" || return 1
	! printf '%s\n' "$qdisc_output" | grep -Eq ' ingress | clsact '
}

no_temporary_egress_shaper() {
	# Removing a root qdisc from a physical OpenWrt interface commonly exposes
	# a kernel-owned handle-0 default (mq/noqueue/fq_codel/pfifo_fast).  Accept
	# only that narrow set or no root at all.  In particular, absence of our
	# random CAKE handle is not enough to authorize a foreign replacement.
	qdisc_output="$(tc qdisc show dev "$target_if" 2>/dev/null)" || return 1
	printf '%s\n' "$qdisc_output" | awk '
		$1 == "qdisc" && $4 == "root" {
			roots++
			if ($3 == "0:" &&
			    ($2 == "mq" || $2 == "noqueue" ||
			     $2 == "fq_codel" || $2 == "pfifo_fast")) defaults++
			else foreign++
		}
		END { exit(roots == 0 || (defaults == roots && foreign == 0) ? 0 : 1) }
	'
}

exact_temp_ifb() {
	[ -e "/sys/class/net/$temp_ifb" ] || return 1
	[ "$(cat "/sys/class/net/$temp_ifb/ifalias" 2>/dev/null)" = "$temp_ifb_alias" ] || return 1
	is_positive_uint "${recovery_temp_ifb_ifindex:-}" || return 1
	[ "$(cat "/sys/class/net/$temp_ifb/ifindex" 2>/dev/null)" = "$recovery_temp_ifb_ifindex" ] || return 1
}

temporary_shaper_owned() {
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		[ "${temp_shaper_active:-0}" = 1 ] || return 1
		[ "${temp_ingress_active:-1}" = 1 ] || return 1
		[ "${temp_egress_active:-1}" = 1 ] || return 1
		is_positive_uint "${temp_download_kbps:-}" || return 1
		is_positive_uint "${temp_upload_kbps:-}" || return 1
		if [ -n "${AUTOTUNE_MOCK_SHAPER_OWNERSHIP_LOST_MARKER:-}" ] &&
		   [ -e "$AUTOTUNE_MOCK_SHAPER_OWNERSHIP_LOST_MARKER" ]; then
			return 1
		fi
		if [ -n "${AUTOTUNE_MOCK_SHAPER_OWNERSHIP_CHECK_COUNTER:-}" ]; then
			ownership_check_count="$(sed -n '1p' "$AUTOTUNE_MOCK_SHAPER_OWNERSHIP_CHECK_COUNTER" 2>/dev/null)"
			case "$ownership_check_count" in ''|*[!0-9]*) ownership_check_count=0 ;; esac
			ownership_check_count=$((ownership_check_count + 1))
			printf '%s\n' "$ownership_check_count" > "$AUTOTUNE_MOCK_SHAPER_OWNERSHIP_CHECK_COUNTER" || return 1
			if is_positive_uint "${AUTOTUNE_MOCK_SHAPER_INVALIDATE_AFTER_CHECK:-}" &&
			   [ "$ownership_check_count" -eq "$AUTOTUNE_MOCK_SHAPER_INVALIDATE_AFTER_CHECK" ]; then
				[ -n "${AUTOTUNE_MOCK_SHAPER_OWNERSHIP_LOST_MARKER:-}" ] || return 1
				: > "$AUTOTUNE_MOCK_SHAPER_OWNERSHIP_LOST_MARKER" || return 1
			fi
		fi
		return 0
	fi
	[ "${recovery_shaper_started:-0}" = 1 ] || return 1
	is_positive_uint "${temp_download_kbps:-}" || return 1
	is_positive_uint "${temp_upload_kbps:-}" || return 1
	exact_temp_ifb &&
		exact_root_qdisc "$target_if" "$temp_target_handle" "$temp_upload_kbps" upload &&
		exact_root_qdisc "$temp_ifb" "$temp_ifb_handle" "$temp_download_kbps" download &&
		exact_ingress_redirect
}

temporary_upload_only_shaper_owned() {
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		[ "${temp_shaper_active:-0}" = 1 ] || return 1
		[ "${temp_ingress_active:-1}" = 0 ] || return 1
		[ "${temp_egress_active:-1}" = 1 ] || return 1
		is_positive_uint "${temp_download_kbps:-}" &&
			is_positive_uint "${temp_upload_kbps:-}"
		return
	fi
	[ "${recovery_shaper_started:-0}" = 1 ] || return 1
	is_positive_uint "${temp_download_kbps:-}" || return 1
	is_positive_uint "${temp_upload_kbps:-}" || return 1
	exact_temp_ifb &&
		exact_root_qdisc "$target_if" "$temp_target_handle" "$temp_upload_kbps" upload &&
		exact_root_qdisc "$temp_ifb" "$temp_ifb_handle" "$temp_download_kbps" download &&
		no_ingress_redirect
}

temporary_download_only_shaper_owned() {
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		[ "${temp_shaper_active:-0}" = 1 ] || return 1
		[ "${temp_ingress_active:-1}" = 1 ] || return 1
		[ "${temp_egress_active:-1}" = 0 ] || return 1
		is_positive_uint "${temp_download_kbps:-}" &&
			is_positive_uint "${temp_upload_kbps:-}"
		return
	fi
	[ "${recovery_shaper_started:-0}" = 1 ] || return 1
	is_positive_uint "${temp_download_kbps:-}" || return 1
	is_positive_uint "${temp_upload_kbps:-}" || return 1
	exact_temp_ifb &&
		no_temporary_egress_shaper &&
		exact_root_qdisc "$temp_ifb" "$temp_ifb_handle" "$temp_download_kbps" download &&
		exact_ingress_redirect
}

bypass_temporary_ingress() {
	temporary_shaper_owned || return 1
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		temp_ingress_active=0
		return 0
	fi
	tc qdisc del dev "$target_if" ingress >/dev/null 2>&1 || return 1
	temp_ingress_active=0
	temporary_upload_only_shaper_owned
}

bypass_temporary_egress() {
	temporary_shaper_owned || return 1
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		temp_egress_active=0
		return 0
	fi
	tc qdisc del dev "$target_if" root >/dev/null 2>&1 || return 1
	temp_egress_active=0
	temporary_download_only_shaper_owned
}

attach_temporary_ingress() {
	tc qdisc add dev "$target_if" handle "$temp_ingress_handle" ingress >/dev/null 2>&1 || return 1
	if ! tc filter add dev "$target_if" parent "$temp_ingress_handle" protocol all \
		pref "$temp_redirect_pref" u32 match u32 0 0 \
		action mirred egress redirect dev "$temp_ifb" >/dev/null 2>&1; then
		# Do not leave a third, partially-owned topology behind. A later cleanup
		# can prove either the complete shaper or the intentional upload-only
		# state, but it must never have to guess who owns a bare ingress qdisc.
		tc qdisc del dev "$target_if" ingress >/dev/null 2>&1 || true
		return 1
	fi
}

restore_temporary_ingress() {
	temporary_upload_only_shaper_owned || return 1
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		temp_ingress_active=1
		return 0
	fi
	attach_temporary_ingress || return 1
	temp_ingress_active=1
	temporary_shaper_owned
}

restore_temporary_egress() {
	temporary_download_only_shaper_owned || return 1
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		temp_egress_active=1
		return 0
	fi
	replace_temporary_cake_qdisc "$target_if" "$temp_target_handle" "$temp_upload_kbps" upload ||
		return 1
	temp_egress_active=1
	temporary_shaper_owned
}

temporary_phase_shaper_owned() {
	case "$phase_topology" in
		both_shaped) temporary_shaper_owned ;;
		upload_only_shaped) temporary_upload_only_shaper_owned ;;
		download_only_shaped) temporary_download_only_shaper_owned ;;
		*) return 1 ;;
	esac
}

temporary_qdisc_stats_json() {
	stats_direction="$1"
	case "$stats_direction" in
		download) stats_device="$temp_ifb"; stats_handle="$temp_ifb_handle" ;;
		upload) stats_device="$target_if"; stats_handle="$temp_target_handle" ;;
		both)
			printf '{"download":'
			temporary_qdisc_stats_json download
			printf ',"upload":'
			temporary_qdisc_stats_json upload
			printf '}'
			return
			;;
		*) printf '{"available":false,"reason":"invalid-direction"}'; return ;;
	esac
	stats_output="$(tc -s qdisc show dev "$stats_device" 2>/dev/null)" || {
		printf '{"available":false,"reason":"tc-read-failed"}'
		return
	}
	stats_values="$(printf '%s\n' "$stats_output" | awk -v handle="$stats_handle" '
		$1 == "qdisc" && $2 == "cake" && $3 == handle { found = 1; next }
		found && $1 == "Sent" {
			bytes = $2
			packets = $4
			dropped = overlimits = requeues = 0
			for (i = 5; i <= NF; i++) {
				key = $i
				gsub(/[(),]/, "", key)
				if (key == "dropped" || key == "overlimits" || key == "requeues") {
					value = $(i + 1)
					gsub(/[(),]/, "", value)
					if (value !~ /^[0-9]+$/) value = 0
					if (key == "dropped") dropped = value
					else if (key == "overlimits") overlimits = value
					else requeues = value
				}
			}
			if (bytes ~ /^[0-9]+$/ && packets ~ /^[0-9]+$/)
				print bytes, packets, dropped, overlimits, requeues
			exit
		}
	')"
	set -- $stats_values
	if [ "$#" -ne 5 ]; then
		printf '{"available":false,"reason":"cake-stats-unavailable"}'
		return
	fi
	printf '{"available":true,"device":"%s","handle":"%s","bytes":%s,"packets":%s,"dropped":%s,"overlimits":%s,"requeues":%s}' \
		"$(json_escape "$stats_device")" "$(json_escape "$stats_handle")" \
		"$1" "$2" "$3" "$4" "$5"
}

restore_temp_shaper() {
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		[ -n "${AUTOTUNE_MOCK_SHAPER_RESTORE_MARKER:-}" ] &&
			touch "$AUTOTUNE_MOCK_SHAPER_RESTORE_MARKER"
		temp_shaper_active=0
		temp_ingress_active=0
		temp_egress_active=0
		if [ "${recovery_shaper_started:-0}" = 1 ]; then
			recovery_shaper_started=0
			write_recovery_journal || return 1
		fi
		return 0
	fi

	if [ "${temp_shaper_active:-0}" = 1 ]; then
		if temporary_shaper_owned; then
			tc qdisc del dev "$target_if" ingress >/dev/null 2>&1 || return 1
			tc qdisc del dev "$target_if" root >/dev/null 2>&1 || return 1
		elif temporary_upload_only_shaper_owned; then
			tc qdisc del dev "$target_if" root >/dev/null 2>&1 || return 1
		elif temporary_download_only_shaper_owned; then
			tc qdisc del dev "$target_if" ingress >/dev/null 2>&1 || return 1
		else
			return 1
		fi
		tc qdisc del dev "$temp_ifb" root >/dev/null 2>&1 || return 1
		if [ "${temp_ifb_created:-0}" = 1 ]; then
			ip link set dev "$temp_ifb" down >/dev/null 2>&1 || return 1
			ip link delete dev "$temp_ifb" type ifb >/dev/null 2>&1 || return 1
		fi
		[ ! -e "/sys/class/net/$temp_ifb" ] || return 1
		temp_shaper_active=0
		temp_ingress_active=0
		temp_egress_active=0
		# The temporary topology is now provably absent.  Publish that durable
		# transition before the recovery helper is allowed to recreate managed
		# SQM.  Otherwise a crash after SQM start but before journal finalization
		# makes the next recovery pass mistake our normal CAKE/IFB for a foreign
		# replacement of the random temporary handles.
		if [ "${recovery_shaper_started:-0}" = 1 ]; then
			recovery_shaper_started=0
			write_recovery_journal || return 1
		fi
	fi

	# Managed SQM is intentionally not restarted here. The recovery helper owns
	# that operation and verifies the immutable SQM/IFB/redirect postconditions
	# before it resumes autorate and releases the interface lock.
}

discard_unpublished_temp_ifb() {
	# This path is only for a synchronous failure before shaper_started=1 is
	# durably published.  Delete nothing unless the just-created link still has
	# both the locally captured ifindex and our random ownership alias.  Crash
	# recovery deliberately ignores an uncommitted IFB and restores managed SQM.
	[ "${temp_ifb_created:-0}" = 1 ] || return 0
	is_positive_uint "${created_temp_ifb_ifindex:-}" || return 1
	[ "$(cat "/sys/class/net/$temp_ifb/ifindex" 2>/dev/null)" = "$created_temp_ifb_ifindex" ] || return 1
	[ "$(cat "/sys/class/net/$temp_ifb/ifalias" 2>/dev/null)" = "$temp_ifb_alias" ] || return 1
	ip link set dev "$temp_ifb" down >/dev/null 2>&1 || return 1
	ip link delete dev "$temp_ifb" type ifb >/dev/null 2>&1 || return 1
	[ ! -e "/sys/class/net/$temp_ifb" ] || return 1
	temp_ifb_created=0
	return 0
}

prepare_temp_shaper() {
	download_kbps="$1"
	upload_kbps="$2"

	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		mock_shaper_was_active="${temp_shaper_active:-0}"
		if [ "${temp_shaper_active:-0}" = 1 ]; then
			if temporary_upload_only_shaper_owned; then
				restore_temporary_ingress ||
					fail "Unable to restore the mock ingress shaper between validation attempts."
			elif temporary_download_only_shaper_owned; then
				restore_temporary_egress ||
					fail "Unable to restore the mock egress shaper between validation attempts."
			else
				temporary_shaper_owned ||
					fail "Mock temporary shaper ownership changed between validation attempts."
			fi
		fi
		temp_shaper_active=1
		temp_ingress_active=1
		temp_egress_active=1
		temp_download_kbps="$download_kbps"
		temp_upload_kbps="$upload_kbps"
		# The lifecycle fixture can mirror the exact typed candidate instead of
		# returning one fixed shaped rate for every bounded-search observation.
		# These variables exist only in the explicit test-shaper path.
		export AUTOTUNE_MOCK_CURRENT_DL_KBPS="$download_kbps"
		export AUTOTUNE_MOCK_CURRENT_UL_KBPS="$upload_kbps"
		if [ "$mock_shaper_was_active" != 1 ] && [ "${recovery_prepared:-0}" = 1 ]; then
			recovery_shaper_started=1
			write_recovery_journal || fail "Unable to journal the mock temporary shaper."
		fi
		return 0
	fi

	command -v tc >/dev/null 2>&1 || fail "tc is required for shaped validation."
	command -v ip >/dev/null 2>&1 || fail "ip is required for shaped validation."
	[ -x /usr/lib/sqm/run.sh ] || fail "sqm-scripts is required for shaped validation."
	[ -n "${temp_ifb:-}" ] && [ -n "${temp_ifb_alias:-}" ] ||
		fail "Temporary shaper ownership identity is unavailable."
	if [ "${temp_shaper_active:-0}" = 1 ]; then
		[ "${recovery_shaper_started:-0}" = 1 ] && [ "$recovery_temp_ifb" = "$temp_ifb" ] ||
			fail "Temporary shaper identity changed between validation attempts."
		if temporary_upload_only_shaper_owned; then
			restore_temporary_ingress ||
				fail "Unable to restore the temporary ingress shaper between validation attempts."
		elif temporary_download_only_shaper_owned; then
			restore_temporary_egress ||
				fail "Unable to restore the temporary egress shaper between validation attempts."
		else
			temporary_shaper_owned || fail "Temporary shaper ownership changed between validation attempts."
		fi
		# Retain the same journal-owned shaper across a bounded correction/retry;
		# only its rates change. Restarting managed SQM between attempts creates a
		# larger crash window and used to make attempt two impossible.
		replace_temporary_cake_qdisc "$target_if" "$temp_target_handle" "$upload_kbps" upload ||
			fail "Unable to update the temporary upload CAKE rate."
		replace_temporary_cake_qdisc "$temp_ifb" "$temp_ifb_handle" "$download_kbps" download ||
			fail "Unable to update the temporary download CAKE rate."
		temp_download_kbps="$download_kbps"
		temp_upload_kbps="$upload_kbps"
		temporary_shaper_owned || fail "Temporary shaper ownership changed while updating candidate rates."
		return 0
	fi

	state_dir="$(sqm_state_dir)"
	if [ "${recovery_sqm_was_active:-0}" = 1 ]; then
		[ -f "$state_dir/$target_if.state" ] ||
			fail "Managed SQM disappeared before shaped validation; recovery remains armed."
		current_sqm_section="$(uci -q get "cake-autorate.$job_name.sqm_section" 2>/dev/null)"
		[ -n "$current_sqm_section" ] || current_sqm_section="cake_$job_name"
		current_ul_if="$(uci -q get "cake-autorate.$job_name.ul_if" 2>/dev/null)"
		[ -n "$current_ul_if" ] || current_ul_if="$target_if"
		current_dl_if="$(uci -q get "cake-autorate.$job_name.dl_if" 2>/dev/null)"
		[ -n "$current_dl_if" ] || current_dl_if="ifb4$target_if"
		[ "$current_sqm_section" = "$recovery_sqm_section" ] &&
			[ "$target_if" = "$recovery_sqm_target_if" ] &&
			[ "$current_ul_if" = "$recovery_sqm_ul_if" ] &&
			[ "$current_dl_if" = "$recovery_sqm_dl_if" ] ||
			fail "Managed SQM identity changed during Full Auto-Tune."
		sqm_was_active=1
		write_recovery_journal || fail "Unable to refresh the managed SQM journal before stopping it."
		/usr/lib/sqm/run.sh stop "$target_if" >/dev/null 2>&1 ||
			fail "Unable to pause existing SQM before shaped validation."
	elif [ -f "$state_dir/$target_if.state" ]; then
		fail "Unexpected SQM state appeared after the recovery snapshot was armed."
	fi

	post_stop_qdisc_state="$(tc qdisc show dev "$target_if" 2>/dev/null)" ||
		fail "Unable to inspect qdisc state after stopping managed SQM."
	root_kind="$(printf '%s\n' "$post_stop_qdisc_state" | awk '$4 == "root" { print $2; exit }')"
	case "$root_kind" in
		''|noqueue|mq|fq_codel|pfifo_fast) ;;
		*) fail "Refusing to replace unmanaged root qdisc $root_kind on $target_if." ;;
	esac
	if printf '%s\n' "$post_stop_qdisc_state" | grep -Eq ' ingress | clsact '; then
		fail "Refusing to replace unmanaged ingress/clsact state on $target_if."
	fi
	[ ! -e "/sys/class/net/$temp_ifb" ] || fail "Refusing to reuse existing IFB $temp_ifb."

	recovery_temp_ifb="$temp_ifb"
	recovery_temp_ifb_alias="$temp_ifb_alias"
	recovery_temp_ifb_ifindex=""
	recovery_shaper_started=0
	write_recovery_journal || fail "Unable to journal the temporary shaper before creating it."
	ip link add name "$temp_ifb" type ifb >/dev/null 2>&1 || fail "Unable to create temporary IFB $temp_ifb."
	temp_ifb_created=1
	created_temp_ifb_ifindex="$(cat "/sys/class/net/$temp_ifb/ifindex" 2>/dev/null)"
	is_positive_uint "$created_temp_ifb_ifindex" || fail "Unable to capture newly-created temporary IFB identity."
	ip link set dev "$temp_ifb" alias "$temp_ifb_alias" >/dev/null 2>&1 ||
		fail "Unable to mark temporary IFB ownership."
	ip link set dev "$temp_ifb" up >/dev/null 2>&1 || {
		discard_unpublished_temp_ifb || true
		fail "Unable to bring up temporary IFB $temp_ifb."
	}
	recovery_temp_ifb_ifindex="$created_temp_ifb_ifindex"
	recovery_shaper_started=1
	write_recovery_journal || {
		recovery_shaper_started=0
		recovery_temp_ifb_ifindex=""
		discard_unpublished_temp_ifb || true
		fail "Unable to atomically journal the created temporary IFB identity."
	}
	# Only a complete name+alias+ifindex tuple published in one atomic journal
	# transition authorizes qdisc attachment or recovery-side deletion.
	temp_shaper_active=1
	temp_ingress_active=0
	temp_egress_active=0
	replace_temporary_cake_qdisc "$target_if" "$temp_target_handle" "$upload_kbps" upload ||
		fail "Unable to attach temporary upload CAKE qdisc."
	replace_temporary_cake_qdisc "$temp_ifb" "$temp_ifb_handle" "$download_kbps" download ||
		fail "Unable to attach temporary download CAKE qdisc."
	temp_download_kbps="$download_kbps"
	temp_upload_kbps="$upload_kbps"
	attach_temporary_ingress ||
		fail "Unable to attach the temporary ingress redirect into the IFB."
	temp_ingress_active=1
	temp_egress_active=1
	temporary_shaper_owned || fail "Temporary CAKE/IFB ownership postconditions failed."
}

cpu_sample_fields() {
	previous_sample="$1"
	current_sample="$2"
	awk -v previous="$previous_sample" -v current="$current_sample" 'BEGIN {
				previous_rows = split(previous, p_rows, "\n")
				for (row = 1; row <= previous_rows; row++) {
					n = split(p_rows[row], field, /[[:space:]]+/)
					if (n == 4) {
						p_total[field[1]] = field[2]
						p_idle[field[1]] = field[3]
						p_softirq[field[1]] = field[4]
					}
				}
				current_rows = split(current, c_rows, "\n")
				total_cpu = 0
				max_core = 0
				max_softirq = 0
				for (row = 1; row <= current_rows; row++) {
					n = split(c_rows[row], field, /[[:space:]]+/)
					name = field[1]
					if (n != 4 || !(name in p_total)) continue
					total = field[2] - p_total[name]
					idle = field[3] - p_idle[name]
					softirq = field[4] - p_softirq[name]
					if (total <= 0) continue
					util = (total - idle) * 100 / total
					softirq_util = softirq * 100 / total
					if (name == "cpu") total_cpu = util
					else if (util > max_core) max_core = util
					if (name != "cpu" && softirq_util > max_softirq) max_softirq = softirq_util
				}
				effective = total_cpu > max_core ? total_cpu : max_core
				printf "%.1f %.1f %.1f %.1f\n", effective, total_cpu, max_core, max_softirq
			}'
}

cpu_monitor() {
	output="$1"
	marker="$2"
	previous=""
	while [ -e "$marker" ]; do
		current="$(awk '
			/^cpu([0-9]+)?[[:space:]]/ {
				total = 0
				# Exclude guest/guest_nice because Linux already accounts those
				# ticks inside user/nice.
				for (i = 2; i <= NF && i <= 9; i++) total += $i
				print $1, total, $5 + $6, $8
			}
		' /proc/stat)"
		if [ -n "$previous" ]; then
			cpu_sample_fields "$previous" "$current" >> "$output"
		fi
		previous="$current"
		sleep 1
	done
}

cpu_peak_fields() {
	cpu_peak_input="$1"
	awk '
		NF >= 1 {
			effective = $1
			total = NF >= 2 ? $2 : effective
			core = NF >= 3 ? $3 : effective
			softirq = NF >= 4 ? $4 : 0
			if (!seen || effective > max_effective) max_effective = effective
			if (!seen || total > max_total) max_total = total
			if (!seen || core > max_core) max_core = core
			if (!seen || softirq > max_softirq) max_softirq = softirq
			seen = 1
		}
		END {
			if (!seen) exit 1
			printf "%.1f %.1f %.1f %.1f", max_effective, max_total, max_core, max_softirq
		}
	' "$cpu_peak_input"
}

cpu_sustained_fields() {
	cpu_sustained_input="$1"
	cpu_sustained_limit="${2:-100}"
	awk -v limit="$cpu_sustained_limit" '
		NF >= 1 {
			effective = $1 + 0
			softirq = NF >= 4 ? $4 + 0 : 0
			effective_value[++count] = effective
			softirq_value[count] = softirq
			sum += effective
			if (effective > limit) {
				over++
				current_run++
				if (current_run > longest_run) longest_run = current_run
			} else current_run = 0
		}
		END {
			if (count < 1) exit 1
			for (i = 2; i <= count; i++) {
				value = effective_value[i]
				j = i - 1
				while (j >= 1 && effective_value[j] > value) {
					effective_value[j + 1] = effective_value[j]
					j--
				}
				effective_value[j + 1] = value
				value = softirq_value[i]
				j = i - 1
				while (j >= 1 && softirq_value[j] > value) {
					softirq_value[j + 1] = softirq_value[j]
					j--
				}
				softirq_value[j + 1] = value
			}
			p95_index = int((count * 95 + 99) / 100)
			if (p95_index < 1) p95_index = 1
			printf "%.1f %.1f %d %d %d %.1f", sum / count,
				effective_value[p95_index], count, over, longest_run,
				softirq_value[p95_index]
		}
	' "$cpu_sustained_input"
}

numeric_latency_stats() {
	input="$1"
	sorted="$2"
	[ -s "$input" ] || return 1
	sort -n "$input" > "$sorted"
	awk '
		{ value[NR] = $1 }
		END {
			if (NR < 1) exit 1
			if (NR % 2) median = value[(NR + 1) / 2]
			else median = (value[NR / 2] + value[NR / 2 + 1]) / 2
			p95_index = int((NR * 95 + 99) / 100)
			if (p95_index < 1) p95_index = 1
			printf "%.3f %.3f %.3f %d", median, value[p95_index], value[NR], NR
		}
	' "$sorted"
}

configure_transport_probe() {
	transport_probe_backend="$(uci -q get "cake-autorate.$job_name.transport_probe_backend" 2>/dev/null || true)"
	transport_probe_endpoint="$(uci -q get "cake-autorate.$job_name.transport_probe_endpoint" 2>/dev/null || true)"
	transport_probe_configuration_error=""
	transport_probe_timeout_s="$(uci -q get "cake-autorate.$job_name.transport_probe_timeout_s" 2>/dev/null || true)"
	case "$transport_probe_timeout_s" in
		''|*[!0-9]*) transport_probe_timeout_s=5 ;;
	esac
	[ "$transport_probe_timeout_s" -ge 1 ] 2>/dev/null || transport_probe_timeout_s=5
	[ "$transport_probe_timeout_s" -le 30 ] 2>/dev/null || transport_probe_timeout_s=30

	case "$transport_probe_backend:$transport_probe_endpoint" in
		:) transport_probe_backend=websocket; transport_probe_endpoint=wss://ping-bufferbloat.libreqos.com/ws ;;
		websocket:ws://*|websocket:wss://*) ;;
		tcp:tcp://*)
			transport_probe_configuration_error="Full Auto-Tune requires persistent WebSocket or HTTPS transport evidence; TCP connect probes are diagnostic-only."
			return 1
			;;
		http:https://*) ;;
		legacy-http:http://*|legacy-http:https://*)
			transport_probe_configuration_error="Full Auto-Tune requires persistent WebSocket or HTTPS transport evidence; Legacy HTTP is diagnostic-only."
			return 1
			;;
		*)
			transport_probe_configuration_error="The configured transport probe backend and endpoint do not match."
			return 1
			;;
	esac
	case "$transport_probe_backend" in
		websocket) transport_probe_reported_backend=websocket ;;
		http) transport_probe_reported_backend=persistent-http ;;
		tcp) transport_probe_reported_backend=tcp-connect ;;
	esac
	return 0
}

run_transport_probe_cli() {
	count="$1"
	interval_ms="$2"
	set -- "$transport_probe_bin" --transport-probe \
		--backend "$transport_probe_backend" \
		--endpoint "$transport_probe_endpoint" \
		--device "$target_if" \
		--source-ip "$source_ip" \
		--count "$count" \
		--timeout "$transport_probe_timeout_s" \
		--interval-ms "$interval_ms"
	[ -n "${route_mark:-}" ] && set -- "$@" --fwmark "$route_mark"
	# Background monitors set this only inside their asynchronous subshell.  An
	# exec keeps $! attached to the native probe instead of an ash wrapper which
	# could be terminated while leaving its long-running child orphaned.
	[ "${transport_probe_exec:-0}" = 1 ] && exec "$@"
	"$@"
}

extract_transport_values() {
	input="$1"
	output="$2"
	awk '
		match($0, /"raw_ms":\[[^]]*\]/) {
			raw = substr($0, RSTART, RLENGTH)
			sub(/^"raw_ms":\[/, "", raw)
			sub(/\]$/, "", raw)
			n = split(raw, values, ",")
			for (i = 1; i <= n; i++)
				if (values[i] ~ /^[0-9]+([.][0-9]+)?$/)
					print values[i]
		}
	' "$input" > "$output"
}

validate_transport_evidence() {
	input="$1"
	output="$2"
	minimum_rows="$3"
	minimum_samples="$4"
	report="$output.report"
	transport_evidence_valid=false
	transport_evidence_reason=transport-output-invalid
	transport_evidence_rows=0
	transport_evidence_samples=0
	: > "$output"

	# TCP connect timings are useful diagnostics but do not have persistent
	# session semantics.  Full Auto-Tune compares loaded and idle application
	# latency, so a handshake-only backend is intentionally inconclusive.
	if [ "$transport_probe_reported_backend" = tcp-connect ]; then
		transport_evidence_reason=transport-backend-not-persistent
		return 1
	fi

	awk -v expected_backend="$transport_probe_reported_backend" \
	    -v expected_endpoint="$transport_probe_endpoint" '
		function string_field(line, key, pattern, value) {
			pattern = "\\\"" key "\\\":\\\"[^\\\"]*\\\""
			if (!match(line, pattern)) return ""
			value = substr(line, RSTART + length(key) + 4, RLENGTH - length(key) - 5)
			return value
		}
		NF {
			rows++
			backend = string_field($0, "backend")
			endpoint = string_field($0, "endpoint")
			if (backend != expected_backend) bad_backend++
			if (endpoint != expected_endpoint) bad_endpoint++
			if ($0 !~ /"trusted":true([,}])/) bad_trust++
			if ($0 ~ /"connection_reused":true([,}])/) reused++
			else if ($0 !~ /"connection_reused":false([,}])/) bad_reuse_field++
			else if (rows > 1) nonpersistent_after_warmup++
			if (match($0, /"raw_ms":\[[^]]*\]/)) {
				raw = substr($0, RSTART, RLENGTH)
				sub(/^"raw_ms":\[/, "", raw)
				sub(/\]$/, "", raw)
				n = split(raw, values, ",")
				for (i = 1; i <= n; i++) {
					gsub(/^[[:space:]]+|[[:space:]]+$/, "", values[i])
					if (values[i] ~ /^[0-9]+([.][0-9]+)?$/) {
						print "V " values[i]
						samples++
					} else if (values[i] != "") bad_sample++
				}
			} else bad_raw++
		}
		END {
			reason = "ok"
			if (rows < 1) reason = "transport-output-empty"
			else if (bad_backend) reason = "transport-backend-mismatch"
			else if (bad_endpoint) reason = "transport-endpoint-mismatch"
			else if (bad_trust) reason = "transport-untrusted"
			else if (bad_reuse_field || nonpersistent_after_warmup || reused < rows - 1)
				reason = "transport-not-persistent"
			else if (bad_raw || bad_sample) reason = "transport-samples-malformed"
			print "M " reason " " rows " " samples
		}
	' "$input" > "$report" 2>/dev/null || {
		rm -f "$report"
		return 1
	}
	awk '$1 == "V" { print $2 }' "$report" > "$output"
	set -- $(awk '$1 == "M" { print $2, $3, $4; exit }' "$report")
	rm -f "$report"
	transport_evidence_reason="${1:-transport-output-invalid}"
	transport_evidence_rows="${2:-0}"
	transport_evidence_samples="${3:-0}"
	[ "$transport_evidence_reason" = ok ] || return 1
	[ "$transport_evidence_rows" -ge "$minimum_rows" ] 2>/dev/null || {
		transport_evidence_reason=transport-too-few-probes
		return 1
	}
	[ "$transport_evidence_samples" -ge "$minimum_samples" ] 2>/dev/null || {
		transport_evidence_reason=transport-too-few-samples
		return 1
	}
	transport_evidence_valid=true
	return 0
}

baseline_transport_latency() {
	raw="$job_dir/transport-baseline.raw"
	values="$job_dir/transport-baseline.values"
	sorted="$job_dir/transport-baseline.sorted"
	errors="$job_dir/transport-baseline.errors"
	: > "$raw"
	if ! run_transport_probe_cli 5 250 > "$raw" 2> "$errors"; then
		[ -s "$raw" ] || return 1
	fi
	validate_transport_evidence "$raw" "$values" 5 15 || {
		printf '%s\n' "$transport_evidence_reason" > "$job_dir/transport-baseline.evidence-error"
		return 1
	}
	numeric_latency_stats "$values" "$sorted"
}

wait_for_baseline_retry() {
	case "$baseline_retry_backoff_s" in
		''|*[!0-9]*) baseline_retry_backoff_s=20 ;;
		*) [ "$baseline_retry_backoff_s" -le 60 ] 2>/dev/null || baseline_retry_backoff_s=20 ;;
	esac
	if [ "$baseline_retry_backoff_s" -gt 0 ] 2>/dev/null; then
		write_status quiet-check 19 "Waiting for ICMP policers and background traffic to settle before baseline retry"
		sleep "$baseline_retry_backoff_s"
	fi
}

capture_idle_baseline() {
	baseline_phase_attempt=1
	while [ "$baseline_phase_attempt" -le 2 ]; do
		write_status quiet-check 19 "Checking that the selected uplink is idle before baseline attempt $baseline_phase_attempt"
		measure_background_traffic
		baseline_pre_dl_kbps="${background_dl_kbps:-0}"
		baseline_pre_ul_kbps="${background_ul_kbps:-0}"
		baseline_pre_reference_deferred="${background_reference_deferred:-false}"
		baseline_prequiet=true
		[ "$background_blocked" = true ] && baseline_prequiet=false
		if [ "$baseline_prequiet" != true ] && [ "${conservative_mode:-0}" != 1 ]; then
			baseline_entry="{\"phase\":\"baseline\",\"attempt\":$baseline_phase_attempt,\"skipped\":true,\"prequiet\":false,\"postquiet\":false,\"icmp_valid\":false,\"transport_valid\":false,\"forwarded_background\":null}"
			if [ -n "${phase_background_runs_json:-}" ]; then
				phase_background_runs_json="$phase_background_runs_json,$baseline_entry"
			else
				phase_background_runs_json="$baseline_entry"
			fi
			phase_contamination_seen=true
			if [ "$baseline_phase_attempt" -lt 2 ]; then
				baseline_phase_attempt=$((baseline_phase_attempt + 1))
				continue
			fi
			stage_terminal_json error "{\"state\":\"background-blocked\",\"schema_version\":7,\"stage\":\"baseline\",\"error\":\"The uplink was busy before both idle baseline attempts. Retry when quiet or explicitly rerun with background-aware conservative safeguards.\",\"background_blocked\":true,\"retryable\":true,\"conservative_available\":true,\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":${phase_evidence_complete:-false},\"phase_contamination_seen\":true,\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"runs\":[${runs_json:-}],\"phase_background\":[$phase_background_runs_json],\"pinger_plan\":${pinger_plan:-null},\"configuration_written\":false}"
			exit 1
		fi

		write_status baseline 22 "Measuring clean idle latency baseline (attempt $baseline_phase_attempt)"
		phase_background_kind=baseline
		start_phase_background_counter "$(phase_reference_rate dl)" "$(phase_reference_rate ul)"
		baseline_valid=true
		candidate_baseline="$(baseline_latency "$reflectors")" || baseline_valid=false
		transport_baseline_valid=true
		candidate_transport_baseline="$(baseline_transport_latency)" || transport_baseline_valid=false
		stop_phase_background_counter

		write_status quiet-check 25 "Checking that the uplink stayed idle through baseline attempt $baseline_phase_attempt"
		measure_background_traffic
		baseline_post_dl_kbps="${background_dl_kbps:-0}"
		baseline_post_ul_kbps="${background_ul_kbps:-0}"
		baseline_post_reference_deferred="${background_reference_deferred:-false}"
		baseline_postquiet=true
		[ "$background_blocked" = true ] && baseline_postquiet=false
		baseline_traffic_contaminated="$phase_background_contaminated"
		[ "$baseline_prequiet" = true ] || baseline_traffic_contaminated=true
		[ "$baseline_postquiet" = true ] || baseline_traffic_contaminated=true
		baseline_contaminated="$baseline_traffic_contaminated"
		[ "$baseline_valid" = true ] || baseline_contaminated=true
		[ "$transport_baseline_valid" = true ] || baseline_contaminated=true
		baseline_entry="{\"phase\":\"baseline\",\"attempt\":$baseline_phase_attempt,\"prequiet\":$baseline_prequiet,\"postquiet\":$baseline_postquiet,\"icmp_valid\":$baseline_valid,\"transport_valid\":$transport_baseline_valid,\"total_interface_background\":{\"pre_download_kbps\":$baseline_pre_dl_kbps,\"pre_upload_kbps\":$baseline_pre_ul_kbps,\"post_download_kbps\":$baseline_post_dl_kbps,\"post_upload_kbps\":$baseline_post_ul_kbps,\"reference_deferred\":$([ "$baseline_pre_reference_deferred" = true ] || [ "$baseline_post_reference_deferred" = true ] && printf true || printf false)},\"forwarded_background\":$(phase_background_json)}"
		if [ -n "${phase_background_runs_json:-}" ]; then
			phase_background_runs_json="$phase_background_runs_json,$baseline_entry"
		else
			phase_background_runs_json="$baseline_entry"
		fi

		if [ "$baseline_valid" = true ] && [ "$transport_baseline_valid" = true ]; then
			set -- $candidate_baseline
			idle_median_ms="$1"
			idle_p95_ms="$2"
			baseline_samples="$3"
			set -- $candidate_transport_baseline
			transport_idle_median_ms="$1"
			transport_idle_p95_ms="$2"
			transport_idle_max_ms="$3"
			transport_idle_samples="$4"
			[ "$baseline_samples" -ge 9 ] 2>/dev/null || baseline_valid=false
			[ "$transport_idle_samples" -ge 15 ] 2>/dev/null || transport_baseline_valid=false
			if [ "$baseline_valid" = true ] && [ "$transport_baseline_valid" = true ] &&
			   { [ "$baseline_contaminated" != true ] ||
			     { [ "${conservative_mode:-0}" = 1 ] && [ "$phase_background_available" = true ]; }; }; then
				baseline_background_available="${phase_background_available:-false}"
				baseline_background_dl_kbps="${phase_background_dl_kbps:-0}"
				baseline_background_ul_kbps="${phase_background_ul_kbps:-0}"
				baseline_reference_deferred=false
				[ "${phase_background_reference_deferred:-false}" != true ] &&
					[ "$baseline_pre_reference_deferred" != true ] &&
					[ "$baseline_post_reference_deferred" != true ] || baseline_reference_deferred=true
				# BusyBox awk rejects the compact a>b?a:b form on some OpenWrt
				# builds.  Keep this deliberately verbose because empty maxima would
				# invalidate the deferred baseline evidence JSON.
				baseline_total_dl_kbps="$(awk -v a="$baseline_pre_dl_kbps" -v b="$baseline_post_dl_kbps" 'BEGIN { if (a + 0 > b + 0) print a + 0; else print b + 0 }')"
				baseline_total_ul_kbps="$(awk -v a="$baseline_pre_ul_kbps" -v b="$baseline_post_ul_kbps" 'BEGIN { if (a + 0 > b + 0) print a + 0; else print b + 0 }')"
				if [ "$baseline_contaminated" = true ]; then
					phase_contamination_seen=true
					unresolved_background_contamination=true
					baseline_quality_provisional=true
					download_background_unresolved=true
					upload_background_unresolved=true
				fi
				phase_background_kind=""
				return 0
			fi
			baseline_contaminated=true
		fi

		# A probe parser/rate-limit retry is measurement instability, not proof
		# of forwarded client traffic.  Preserve auto-apply eligibility when a
		# second baseline is fully clean; real pre/post/counter contamination
		# remains sticky and fail-closed.
		[ "$baseline_traffic_contaminated" = true ] && phase_contamination_seen=true
		if [ "$baseline_phase_attempt" -lt 2 ]; then
			wait_for_baseline_retry
			baseline_phase_attempt=$((baseline_phase_attempt + 1))
			continue
		fi
		if [ "$phase_background_available" != true ]; then
			fail "Forwarded-traffic evidence was unavailable for both idle baseline attempts; an idle p95 cannot be proven."
		fi
		if [ "$baseline_valid" != true ]; then
			phase_evidence_complete=false
			measurement_inconclusive baseline icmp-insufficient-per-reflector-baseline
		fi
		if [ "$transport_baseline_valid" != true ]; then
			phase_evidence_complete=false
			baseline_transport_reason="$(sed -n '1p' "$job_dir/transport-baseline.evidence-error" 2>/dev/null)"
			measurement_inconclusive baseline "${baseline_transport_reason:-transport-baseline-invalid}"
		fi
		fail "Background traffic contaminated both idle baseline attempts. Conservative mode cannot reuse a contaminated idle p95."
	done
	return 1
}

validate_deferred_baseline_capacity() {
	retrospective_dl_capacity="${1:-0}"
	retrospective_ul_capacity="${2:-0}"
	if [ "${baseline_reference_deferred:-false}" != true ] &&
	   [ "${prethroughput_background_reference_deferred:-false}" != true ]; then
		return 0
	fi
	is_positive_uint "$retrospective_dl_capacity" ||
		fail "Deferred baseline validation has no trusted download capacity."
	is_positive_uint "$retrospective_ul_capacity" ||
		fail "Deferred baseline validation has no trusted upload capacity."

	retrospective_total_dl_limit="$(strict_background_limit "$retrospective_dl_capacity" 0.05)"
	retrospective_total_ul_limit="$(strict_background_limit "$retrospective_ul_capacity" 0.05)"
	retrospective_forwarded_dl_limit="$(strict_background_limit "$retrospective_dl_capacity" 0.02)"
	retrospective_forwarded_ul_limit="$(strict_background_limit "$retrospective_ul_capacity" 0.02)"
	retrospective_pass=true
	background_rate_exceeds "${baseline_total_dl_kbps:-0}" "$retrospective_total_dl_limit" && retrospective_pass=false
	background_rate_exceeds "${baseline_total_ul_kbps:-0}" "$retrospective_total_ul_limit" && retrospective_pass=false
	background_rate_exceeds "${baseline_background_dl_kbps:-0}" "$retrospective_forwarded_dl_limit" && retrospective_pass=false
	background_rate_exceeds "${baseline_background_ul_kbps:-0}" "$retrospective_forwarded_ul_limit" && retrospective_pass=false
	background_rate_exceeds "${prethroughput_background_dl_kbps:-0}" "$retrospective_total_dl_limit" && retrospective_pass=false
	background_rate_exceeds "${prethroughput_background_ul_kbps:-0}" "$retrospective_total_ul_limit" && retrospective_pass=false
	retrospective_contaminated=true
	[ "$retrospective_pass" = true ] && retrospective_contaminated=false
	# The provisional baseline was sampled before a capacity reference existed,
	# so its shares were necessarily recorded as zero. Re-score every retained
	# total-interface and forwarded observation now that the routed control has
	# supplied real direction-specific capacities.
	retrospective_dl_share_percent="$(awk \
		-v a="${baseline_total_dl_kbps:-0}" \
		-v b="${baseline_background_dl_kbps:-0}" \
		-v c="${prethroughput_background_dl_kbps:-0}" \
		-v r="$retrospective_dl_capacity" 'BEGIN {
			m = a + 0; if (b + 0 > m) m = b + 0; if (c + 0 > m) m = c + 0
			p = m * 100 / r; if (p > 999) p = 999; printf "%.1f", p
		}')"
	retrospective_ul_share_percent="$(awk \
		-v a="${baseline_total_ul_kbps:-0}" \
		-v b="${baseline_background_ul_kbps:-0}" \
		-v c="${prethroughput_background_ul_kbps:-0}" \
		-v r="$retrospective_ul_capacity" 'BEGIN {
			m = a + 0; if (b + 0 > m) m = b + 0; if (c + 0 > m) m = c + 0
			p = m * 100 / r; if (p > 999) p = 999; printf "%.1f", p
		}')"
	if awk -v a="$retrospective_dl_share_percent" -v b="${observed_background_dl_max_share_percent:-0}" 'BEGIN { exit(a > b ? 0 : 1) }'; then
		observed_background_dl_max_share_percent="$retrospective_dl_share_percent"
	fi
	if awk -v a="$retrospective_ul_share_percent" -v b="${observed_background_ul_max_share_percent:-0}" 'BEGIN { exit(a > b ? 0 : 1) }'; then
		observed_background_ul_max_share_percent="$retrospective_ul_share_percent"
	fi

	retrospective_entry="{\"phase\":\"baseline-retrospective\",\"passed\":$retrospective_pass,\"measured_capacity\":{\"download_kbps\":$retrospective_dl_capacity,\"upload_kbps\":$retrospective_ul_capacity},\"total_interface_background\":{\"baseline_download_kbps\":${baseline_total_dl_kbps:-0},\"baseline_upload_kbps\":${baseline_total_ul_kbps:-0},\"prethroughput_download_kbps\":${prethroughput_background_dl_kbps:-0},\"prethroughput_upload_kbps\":${prethroughput_background_ul_kbps:-0},\"download_limit_kbps\":$retrospective_total_dl_limit,\"upload_limit_kbps\":$retrospective_total_ul_limit,\"download_share_percent\":$retrospective_dl_share_percent,\"upload_share_percent\":$retrospective_ul_share_percent},\"forwarded_background\":{\"available\":${baseline_background_available:-false},\"contaminated\":$retrospective_contaminated,\"reference_deferred\":false,\"download_kbps\":${baseline_background_dl_kbps:-0},\"upload_kbps\":${baseline_background_ul_kbps:-0},\"download_reference_kbps\":$retrospective_dl_capacity,\"upload_reference_kbps\":$retrospective_ul_capacity,\"download_reference_known\":true,\"upload_reference_known\":true,\"download_limit_kbps\":$retrospective_forwarded_dl_limit,\"upload_limit_kbps\":$retrospective_forwarded_ul_limit}}"
	if [ -n "${phase_background_runs_json:-}" ]; then
		phase_background_runs_json="$phase_background_runs_json,$retrospective_entry"
	else
		phase_background_runs_json="$retrospective_entry"
	fi

	dl_reference="$retrospective_dl_capacity"
	ul_reference="$retrospective_ul_capacity"
	background_dl_reference_known=true
	background_ul_reference_known=true
	background_reference_deferred=false
	background_dl_limit="$retrospective_total_dl_limit"
	background_ul_limit="$retrospective_total_ul_limit"
	background_dl_hard="$(strict_background_limit "$retrospective_dl_capacity" 0.35 5000)"
	background_ul_hard="$(strict_background_limit "$retrospective_ul_capacity" 0.35 5000)"
	if [ "$retrospective_pass" != true ] && [ "${conservative_mode:-0}" != 1 ]; then
		phase_contamination_seen=true
		stage_terminal_json error "{\"state\":\"background-blocked\",\"schema_version\":7,\"stage\":\"baseline-retrospective\",\"reason\":\"baseline-retrospectively-contaminated\",\"error\":\"The provisional idle baseline carried too much traffic relative to the measured link capacity. Retry when quieter or explicitly rerun with background-aware conservative safeguards.\",\"background_blocked\":true,\"retryable\":true,\"conservative_available\":true,\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":${phase_evidence_complete:-false},\"phase_contamination_seen\":true,\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"baseline_traffic\":$retrospective_entry,\"runs\":[${runs_json:-}],\"phase_background\":[$phase_background_runs_json],\"pinger_plan\":${pinger_plan:-null},\"configuration_written\":false}"
		exit 1
	fi
	if [ "$retrospective_pass" != true ]; then
		phase_contamination_seen=true
		unresolved_background_contamination=true
		baseline_quality_provisional=true
		download_background_unresolved=true
		upload_background_unresolved=true
	fi
	baseline_reference_deferred=false
	prethroughput_background_reference_deferred=false
}

start_transport_latency_monitor() {
	output="$1"
	errors="$2"
	: > "$output"
	transport_probe_exec=1 run_transport_probe_cli 100 1000 > "$output" 2> "$errors" &
	transport_pid="$!"
	transport_starttime="$(proc_starttime "$transport_pid" 2>/dev/null)"
	is_positive_uint "$transport_starttime" || {
		kill -KILL "$transport_pid" 2>/dev/null || true
		wait "$transport_pid" 2>/dev/null || true
		transport_pid=""
		return 1
	}
}

owned_monitor_gone() {
	monitor_pid="$1"
	monitor_start="$2"
	actual_monitor_start="$(proc_starttime "$monitor_pid" 2>/dev/null)" || return 0
	# A different start time proves that our child has already exited and its
	# PID was reused.  Treat that exactly like an absent process: it is unsafe
	# to signal the new owner, but there is no owned monitor left to terminate.
	[ "$actual_monitor_start" = "$monitor_start" ] || return 0
	case "$(proc_state "$monitor_pid" 2>/dev/null)" in ''|Z|z) return 0 ;; esac
	return 1
}

stop_owned_monitor() {
	monitor_pid="$1"
	monitor_start="$2"
	[ -n "$monitor_pid" ] || return 0
	is_positive_uint "$monitor_start" || return 1
	owned_monitor_gone "$monitor_pid" "$monitor_start" && {
		wait "$monitor_pid" 2>/dev/null || true
		return 0
	}
	# Marker-driven monitors can exit naturally between the gone check above
	# and this identity guard.  Absence or PID reuse is successful cleanup, not
	# a lifecycle failure.  Only signal the still-identical child.
	[ "$(proc_starttime "$monitor_pid" 2>/dev/null)" = "$monitor_start" ] || {
		wait "$monitor_pid" 2>/dev/null || true
		return 0
	}
	kill -TERM "$monitor_pid" 2>/dev/null || true
	monitor_wait=0
	while [ "$monitor_wait" -lt 3 ]; do
		owned_monitor_gone "$monitor_pid" "$monitor_start" && {
			wait "$monitor_pid" 2>/dev/null || true
			return 0
		}
		monitor_wait=$((monitor_wait + 1))
		sleep 1
	done
	[ "$(proc_starttime "$monitor_pid" 2>/dev/null)" = "$monitor_start" ] || {
		wait "$monitor_pid" 2>/dev/null || true
		return 0
	}
	kill -KILL "$monitor_pid" 2>/dev/null || true
	monitor_wait=0
	while [ "$monitor_wait" -lt 3 ]; do
		owned_monitor_gone "$monitor_pid" "$monitor_start" && {
			wait "$monitor_pid" 2>/dev/null || true
			return 0
		}
		monitor_wait=$((monitor_wait + 1))
		sleep 1
	done
	return 1

}

stop_transport_latency_monitor() {
	[ -n "${transport_pid:-}" ] || return 0
	stop_owned_monitor "$transport_pid" "${transport_starttime:-}" || return 1
	transport_pid=""
	transport_starttime=""
	return 0
}

icmp_latency_monitor() {
	output="$1"
	marker="$2"
	while [ -e "$marker" ]; do
		case $- in *f*) monitor_had_noglob=1 ;; *) monitor_had_noglob=0; set -f ;; esac
		# fping accepts --; every following token has also passed
		# valid_reflector, preventing target text from becoming an option.
		set -- $reflectors
		[ "$monitor_had_noglob" = 1 ] || set +f
		route_exec "$fping_bin" -I "$target_if" -D -c 1 -p 1000 -- "$@" >> "$output" 2>&1 || true
		[ -e "$marker" ] && sleep 1
	done
}

latency_stats() {
	input="$1"
	values="$job_dir/loaded.values"
	sorted="$job_dir/loaded.sorted"
	awk '
		{
			for (i = 2; i <= NF; i++)
				if ($i == "ms" && $(i - 1) ~ /^[0-9]+([.][0-9]+)?$/)
					print $(i - 1)
		}
	' "$input" > "$values"
	[ -s "$values" ] || return 1
	sort -n "$values" > "$sorted"
	awk '
		{ value[NR] = $1 }
		END {
			if (NR < 1) exit 1
			if (NR % 2) median = value[(NR + 1) / 2]
			else median = (value[NR / 2] + value[NR / 2 + 1]) / 2
			p95_index = int((NR * 95 + 99) / 100)
			printf "%.3f %.3f %.3f %d", median, value[p95_index], value[NR], NR
		}
	' "$sorted"
}

build_icmp_evidence() {
	icmp_build_input="$1"
	icmp_build_expected="$2"
	icmp_build_output="$3"
	icmp_build_format="$4"
	icmp_build_minimum_attempts="$5"
	icmp_build_minimum_successes="$6"
	awk -v expected="$icmp_build_expected" -v format="$icmp_build_format" \
	    -v minimum_attempts="$icmp_build_minimum_attempts" -v minimum_successes="$icmp_build_minimum_successes" '
		function remember(host, value) {
			success[host]++
			values[host SUBSEP success[host]] = value + 0
		}
		format == "baseline" {
			# fping right-aligns the separator, so short IPv4 addresses have
			# several spaces before the colon.  Match the whitespace-delimited
			# separator rather than the exact three-byte string " : ".
			if (!match($0, /[[:space:]]+:[[:space:]]+/)) next
			host = substr($0, 1, RSTART - 1)
			gsub(/[[:space:]]+$/, "", host)
			rest = substr($0, RSTART + RLENGTH)
			n = split(rest, fields, /[[:space:]]+/)
			for (i = 1; i <= n; i++) {
				if (fields[i] == "-") attempts[host]++
				else if (fields[i] ~ /^[0-9]+([.][0-9]+)?$/) {
					attempts[host]++
					remember(host, fields[i])
				}
			}
			next
		}
		format == "loaded" {
			host = $2
			if (host == "") next
			if (index($0, "timed out")) {
				attempts[host]++
				next
			}
			if (index($0, " bytes,") && index($0, " ms")) {
				attempts[host]++
				for (i = 2; i <= NF; i++)
					if ($i == "ms" && $(i - 1) ~ /^[0-9]+([.][0-9]+)?$/) {
						remember(host, $(i - 1))
						break
					}
			}
		}
		END {
			nhosts = split(expected, hosts, /[[:space:]]+/)
			if (nhosts < 3) invalid = 1
			for (h = 1; h <= nhosts; h++) {
				host = hosts[h]
				if (host == "") { invalid = 1; continue }
				if (attempts[host] < minimum_attempts || success[host] < minimum_successes) invalid = 1
				for (i = 1; i <= success[host]; i++) sorted[i] = values[host SUBSEP i]
				for (i = 1; i <= success[host]; i++)
					for (j = i + 1; j <= success[host]; j++)
						if (sorted[j] < sorted[i]) { tmp = sorted[i]; sorted[i] = sorted[j]; sorted[j] = tmp }
				p95index = int((success[host] * 95 + 99) / 100)
				if (p95index < 1) p95index = 1
				p95 = success[host] ? sorted[p95index] : 0
				loss = attempts[host] ? 100 * (attempts[host] - success[host]) / attempts[host] : 100
				printf "%s\t%d\t%d\t%.2f\t%.3f\n", host, attempts[host], success[host], loss, p95
				for (i = 1; i <= success[host]; i++) delete sorted[i]
			}
			exit(invalid ? 1 : 0)
		}
	' "$icmp_build_input" > "$icmp_build_output"
}

classify_loaded_icmp_evidence() {
	loaded_stats="$1"
	baseline_stats="$2"
	classification="$(awk '
		FNR == NR { baseline[$1] = $5; next }
		{
			n++
			host[n] = $1
			loss[n] = $4 + 0
			delta[n] = $5 - baseline[$1]
			if (delta[n] < 0) delta[n] = 0
		}
		END {
			if (n < 3) { print "incomplete|fewer-than-three-reflector-families"; exit }
			for (i = 1; i <= n; i++) {
				sorted_loss[i] = loss[i]
				sorted_delta[i] = delta[i]
			}
			for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) {
				if (sorted_loss[j] < sorted_loss[i]) { tmp=sorted_loss[i]; sorted_loss[i]=sorted_loss[j]; sorted_loss[j]=tmp }
				if (sorted_delta[j] < sorted_delta[i]) { tmp=sorted_delta[i]; sorted_delta[i]=sorted_delta[j]; sorted_delta[j]=tmp }
			}
			max_loss = sorted_loss[n]
			second_loss = sorted_loss[n - 1]
			if (max_loss >= 20 && second_loss <= 5) {
				for (i = 1; i <= n; i++) if (loss[i] == max_loss) { print "rate-limit|" host[i]; exit }
			}
			median_delta = sorted_delta[int((n + 1) / 2)]
			spread_limit = median_delta * 3 + 10
			if (spread_limit < 30) spread_limit = 30
			if (sorted_delta[n] - sorted_delta[1] > spread_limit) {
				print "disagreement|reflector-family-p95-disagreement"
				exit
			}
			print "ok|ok"
		}
	' "$baseline_stats" "$loaded_stats" 2>/dev/null)"
	icmp_evidence_class="${classification%%|*}"
	icmp_evidence_detail="${classification#*|}"
	[ "$icmp_evidence_class" = ok ]
}

packet_loss_percent() {
	input="$1"
	probe_loss="$(awk '
		index($0, "timed out") {
			host = $2; sent[host]++; next
		}
		index($0, " bytes,") && index($0, " ms") {
			host = $2; sent[host]++; received[host]++
		}
		END {
			for (host in sent) {
				if (host == "") continue
				n++
				loss[n] = 100 * (sent[host] - received[host]) / sent[host]
			}
			if (n < 1) exit 1
			for (i = 1; i <= n; i++)
				for (j = i + 1; j <= n; j++)
					if (loss[j] < loss[i]) {
						tmp = loss[i]; loss[i] = loss[j]; loss[j] = tmp
					}
			if (n % 2) median = loss[(n + 1) / 2]
			else median = (loss[n / 2] + loss[n / 2 + 1]) / 2
			printf "%.2f\n", median
		}
	' "$input" 2>/dev/null)" || probe_loss=""
	if [ -n "$probe_loss" ]; then
		printf '%s\n' "$probe_loss"
		return 0
	fi

	# Some fping variants only expose per-host summaries.  Use their median so
	# one public reflector's ICMP rate limiting does not masquerade as link loss.
	sed -n 's/.*%loss = [0-9][0-9]*\/[0-9][0-9]*\/\([0-9.][0-9.]*\)%.*/\1/p' "$input" |
		sort -n |
	awk '
		{ value[NR] = $1 }
		END {
			if (NR < 1) exit 1
			if (NR % 2) median = value[(NR + 1) / 2]
			else median = (value[NR / 2] + value[NR / 2 + 1]) / 2
			printf "%.2f\n", median
		}
	'
}

typed_json_fragment() {
	typed_json="$1"
	typed_field="$2"
	case "$typed_field" in
		metrics) printf '%s\n' "$typed_json" | sed -n 's/^.*"metrics":\(.*\),"signals":.*$/\1/p' ;;
		signals) printf '%s\n' "$typed_json" | sed -n 's/^.*"signals":\(.*\),"gates":.*$/\1/p' ;;
		gates) printf '%s\n' "$typed_json" | sed -n 's/^.*"gates":\(\[.*\]\),"reasons":.*$/\1/p' ;;
		reasons) printf '%s\n' "$typed_json" | sed -n 's/^.*"reasons":\(\[.*\]\),"warnings":.*$/\1/p' ;;
		warnings) printf '%s\n' "$typed_json" | sed -n 's/^.*"warnings":\(\[.*\]\),"correction":.*$/\1/p' ;;
		correction) printf '%s\n' "$typed_json" | sed -n 's/^.*"correction":\(.*\)}$/\1/p' ;;
		*) return 1 ;;
	esac
}

scale_for_reference_base() {
	desired_kbps="$1"
	reference_kbps="$2"
	awk -v desired="$desired_kbps" -v reference="$reference_kbps" 'BEGIN {
		if (desired <= 0 || reference <= 0) exit 1
		printf "%.9f", desired / reference
	}'
}

extract_json() {
	json="$1"
	expression="$2"
	[ -n "$jsonfilter_bin" ] || return 1
	printf '%s\n' "$json" | "$jsonfilter_bin" -e "$expression" 2>/dev/null
}

proposal_json_valid() {
	proposal_candidate="$1"
	[ -n "$proposal_candidate" ] || return 1
	strict_single_json_object "$proposal_candidate" || return 1
	proposal_schema="$(extract_json "$proposal_candidate" '@.schema_version')" || return 1
	proposal_profile="$(extract_json "$proposal_candidate" '@.profile')" || return 1
	proposal_target_grade="$(extract_json "$proposal_candidate" '@.target_grade')" || return 1
	proposal_quality_required="$(extract_json "$proposal_candidate" '@.quality_target_required')" || return 1
	proposal_throughput_priority="$(extract_json "$proposal_candidate" '@.throughput_priority')" || return 1
	[ "$proposal_schema" = 3 ] && [ "$proposal_profile" = "$autotune_profile" ] || return 1

	proposal_dl_min="$(extract_json "$proposal_candidate" '@.download.minimum_kbps')" || return 1
	proposal_dl_base="$(extract_json "$proposal_candidate" '@.download.base_kbps')" || return 1
	proposal_dl_max="$(extract_json "$proposal_candidate" '@.download.maximum_kbps')" || return 1
	proposal_dl_cap="$(extract_json "$proposal_candidate" '@.download.absolute_cap_kbps')" || return 1
	proposal_dl_low="$(extract_json "$proposal_candidate" '@.download.observed_low_kbps')" || return 1
	proposal_dl_median="$(extract_json "$proposal_candidate" '@.download.observed_median_kbps')" || return 1
	proposal_dl_high="$(extract_json "$proposal_candidate" '@.download.observed_high_kbps')" || return 1
	proposal_ul_min="$(extract_json "$proposal_candidate" '@.upload.minimum_kbps')" || return 1
	proposal_ul_base="$(extract_json "$proposal_candidate" '@.upload.base_kbps')" || return 1
	proposal_ul_max="$(extract_json "$proposal_candidate" '@.upload.maximum_kbps')" || return 1
	proposal_ul_cap="$(extract_json "$proposal_candidate" '@.upload.absolute_cap_kbps')" || return 1
	proposal_ul_low="$(extract_json "$proposal_candidate" '@.upload.observed_low_kbps')" || return 1
	proposal_ul_median="$(extract_json "$proposal_candidate" '@.upload.observed_median_kbps')" || return 1
	proposal_ul_high="$(extract_json "$proposal_candidate" '@.upload.observed_high_kbps')" || return 1
	for proposal_rate in \
		"$proposal_dl_min" "$proposal_dl_base" "$proposal_dl_max" "$proposal_dl_cap" \
		"$proposal_dl_low" "$proposal_dl_median" "$proposal_dl_high" \
		"$proposal_ul_min" "$proposal_ul_base" "$proposal_ul_max" "$proposal_ul_cap" \
		"$proposal_ul_low" "$proposal_ul_median" "$proposal_ul_high"; do
		is_uint_between "$proposal_rate" 100 100000000 || return 1
	done
	[ "$proposal_dl_min" -le "$proposal_dl_base" ] &&
		[ "$proposal_dl_base" -le "$proposal_dl_max" ] &&
		[ "$proposal_dl_max" -le "$proposal_dl_cap" ] &&
		[ "$proposal_dl_low" -le "$proposal_dl_median" ] &&
		[ "$proposal_dl_median" -le "$proposal_dl_high" ] || return 1
	[ "$proposal_ul_min" -le "$proposal_ul_base" ] &&
		[ "$proposal_ul_base" -le "$proposal_ul_max" ] &&
		[ "$proposal_ul_max" -le "$proposal_ul_cap" ] &&
		[ "$proposal_ul_low" -le "$proposal_ul_median" ] &&
		[ "$proposal_ul_median" -le "$proposal_ul_high" ] || return 1

	proposal_active="$(extract_json "$proposal_candidate" '@.active_threshold_kbps')" || return 1
	proposal_adjust_up="$(extract_json "$proposal_candidate" '@.thresholds_ms.adjust_up')" || return 1
	proposal_delay="$(extract_json "$proposal_candidate" '@.thresholds_ms.delay')" || return 1
	proposal_adjust_down="$(extract_json "$proposal_candidate" '@.thresholds_ms.adjust_down')" || return 1
	is_uint_between "$proposal_active" 1 20000 || return 1
	[ "$proposal_active" -le "$proposal_dl_min" ] &&
		[ "$proposal_active" -le "$proposal_ul_min" ] || return 1
	is_uint_between "$proposal_adjust_up" 1 200 || return 1
	is_uint_between "$proposal_delay" 1 1000 || return 1
	is_uint_between "$proposal_adjust_down" 1 5000 || return 1
	[ "$proposal_adjust_up" -le "$proposal_delay" ] &&
		[ "$proposal_delay" -le "$proposal_adjust_down" ] || return 1

	proposal_adaptive_enabled="$(extract_json "$proposal_candidate" '@.adaptive_ceiling.enabled')" || return 1
	proposal_adaptive_hold="$(extract_json "$proposal_candidate" '@.adaptive_ceiling.hold_s')" || return 1
	proposal_adaptive_growth="$(extract_json "$proposal_candidate" '@.adaptive_ceiling.growth_percent')" || return 1
	proposal_adaptive_probe="$(extract_json "$proposal_candidate" '@.adaptive_ceiling.probe_s')" || return 1
	proposal_adaptive_cooldown="$(extract_json "$proposal_candidate" '@.adaptive_ceiling.cooldown_s')" || return 1
	proposal_adaptive_ttl="$(extract_json "$proposal_candidate" '@.adaptive_ceiling.failed_bound_ttl_s')" || return 1
	case "$proposal_adaptive_enabled" in true|false) ;; *) return 1 ;; esac
	is_uint_between "$proposal_adaptive_hold" 1 86400 || return 1
	is_decimal_between "$proposal_adaptive_growth" 0.1 10 || return 1
	is_uint_between "$proposal_adaptive_probe" 1 3600 || return 1
	is_uint_between "$proposal_adaptive_cooldown" 0 86400 || return 1
	is_uint_between "$proposal_adaptive_ttl" 1 604800 || return 1

	proposal_validation_realization_min="$(extract_json "$proposal_candidate" '@.validation.candidate_realization_min_percent')" || return 1
	proposal_validation_realization_max="$(extract_json "$proposal_candidate" '@.validation.candidate_realization_max_percent')" || return 1
	proposal_validation_retention="$(extract_json "$proposal_candidate" '@.validation.capacity_retention_min_percent')" || return 1
	proposal_validation_icmp="$(extract_json "$proposal_candidate" '@.validation.icmp_delta_max_ms')" || return 1
	proposal_validation_transport="$(extract_json "$proposal_candidate" '@.validation.transport_delta_max_ms')" || return 1
	proposal_validation_loss="$(extract_json "$proposal_candidate" '@.validation.loss_max_percent')" || return 1
	proposal_validation_cpu="$(extract_json "$proposal_candidate" '@.validation.cpu_max_percent')" || return 1
	numbers_equal "$proposal_validation_realization_min" 80 || return 1
	numbers_equal "$proposal_validation_realization_max" 110 || return 1
	numbers_equal "$proposal_validation_cpu" 85 || return 1

	proposal_sqm_qdisc="$(extract_json "$proposal_candidate" '@.sqm.qdisc')" || return 1
	proposal_sqm_script="$(extract_json "$proposal_candidate" '@.sqm.script')" || return 1
	proposal_sqm_classification="$(extract_json "$proposal_candidate" '@.sqm.classification')" || return 1
	proposal_sqm_squash_dscp="$(extract_json "$proposal_candidate" '@.sqm.squash_dscp')" || return 1
	proposal_sqm_squash_ingress="$(extract_json "$proposal_candidate" '@.sqm.squash_ingress')" || return 1
	proposal_sqm_ingress_ecn="$(extract_json "$proposal_candidate" '@.sqm.ingress_ecn')" || return 1
	proposal_sqm_egress_ecn="$(extract_json "$proposal_candidate" '@.sqm.egress_ecn')" || return 1
	proposal_sqm_iqdisc_opts="$(extract_json "$proposal_candidate" '@.sqm.iqdisc_opts')" || return 1
	proposal_sqm_eqdisc_opts="$(extract_json "$proposal_candidate" '@.sqm.eqdisc_opts')" || return 1
	[ "$proposal_sqm_qdisc" = cake ] &&
		[ "$proposal_sqm_ingress_ecn" = ECN ] &&
		[ "$proposal_sqm_egress_ecn" = NOECN ] || return 1

	case "$autotune_profile" in
		gaming|gaming_extreme)
			[ "$proposal_target_grade" = A+ ] &&
				[ "$proposal_quality_required" = true ] &&
				[ "$proposal_throughput_priority" = false ] &&
				numbers_equal "$proposal_validation_retention" 70 &&
				numbers_equal "$proposal_validation_icmp" 5 &&
				numbers_equal "$proposal_validation_transport" 5 &&
				numbers_equal "$proposal_validation_loss" 1 &&
				[ "$proposal_sqm_script" = layer_cake.qos ] &&
				[ "$proposal_sqm_classification" = diffserv4 ] &&
				[ "$proposal_sqm_squash_dscp" = false ] &&
				[ "$proposal_sqm_squash_ingress" = false ] &&
				[ "$proposal_sqm_iqdisc_opts" = diffserv4 ] &&
				[ "$proposal_sqm_eqdisc_opts" = diffserv4 ] || return 1
			;;
		best_overall)
			[ "$proposal_target_grade" = A ] &&
				[ "$proposal_quality_required" = true ] &&
				[ "$proposal_throughput_priority" = false ] &&
				numbers_equal "$proposal_validation_retention" 80 &&
				numbers_equal "$proposal_validation_icmp" 30 &&
				numbers_equal "$proposal_validation_transport" 30 &&
				numbers_equal "$proposal_validation_loss" 3 || return 1
			;;
		variable_link)
			[ "$proposal_target_grade" = B ] &&
				[ "$proposal_quality_required" = true ] &&
				[ "$proposal_throughput_priority" = false ] &&
				numbers_equal "$proposal_validation_retention" 70 &&
				numbers_equal "$proposal_validation_icmp" 60 &&
				numbers_equal "$proposal_validation_transport" 60 &&
				numbers_equal "$proposal_validation_loss" 3 || return 1
			;;
		fair)
			[ "$proposal_target_grade" = C ] &&
				[ "$proposal_quality_required" = false ] &&
				[ "$proposal_throughput_priority" = true ] &&
				numbers_equal "$proposal_validation_retention" 90 &&
				numbers_equal "$proposal_validation_icmp" 200 &&
				numbers_equal "$proposal_validation_transport" 200 &&
				numbers_equal "$proposal_validation_loss" 5 || return 1
			;;
		*) return 1 ;;
	esac
	case "$autotune_profile" in
		best_overall|variable_link|fair)
			[ "$proposal_sqm_script" = layer_cake.qos ] &&
				[ "$proposal_sqm_classification" = diffserv4 ] &&
				[ "$proposal_sqm_squash_dscp" = true ] &&
				[ "$proposal_sqm_squash_ingress" = true ] &&
				[ "$proposal_sqm_iqdisc_opts" = besteffort ] &&
				[ "$proposal_sqm_eqdisc_opts" = diffserv4 ] || return 1
			;;
	esac

	proposal_link_layer="$(extract_json "$proposal_candidate" '@.link.layer')" || return 1
	proposal_link_overhead="$(extract_json "$proposal_candidate" '@.link.overhead')" || return 1
	proposal_link_mpu="$(extract_json "$proposal_candidate" '@.link.mpu')" || return 1
	case "$proposal_link_layer" in none|ethernet|atm) ;; *) return 1 ;; esac
	is_uint_between "$proposal_link_overhead" 0 1500 || return 1
	is_uint_between "$proposal_link_mpu" 0 65535 || return 1
	return 0
}

process_group_contains_session() {
	group_id="$1"
	for proc_dir in /proc/[0-9]*; do
		[ -r "$proc_dir/stat" ] || continue
		member_pid="${proc_dir#/proc/}"
		case "$(proc_state "$member_pid" 2>/dev/null)" in
			''|Z|z) continue ;;
		esac
		[ "$(proc_group "$member_pid")" = "$group_id" ] || continue
		[ "$(proc_session "$member_pid")" = "$group_id" ] || continue
		return 0
	done
	return 1
}

speedtest_identity_matches() {
	local candidate_pid="$1" expected_starttime="$2"
	local identity_start_before identity_start_after identity_state_after argv_match=1

	# Return 0 for the exact live helper, 1 for a live process whose immutable
	# argv no longer matches, and 2 when the original process has normally
	# exited, become a zombie, or otherwise disappeared while /proc was being
	# sampled.  The distinct terminal-transition result prevents an ordinary
	# helper exit between the start-time and cmdline reads from being reported
	# as a hostile PID/argv replacement.
	identity_start_before="$(proc_starttime "$candidate_pid" 2>/dev/null)"
	[ "$identity_start_before" = "$expected_starttime" ] || return 2
	proc_cmdline_has_arg "$candidate_pid" "$speedtest_bin" || argv_match=0
	proc_cmdline_has_arg "$candidate_pid" "$job_name" || argv_match=0
	proc_cmdline_has_arg "$candidate_pid" "$target_if" || argv_match=0
	identity_start_after="$(proc_starttime "$candidate_pid" 2>/dev/null)"
	identity_state_after="$(proc_state "$candidate_pid" 2>/dev/null)"
	[ "$identity_start_after" = "$expected_starttime" ] || return 2
	case "$identity_state_after" in ''|Z|z) return 2 ;; esac
	[ "$argv_match" = 1 ] || return 1
	return 0
}

signal_test_group_until_gone() {
	group_id="$1"
	group_starttime="$2"
	process_group_contains_session "$group_id" || return 0
	if [ -d "/proc/$group_id" ]; then
		[ "$(proc_starttime "$group_id" 2>/dev/null)" = "$group_starttime" ] || return 1
		case "$(proc_state "$group_id" 2>/dev/null)" in
			Z|z) ;;
			*) speedtest_identity_matches "$group_id" "$group_starttime" || return 1 ;;
		esac
	fi
	kill -TERM -- "-$group_id" >/dev/null 2>&1 || kill -TERM "-$group_id" >/dev/null 2>&1 || true
	grace_second=0
	while [ "$grace_second" -lt "$test_termination_grace_s" ]; do
		process_group_contains_session "$group_id" || return 0
		if [ -d "/proc/$group_id" ]; then
			[ "$(proc_starttime "$group_id" 2>/dev/null)" = "$group_starttime" ] || return 1
			case "$(proc_state "$group_id" 2>/dev/null)" in
				Z|z) ;;
				*) speedtest_identity_matches "$group_id" "$group_starttime" || return 1 ;;
			esac
		fi
		grace_second=$((grace_second + 1))
		sleep 1
	done
	if [ -d "/proc/$group_id" ]; then
		[ "$(proc_starttime "$group_id" 2>/dev/null)" = "$group_starttime" ] || return 1
		case "$(proc_state "$group_id" 2>/dev/null)" in
			Z|z) ;;
			*) speedtest_identity_matches "$group_id" "$group_starttime" || return 1 ;;
		esac
	fi
	kill -KILL -- "-$group_id" >/dev/null 2>&1 || kill -KILL "-$group_id" >/dev/null 2>&1 || true
	grace_second=0
	while [ "$grace_second" -lt 3 ]; do
		process_group_contains_session "$group_id" || return 0
		grace_second=$((grace_second + 1))
		sleep 1
	done
	return 1
}

clear_active_test_journal() {
	old_active_test_pgid="${recovery_active_test_pgid:-}"
	old_active_test_starttime="${recovery_active_test_starttime:-}"
	recovery_active_test_pgid=""
	recovery_active_test_starttime=""
	if ! write_recovery_journal; then
		recovery_active_test_pgid="$old_active_test_pgid"
		recovery_active_test_starttime="$old_active_test_starttime"
		return 1
	fi
	return 0
}

speedtest_supervisor_fail() {
	speedtest_supervisor_reason="$1"
	speedtest_supervisor_rc="${2:-1}"
	return "$speedtest_supervisor_rc"
}

capture_speedtest_helper_error() {
	speedtest_supervisor_detail=""
	owned_regular_file "$test_output" || return 0
	helper_error_size="$(wc -c < "$test_output" 2>/dev/null)"
	case "$helper_error_size" in ''|*[!0-9]*) return 0 ;; esac
	[ "$helper_error_size" -ge 2 ] && [ "$helper_error_size" -le 262144 ] || return 0
	helper_error_payload="$(cat "$test_output" 2>/dev/null)" || return 0
	strict_single_json_object "$helper_error_payload" || return 0
	helper_error_detail="$(extract_json "$helper_error_payload" '@.error' 2>/dev/null | sed -n '1p')"
	[ -n "$helper_error_detail" ] || return 0
	[ "${#helper_error_detail}" -le 1024 ] 2>/dev/null || return 0
	speedtest_supervisor_detail="$helper_error_detail"
}

interface_total_bytes() {
	budget_interface="$1"
	budget_rx="$(sed -n '1p' "$sys_class_net/$budget_interface/statistics/rx_bytes" 2>/dev/null)"
	budget_tx="$(sed -n '1p' "$sys_class_net/$budget_interface/statistics/tx_bytes" 2>/dev/null)"
	case "$budget_rx:$budget_tx" in *[!0-9:]*) return 1 ;; esac
	uint53_add "$budget_rx" "$budget_tx"
}

traffic_budget_consumed_bytes() {
	uint53_is_positive "${traffic_budget_bytes:-0}" || {
		printf '%s\n' 0
		return 0
	}
	current_budget_bytes="$(interface_total_bytes "$target_if")" || return 1
	uint53_subtract "$current_budget_bytes" "${traffic_budget_start_bytes:-0}"
}

finalize_speedtest_result() {
	final_destination="$1"
	final_test_rc="$2"
	final_timed_out="$3"
	final_budget_exhausted="${4:-0}"
	final_budget_counter_invalid="${5:-0}"

	# The helper leader may be reaped just before its final child disappears.
	# Give that already-terminating group the same small bounded grace used for
	# supervised termination. Never signal it here: a genuinely persistent
	# descendant remains journalled and is rejected below.
	final_drain_attempt=0
	while process_group_contains_session "$test_pid" &&
	      [ "$final_drain_attempt" -lt "$test_termination_grace_s" ]; do
		final_drain_attempt=$((final_drain_attempt + 1))
		sleep 1
	done
	if process_group_contains_session "$test_pid"; then
		speedtest_supervisor_fail descendant-remained 1
		return
	fi
	if ! clear_active_test_journal; then
		speedtest_supervisor_fail journal-clear 1
		return
	fi
	if [ "$final_timed_out" = 1 ]; then
		speedtest_supervisor_fail timeout 124
		return
	fi
	if [ "$final_budget_exhausted" = 1 ]; then
		speedtest_supervisor_fail traffic-budget-exhausted 125
		return
	fi
	if [ "$final_budget_counter_invalid" = 1 ]; then
		speedtest_supervisor_fail traffic-budget-counter-invalid 1
		return
	fi
	if [ "$final_test_rc" -ne 0 ] 2>/dev/null; then
		capture_speedtest_helper_error
		speedtest_supervisor_fail "helper-exit:$final_test_rc" "$final_test_rc"
		return
	fi
	if ! owned_regular_file "$test_output"; then
		speedtest_supervisor_fail result-unsafe 1
		return
	fi
	final_size="$(wc -c < "$test_output" 2>/dev/null)"
	case "$final_size" in
		''|*[!0-9]*)
			speedtest_supervisor_fail result-size-unavailable 1
			return
			;;
	esac
	if [ "$final_size" -lt 2 ] || [ "$final_size" -gt 262144 ]; then
		speedtest_supervisor_fail result-size-invalid 1
		return
	fi
	final_payload="$(cat "$test_output" 2>/dev/null)" || {
		speedtest_supervisor_fail result-read 1
		return
	}
	if ! strict_single_json_object "$final_payload"; then
		speedtest_supervisor_fail result-malformed 1
		return
	fi
	[ ! -L "$final_destination" ] || {
		speedtest_supervisor_fail destination-unsafe 1
		return
	}
	rm -f "$final_destination"
	if ! mv "$test_output" "$final_destination" || ! owned_regular_file "$final_destination"; then
		speedtest_supervisor_fail result-publish 1
		return
	fi
	speedtest_supervisor_reason=ok
	speedtest_supervisor_rc=0
	return 0
}

run_speedtest_with_timeout() {
	# Keep every speedtest-go phase on the server selected by the first
	# unshaped sample.  The helper's automatic validation may otherwise pick a
	# different server under a deliberately shaped low-rate validation run,
	# making the throughput and latency comparison invalid.
	speedtest_destination="$1"
	shift
	speedtest_supervisor_reason=precondition
	speedtest_supervisor_rc=1
	speedtest_supervisor_detail=""
	speedtest_supervisor_elapsed_s=0
	[ "${recovery_prepared:-0}" = 1 ] && [ "${recovery_armed:-0}" = 1 ] &&
		[ -f "$recovery_journal" ] && [ -e "$recovery_heartbeat" ] || {
			speedtest_supervisor_fail recovery-not-armed 1
			return
		}
	setsid_bin="$(command -v setsid 2>/dev/null)"
	[ -n "$setsid_bin" ] || {
		speedtest_supervisor_fail setsid-unavailable 1
		return
	}
	test_timeout_s="${CAKE_AUTORATE_AUTOTUNE_SPEEDTEST_TIMEOUT_S:-90}"
	test_termination_grace_s="${CAKE_AUTORATE_AUTOTUNE_SPEEDTEST_TERM_GRACE_S:-3}"
	case "$test_timeout_s" in ''|*[!0-9]*) test_timeout_s=90 ;; esac
	case "$test_termination_grace_s" in ''|*[!0-9]*) test_termination_grace_s=3 ;; esac
	[ "$test_timeout_s" -ge 1 ] 2>/dev/null || test_timeout_s=90
	[ "$test_timeout_s" -le 300 ] 2>/dev/null || test_timeout_s=300
	[ "$test_termination_grace_s" -ge 1 ] 2>/dev/null || test_termination_grace_s=3
	[ "$test_termination_grace_s" -le 10 ] 2>/dev/null || test_termination_grace_s=10
	test_output="$job_dir/speedtest-phase.raw"
	test_progress="$job_dir/speedtest-phase.progress"
	rm -f "$test_output" "$test_progress" "$speedtest_destination"
	launch_parent_group="$(proc_group "$$" 2>/dev/null)"
	launch_parent_session="$(proc_session "$$" 2>/dev/null)"
	if [ "$backend" = "speedtest-go" ] && is_positive_uint "${selected_server_id:-}"; then
		CAKE_AUTORATE_SPEEDTEST_GO_SERVER_ID="$selected_server_id" \
		CAKE_AUTORATE_SPEEDTEST_GO_EXCLUDE_SERVER_ID="${speedtest_excluded_server_id:-}" \
		CAKE_AUTORATE_SPEEDTEST_PROGRESS_FILE="$test_progress" \
		CAKE_AUTORATE_SPEEDTEST_BYPASS_SCOPE="${speedtest_bypass_scope:-full}" \
		CAKE_AUTORATE_SPEEDTEST_START_STOPPED=1 CAKE_AUTORATE_SPEEDTEST_SETSID="$setsid_bin" \
			"$speedtest_bin" "$@" > "$test_output" &
	else
		CAKE_AUTORATE_SPEEDTEST_GO_EXCLUDE_SERVER_ID="${speedtest_excluded_server_id:-}" \
		CAKE_AUTORATE_SPEEDTEST_PROGRESS_FILE="$test_progress" \
		CAKE_AUTORATE_SPEEDTEST_BYPASS_SCOPE="${speedtest_bypass_scope:-full}" \
		CAKE_AUTORATE_SPEEDTEST_START_STOPPED=1 CAKE_AUTORATE_SPEEDTEST_SETSID="$setsid_bin" \
			"$speedtest_bin" "$@" > "$test_output" &
	fi
	test_pid="$!"
	test_starttime="$(proc_starttime "$test_pid" 2>/dev/null)"
	is_positive_uint "$test_starttime" || {
		kill -KILL "$test_pid" 2>/dev/null || true
		wait "$test_pid" 2>/dev/null || true
		speedtest_supervisor_fail launch-identity 1
		return
	}
	test_stopped=0
	identity_attempt=0
	while [ "$identity_attempt" -lt 5 ]; do
		if [ "$(proc_starttime "$test_pid" 2>/dev/null)" = "$test_starttime" ] &&
		   [ "$(proc_state "$test_pid" 2>/dev/null)" = T ] &&
		   [ "$(proc_group "$test_pid" 2>/dev/null)" = "$launch_parent_group" ] &&
		   [ "$(proc_session "$test_pid" 2>/dev/null)" = "$launch_parent_session" ] &&
		   speedtest_identity_matches "$test_pid" "$test_starttime"; then
			test_stopped=1
			break
		fi
		[ "$(proc_state "$test_pid" 2>/dev/null)" = Z ] && break
		kill -0 "$test_pid" 2>/dev/null || break
		identity_attempt=$((identity_attempt + 1))
		sleep 1
	done
	if [ "$test_stopped" != 1 ]; then
		[ "$(proc_starttime "$test_pid" 2>/dev/null)" = "$test_starttime" ] &&
			kill -KILL "$test_pid" 2>/dev/null || true
		wait "$test_pid" 2>/dev/null || true
		speedtest_supervisor_fail launch-stopped-handshake 1
		return
	fi
	recovery_active_test_pgid="$test_pid"
	recovery_active_test_starttime="$test_starttime"
	if ! write_recovery_journal; then
		kill -KILL "$test_pid" 2>/dev/null || true
		wait "$test_pid" 2>/dev/null || true
		speedtest_supervisor_fail journal-publish 1
		return
	fi
	[ "$(proc_starttime "$test_pid" 2>/dev/null)" = "$test_starttime" ] &&
		[ "$(proc_state "$test_pid" 2>/dev/null)" = T ] &&
		[ "$(proc_group "$test_pid" 2>/dev/null)" = "$launch_parent_group" ] &&
		[ "$(proc_session "$test_pid" 2>/dev/null)" = "$launch_parent_session" ] &&
		speedtest_identity_matches "$test_pid" "$test_starttime" || {
			[ "$(proc_starttime "$test_pid" 2>/dev/null)" = "$test_starttime" ] &&
				kill -KILL "$test_pid" 2>/dev/null || true
			wait "$test_pid" 2>/dev/null || true
			if process_group_contains_session "$test_pid"; then
				speedtest_supervisor_fail descendant-remained 1
				return
			fi
			if ! clear_active_test_journal; then
				speedtest_supervisor_fail journal-clear 1
				return
			fi
			speedtest_supervisor_fail identity-before-resume 1
			return
		}
	kill -CONT "$test_pid" 2>/dev/null || {
			[ "$(proc_starttime "$test_pid" 2>/dev/null)" = "$test_starttime" ] &&
			kill -KILL "$test_pid" 2>/dev/null || true
		wait "$test_pid" 2>/dev/null || true
		if process_group_contains_session "$test_pid"; then
			speedtest_supervisor_fail descendant-remained 1
			return
		fi
		if ! clear_active_test_journal; then
			speedtest_supervisor_fail journal-clear 1
			return
		fi
		speedtest_supervisor_fail resume 1
		return
	}
	test_group_verified=0
	transition_attempt=0
	while [ "$transition_attempt" -lt 5 ]; do
		test_state="$(proc_state "$test_pid" 2>/dev/null)"
		case "$test_state" in ''|Z|z) break ;; esac
		if speedtest_identity_matches "$test_pid" "$test_starttime" &&
		   [ "$(proc_group "$test_pid" 2>/dev/null)" = "$test_pid" ] &&
		   [ "$(proc_session "$test_pid" 2>/dev/null)" = "$test_pid" ]; then
			test_group_verified=1
			break
		fi
		transition_attempt=$((transition_attempt + 1))
		sleep 1
	done
	if [ "$test_group_verified" != 1 ]; then
		test_state="$(proc_state "$test_pid" 2>/dev/null)"
		case "$test_state" in
			''|Z|z)
				if wait "$test_pid" 2>/dev/null; then test_rc=0; else test_rc="$?"; fi
				finalize_speedtest_result "$speedtest_destination" "$test_rc" 0 0
				return
				;;
			*)
				# The child never completed its verified setsid transition.  It is
				# still an exact child in the owner group, so kill only that PID;
				# never enter an unbounded wait and never clear the journal until
				# absence of a separately created group has been proved.
				if [ "$(proc_starttime "$test_pid" 2>/dev/null)" = "$test_starttime" ]; then
					kill -KILL "$test_pid" 2>/dev/null || true
				fi
				wait "$test_pid" 2>/dev/null || true
				if process_group_contains_session "$test_pid"; then
					speedtest_supervisor_fail descendant-remained 1
					return
				fi
				if ! clear_active_test_journal; then
					speedtest_supervisor_fail journal-clear 1
					return
				fi
				speedtest_supervisor_fail setsid-transition 1
				return
				;;
		esac
	fi

	timed_out=0
	budget_exhausted=0
	budget_counter_invalid=0
	elapsed_seconds=0
	while process_group_contains_session "$test_pid"; do
		if [ "$elapsed_seconds" -ge "$test_timeout_s" ]; then
			timed_out=1
			signal_test_group_until_gone "$test_pid" "$test_starttime" || {
				speedtest_supervisor_fail termination-failed 1
				return
			}
			break
		fi
		if uint53_is_positive "${traffic_budget_bytes:-0}"; then
			consumed_budget_bytes="$(traffic_budget_consumed_bytes)" || {
				budget_counter_invalid=1
				signal_test_group_until_gone "$test_pid" "$test_starttime" || {
					speedtest_supervisor_fail termination-failed 1
					return
				}
				break
			}
			if uint53_compare "$consumed_budget_bytes" ge "$traffic_budget_bytes"; then
				budget_exhausted=1
				signal_test_group_until_gone "$test_pid" "$test_starttime" || {
					speedtest_supervisor_fail termination-failed 1
					return
				}
				break
			fi
		fi
		if [ -d "/proc/$test_pid" ] &&
		   [ "$(proc_starttime "$test_pid" 2>/dev/null)" = "$test_starttime" ]; then
			if speedtest_identity_matches "$test_pid" "$test_starttime"; then
				identity_check_rc=0
			else
				identity_check_rc="$?"
			fi
			if [ "$identity_check_rc" = 1 ]; then
				signal_test_group_until_gone "$test_pid" "$test_starttime" || true
				speedtest_supervisor_fail identity-mismatch 1
				return
			fi
		fi
		elapsed_seconds=$((elapsed_seconds + 1))
		speedtest_supervisor_elapsed_s="$elapsed_seconds"
		sleep 1
	done
	speedtest_supervisor_elapsed_s="$elapsed_seconds"
	if wait "$test_pid"; then test_rc=0; else test_rc="$?"; fi
	finalize_speedtest_result "$speedtest_destination" "$test_rc" "$timed_out" \
		"$budget_exhausted" "$budget_counter_invalid"
}

baseline_latency() {
	reflectors="$1"
	values="$job_dir/baseline.values"
	sorted="$job_dir/baseline.sorted"
	output="$job_dir/baseline.raw"
	: > "$values"

	[ -n "$fping_bin" ] || return 1
	[ -n "$reflectors" ] || reflectors="1.1.1.1 9.9.9.9"
	# fping writes summary output to stderr.  -C gives each individual RTT,
	# which is preferable to estimating p95 from only min/avg/max.
	case $- in *f*) baseline_had_noglob=1 ;; *) baseline_had_noglob=0; set -f ;; esac
	set -- $reflectors
	[ "$baseline_had_noglob" = 1 ] || set +f
	route_exec "$fping_bin" -I "$target_if" -C 5 -p 1000 -q -- "$@" > /dev/null 2> "$output" || true
	# A large total is not enough: one fast reflector could otherwise hide two
	# dead or heavily lossy families.  Require an independently useful baseline
	# (at least three successful RTTs) from every selected reflector.
	build_icmp_evidence "$output" "$reflectors" \
		"$job_dir/icmp-baseline-reflectors.tsv" baseline 5 3 || return 1
	awk '
		{
			if (!match($0, /[[:space:]]+:[[:space:]]+/)) next
			rest = substr($0, RSTART + RLENGTH)
			n = split(rest, fields, /[[:space:]]+/)
			for (i = 1; i <= n; i++)
				if (fields[i] ~ /^[0-9]+([.][0-9]+)?$/) print fields[i]
		}
	' "$output" > "$values"
	[ -s "$values" ] || return 1
	sort -n "$values" > "$sorted"
	awk '
		{ value[NR] = $1 }
		END {
			if (NR < 1) exit 1
			if (NR % 2) median = value[(NR + 1) / 2]
			else median = (value[NR / 2] + value[NR / 2 + 1]) / 2
			p95_index = int((NR * 95 + 99) / 100)
			if (p95_index < 1) p95_index = 1
			printf "%.3f %.3f %d", median, value[p95_index], NR
		}
	' "$sorted"
}

preflight() {
	write_status preflight 5 "Checking interface, route, test backend, and helper availability"
	[ -r "$runtime_lock_lib" ] && command -v runtime_lock_acquire_interface >/dev/null 2>&1 ||
		fail "The shared CAKE/SQM runtime-lock helper is unavailable."
	[ -x "$speedtest_bin" ] || fail "Speed test helper is not installed."
	[ -x "$pinger_plan_bin" ] || fail "Reflector planner is not installed."
	[ -x "$daemon_bin" ] || fail "cake-autorated is not installed."
	[ -n "$jsonfilter_bin" ] || fail "jsonfilter is required for Full Auto-Tune."
	[ -n "$fping_bin" ] || fail "fping is required for Full Auto-Tune latency validation."
	[ -x "$transport_probe_bin" ] || fail "The native transport probe helper is required for Full Auto-Tune latency validation."
	configure_transport_probe || fail "$transport_probe_configuration_error"

	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_PREFLIGHT:-0}" = 1 ]; then
		# Test-only injection: LuCI/rpcd does not pass caller-controlled
		# environment variables, so production cannot bypass these gates.
		target_if="$target_if_input"
		source_ip="192.0.2.1"
		route_if="$target_if"
		route_mode=main
		mwan3_member=""
		route_mark=""
		route_table="main"
		route_identity="main||$route_if|$source_ip||main"
		calibration_route_identity="$route_identity"
		link_kind="${CAKE_AUTORATE_AUTOTUNE_TEST_LINK_KIND:-cellular}"
	else
		target_if="$(resolve_interface_device "$target_if_input")" ||
			fail "Target interface $target_if_input does not resolve to an active device."
		operstate="$(sed -n '1p' "/sys/class/net/$target_if/operstate" 2>/dev/null)"
		case "$operstate" in
			up|unknown) ;;
			*) fail "Target interface $target_if is not up (state: ${operstate:-missing})." ;;
		esac
		inspect_autotune_route ||
			fail "Selected route is offline, mismatched, or cannot be forced through $target_if."
		calibration_route_identity="$route_identity"
		link_kind="$(detect_link_kind "$target_if" "$target_if_input")"
	fi
	collect_datapath_diagnostics
	preflight_sqm_ownership
	if [ "$calibration_strategy" = reuse_trusted ]; then
		trusted_capacity_dl_kbps="$(uci -q get "cake-autorate.$job_name.throughput_reference_dl_p50_kbps" 2>/dev/null)"
		trusted_capacity_ul_kbps="$(uci -q get "cake-autorate.$job_name.throughput_reference_ul_p50_kbps" 2>/dev/null)"
		is_positive_uint "$trusted_capacity_dl_kbps" && is_positive_uint "$trusted_capacity_ul_kbps" ||
			fail "Reuse current trusted bounds requires existing DL and UL P50 capacity references from a completed calibration."
	fi

	requested_backend="$backend"
	status_backend="$requested_backend"
	# Full Auto-Tune needs one server that can be pinned across unshaped and
	# directional shaped phases. Generic speedtest `auto` may prefer
	# librespeed-cli first, so deliberately resolve the supported pinnable
	# backend instead of selecting one and rejecting it afterwards.
	[ "$requested_backend" = auto ] && status_backend=speedtest-go
	backend_status="$($speedtest_bin "$job_name" "$target_if" status "$status_backend" 2>/dev/null)"
	backend_available="$(extract_json "$backend_status" '@.available')"
	[ "$backend_available" = true ] || fail "No usable speed test backend is available."
	resolved_backend="$(extract_json "$backend_status" '@.selected_backend')"
	case "$resolved_backend" in
		speedtest-go) ;;
		'') fail "The speed test helper did not resolve $status_backend to a concrete backend." ;;
		*) fail "Full Auto-Tune requires a backend with a pinnable, verifiable server identity; $resolved_backend cannot currently prove comparable multi-phase samples." ;;
	esac
	backend="$resolved_backend"
	preflight_phase_accounting
	conflicting_instance="$(autorate_conflict_for_target 2>/dev/null || true)"
	[ -z "$conflicting_instance" ] ||
		fail "Enabled autorate instance $conflicting_instance already owns $target_if. Tune that instance instead of creating a duplicate."
}

speedtest_supervisor_json() {
	if [ -z "${speedtest_supervisor_reason:-}" ] || [ "$speedtest_supervisor_reason" = ok ]; then
		printf 'null'
		return
	fi
	supervisor_raw_available=false
	supervisor_raw_bytes=0
	if [ -n "${test_output:-}" ] && owned_regular_file "$test_output"; then
		supervisor_raw_available=true
		supervisor_raw_bytes="$(wc -c < "$test_output" 2>/dev/null)"
		case "$supervisor_raw_bytes" in ''|*[!0-9]*) supervisor_raw_bytes=0 ;; esac
	fi
	if [ -n "${speedtest_supervisor_detail:-}" ]; then
		supervisor_detail_json="\"$(json_escape "$speedtest_supervisor_detail")\""
	else
		supervisor_detail_json=null
	fi
	supervisor_progress_json=null
	if [ -n "${test_progress:-}" ] && owned_regular_file "$test_progress"; then
		supervisor_progress_payload="$(cat "$test_progress" 2>/dev/null || true)"
		if strict_single_json_object "$supervisor_progress_payload"; then
			supervisor_progress_stage="$(extract_json "$supervisor_progress_payload" '@.stage' 2>/dev/null || true)"
			supervisor_progress_bytes="$(extract_json "$supervisor_progress_payload" '@.response_bytes' 2>/dev/null || true)"
			case "$supervisor_progress_stage" in
				route-verified|bypass-prepared|speedtest-go-started|speedtest-go-output-ready|speedtest-go-command-failed|speedtest-go-verified|backend-complete)
					case "$supervisor_progress_bytes" in ''|*[!0-9]*) supervisor_progress_bytes=0 ;; esac
					supervisor_progress_json="{\"stage\":\"$supervisor_progress_stage\",\"response_bytes\":$supervisor_progress_bytes}"
					;;
			esac
		fi
	fi
	printf '{"reason":"%s","exit_code":%s,"timeout_seconds":%s,"elapsed_seconds":%s,"raw_available":%s,"raw_bytes":%s,"progress":%s,"detail":%s}' \
		"$(json_escape "$speedtest_supervisor_reason")" \
		"${speedtest_supervisor_rc:-1}" "${test_timeout_s:-0}" "${speedtest_supervisor_elapsed_s:-0}" \
		"$supervisor_raw_available" "$supervisor_raw_bytes" "$supervisor_progress_json" \
		"$supervisor_detail_json"
}

speedtest_supervisor_retryable() {
	case "${speedtest_supervisor_reason:-}" in
		timeout) return 0 ;;
		*) return 1 ;;
	esac
}

record_speedtest_retry_event() {
	retry_context="$1"
	retry_attempt="$2"
	retry_event="{\"context\":\"$(json_escape "$retry_context")\",\"attempt\":$retry_attempt,\"supervisor\":$(speedtest_supervisor_json)}"
	if [ -n "${speedtest_retry_events_json:-}" ]; then
		speedtest_retry_events_json="$speedtest_retry_events_json,$retry_event"
	else
		speedtest_retry_events_json="$retry_event"
	fi
}

speedtest_retry_backoff() {
	retry_label="$1"
	retry_seconds="${CAKE_AUTORATE_AUTOTUNE_SPEEDTEST_RETRY_BACKOFF_S:-8}"
	case "$retry_seconds" in ''|*[!0-9]*) retry_seconds=8 ;; esac
	[ "$retry_seconds" -le 30 ] 2>/dev/null || retry_seconds=30
	write_status throughput "${current_progress:-45}" \
		"$retry_label timed out; retrying after a bounded ${retry_seconds}s cooldown"
	while [ "$retry_seconds" -gt 0 ] 2>/dev/null; do
		[ -z "${cancel_file:-}" ] || [ ! -e "$cancel_file" ] || exit 130
		sleep 1
		retry_seconds=$((retry_seconds - 1))
	done
}

speedtest_timeout_inconclusive() {
	timeout_stage="$1"
	timeout_context="$2"
	timeout_message="The $timeout_context timed out after bounded retries. The verified measurements already collected remain diagnostic only; no proposal can be applied. Retry the calibration when the selected server is responsive."
	stage_terminal_json error "{\"state\":\"inconclusive\",\"schema_version\":8,\"stage\":\"$(json_escape "$timeout_stage")\",\"search_state\":\"measurement_timeout\",\"error\":\"$(json_escape "$timeout_message")\",\"reason\":\"speedtest-timeout\",\"retryable\":true,\"speedtest_supervisor\":$(speedtest_supervisor_json),\"speedtest_retries\":[${speedtest_retry_events_json:-}],\"traffic_budget\":$(traffic_budget_json),\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":false,\"phase_contamination_seen\":${phase_contamination_seen:-false},\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"runs\":[${runs_json:-}],\"phase_background\":[${phase_background_runs_json:-}],\"pinger_plan\":${pinger_plan:-null},\"proposal\":null,\"configuration_written\":false}"
	exit 1
}

traffic_budget_json() {
	if ! uint53_is_positive "${traffic_budget_bytes:-0}"; then
		printf '%s' '{"enabled":false,"limit_bytes":0,"consumed_bytes":0,"poll_interval_seconds":1}'
		return
	fi
	budget_consumed_json=null
	if [ -n "${target_if:-}" ] &&
	   uint53_normalize "${traffic_budget_start_bytes:-0}" >/dev/null; then
		budget_consumed_value="$(traffic_budget_consumed_bytes 2>/dev/null || true)"
		case "$budget_consumed_value" in ''|*[!0-9]*) ;; *) budget_consumed_json="$budget_consumed_value" ;; esac
	fi
	printf '{"enabled":true,"limit_bytes":%s,"consumed_bytes":%s,"poll_interval_seconds":1}' \
		"$traffic_budget_bytes" "$budget_consumed_json"
}

fail() {
	message="$1"
	if [ -n "${cancel_file:-}" ] && [ -e "$cancel_file" ]; then
		exit 130
	fi
	worker_trace "failure message=$(json_escape "$message")"
	failure_payload="{\"state\":\"failed\",\"schema_version\":7,\"stage\":\"$(json_escape "${current_phase:-unknown}")\",\"error\":\"$(json_escape "$message")\",\"speedtest_supervisor\":$(speedtest_supervisor_json),\"traffic_budget\":$(traffic_budget_json),\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":${phase_evidence_complete:-false},\"phase_contamination_seen\":${phase_contamination_seen:-false},\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"runs\":[${runs_json:-}],\"phase_background\":[${phase_background_runs_json:-}],\"validation_attempts\":[${validation_attempts_json:-}],\"validation\":${validation_json:-null},\"pinger_plan\":${pinger_plan:-null},\"proposal\":${proposal:-null},\"configuration_written\":false}"
	if ! stage_terminal_json error "$failure_payload"; then
		# Route loss and helper failures can leave one optional diagnostics
		# fragment unavailable. Never let that erase the authoritative reason:
		# retain a small schema-valid terminal which recovery can publish after
		# runtime restoration. The detailed breadcrumb remains RAM-only in
		# job.log and contains no command output or UCI values.
		worker_trace "detailed failure terminal rejected; staging compact terminal"
		stage_terminal_json error "{\"state\":\"failed\",\"schema_version\":7,\"stage\":\"$(json_escape "${current_phase:-unknown}")\",\"error\":\"$(json_escape "$message")\",\"traffic_budget\":$(traffic_budget_json),\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":false,\"phase_contamination_seen\":${phase_contamination_seen:-false},\"configuration_written\":false}" || true
	fi
	exit 1
}

measurement_inconclusive() {
	measurement_stage="$1"
	measurement_reason="$2"
	measurement_search_state=inconclusive
	measurement_recommended_profile_json=
	measurement_message="Measurement evidence remained invalid after a bounded retry; no candidate was accepted."
	case "$measurement_reason" in
		directional-manual-fallback-final-pair-unsafe)
			measurement_search_state=joint_unsafe
			measurement_message="The final simultaneous download and upload confirmation exceeded this profile's manual safety ceiling. Direction-only evidence is not a safe proposal; no settings can be applied from this result."
			if [ "$autotune_profile" = variable_link ]; then
				measurement_recommended_profile_json=',"recommended_profile":"fair"'
			fi
			;;
		*queue-outside-cake-control*)
			measurement_search_state=no_cake_effect
			measurement_message="Reducing the tested CAKE rate did not produce a measurable latency improvement. The bottleneck appears to be outside CAKE control; no runtime minimum was invented."
			;;
		*noisy*|*nonmonotonic*)
			measurement_search_state=noisy
			measurement_message="The variable-link measurements did not converge after bounded repeats. No runtime minimum was invented."
			;;
	esac
	stage_terminal_json error "{\"state\":\"inconclusive\",\"schema_version\":7,\"stage\":\"$(json_escape "$measurement_stage")\",\"search_state\":\"$measurement_search_state\",\"error\":\"$(json_escape "$measurement_message")\",\"reason\":\"$(json_escape "$measurement_reason")\"${measurement_recommended_profile_json},\"retryable\":true,\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":false,\"phase_contamination_seen\":${phase_contamination_seen:-false},\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"runs\":[${runs_json:-}],\"phase_background\":[${phase_background_runs_json:-}],\"validation_attempts\":[${validation_attempts_json:-}],\"profile_search\":{\"download\":${dl_search_json:-null},\"upload\":${ul_search_json:-null}},\"pinger_plan\":${pinger_plan:-null},\"proposal\":${proposal:-null},\"configuration_written\":false}"
	exit 1
}

run_measurement() {
	index="$1"
	speedtest_bypass_scope=full
	measurement_job_key=""
	measurement_label="unshaped full-path"
	if [ "$calibration_strategy" != full_raw ]; then
		measurement_job_key=shaped
		measurement_label="shaped current-bound"
	fi
	measurement_attempt=1
	while [ "$measurement_attempt" -le 2 ]; do
		measurement_network_attempt=1
		measurement_network_max_attempts="${CAKE_AUTORATE_AUTOTUNE_SPEEDTEST_RETRY_ATTEMPTS:-3}"
		case "$measurement_network_max_attempts" in ''|*[!0-9]*) measurement_network_max_attempts=3 ;; esac
		[ "$measurement_network_max_attempts" -ge 1 ] 2>/dev/null || measurement_network_max_attempts=1
		[ "$measurement_network_max_attempts" -le 3 ] 2>/dev/null || measurement_network_max_attempts=3
		while [ "$measurement_network_attempt" -le "$measurement_network_max_attempts" ]; do
			current_progress=40
			write_status throughput 40 "Running the $measurement_label control (sample attempt $measurement_attempt, network attempt $measurement_network_attempt of $measurement_network_max_attempts)"
			phase_background_kind="$calibration_strategy"
			start_phase_background_counter "$(phase_reference_rate dl)" "$(phase_reference_rate ul)"
			fair_control_this_attempt=0
			if [ "$calibration_strategy" = full_raw ] && [ "$index" -eq 1 ]; then
				fair_control_key=$((measurement_attempt * 10 + measurement_network_attempt))
				if start_fair_control_monitors "$fair_control_key"; then
					fair_control_this_attempt=1
				else
					fair_control_json='{"available":false,"measurement_evidence":{"valid":false,"reason":"control-monitor-start-failed"}}'
					raw_control_json="$fair_control_json"
				fi
			fi
			measurement_result_file="$job_dir/unshaped-$index-$measurement_attempt-$measurement_network_attempt.result"
			if run_speedtest_with_timeout "$measurement_result_file" \
				"$job_name" "$target_if" run "$backend" "$measurement_job_key" "$route_mode" "$mwan3_member"; then
				break
			fi
			[ "$fair_control_this_attempt" -eq 0 ] ||
				stop_fair_control_monitors >/dev/null 2>&1 || true
			stop_phase_background_counter
			record_speedtest_retry_event "$measurement_label-control-$index" "$measurement_network_attempt"
			if ! speedtest_supervisor_retryable; then
				if [ -n "${speedtest_supervisor_detail:-}" ]; then
					speedtest_failure_summary="${speedtest_supervisor_reason:-unknown}: $speedtest_supervisor_detail"
				else
					speedtest_failure_summary="${speedtest_supervisor_reason:-unknown}"
				fi
				fail "Throughput sample $index failed in the speed-test supervisor ($speedtest_failure_summary)."
			fi
			if [ "$measurement_network_attempt" -ge "$measurement_network_max_attempts" ]; then
				speedtest_timeout_inconclusive throughput "$measurement_label control"
			fi
			speedtest_retry_backoff "$measurement_label control"
			measurement_network_attempt=$((measurement_network_attempt + 1))
		done
		result="$(cat "$measurement_result_file" 2>/dev/null)"
		rm -f "$measurement_result_file"
		if [ "$fair_control_this_attempt" -eq 1 ] &&
		   ! stop_fair_control_monitors; then
			fair_control_json='{"available":false,"measurement_evidence":{"valid":false,"reason":"control-monitor-stop-failed"}}'
			raw_control_json="$fair_control_json"
			fair_control_this_attempt=0
		fi
		stop_phase_background_counter
		if [ "$fair_control_this_attempt" -eq 1 ]; then
			evaluate_fair_control "$result"
			raw_control_json="$fair_control_json"
		fi
		result_backend="$(extract_json "$result" '@.backend')"
		[ "$result_backend" = "$backend" ] ||
			fail "Speed test backend changed from $backend to ${result_backend:-unknown} during unshaped sample $index."
		measurement_shaper_bypassed="$(extract_json "$result" '@.shaper_bypassed')"
		measurement_sqm_paused="$(extract_json "$result" '@.sqm_paused')"
		measurement_sqm_bypass_mode="$(extract_json "$result" '@.sqm_bypass_mode')"
		if [ "$calibration_strategy" = full_raw ]; then
			[ "$measurement_shaper_bypassed" = true ] ||
				fail "The full-raw control did not prove managed SQM bypass."
		else
			[ "$measurement_shaper_bypassed" = false ] && [ "$measurement_sqm_paused" = false ] &&
				[ "$measurement_sqm_bypass_mode" = none ] ||
				fail "The shaped control unexpectedly bypassed managed SQM."
		fi
		download="$(extract_json "$result" '@.download_kbps')"
		upload="$(extract_json "$result" '@.upload_kbps')"
		is_positive_uint "$download" || fail "Throughput sample $index returned no download rate."
		is_positive_uint "$upload" || fail "Throughput sample $index returned no upload rate."
		if [ "${phase_background_reference_deferred:-false}" = true ]; then
			# A new instance has no trustworthy configured rate.  The speed test
			# itself is router-originated and therefore absent from the forward
			# counter, so its verified raw result safely resolves the relative
			# client-traffic limit for this phase.
			classify_phase_background "$download" "$upload"
		fi
		phase_entry="{\"phase\":\"$(json_escape "$calibration_strategy")\",\"sample\":$index,\"attempt\":$measurement_attempt,\"network_attempt\":$measurement_network_attempt,\"measured\":{\"download_kbps\":${download:-0},\"upload_kbps\":${upload:-0}},\"forwarded_background\":$(phase_background_json)}"
		if [ -n "${phase_background_runs_json:-}" ]; then
			phase_background_runs_json="$phase_background_runs_json,$phase_entry"
		else
			phase_background_runs_json="$phase_entry"
		fi
		if [ "$phase_background_contaminated" != true ]; then
			break
		fi
		phase_contamination_seen=true
		if [ "$measurement_attempt" -ge 2 ]; then
			if [ "$phase_background_available" != true ]; then
				fail "Forwarded-traffic evidence was unavailable for both attempts of unshaped sample $index."
			fi
			if [ "${conservative_mode:-0}" = 1 ]; then
				unresolved_background_contamination=true
				download_background_unresolved=true
				upload_background_unresolved=true
				break
			fi
			stage_terminal_json error "{\"state\":\"background-blocked\",\"schema_version\":7,\"error\":\"Forwarded WAN traffic contaminated both attempts of unshaped sample $index. Retry when quiet or explicitly continue conservatively.\",\"background_blocked\":true,\"retryable\":true,\"stage\":\"throughput\",\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":${phase_evidence_complete:-false},\"phase_contamination_seen\":true,\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"runs\":[${runs_json:-}],\"phase_background\":[$phase_background_runs_json],\"pinger_plan\":${pinger_plan:-null},\"configuration_written\":false}"
			exit 1
		fi
		measurement_attempt=$((measurement_attempt + 1))
	done
	download="$(extract_json "$result" '@.download_kbps')"
	upload="$(extract_json "$result" '@.upload_kbps')"
	is_positive_uint "$download" || fail "Throughput sample $index returned no download rate."
	is_positive_uint "$upload" || fail "Throughput sample $index returned no upload rate."
	server_id="$(extract_json "$result" '@.server_id')"
	is_positive_uint "$server_id" || fail "The pinned speedtest-go server identity was missing from throughput sample $index."
	result_route_identity="$(extract_json "$result" '@.route_mode')|$(extract_json "$result" '@.mwan3_member')|$(extract_json "$result" '@.route_interface')|$(extract_json "$result" '@.route_source_ip')|$(extract_json "$result" '@.route_fwmark')|$(extract_json "$result" '@.route_table')"
	[ "$result_route_identity" = "$calibration_route_identity" ] ||
		fail "WAN route identity changed between Full Auto-Tune phases."
	result_external_ip="$(extract_json "$result" '@.external_ip_after')"
	[ -n "$result_external_ip" ] || fail "Throughput sample $index returned no routed external IP."
	if [ "$index" -eq 1 ]; then
		selected_server_id="$server_id"
		selected_external_ip="$result_external_ip"
	elif [ -n "$selected_server_id" ] && [ "$server_id" != "$selected_server_id" ]; then
		fail "Speed test server changed during raw calibration; retry for comparable samples."
	fi
	[ "$result_external_ip" = "$selected_external_ip" ] ||
		fail "External IP changed between Full Auto-Tune throughput samples."
	if [ -n "$full_download_samples" ]; then
		full_download_samples="$full_download_samples,$download"
		full_upload_samples="$full_upload_samples,$upload"
		runs_json="$runs_json,$result"
	else
		full_download_samples="$download"
		full_upload_samples="$upload"
		runs_json="$result"
	fi
	calibration_capacity_dl_kbps="$download"
	calibration_capacity_ul_kbps="$upload"
}

run_directional_control() {
	control_direction="$1"
	control_index="$2"
	case "$control_direction" in download|upload) ;; *) fail "Invalid directional control." ;; esac
	control_job_key=""
	control_label=unshaped
	if [ "$calibration_strategy" = full_raw ]; then
		case "$control_direction" in
			download)
				case "$sqm_direction_mode" in
					upload_only) speedtest_bypass_scope=already-unshaped ;;
					*) speedtest_bypass_scope=ingress ;;
				esac
				;;
			upload)
				case "$sqm_direction_mode" in
					download_only) speedtest_bypass_scope=already-unshaped ;;
					*) speedtest_bypass_scope=egress ;;
				esac
				;;
		esac
	else
		speedtest_bypass_scope=full
		control_job_key=shaped
		control_label=shaped
	fi
	control_attempt=1
	while [ "$control_attempt" -le 2 ]; do
		case "$control_direction" in
			download) control_progress=$((45 + control_index * 5)) ;;
			upload) control_progress=$((60 + control_index * 5)) ;;
		esac
		current_progress="$control_progress"
		control_network_attempt=1
		control_network_max_attempts="${CAKE_AUTORATE_AUTOTUNE_SPEEDTEST_RETRY_ATTEMPTS:-3}"
		case "$control_network_max_attempts" in ''|*[!0-9]*) control_network_max_attempts=3 ;; esac
		[ "$control_network_max_attempts" -ge 1 ] 2>/dev/null || control_network_max_attempts=1
		[ "$control_network_max_attempts" -le 3 ] 2>/dev/null || control_network_max_attempts=3
		while [ "$control_network_attempt" -le "$control_network_max_attempts" ]; do
			write_status throughput "$control_progress" \
				"Running $control_label $control_direction-only control $control_index of 2 (sample attempt $control_attempt, network attempt $control_network_attempt of $control_network_max_attempts)"
			phase_background_kind="$calibration_strategy"
			start_phase_background_counter "$(phase_reference_rate dl)" "$(phase_reference_rate ul)"
			control_result_file="$job_dir/unshaped-$control_direction-$control_index-$control_attempt-$control_network_attempt.result"
			if run_speedtest_with_timeout "$control_result_file" \
				"$job_name" "$target_if" run "$backend" "$control_job_key" "$route_mode" "$mwan3_member" "$control_direction"; then
				break
			fi
			stop_phase_background_counter
			record_speedtest_retry_event "$control_label-$control_direction-control-$control_index" "$control_network_attempt"
			if ! speedtest_supervisor_retryable; then
				fail "The $control_label $control_direction-only control failed in the speed-test supervisor (${speedtest_supervisor_reason:-unknown})."
			fi
			if [ "$control_network_attempt" -ge "$control_network_max_attempts" ]; then
				speedtest_retry_exhausted_context="$control_label $control_direction-only control $control_index"
				return 75
			fi
			speedtest_retry_backoff "$control_label $control_direction-only control $control_index"
			control_network_attempt=$((control_network_attempt + 1))
		done
		control_result="$(cat "$control_result_file" 2>/dev/null)"
		rm -f "$control_result_file"
		stop_phase_background_counter
		control_backend="$(extract_json "$control_result" '@.backend')"
		[ "$control_backend" = "$backend" ] ||
			fail "Speed test backend changed during the $control_direction-only control."
		control_reported_direction="$(extract_json "$control_result" '@.test_direction')"
		[ "$control_reported_direction" = "$control_direction" ] ||
			fail "Speed test helper reported ${control_reported_direction:-no direction} for the unshaped $control_direction-only control."
		control_shaper_bypassed="$(extract_json "$control_result" '@.shaper_bypassed')"
		control_sqm_paused="$(extract_json "$control_result" '@.sqm_paused')"
		control_sqm_bypass_mode="$(extract_json "$control_result" '@.sqm_bypass_mode')"
		if [ "$calibration_strategy" = full_raw ]; then
			[ "$control_shaper_bypassed" = true ] ||
				fail "The unshaped $control_direction-only control did not prove shaper bypass."
			case "$control_direction:$control_sqm_bypass_mode:$control_sqm_paused" in
				download:ingress-only-managed:false|upload:egress-only-managed:false|*:already-unshaped:false) ;;
				*) fail "The unshaped $control_direction-only control returned inconsistent SQM bypass evidence." ;;
			esac
		else
			[ "$control_shaper_bypassed" = false ] && [ "$control_sqm_paused" = false ] &&
				[ "$control_sqm_bypass_mode" = none ] ||
				fail "The shaped $control_direction-only control unexpectedly bypassed managed SQM."
		fi
		case "$control_direction" in
			download) control_rate="$(extract_json "$control_result" '@.download_kbps')" ;;
			upload) control_rate="$(extract_json "$control_result" '@.upload_kbps')" ;;
		esac
		is_positive_uint "$control_rate" ||
			fail "The unshaped $control_direction-only control returned no rate."
		control_entry="{\"phase\":\"unshaped-directional\",\"direction\":\"$control_direction\",\"sample\":$control_index,\"attempt\":$control_attempt,\"network_attempt\":$control_network_attempt,\"measured_kbps\":$control_rate,\"forwarded_background\":$(phase_background_json)}"
		phase_background_runs_json="$phase_background_runs_json,$control_entry"
		if [ "$phase_background_contaminated" != true ]; then
			break
		fi
		phase_contamination_seen=true
		if [ "$control_attempt" -ge 2 ]; then
			if [ "$phase_background_available" != true ]; then
				fail "Forwarded-traffic evidence was unavailable for both $control_direction-only control attempts."
			fi
			if [ "${conservative_mode:-0}" != 1 ]; then
				stage_terminal_json error "{\"state\":\"background-blocked\",\"schema_version\":7,\"error\":\"Forwarded WAN traffic contaminated both $control_direction-only controls. Retry when quiet or explicitly continue conservatively.\",\"background_blocked\":true,\"retryable\":true,\"stage\":\"directional-control-$control_direction\",\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":${phase_evidence_complete:-false},\"phase_contamination_seen\":true,\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"runs\":[${runs_json:-}],\"phase_background\":[$phase_background_runs_json],\"pinger_plan\":${pinger_plan:-null},\"configuration_written\":false}"
				exit 1
			fi
			unresolved_background_contamination=true
			case "$control_direction" in
				download) download_background_unresolved=true ;;
				upload) upload_background_unresolved=true ;;
			esac
			break
		fi
		control_attempt=$((control_attempt + 1))
	done

	control_server_id="$(extract_json "$control_result" '@.server_id')"
	[ "$control_server_id" = "$selected_server_id" ] ||
		fail "Speed test server changed during the $control_direction-only control."
	control_route_identity="$(extract_json "$control_result" '@.route_mode')|$(extract_json "$control_result" '@.mwan3_member')|$(extract_json "$control_result" '@.route_interface')|$(extract_json "$control_result" '@.route_source_ip')|$(extract_json "$control_result" '@.route_fwmark')|$(extract_json "$control_result" '@.route_table')"
	[ "$control_route_identity" = "$calibration_route_identity" ] ||
		fail "WAN route identity changed during the $control_direction-only control."
	[ "$(extract_json "$control_result" '@.external_ip_after')" = "$selected_external_ip" ] ||
		fail "External IP changed during the $control_direction-only control."
	case "$control_direction" in
		download)
			if [ -n "$download_samples" ]; then
				download_samples="$download_samples,$control_rate"
			else
				download_samples="$control_rate"
			fi
			;;
		upload)
			if [ -n "$upload_samples" ]; then
				upload_samples="$upload_samples,$control_rate"
			else
				upload_samples="$control_rate"
			fi
			;;
	esac
	runs_json="$runs_json,$control_result"
}

calculate_proposal() {
	dl_base_scale="${1:-1.0}"
	ul_base_scale="${2:-$dl_base_scale}"
	dl_runtime_minimum="${3:-}"
	ul_runtime_minimum="${4:-}"
	set --
	if [ -n "$dl_runtime_minimum" ]; then
		is_positive_uint "$dl_runtime_minimum" || return 1
		set -- "$@" --dl-runtime-min-kbps "$dl_runtime_minimum"
	fi
	if [ -n "$ul_runtime_minimum" ]; then
		is_positive_uint "$ul_runtime_minimum" || return 1
		set -- "$@" --ul-runtime-min-kbps "$ul_runtime_minimum"
	fi
	if [ "${conservative_mode:-0}" = 1 ]; then
		"$daemon_bin" --autotune-proposal \
			--dl-samples "$download_samples" \
			--ul-samples "$upload_samples" \
			--idle-median-ms "$idle_median_ms" \
			--idle-p95-ms "$idle_p95_ms" \
			--idle-samples "$baseline_samples" \
			--link-kind "$link_kind" \
			--profile "$autotune_profile" \
			--dl-base-scale "$dl_base_scale" \
			--ul-base-scale "$ul_base_scale" \
			--conservative-background-dl-kbps "${background_dl_kbps:-0}" \
			--conservative-background-ul-kbps "${background_ul_kbps:-0}" \
			--retain-dl "$([ "$background_dl_usable" = true ] && printf 0 || printf 1)" \
			--retain-ul "$([ "$background_ul_usable" = true ] && printf 0 || printf 1)" \
			--current-dl-min-kbps "${current_dl_min:-0}" \
			--current-dl-base-kbps "${current_dl_base:-0}" \
			--current-dl-max-kbps "${current_dl_max:-0}" \
			--current-dl-cap-kbps "${current_dl_cap:-0}" \
			--current-ul-min-kbps "${current_ul_min:-0}" \
			--current-ul-base-kbps "${current_ul_base:-0}" \
			--current-ul-max-kbps "${current_ul_max:-0}" \
			--current-ul-cap-kbps "${current_ul_cap:-0}" \
			"$@"
	else
		"$daemon_bin" --autotune-proposal \
			--dl-samples "$download_samples" \
			--ul-samples "$upload_samples" \
			--idle-median-ms "$idle_median_ms" \
			--idle-p95-ms "$idle_p95_ms" \
			--idle-samples "$baseline_samples" \
			--link-kind "$link_kind" \
			--profile "$autotune_profile" \
			--dl-base-scale "$dl_base_scale" \
			--ul-base-scale "$ul_base_scale" \
			"$@"
	fi
}

stop_validation_monitors() {
	rm -f "${cpu_marker:-}" "${latency_marker:-}"
	monitors_stopped=1
	stop_transport_latency_monitor || monitors_stopped=0
	[ -z "${latency_pid:-}" ] ||
		stop_owned_monitor "$latency_pid" "${latency_starttime:-}" || monitors_stopped=0
	[ -z "${cpu_pid:-}" ] ||
		stop_owned_monitor "$cpu_pid" "${cpu_starttime:-}" || monitors_stopped=0
	latency_pid=""
	latency_starttime=""
	cpu_pid=""
	cpu_starttime=""
	[ "$monitors_stopped" = 1 ]
}

quality_grade_for_delta() {
	awk -v delta="$1" 'BEGIN {
		if (delta < 5) print "A+"
		else if (delta < 30) print "A"
		else if (delta < 60) print "B"
		else if (delta < 200) print "C"
		else if (delta < 400) print "D"
		else print "F"
	}'
}

quality_grade_rank() {
	case "$1" in
		A+) printf '0\n' ;;
		A) printf '1\n' ;;
		B) printf '2\n' ;;
		C) printf '3\n' ;;
		D) printf '4\n' ;;
		F) printf '5\n' ;;
		*) return 1 ;;
	esac
}

# A no-SQM candidate is admitted only by evidence collected while the complete
# managed shaper was demonstrably bypassed.  Whether it is faster than the
# shaped candidate, or whether its latency is as good, is a utility judgement
# shown in Review rather than a measurement-integrity gate.
raw_control_hard_safety() {
	raw_gate_control="$1"
	raw_gate_available="$(extract_json "$raw_gate_control" '@.available' 2>/dev/null || true)"
	raw_gate_valid="$(extract_json "$raw_gate_control" '@.measurement_evidence.valid' 2>/dev/null || true)"
	raw_gate_reason="$(extract_json "$raw_gate_control" '@.measurement_evidence.reason' 2>/dev/null || true)"
	raw_gate_direction="$(extract_json "$raw_gate_control" '@.measurement_evidence.test_direction' 2>/dev/null || true)"
	raw_gate_bypassed="$(extract_json "$raw_gate_control" '@.measurement_evidence.shaper_bypassed' 2>/dev/null || true)"
	raw_gate_paused="$(extract_json "$raw_gate_control" '@.measurement_evidence.sqm_paused' 2>/dev/null || true)"
	raw_gate_bypass_mode="$(extract_json "$raw_gate_control" '@.measurement_evidence.sqm_bypass_mode' 2>/dev/null || true)"
	raw_gate_delta="$(extract_json "$raw_gate_control" '@.effective_delta_ms' 2>/dev/null || true)"
	raw_gate_grade="$(extract_json "$raw_gate_control" '@.grade' 2>/dev/null || true)"
	raw_gate_loss="$(extract_json "$raw_gate_control" '@.icmp_latency.loss_percent' 2>/dev/null || true)"
	raw_gate_dl="$(extract_json "$raw_gate_control" '@.throughput.download_kbps' 2>/dev/null || true)"
	raw_gate_ul="$(extract_json "$raw_gate_control" '@.throughput.upload_kbps' 2>/dev/null || true)"
	raw_gate_background_available="$(extract_json "$raw_gate_control" '@.forwarded_background.available' 2>/dev/null || true)"
	raw_gate_background_contaminated="$(extract_json "$raw_gate_control" '@.forwarded_background.contaminated' 2>/dev/null || true)"
	raw_gate_background_dl="$(extract_json "$raw_gate_control" '@.forwarded_background.download_kbps' 2>/dev/null || true)"
	raw_gate_background_ul="$(extract_json "$raw_gate_control" '@.forwarded_background.upload_kbps' 2>/dev/null || true)"
	raw_gate_background_dl_limit="$(extract_json "$raw_gate_control" '@.forwarded_background.download_limit_kbps' 2>/dev/null || true)"
	raw_gate_background_ul_limit="$(extract_json "$raw_gate_control" '@.forwarded_background.upload_limit_kbps' 2>/dev/null || true)"

	[ "${phase_evidence_complete:-false}" = true ] &&
		[ "$raw_gate_available" = true ] &&
		[ "$raw_gate_valid" = true ] &&
		[ "$raw_gate_reason" = ok ] &&
		[ "$raw_gate_direction" = both ] &&
		[ "$raw_gate_bypassed" = true ] || return 1
	case "$raw_gate_bypass_mode:$raw_gate_paused" in
		paused-managed:true|already-unshaped:false) ;;
		*) return 1 ;;
	esac
	raw_gate_expected_grade="$(quality_grade_for_delta "$raw_gate_delta" 2>/dev/null || true)"
	[ -n "$raw_gate_expected_grade" ] && [ "$raw_gate_grade" = "$raw_gate_expected_grade" ] || return 1
	awk -v delta="$raw_gate_delta" -v manual_limit="$validation_manual_latency_review_max_ms" \
		-v loss="$raw_gate_loss" -v loss_limit="$validation_loss_max_percent" \
		-v dl="$raw_gate_dl" -v ul="$raw_gate_ul" \
		-v background_available="$raw_gate_background_available" \
		-v contaminated="$raw_gate_background_contaminated" \
		-v background_dl="$raw_gate_background_dl" -v background_ul="$raw_gate_background_ul" \
		-v background_dl_limit="$raw_gate_background_dl_limit" \
		-v background_ul_limit="$raw_gate_background_ul_limit" 'BEGIN {
			number = "^[0-9]+([.][0-9]+)?$"
			exit(!(delta ~ number && delta <= manual_limit &&
				loss ~ number && loss <= loss_limit &&
				dl ~ number && dl > 0 && ul ~ number && ul > 0 &&
				background_available == "true" && contaminated == "false" &&
				background_dl ~ number && background_dl_limit ~ number && background_dl <= background_dl_limit &&
				background_ul ~ number && background_ul_limit ~ number && background_ul <= background_ul_limit))
		}'
}

build_fair_outcome() {
	fair_outcome_mode="$1"
	fair_safety_state="${2:-safety-floor-met}"
	fair_objective_state="${3:-capacity-objective-met}"
	# Directional validation is not the final line-quality verdict.  The
	# simultaneous DL+UL confirmation can expose ACK starvation or shared-path
	# queueing which neither isolated phase saw.  Callers therefore pass the
	# authoritative worst-case grade and delay; the defaults keep the standalone
	# unit fixture useful without weakening the real result contract.
	fair_actual_grade="${4:-$validation_actual_grade}"
	fair_actual_effective_delta_ms="${5:-$effective_loaded_delta_ms}"
	fair_apply_sqm_available=true
	fair_recommended_action=apply_sqm
	fair_disable_available=false
	fair_comparison_reason=quality-target-met
	fair_control_available="$(extract_json "$fair_control_json" '@.available' 2>/dev/null || true)"
	fair_control_dl_gain_percent=0
	fair_control_ul_gain_percent=0
	# A clean raw control is always a manually reviewable alternative.  The
	# comparison below may rank it first, but lack of a measured utility gain
	# must not erase an otherwise safe topology from Review.
	if raw_control_hard_safety "$fair_control_json"; then
		fair_disable_available=true
	fi

	if [ "$fair_safety_state" = safety-floor-infeasible ]; then
		fair_apply_sqm_available=false
		fair_recommended_action=keep_current
		fair_comparison_reason=achieved-throughput-below-catastrophic-floor
	elif [ "$fair_safety_state" = historical-trust-missed ]; then
		# Cellular capacity can legitimately move far below an earlier clean
		# sample. Keep a currently controlled candidate available for manual
		# review, but do not turn that historical miss into advice to disable SQM.
		fair_comparison_reason=historical-capacity-comparison-warning
	elif [ "$fair_objective_state" = capacity-objective-missed ]; then
		fair_comparison_reason=throughput-retention-below-profile-objective
	fi

	if [ "$fair_outcome_mode" = throughput-fallback ]; then
		[ "$fair_safety_state" != safety-floor-met ] ||
			fair_comparison_reason=quality-target-unreachable-above-throughput-floor
		if [ "$fair_safety_state" = safety-floor-met ] && [ "$fair_control_available" = true ]; then
			fair_control_grade_value="$(extract_json "$fair_control_json" '@.grade')"
			fair_control_delta_value="$(extract_json "$fair_control_json" '@.effective_delta_ms')"
			fair_control_dl="$(extract_json "$fair_control_json" '@.throughput.download_kbps')"
			fair_control_ul="$(extract_json "$fair_control_json" '@.throughput.upload_kbps')"
			fair_control_loss="$(extract_json "$fair_control_json" '@.icmp_latency.loss_percent')"
			fair_control_background_available="$(extract_json "$fair_control_json" '@.forwarded_background.available')"
			fair_control_background_contaminated="$(extract_json "$fair_control_json" '@.forwarded_background.contaminated')"
			fair_control_background_dl="$(extract_json "$fair_control_json" '@.forwarded_background.download_kbps')"
			fair_control_background_ul="$(extract_json "$fair_control_json" '@.forwarded_background.upload_kbps')"
			fair_control_background_dl_limit="$(extract_json "$fair_control_json" '@.forwarded_background.download_limit_kbps')"
			fair_control_background_ul_limit="$(extract_json "$fair_control_json" '@.forwarded_background.upload_limit_kbps')"
			fair_shaped_rank="$(quality_grade_rank "$fair_actual_grade")" || fair_shaped_rank=99
			fair_control_rank="$(quality_grade_rank "$fair_control_grade_value")" || fair_control_rank=99
			fair_control_dl_gain_percent="$(awk -v control="$fair_control_dl" -v shaped="$shaped_dl" 'BEGIN {
				if (control <= 0 || shaped <= 0) { print 0; exit }
				printf "%.3f", (control / shaped - 1) * 100
			}')"
			fair_control_ul_gain_percent="$(awk -v control="$fair_control_ul" -v shaped="$shaped_ul" 'BEGIN {
				if (control <= 0 || shaped <= 0) { print 0; exit }
				printf "%.3f", (control / shaped - 1) * 100
			}')"
			if awk -v control_rank="$fair_control_rank" -v shaped_rank="$fair_shaped_rank" \
				-v control_delta="$fair_control_delta_value" -v shaped_delta="$fair_actual_effective_delta_ms" \
				-v dl_gain="$fair_control_dl_gain_percent" -v ul_gain="$fair_control_ul_gain_percent" \
				-v control_loss="$fair_control_loss" -v loss_limit="$validation_loss_max_percent" \
				-v background_available="$fair_control_background_available" \
				-v background_contaminated="$fair_control_background_contaminated" \
				-v background_dl="$fair_control_background_dl" -v background_ul="$fair_control_background_ul" \
				-v background_dl_limit="$fair_control_background_dl_limit" \
				-v background_ul_limit="$fair_control_background_ul_limit" 'BEGIN {
					exit(!(background_available == "true" && background_contaminated == "false" &&
						background_dl ~ /^[0-9]+([.][0-9]+)?$/ &&
						background_ul ~ /^[0-9]+([.][0-9]+)?$/ &&
						background_dl_limit ~ /^[0-9]+([.][0-9]+)?$/ &&
						background_ul_limit ~ /^[0-9]+([.][0-9]+)?$/ &&
						background_dl <= background_dl_limit &&
						background_ul <= background_ul_limit &&
						control_loss ~ /^[0-9]+([.][0-9]+)?$/ && control_loss <= loss_limit &&
						control_rank <= shaped_rank &&
						control_delta <= shaped_delta + 10 &&
						dl_gain >= 2 && ul_gain >= 2))
				}'; then
				fair_outcome_mode=sqm-disable-recommended
				fair_recommended_action=disable_sqm
				fair_disable_available=true
				fair_comparison_reason=no-material-latency-benefit-with-throughput-cost
			fi
		fi
	fi

	if [ "$fair_apply_sqm_available" = true ]; then
		fair_allowed_actions='"apply_sqm","keep_current"'
	else
		fair_allowed_actions='"keep_current"'
	fi
	[ "$fair_disable_available" = true ] &&
		fair_allowed_actions="$fair_allowed_actions,\"disable_sqm\""
	fair_outcome_json="{\"mode\":\"$(json_escape "$fair_outcome_mode")\",\"target_grade\":\"C\",\"target_delta_ms\":200,\"capacity_floor_percent\":90,\"capacity_floor_met\":$([ "$fair_objective_state" = capacity-objective-met ] && printf true || printf false),\"throughput_safety_floor_percent\":50,\"throughput_safety_floor_met\":$profile_safety_floor_met,\"actual_grade\":\"$(json_escape "$fair_actual_grade")\",\"actual_effective_delta_ms\":$fair_actual_effective_delta_ms,\"recommended_action\":\"$fair_recommended_action\",\"allowed_actions\":[$fair_allowed_actions],\"apply_sqm_available\":$fair_apply_sqm_available,\"disable_sqm_available\":$fair_disable_available,\"comparison_reason\":\"$(json_escape "$fair_comparison_reason")\",\"no_sqm_control\":$fair_control_json,\"throughput_gain_without_sqm\":{\"download_percent\":$fair_control_dl_gain_percent,\"upload_percent\":$fair_control_ul_gain_percent}}"
}

start_fair_control_monitors() {
	fair_control_attempt="$1"
	fair_control_active=1
	cpu_pid=""
	latency_pid=""
	transport_pid=""
	loaded_raw="$job_dir/fair-control-icmp-$fair_control_attempt.raw"
	latency_marker="$job_dir/fair-control-latency.running"
	transport_raw="$job_dir/fair-control-transport-$fair_control_attempt.raw"
	transport_values="$job_dir/fair-control-transport-$fair_control_attempt.values"
	transport_sorted="$job_dir/fair-control-transport-$fair_control_attempt.sorted"
	transport_errors="$job_dir/fair-control-transport-$fair_control_attempt.errors"
	cpu_values="$job_dir/fair-control-cpu-$fair_control_attempt.values"
	cpu_marker="$job_dir/fair-control-cpu.running"
	: > "$loaded_raw"
	: > "$transport_raw"
	: > "$transport_values"
	: > "$cpu_values"
	: > "$cpu_marker"
	: > "$latency_marker"

	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
		if [ "${AUTOTUNE_MOCK_FAIR_CONTROL_BAD:-0}" = 1 ]; then
			fair_control_icmp_base=310
			fair_control_transport_raw='[310.0,320.0,330.0,340.0]'
		else
			fair_control_icmp_base=20
			fair_control_transport_raw='[20.0,22.0,23.0,24.0]'
		fi
		printf '%s\n' \
			"[1.00000] 1.1.1.1 : [0], 64 bytes, ${fair_control_icmp_base}.0 ms (${fair_control_icmp_base}.0 avg, 0% loss)" \
			"[1.10000] 9.9.9.9 : [0], 64 bytes, $((fair_control_icmp_base + 1)).0 ms ($((fair_control_icmp_base + 1)).0 avg, 0% loss)" \
			"[1.20000] 8.8.8.8 : [0], 64 bytes, $((fair_control_icmp_base + 2)).0 ms ($((fair_control_icmp_base + 2)).0 avg, 0% loss)" \
			"[2.00000] 1.1.1.1 : [1], 64 bytes, $((fair_control_icmp_base + 2)).0 ms ($((fair_control_icmp_base + 1)).0 avg, 0% loss)" \
			"[2.10000] 9.9.9.9 : [1], 64 bytes, $((fair_control_icmp_base + 3)).0 ms ($((fair_control_icmp_base + 2)).0 avg, 0% loss)" \
			"[2.20000] 8.8.8.8 : [1], 64 bytes, $((fair_control_icmp_base + 4)).0 ms ($((fair_control_icmp_base + 3)).0 avg, 0% loss)" \
			"[3.00000] 1.1.1.1 : [2], 64 bytes, $((fair_control_icmp_base + 4)).0 ms ($((fair_control_icmp_base + 2)).0 avg, 0% loss)" \
			"[3.10000] 9.9.9.9 : [2], 64 bytes, $((fair_control_icmp_base + 5)).0 ms ($((fair_control_icmp_base + 3)).0 avg, 0% loss)" \
			"[3.20000] 8.8.8.8 : [2], 64 bytes, $((fair_control_icmp_base + 6)).0 ms ($((fair_control_icmp_base + 4)).0 avg, 0% loss)" \
			"[4.00000] 1.1.1.1 : [3], 64 bytes, $((fair_control_icmp_base + 6)).0 ms ($((fair_control_icmp_base + 3)).0 avg, 0% loss)" \
			"[4.10000] 9.9.9.9 : [3], 64 bytes, $((fair_control_icmp_base + 7)).0 ms ($((fair_control_icmp_base + 4)).0 avg, 0% loss)" \
			"[4.20000] 8.8.8.8 : [3], 64 bytes, $((fair_control_icmp_base + 8)).0 ms ($((fair_control_icmp_base + 5)).0 avg, 0% loss)" > "$loaded_raw"
		printf '%s\n' 12.0 > "$cpu_values"
		printf '%s\n' \
			"{\"index\":1,\"backend\":\"$transport_probe_reported_backend\",\"endpoint\":\"$transport_probe_endpoint\",\"raw_ms\":$fair_control_transport_raw,\"trusted\":true,\"connection_reused\":true}" \
			"{\"index\":2,\"backend\":\"$transport_probe_reported_backend\",\"endpoint\":\"$transport_probe_endpoint\",\"raw_ms\":$fair_control_transport_raw,\"trusted\":true,\"connection_reused\":true}" \
			"{\"index\":3,\"backend\":\"$transport_probe_reported_backend\",\"endpoint\":\"$transport_probe_endpoint\",\"raw_ms\":$fair_control_transport_raw,\"trusted\":true,\"connection_reused\":true}" \
			"{\"index\":4,\"backend\":\"$transport_probe_reported_backend\",\"endpoint\":\"$transport_probe_endpoint\",\"raw_ms\":$fair_control_transport_raw,\"trusted\":true,\"connection_reused\":true}" > "$transport_raw"
	else
		cpu_monitor "$cpu_values" "$cpu_marker" &
		cpu_pid="$!"
		cpu_starttime="$(proc_starttime "$cpu_pid" 2>/dev/null)"
		is_positive_uint "$cpu_starttime" || {
			stop_validation_monitors >/dev/null 2>&1 || true
			fair_control_active=0
			return 1
		}
		start_transport_latency_monitor "$transport_raw" "$transport_errors" || {
			stop_validation_monitors >/dev/null 2>&1 || true
			fair_control_active=0
			return 1
		}
		icmp_latency_monitor "$loaded_raw" "$latency_marker" &
		latency_pid="$!"
		latency_starttime="$(proc_starttime "$latency_pid" 2>/dev/null)"
		is_positive_uint "$latency_starttime" || {
			stop_validation_monitors >/dev/null 2>&1 || true
			fair_control_active=0
			return 1
		}
	fi
	return 0
}

stop_fair_control_monitors() {
	[ "${fair_control_active:-0}" = 1 ] || return 0
	stop_validation_monitors || return 1
	fair_control_active=0
	return 0
}

evaluate_fair_control() {
	fair_control_result="$1"
	fair_control_valid=true
	fair_control_reason=ok
	fair_control_direction="$(extract_json "$fair_control_result" '@.test_direction')"
	fair_control_bypassed="$(extract_json "$fair_control_result" '@.shaper_bypassed')"
	fair_control_sqm_paused="$(extract_json "$fair_control_result" '@.sqm_paused')"
	fair_control_sqm_bypass_mode="$(extract_json "$fair_control_result" '@.sqm_bypass_mode')"
	if [ "$fair_control_direction" != both ]; then
		fair_control_valid=false
		fair_control_reason=control-direction-invalid
	elif [ "$fair_control_bypassed" != true ]; then
		fair_control_valid=false
		fair_control_reason=control-shaper-proof-invalid
	elif [ "${temp_shaper_active:-0}" != 0 ]; then
		fair_control_valid=false
		fair_control_reason=control-sqm-proof-invalid
	else
		case "$fair_control_sqm_bypass_mode:$fair_control_sqm_paused" in
			paused-managed:true|already-unshaped:false) ;;
			*)
				fair_control_valid=false
				fair_control_reason=control-sqm-proof-invalid
				;;
		esac
	fi
	fair_control_icmp_stats="$job_dir/fair-control-icmp-$fair_control_attempt.tsv"
	if [ "$fair_control_valid" = true ] &&
	   ! build_icmp_evidence "$loaded_raw" "$reflectors" "$fair_control_icmp_stats" loaded 3 3; then
		fair_control_valid=false
		fair_control_reason=control-icmp-insufficient
	elif [ "$fair_control_valid" = true ] &&
	     ! classify_loaded_icmp_evidence "$fair_control_icmp_stats" "$job_dir/icmp-baseline-reflectors.tsv"; then
		fair_control_valid=false
		fair_control_reason=control-icmp-inconsistent
	fi
	if [ "$fair_control_valid" = true ]; then
		fair_control_loaded="$(latency_stats "$loaded_raw")" || {
			fair_control_valid=false
			fair_control_reason=control-icmp-statistics
		}
	fi
	if [ "$fair_control_valid" = true ]; then
		set -- $fair_control_loaded
		fair_control_icmp_median_ms="$1"
		fair_control_icmp_p95_ms="$2"
		fair_control_icmp_max_ms="$3"
		fair_control_icmp_samples="$4"
		fair_control_loss_percent="$(packet_loss_percent "$loaded_raw")"
		[ -n "$fair_control_loss_percent" ] || {
			fair_control_valid=false
			fair_control_reason=control-loss-unavailable
		}
	fi
	if [ "$fair_control_valid" = true ] &&
	   ! validate_transport_evidence "$transport_raw" "$transport_values" 4 12; then
		fair_control_valid=false
		fair_control_reason="$transport_evidence_reason"
	fi
	if [ "$fair_control_valid" = true ]; then
		fair_control_transport="$(numeric_latency_stats "$transport_values" "$transport_sorted")" || {
			fair_control_valid=false
			fair_control_reason=control-transport-statistics
		}
	fi
	fair_control_cpu_fields="$(cpu_peak_fields "$cpu_values" 2>/dev/null)"
	fair_control_cpu_sustained_fields="$(cpu_sustained_fields "$cpu_values" "${validation_cpu_max_percent:-100}" 2>/dev/null)"
	if [ -z "$fair_control_cpu_fields" ] || [ -z "$fair_control_cpu_sustained_fields" ]; then
		fair_control_valid=false
		fair_control_reason=control-cpu-unavailable
	else
		set -- $fair_control_cpu_fields
		fair_control_cpu_peak="$1"
		fair_control_cpu_total_peak="$2"
		fair_control_cpu_core_peak="$3"
		fair_control_softirq_peak="$4"
		set -- $fair_control_cpu_sustained_fields
		fair_control_cpu_mean="$1"
		fair_control_cpu_p95="$2"
		fair_control_cpu_samples="$3"
		fair_control_cpu_over_limit_samples="$4"
		fair_control_cpu_longest_over_limit="$5"
		fair_control_softirq_p95="$6"
	fi
	if [ "$fair_control_valid" != true ]; then
		fair_control_json="{\"available\":false,\"measurement_evidence\":{\"valid\":false,\"reason\":\"$(json_escape "$fair_control_reason")\"}}"
		return 0
	fi
	set -- $fair_control_transport
	fair_control_transport_median_ms="$1"
	fair_control_transport_p95_ms="$2"
	fair_control_transport_max_ms="$3"
	fair_control_transport_samples="$4"
	fair_control_icmp_delta_ms="$(nonnegative_delta "$fair_control_icmp_p95_ms" "$idle_p95_ms")"
	fair_control_transport_delta_ms="$(nonnegative_delta "$fair_control_transport_p95_ms" "$transport_idle_p95_ms")"
	fair_control_effective_delta_ms="$(maximum_number "$fair_control_icmp_delta_ms" "$fair_control_transport_delta_ms")"
	fair_control_grade="$(quality_grade_for_delta "$fair_control_effective_delta_ms")"
	fair_control_json="{\"available\":true,\"measurement_evidence\":{\"valid\":true,\"reason\":\"ok\",\"test_direction\":\"both\",\"shaper_bypassed\":true,\"sqm_paused\":$fair_control_sqm_paused,\"sqm_bypass_mode\":\"$(json_escape "$fair_control_sqm_bypass_mode")\"},\"grade\":\"$(json_escape "$fair_control_grade")\",\"effective_delta_ms\":$fair_control_effective_delta_ms,\"throughput\":{\"download_kbps\":$(extract_json "$fair_control_result" '@.download_kbps'),\"upload_kbps\":$(extract_json "$fair_control_result" '@.upload_kbps')},\"icmp_latency\":{\"median_ms\":$fair_control_icmp_median_ms,\"p95_ms\":$fair_control_icmp_p95_ms,\"max_ms\":$fair_control_icmp_max_ms,\"idle_p95_ms\":$idle_p95_ms,\"delta_p95_ms\":$fair_control_icmp_delta_ms,\"samples\":$fair_control_icmp_samples,\"loss_percent\":$fair_control_loss_percent},\"transport_latency\":{\"backend\":\"$(json_escape "$transport_probe_backend")\",\"endpoint\":\"$(json_escape "$transport_probe_endpoint")\",\"median_ms\":$fair_control_transport_median_ms,\"p95_ms\":$fair_control_transport_p95_ms,\"max_ms\":$fair_control_transport_max_ms,\"idle_p95_ms\":$transport_idle_p95_ms,\"delta_p95_ms\":$fair_control_transport_delta_ms,\"samples\":$fair_control_transport_samples},\"cpu_peak_percent\":$fair_control_cpu_peak,\"cpu\":{\"effective_peak_percent\":$fair_control_cpu_peak,\"total_peak_percent\":$fair_control_cpu_total_peak,\"max_core_peak_percent\":$fair_control_cpu_core_peak,\"softirq_peak_percent\":$fair_control_softirq_peak,\"mean_effective_percent\":$fair_control_cpu_mean,\"p95_effective_percent\":$fair_control_cpu_p95,\"samples\":$fair_control_cpu_samples,\"over_limit_samples\":$fair_control_cpu_over_limit_samples,\"longest_over_limit_samples\":$fair_control_cpu_longest_over_limit,\"p95_softirq_percent\":$fair_control_softirq_p95},\"forwarded_background\":$(phase_background_json)}"
}

run_speedtest_with_bypass_scope() {
	scoped_bypass_requested="$1"
	shift
	scoped_bypass_was_set=false
	scoped_bypass_previous=""
	if [ "${speedtest_bypass_scope+x}" = x ]; then
		scoped_bypass_was_set=true
		scoped_bypass_previous="$speedtest_bypass_scope"
	fi
	speedtest_bypass_scope="$scoped_bypass_requested"
	run_speedtest_with_timeout "$@"
	scoped_bypass_rc="$?"
	if [ "$scoped_bypass_was_set" = true ]; then
		speedtest_bypass_scope="$scoped_bypass_previous"
	else
		unset speedtest_bypass_scope
	fi
	return "$scoped_bypass_rc"
}

run_validation_direction_phase() {
	phase_direction="$1"
	phase_validation_attempt="$2"
	phase_topology="${3:-both_shaped}"
	case "$phase_topology" in
		both_shaped)
			phase_kind=shaped
			phase_speedtest_mode=shaped
			phase_status_topology="CAKE on download and upload"
			;;
		upload_only_shaped)
			[ "$phase_direction" = both ] ||
				fail "Upload-only topology evidence requires simultaneous download and upload load."
			phase_kind=upload-only-shaped
			phase_speedtest_mode=shaped
			phase_status_topology="upload CAKE only; download ingress bypassed"
			;;
		download_only_shaped)
			[ "$phase_direction" = both ] ||
				fail "Download-only topology evidence requires simultaneous download and upload load."
			phase_kind=download-only-shaped
			phase_speedtest_mode=shaped
			phase_status_topology="download CAKE only; upload egress bypassed"
			;;
		*) fail "Unknown validation topology $phase_topology." ;;
	esac
	case "$phase_topology" in
		upload_only_shaped)
			bypass_temporary_ingress ||
				fail "Unable to establish the owned temporary upload-only CAKE topology."
			;;
		download_only_shaped)
			bypass_temporary_egress ||
				fail "Unable to establish the owned temporary download-only CAKE topology."
			;;
	esac
	phase_background_attempt=1
	while [ "$phase_background_attempt" -le 2 ]; do
		cpu_pid=""
		latency_pid=""
		transport_pid=""
		loaded_raw="$job_dir/loaded-$phase_topology-$phase_direction-$phase_validation_attempt-$phase_background_attempt.raw"
		latency_marker="$job_dir/latency-$phase_direction.running"
		transport_raw="$job_dir/transport-loaded-$phase_topology-$phase_direction-$phase_validation_attempt-$phase_background_attempt.raw"
		transport_values="$job_dir/transport-loaded-$phase_topology-$phase_direction-$phase_validation_attempt-$phase_background_attempt.values"
		transport_sorted="$job_dir/transport-loaded-$phase_topology-$phase_direction-$phase_validation_attempt-$phase_background_attempt.sorted"
		transport_errors="$job_dir/transport-loaded-$phase_topology-$phase_direction-$phase_validation_attempt-$phase_background_attempt.errors"
		cpu_values="$job_dir/cpu-$phase_topology-$phase_direction-$phase_validation_attempt-$phase_background_attempt.values"
		cpu_marker="$job_dir/cpu-$phase_direction.running"
		: > "$loaded_raw"
		: > "$transport_raw"
		: > "$transport_values"
		: > "$cpu_values"
		: > "$cpu_marker"
		: > "$latency_marker"

		if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_SHAPER:-0}" = 1 ]; then
			printf '%s\n' \
				'[1.00000] 1.1.1.1 : [0], 64 bytes, 20.0 ms (20.0 avg, 0% loss)' \
				'[1.10000] 9.9.9.9 : [0], 64 bytes, 21.0 ms (21.0 avg, 0% loss)' \
				'[1.20000] 8.8.8.8 : [0], 64 bytes, 22.0 ms (22.0 avg, 0% loss)' \
				'[2.00000] 1.1.1.1 : [1], 64 bytes, 22.0 ms (21.0 avg, 0% loss)' \
				'[2.10000] 9.9.9.9 : [1], 64 bytes, 23.0 ms (22.0 avg, 0% loss)' \
				'[2.20000] 8.8.8.8 : [1], 64 bytes, 24.0 ms (23.0 avg, 0% loss)' \
				'[3.00000] 1.1.1.1 : [2], 64 bytes, 24.0 ms (22.0 avg, 0% loss)' \
				'[3.10000] 9.9.9.9 : [2], 64 bytes, 25.0 ms (23.0 avg, 0% loss)' \
				'[3.20000] 8.8.8.8 : [2], 64 bytes, 26.0 ms (24.0 avg, 0% loss)' \
				'[4.00000] 1.1.1.1 : [3], 64 bytes, 26.0 ms (23.0 avg, 0% loss)' \
				'[4.10000] 9.9.9.9 : [3], 64 bytes, 27.0 ms (24.0 avg, 0% loss)' \
				'[4.20000] 8.8.8.8 : [3], 64 bytes, 28.0 ms (25.0 avg, 0% loss)' > "$loaded_raw"
			if [ "${AUTOTUNE_MOCK_ICMP_RATE_LIMIT:-0}" = 1 ]; then
				printf '%s\n' '[5.00000] 1.1.1.1 : [4], timed out (NaN avg, 20% loss)' >> "$loaded_raw"
			fi
			if [ "${AUTOTUNE_MOCK_VARIABLE_DIRECTIONAL_NO_EFFECT:-0}" = 1 ]; then
				printf '%s\n' 12.0 > "$cpu_values"
				case "$phase_direction:$phase_validation_attempt" in
					download:1) phase_test_transport_raw='[80.0,82.0,83.0,84.0]' ;;
					download:2) phase_test_transport_raw='[40.0,42.0,43.0,44.0]' ;;
					download:3) phase_test_transport_raw='[39.0,41.0,42.0,43.0]' ;;
					download:*) phase_test_transport_raw='[38.0,40.0,41.0,42.0]' ;;
					*) phase_test_transport_raw='[40.0,42.0,43.0,44.0]' ;;
				esac
			elif [ "${AUTOTUNE_MOCK_BIDI_HIGH_LATENCY:-0}" = 1 ] &&
			   [ "$phase_direction" = both ] &&
			   { [ "$phase_topology" = both_shaped ] ||
			     { [ "$phase_topology" = upload_only_shaped ] &&
			       [ "${AUTOTUNE_MOCK_UPLOAD_ONLY_SAFE:-0}" != 1 ]; } ||
			     { [ "$phase_topology" = download_only_shaped ] &&
			       [ "${AUTOTUNE_MOCK_DOWNLOAD_ONLY_SAFE:-0}" != 1 ]; }; }; then
				printf '%s\n' 35.0 > "$cpu_values"
				# Miss Best overall's A target, but remain inside the adjacent
				# B-grade manual-review envelope used by the lifecycle fixture.
				phase_test_transport_raw='[35.0,40.0,45.0,55.0]'
			elif [ "${AUTOTUNE_MOCK_COMPUTE_CEILING:-0}" = 1 ]; then
				printf '%s\n' 97.0 > "$cpu_values"
				phase_test_transport_raw='[20.0,22.0,23.0,24.0]'
			elif [ "${AUTOTUNE_MOCK_RC16:-0}" = 1 ] ||
			   [ "${AUTOTUNE_MOCK_FAIR_SHAPED_BAD:-0}" = 1 ]; then
				printf '%s\n' 53.2 > "$cpu_values"
				phase_test_transport_raw='[230.0,240.0,250.0,480.0]'
			else
				printf '%s\n' 12.0 > "$cpu_values"
				phase_test_transport_raw='[20.0,22.0,23.0,24.0]'
			fi
			printf '%s\n' \
				"{\"index\":1,\"backend\":\"$transport_probe_reported_backend\",\"endpoint\":\"$transport_probe_endpoint\",\"raw_ms\":$phase_test_transport_raw,\"trusted\":true,\"connection_reused\":true}" \
				"{\"index\":2,\"backend\":\"$transport_probe_reported_backend\",\"endpoint\":\"$transport_probe_endpoint\",\"raw_ms\":$phase_test_transport_raw,\"trusted\":true,\"connection_reused\":true}" \
				"{\"index\":3,\"backend\":\"$transport_probe_reported_backend\",\"endpoint\":\"$transport_probe_endpoint\",\"raw_ms\":$phase_test_transport_raw,\"trusted\":true,\"connection_reused\":true}" \
				"{\"index\":4,\"backend\":\"$transport_probe_reported_backend\",\"endpoint\":\"$transport_probe_endpoint\",\"raw_ms\":$phase_test_transport_raw,\"trusted\":true,\"connection_reused\":true}" > "$transport_raw"
		else
			cpu_monitor "$cpu_values" "$cpu_marker" &
			cpu_pid="$!"
			cpu_starttime="$(proc_starttime "$cpu_pid" 2>/dev/null)"
			is_positive_uint "$cpu_starttime" || fail "Unable to register the CPU monitor process."
			start_transport_latency_monitor "$transport_raw" "$transport_errors" ||
				fail "Unable to register the transport-latency monitor process."
			icmp_latency_monitor "$loaded_raw" "$latency_marker" &
			latency_pid="$!"
			latency_starttime="$(proc_starttime "$latency_pid" 2>/dev/null)"
			is_positive_uint "$latency_starttime" || fail "Unable to register the ICMP monitor process."
		fi

		write_status shaped 87 "Running $phase_direction validation phase $phase_validation_attempt with $phase_status_topology on the pinned server (traffic check $phase_background_attempt)"
		phase_background_kind="$phase_kind"
		if ! temporary_phase_shaper_owned; then
			stop_validation_monitors ||
				fail "A validation monitor could not be terminated; crash recovery remains armed."
			phase_evidence_complete=false
			measurement_inconclusive "shaped-$phase_direction" temporary-shaper-precondition-failed
		fi
		start_phase_background_counter "$dl_base" "$ul_base"
		phase_result_file="$job_dir/$phase_kind-$phase_direction-$phase_validation_attempt-$phase_background_attempt.result"
		phase_speedtest_ok=true
		run_speedtest_with_timeout "$phase_result_file" \
			"$job_name" "$target_if" run "$backend" "$phase_speedtest_mode" "$route_mode" "$mwan3_member" "$phase_direction" ||
			phase_speedtest_ok=false
		if [ "$phase_speedtest_ok" != true ]; then
			stop_phase_background_counter
			stop_validation_monitors ||
				fail "A validation monitor could not be terminated; crash recovery remains armed."
			phase_failure_reason="${speedtest_supervisor_reason:-unknown}"
			phase_failure_entry="{\"phase\":\"$phase_kind\",\"topology\":\"$phase_topology\",\"direction\":\"$phase_direction\",\"validation_attempt\":$phase_validation_attempt,\"attempt\":$phase_background_attempt,\"measurement_evidence\":{\"valid\":false,\"reason\":\"$(json_escape "$phase_failure_reason")\"},\"forwarded_background\":$(phase_background_json)}"
			if [ -n "${phase_background_runs_json:-}" ]; then
				phase_background_runs_json="$phase_background_runs_json,$phase_failure_entry"
			else
				phase_background_runs_json="$phase_failure_entry"
			fi
			# A remote server can reset one transfer even though the selected
			# route and temporary CAKE pair remain valid. Retry exactly once at
			# the identical candidate, direction and pinned server. A second exit
			# fails closed; earlier candidate evidence is never silently reused.
			case "$phase_failure_reason:$phase_background_attempt" in
				timeout:1|helper-exit:*:1)
				record_speedtest_retry_event "$phase_kind-$phase_direction-validation" "$phase_background_attempt"
					temporary_phase_shaper_owned ||
						fail "Temporary shaper ownership changed after a failed $phase_direction-only speed test."
					if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_PREFLIGHT:-0}" != 1 ]; then
						inspect_autotune_route ||
							fail "Selected route went offline after a failed $phase_direction-only speed test."
						[ "$route_identity" = "$calibration_route_identity" ] ||
							fail "WAN route identity changed after a failed $phase_direction-only speed test."
					fi
					[ "$phase_failure_reason" != timeout ] || {
						current_progress=87
						speedtest_retry_backoff "$phase_direction-only shaped validation"
					}
					phase_background_attempt=$((phase_background_attempt + 1))
					continue
					;;
			esac
			[ "$phase_failure_reason" != timeout ] || {
				record_speedtest_retry_event "$phase_kind-$phase_direction-validation" "$phase_background_attempt"
				speedtest_timeout_inconclusive "shaped-$phase_direction" "$phase_direction-only shaped validation"
			}
			fail "The $phase_direction-only shaped validation speed test failed in the supervisor (${speedtest_supervisor_reason:-unknown})."
		fi
		if ! temporary_phase_shaper_owned; then
			stop_phase_background_counter
			stop_validation_monitors ||
				fail "A validation monitor could not be terminated; crash recovery remains armed."
			rm -f "$phase_result_file"
			phase_evidence_complete=false
			measurement_inconclusive "shaped-$phase_direction" temporary-shaper-postcondition-failed
		fi
		phase_result="$(cat "$phase_result_file" 2>/dev/null)"
		rm -f "$phase_result_file"
		stop_phase_background_counter
		stop_validation_monitors ||
			fail "A validation monitor could not be terminated; crash recovery remains armed."
		phase_qdisc_stats_json="$(temporary_qdisc_stats_json "$phase_direction")"
		phase_backend="$(extract_json "$phase_result" '@.backend')"
		[ "$phase_backend" = "$backend" ] ||
			fail "Speed test backend changed from $backend to ${phase_backend:-unknown} during $phase_direction-only validation."
		phase_reported_direction="$(extract_json "$phase_result" '@.test_direction')"
		[ "$phase_reported_direction" = "$phase_direction" ] ||
			fail "Speed test helper reported ${phase_reported_direction:-no direction} for the requested $phase_direction-only validation phase."
		phase_helper_shaper_bypassed="$(extract_json "$phase_result" '@.shaper_bypassed')"
		phase_helper_sqm_paused="$(extract_json "$phase_result" '@.sqm_paused')"
		phase_helper_sqm_bypass_mode="$(extract_json "$phase_result" '@.sqm_bypass_mode')"
		phase_shaper_bypassed="$phase_helper_shaper_bypassed"
		phase_sqm_paused="$phase_helper_sqm_paused"
		phase_sqm_bypass_mode="$phase_helper_sqm_bypass_mode"

		case "$phase_direction" in
			download) phase_achieved_kbps="$(extract_json "$phase_result" '@.download_kbps')" ;;
			upload) phase_achieved_kbps="$(extract_json "$phase_result" '@.upload_kbps')" ;;
			both)
				phase_achieved_dl_kbps="$(extract_json "$phase_result" '@.download_kbps')"
				phase_achieved_ul_kbps="$(extract_json "$phase_result" '@.upload_kbps')"
				is_positive_uint "$phase_achieved_dl_kbps" &&
					is_positive_uint "$phase_achieved_ul_kbps" ||
					fail "The bidirectional validation returned no download or upload rate."
				phase_achieved_kbps=0
				;;
		esac
		[ "$phase_direction" = both ] ||
			is_positive_uint "$phase_achieved_kbps" || fail "The $phase_direction-only validation returned no rate."

		phase_measurement_valid=true
		phase_measurement_reason=ok
		case "$phase_topology" in
			both_shaped)
				if [ "$phase_helper_shaper_bypassed" != false ] || [ "$phase_helper_sqm_paused" != false ]; then
					phase_measurement_valid=false
					phase_measurement_reason=shaped-shaper-proof-invalid
				fi
				;;
			upload_only_shaped)
				if [ "$phase_helper_shaper_bypassed" != false ] ||
				   [ "$phase_helper_sqm_paused" != false ] ||
				   [ "$phase_helper_sqm_bypass_mode" != none ] ||
				   ! temporary_upload_only_shaper_owned; then
					phase_measurement_valid=false
					phase_measurement_reason=upload-only-shaper-proof-invalid
				else
					phase_shaper_bypassed=true
					phase_sqm_paused=false
					phase_sqm_bypass_mode=ingress-only-autotune
				fi
				;;
			download_only_shaped)
				if [ "$phase_helper_shaper_bypassed" != false ] ||
				   [ "$phase_helper_sqm_paused" != false ] ||
				   [ "$phase_helper_sqm_bypass_mode" != none ] ||
				   ! temporary_download_only_shaper_owned; then
					phase_measurement_valid=false
					phase_measurement_reason=download-only-shaper-proof-invalid
				else
					phase_shaper_bypassed=true
					phase_sqm_paused=false
					phase_sqm_bypass_mode=egress-only-autotune
				fi
				;;
		esac
		phase_icmp_stats="$job_dir/icmp-loaded-$phase_topology-$phase_direction-$phase_validation_attempt-$phase_background_attempt.tsv"
		if [ "$phase_measurement_valid" = true ] &&
		   ! build_icmp_evidence "$loaded_raw" "$reflectors" "$phase_icmp_stats" loaded 3 3; then
			phase_measurement_valid=false
			phase_measurement_reason=icmp-insufficient-per-reflector-samples
		elif [ "$phase_measurement_valid" = true ] &&
		     ! classify_loaded_icmp_evidence "$phase_icmp_stats" "$job_dir/icmp-baseline-reflectors.tsv"; then
			phase_measurement_valid=false
			case "$icmp_evidence_class" in
				rate-limit) phase_measurement_reason="icmp-rate-limit-suspected:$icmp_evidence_detail" ;;
				disagreement) phase_measurement_reason=icmp-reflector-family-disagreement ;;
				*) phase_measurement_reason=icmp-evidence-incomplete ;;
			esac
		fi
		if [ "$phase_measurement_valid" = true ]; then
			phase_loaded="$(latency_stats "$loaded_raw")" || {
				phase_measurement_valid=false
				phase_measurement_reason=icmp-no-aggregate-samples
			}
		fi
		if [ "$phase_measurement_valid" = true ]; then
			set -- $phase_loaded
			phase_loaded_median_ms="$1"
			phase_loaded_p95_ms="$2"
			phase_loaded_max_ms="$3"
			phase_loaded_samples="$4"
			phase_loss_percent="$(packet_loss_percent "$loaded_raw")"
			[ -n "$phase_loss_percent" ] || {
				phase_measurement_valid=false
				phase_measurement_reason=icmp-loss-unavailable
			}
		fi
		if [ "$phase_measurement_valid" = true ] &&
		   ! validate_transport_evidence "$transport_raw" "$transport_values" 4 12; then
			phase_measurement_valid=false
			phase_measurement_reason="$transport_evidence_reason"
		fi
		if [ "$phase_measurement_valid" = true ]; then
			phase_transport_loaded="$(numeric_latency_stats "$transport_values" "$transport_sorted")" || {
				phase_measurement_valid=false
				phase_measurement_reason=transport-statistics-unavailable
			}
		fi
		phase_cpu_fields="$(cpu_peak_fields "$cpu_values" 2>/dev/null)"
		phase_cpu_sustained_fields="$(cpu_sustained_fields "$cpu_values" "${validation_cpu_max_percent:-100}" 2>/dev/null)"
		if [ -z "$phase_cpu_fields" ] || [ -z "$phase_cpu_sustained_fields" ]; then
			phase_measurement_valid=false
			phase_measurement_reason=cpu-samples-unavailable
		else
			set -- $phase_cpu_fields
			phase_cpu_peak="$1"
			phase_cpu_total_peak="$2"
			phase_cpu_core_peak="$3"
			phase_softirq_peak="$4"
			set -- $phase_cpu_sustained_fields
			phase_cpu_mean="$1"
			phase_cpu_p95="$2"
			phase_cpu_samples="$3"
			phase_cpu_over_limit_samples="$4"
			phase_cpu_longest_over_limit="$5"
			phase_softirq_p95="$6"
		fi

		if [ "$phase_direction" = both ]; then
			phase_measured_json="{\"download_kbps\":$phase_achieved_dl_kbps,\"upload_kbps\":$phase_achieved_ul_kbps}"
		else
			phase_measured_json="$phase_achieved_kbps"
		fi
		phase_entry="{\"phase\":\"$phase_kind\",\"topology\":\"$phase_topology\",\"direction\":\"$phase_direction\",\"validation_attempt\":$phase_validation_attempt,\"attempt\":$phase_background_attempt,\"measured_kbps\":$phase_measured_json,\"measurement_evidence\":{\"valid\":$phase_measurement_valid,\"reason\":\"$(json_escape "$phase_measurement_reason")\"},\"forwarded_background\":$(phase_background_json)}"
		if [ -n "${phase_background_runs_json:-}" ]; then
			phase_background_runs_json="$phase_background_runs_json,$phase_entry"
		else
			phase_background_runs_json="$phase_entry"
		fi
		if [ "$phase_measurement_valid" != true ]; then
			if [ "$phase_background_attempt" -lt 2 ]; then
				case "$phase_measurement_reason" in
					icmp-rate-limit-suspected:*)
						# Replacing a reflector here used to overwrite the accepted idle
						# baseline while the temporary shaper and loaded phase were active.
						# That can only reduce loaded-minus-idle delay and create a false
						# pass. A different reflector set requires a brand-new clean run.
						phase_evidence_complete=false
						measurement_inconclusive "shaped-$phase_direction" \
							"$phase_measurement_reason-restart-required"
						;;
				esac
				phase_background_attempt=$((phase_background_attempt + 1))
				continue
			fi
			phase_evidence_complete=false
			measurement_inconclusive "shaped-$phase_direction" "$phase_measurement_reason"
		fi

		set -- $phase_transport_loaded
		phase_transport_median_ms="$1"
		phase_transport_p95_ms="$2"
		phase_transport_max_ms="$3"
		phase_transport_samples="$4"
		phase_icmp_delta_ms="$(nonnegative_delta "$phase_loaded_p95_ms" "$idle_p95_ms")"
		phase_transport_delta_ms="$(nonnegative_delta "$phase_transport_p95_ms" "$transport_idle_p95_ms")"
		if [ "${AUTOTUNE_MOCK_RC16:-0}" = 1 ]; then
			phase_icmp_delta_ms=0.19
			phase_loss_percent=7.59
		fi
		phase_observation_json="{\"topology\":\"$phase_topology\",\"direction\":\"$phase_direction\",\"throughput_kbps\":$phase_measured_json,\"measurement_evidence\":{\"valid\":true,\"reason\":\"ok\",\"shaper_bypassed\":$phase_shaper_bypassed,\"sqm_paused\":$phase_sqm_paused,\"sqm_bypass_mode\":\"$(json_escape "$phase_sqm_bypass_mode")\",\"transport_rows\":$transport_evidence_rows},\"icmp_latency\":{\"median_ms\":$phase_loaded_median_ms,\"p95_ms\":$phase_loaded_p95_ms,\"max_ms\":$phase_loaded_max_ms,\"idle_p95_ms\":$idle_p95_ms,\"delta_p95_ms\":$phase_icmp_delta_ms,\"samples\":$phase_loaded_samples,\"loss_percent\":$phase_loss_percent},\"transport_latency\":{\"backend\":\"$(json_escape "$transport_probe_backend")\",\"endpoint\":\"$(json_escape "$transport_probe_endpoint")\",\"median_ms\":$phase_transport_median_ms,\"p95_ms\":$phase_transport_p95_ms,\"max_ms\":$phase_transport_max_ms,\"idle_p95_ms\":$transport_idle_p95_ms,\"delta_p95_ms\":$phase_transport_delta_ms,\"samples\":$phase_transport_samples},\"cpu_peak_percent\":$phase_cpu_peak,\"cpu\":{\"effective_peak_percent\":$phase_cpu_peak,\"total_peak_percent\":$phase_cpu_total_peak,\"max_core_peak_percent\":$phase_cpu_core_peak,\"softirq_peak_percent\":$phase_softirq_peak,\"mean_effective_percent\":$phase_cpu_mean,\"p95_effective_percent\":$phase_cpu_p95,\"samples\":$phase_cpu_samples,\"over_limit_samples\":$phase_cpu_over_limit_samples,\"longest_over_limit_samples\":$phase_cpu_longest_over_limit,\"p95_softirq_percent\":$phase_softirq_p95},\"qdisc\":$phase_qdisc_stats_json,\"forwarded_background\":$(phase_background_json),\"server_id\":\"$(json_escape "$(extract_json "$phase_result" '@.server_id')")\"}"
		if [ "$phase_background_contaminated" != true ]; then
			break
		fi
		phase_contamination_seen=true
		if [ "$phase_background_attempt" -lt 2 ]; then
			phase_background_attempt=$((phase_background_attempt + 1))
			continue
		fi
		if [ "${conservative_mode:-0}" != 1 ]; then
			stage_terminal_json error "{\"state\":\"background-blocked\",\"schema_version\":7,\"error\":\"Forwarded WAN traffic contaminated both $phase_direction-only shaped validation attempts. Retry when quiet or explicitly continue conservatively.\",\"background_blocked\":true,\"retryable\":true,\"stage\":\"shaped-$phase_direction\",\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":${phase_evidence_complete:-false},\"phase_contamination_seen\":true,\"route\":$(route_diagnostics_json),\"background\":$(background_json),\"baseline\":$(baseline_diagnostics_json),\"runs\":[${runs_json:-}],\"phase_background\":[$phase_background_runs_json],\"pinger_plan\":${pinger_plan:-null},\"proposal\":$proposal,\"configuration_written\":false}"
			exit 1
		fi
		if [ "$phase_background_available" != true ]; then
			fail "Forwarded-traffic evidence was unavailable for both $phase_direction-only validation attempts."
		fi
		validation_contaminated=true
		unresolved_background_contamination=true
		case "$phase_direction" in
			download) download_background_unresolved=true ;;
			upload) upload_background_unresolved=true ;;
		esac
		break
	done

	phase_server_id="$(extract_json "$phase_result" '@.server_id')"
	is_positive_uint "$phase_server_id" ||
		fail "The pinned speedtest-go server identity was missing during $phase_direction-only validation."
	if [ "$phase_server_id" != "$selected_server_id" ]; then
		fail "Speed test server changed during $phase_direction-only shaped validation."
	fi
	phase_route_identity="$(extract_json "$phase_result" '@.route_mode')|$(extract_json "$phase_result" '@.mwan3_member')|$(extract_json "$phase_result" '@.route_interface')|$(extract_json "$phase_result" '@.route_source_ip')|$(extract_json "$phase_result" '@.route_fwmark')|$(extract_json "$phase_result" '@.route_table')"
	[ "$phase_route_identity" = "$calibration_route_identity" ] ||
		fail "WAN route identity changed during $phase_direction-only shaped validation."
	[ "$(extract_json "$phase_result" '@.external_ip_after')" = "$selected_external_ip" ] ||
		fail "External IP changed during $phase_direction-only shaped validation."
	case "$phase_topology" in
		upload_only_shaped)
			restore_temporary_ingress ||
				fail "Unable to restore the owned temporary download CAKE ingress after comparison."
			;;
		download_only_shaped)
			restore_temporary_egress ||
				fail "Unable to restore the owned temporary upload CAKE egress after comparison."
			;;
	esac
}

run_shaped_validation() {
	validation_attempt="${1:-1}"
	config_fingerprint_matches || config_changed_inconclusive
	dl_base="$(extract_json "$proposal" '@.download.base_kbps')"
	ul_base="$(extract_json "$proposal" '@.upload.base_kbps')"
	raw_dl_low="$(extract_json "$proposal" '@.download.observed_low_kbps')"
	raw_ul_low="$(extract_json "$proposal" '@.upload.observed_low_kbps')"
	dl_minimum="$(extract_json "$proposal" '@.download.minimum_kbps')"
	ul_minimum="$(extract_json "$proposal" '@.upload.minimum_kbps')"
	dl_maximum="$(extract_json "$proposal" '@.download.maximum_kbps')"
	ul_maximum="$(extract_json "$proposal" '@.upload.maximum_kbps')"
	for required_rate in "$dl_base" "$ul_base" "$raw_dl_low" "$raw_ul_low" \
		"$dl_minimum" "$ul_minimum" "$dl_maximum" "$ul_maximum"; do
		is_positive_uint "$required_rate" || fail "Proposal returned an invalid rate for shaped validation."
	done

	write_status shaped 84 "Temporarily applying candidate CAKE rates for directional validation attempt $validation_attempt"
	prepare_temp_shaper "$dl_base" "$ul_base"
	validation_contaminated=false

	run_validation_direction_phase download "$validation_attempt"
	shaped_dl="$phase_achieved_kbps"
	download_phase_observation_json="$phase_observation_json"
	dl_loaded_median_ms="$phase_loaded_median_ms"
	dl_loaded_p95_ms="$phase_loaded_p95_ms"
	dl_loaded_max_ms="$phase_loaded_max_ms"
	dl_loaded_samples="$phase_loaded_samples"
	dl_icmp_delta_ms="$phase_icmp_delta_ms"
	dl_loss_percent="$phase_loss_percent"
	dl_transport_median_ms="$phase_transport_median_ms"
	dl_transport_p95_ms="$phase_transport_p95_ms"
	dl_transport_max_ms="$phase_transport_max_ms"
	dl_transport_samples="$phase_transport_samples"
	dl_transport_delta_ms="$phase_transport_delta_ms"
	dl_cpu_peak="$phase_cpu_peak"
	dl_cpu_total_peak="$phase_cpu_total_peak"
	dl_cpu_core_peak="$phase_cpu_core_peak"
	dl_softirq_peak="$phase_softirq_peak"

	run_validation_direction_phase upload "$validation_attempt"
	shaped_ul="$phase_achieved_kbps"
	upload_phase_observation_json="$phase_observation_json"
	ul_loaded_median_ms="$phase_loaded_median_ms"
	ul_loaded_p95_ms="$phase_loaded_p95_ms"
	ul_loaded_max_ms="$phase_loaded_max_ms"
	ul_loaded_samples="$phase_loaded_samples"
	ul_icmp_delta_ms="$phase_icmp_delta_ms"
	ul_loss_percent="$phase_loss_percent"
	ul_transport_median_ms="$phase_transport_median_ms"
	ul_transport_p95_ms="$phase_transport_p95_ms"
	ul_transport_max_ms="$phase_transport_max_ms"
	ul_transport_samples="$phase_transport_samples"
	ul_transport_delta_ms="$phase_transport_delta_ms"
	ul_cpu_peak="$phase_cpu_peak"
	ul_cpu_total_peak="$phase_cpu_total_peak"
	ul_cpu_core_peak="$phase_cpu_core_peak"
	ul_softirq_peak="$phase_softirq_peak"
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_PREFLIGHT:-0}" != 1 ]; then
		inspect_autotune_route || fail "Selected route went offline during calibration."
		[ "$route_identity" = "$calibration_route_identity" ] ||
			fail "WAN route identity changed during calibration; no configuration was written."
	fi

	typed_validation_decision="$("$daemon_bin" --autotune-validate \
		--profile "$autotune_profile" \
		--dl-observed-low-kbps "$raw_dl_low" \
		--ul-observed-low-kbps "$raw_ul_low" \
		--dl-candidate-kbps "$dl_base" \
		--ul-candidate-kbps "$ul_base" \
		--dl-achieved-kbps "$shaped_dl" \
		--ul-achieved-kbps "$shaped_ul" \
		--dl-min-kbps "$dl_minimum" \
		--ul-min-kbps "$ul_minimum" \
		--dl-max-kbps "$dl_maximum" \
		--ul-max-kbps "$ul_maximum" \
		--dl-icmp-delta-ms "$dl_icmp_delta_ms" \
		--ul-icmp-delta-ms "$ul_icmp_delta_ms" \
		--dl-transport-delta-ms "$dl_transport_delta_ms" \
		--ul-transport-delta-ms "$ul_transport_delta_ms" \
		--dl-loss-percent "$dl_loss_percent" \
		--ul-loss-percent "$ul_loss_percent" \
		--dl-cpu-percent "$dl_cpu_peak" \
		--ul-cpu-percent "$ul_cpu_peak" \
		--candidate-realization-min-percent "$validation_candidate_realization_min_percent" \
		--candidate-realization-max-percent "$validation_candidate_realization_max_percent" \
		--capacity-retention-min-percent "$validation_capacity_retention_min_percent" \
		--icmp-delta-max-ms "$validation_delay_max_ms" \
		--transport-delta-max-ms "$validation_delay_max_ms" \
		--loss-max-percent "$validation_loss_max_percent" \
		--cpu-max-percent "$validation_cpu_max_percent")" ||
		fail "The typed shaped-candidate validator rejected its inputs."

	validation_pass="$(extract_json "$typed_validation_decision" '@.pass')"
	validation_hard_pass="$(extract_json "$typed_validation_decision" '@.hard_pass')"
	validation_safety_pass="$(extract_json "$typed_validation_decision" '@.safety_pass')"
	validation_profile_objectives_met="$(extract_json "$typed_validation_decision" '@.profile_objectives_met')"
	validation_quality_target_met="$(extract_json "$typed_validation_decision" '@.quality_target_met')"
	validation_actual_grade="$(extract_json "$typed_validation_decision" '@.actual_grade')"
	validation_score="$(extract_json "$typed_validation_decision" '@.score')"
	validation_correction_action="$(extract_json "$typed_validation_decision" '@.correction.action')"
	validation_correction_feasible="$(extract_json "$typed_validation_decision" '@.correction.feasible')"
	validation_correction_reason="$(extract_json "$typed_validation_decision" '@.correction.reason')"
	dl_correction_action="$(extract_json "$typed_validation_decision" '@.correction.download.action')"
	ul_correction_action="$(extract_json "$typed_validation_decision" '@.correction.upload.action')"
	dl_correction_proposed_kbps="$(extract_json "$typed_validation_decision" '@.correction.download.proposed_kbps')"
	ul_correction_proposed_kbps="$(extract_json "$typed_validation_decision" '@.correction.upload.proposed_kbps')"
	dl_candidate_realization="$(extract_json "$typed_validation_decision" '@.metrics.download.candidate_realization_percent')"
	ul_candidate_realization="$(extract_json "$typed_validation_decision" '@.metrics.upload.candidate_realization_percent')"
	dl_retention="$(extract_json "$typed_validation_decision" '@.metrics.download.capacity_retention_percent')"
	ul_retention="$(extract_json "$typed_validation_decision" '@.metrics.upload.capacity_retention_percent')"
	effective_loaded_delta_ms="$(extract_json "$typed_validation_decision" '@.metrics.effective_delta_ms')"
	case "$validation_pass:$validation_correction_feasible" in
		true:true|false:true|false:false) ;;
		*) fail "The typed validator returned an invalid decision." ;;
	esac
	for validation_boolean in "$validation_hard_pass" "$validation_safety_pass" \
		"$validation_profile_objectives_met" "$validation_quality_target_met"; do
		case "$validation_boolean" in true|false) ;; *) fail "The typed validator returned invalid safety or quality state." ;; esac
	done
	case "$validation_actual_grade" in A+|A|B|C|D|F) ;; *) fail "The typed validator returned an invalid quality grade." ;; esac
	case "$validation_correction_action" in
		none|increase|decrease|mixed|retry-measurement|infeasible) ;;
		*) fail "The typed validator returned an unknown correction action." ;;
	esac
	[ -n "$validation_score" ] && [ -n "$validation_correction_reason" ] &&
		[ -n "$dl_candidate_realization" ] && [ -n "$ul_candidate_realization" ] &&
		[ -n "$dl_retention" ] && [ -n "$ul_retention" ] &&
		[ -n "$effective_loaded_delta_ms" ] || fail "The typed validator omitted required metrics."
	is_positive_uint "$dl_correction_proposed_kbps" || fail "Typed validator returned no download correction target."
	is_positive_uint "$ul_correction_proposed_kbps" || fail "Typed validator returned no upload correction target."

	validation_metrics_json="$(typed_json_fragment "$typed_validation_decision" metrics)"
	validation_signals_json="$(typed_json_fragment "$typed_validation_decision" signals)"
	validation_gates_json="$(typed_json_fragment "$typed_validation_decision" gates)"
	validation_reasons_json="$(typed_json_fragment "$typed_validation_decision" reasons)"
	validation_warnings_json="$(typed_json_fragment "$typed_validation_decision" warnings)"
	validation_correction_json="$(typed_json_fragment "$typed_validation_decision" correction)"
	[ -n "$validation_metrics_json" ] && [ -n "$validation_signals_json" ] &&
		[ -n "$validation_gates_json" ] && [ -n "$validation_reasons_json" ] && [ -n "$validation_warnings_json" ] &&
		[ -n "$validation_correction_json" ] || fail "Unable to preserve structured typed validation diagnostics."

	loaded_delta_ms="$(maximum_number "$dl_icmp_delta_ms" "$ul_icmp_delta_ms")"
	transport_loaded_delta_ms="$(maximum_number "$dl_transport_delta_ms" "$ul_transport_delta_ms")"
	loss_percent="$(maximum_number "$dl_loss_percent" "$ul_loss_percent")"
	cpu_peak="$(maximum_number "$dl_cpu_peak" "$ul_cpu_peak")"
	loaded_median_ms="$(maximum_number "$dl_loaded_median_ms" "$ul_loaded_median_ms")"
	loaded_p95_ms="$(maximum_number "$dl_loaded_p95_ms" "$ul_loaded_p95_ms")"
	loaded_max_ms="$(maximum_number "$dl_loaded_max_ms" "$ul_loaded_max_ms")"
	loaded_samples=$((dl_loaded_samples + ul_loaded_samples))
	transport_loaded_median_ms="$(maximum_number "$dl_transport_median_ms" "$ul_transport_median_ms")"
	transport_loaded_p95_ms="$(maximum_number "$dl_transport_p95_ms" "$ul_transport_p95_ms")"
	transport_loaded_max_ms="$(maximum_number "$dl_transport_max_ms" "$ul_transport_max_ms")"
	transport_loaded_samples=$((dl_transport_samples + ul_transport_samples))
	validation_json="{\"profile\":\"$(json_escape "$autotune_profile")\",\"pass\":$validation_pass,\"hard_pass\":$validation_hard_pass,\"safety_pass\":$validation_safety_pass,\"profile_objectives_met\":$validation_profile_objectives_met,\"quality_target_met\":$validation_quality_target_met,\"actual_grade\":\"$(json_escape "$validation_actual_grade")\",\"contaminated\":$validation_contaminated,\"score\":$validation_score,\"metrics\":$validation_metrics_json,\"signals\":$validation_signals_json,\"gates\":$validation_gates_json,\"reasons\":$validation_reasons_json,\"warnings\":$validation_warnings_json,\"correction\":$validation_correction_json,\"candidate_base\":{\"download_kbps\":$dl_base,\"upload_kbps\":$ul_base},\"throughput\":{\"download_kbps\":$shaped_dl,\"upload_kbps\":$shaped_ul,\"download_candidate_realization_percent\":$dl_candidate_realization,\"upload_candidate_realization_percent\":$ul_candidate_realization,\"download_capacity_retention_percent\":$dl_retention,\"upload_capacity_retention_percent\":$ul_retention,\"comparison\":\"direction-matched-observed-low\"},\"direction_phases\":{\"download\":$download_phase_observation_json,\"upload\":$upload_phase_observation_json},\"latency\":{\"median_ms\":$loaded_median_ms,\"p95_ms\":$loaded_p95_ms,\"max_ms\":$loaded_max_ms,\"delta_p95_ms\":$loaded_delta_ms,\"samples\":$loaded_samples,\"loss_percent\":$loss_percent},\"transport_latency\":{\"backend\":\"$(json_escape "$transport_probe_backend")\",\"endpoint\":\"$(json_escape "$transport_probe_endpoint")\",\"median_ms\":$transport_loaded_median_ms,\"p95_ms\":$transport_loaded_p95_ms,\"max_ms\":$transport_loaded_max_ms,\"delta_p95_ms\":$transport_loaded_delta_ms,\"samples\":$transport_loaded_samples},\"effective_delta_ms\":$effective_loaded_delta_ms,\"cpu_peak_percent\":$cpu_peak,\"server_id\":\"$(json_escape "$selected_server_id")\",\"decision\":$typed_validation_decision}"
}

run_bidirectional_confirmation() {
	bidirectional_attempt="${1:-1}"
	write_status confirmation 95 "Confirming the selected pair under simultaneous download and upload load"
	run_validation_direction_phase both "$bidirectional_attempt"
	bidirectional_download_kbps="$phase_achieved_dl_kbps"
	bidirectional_upload_kbps="$phase_achieved_ul_kbps"
	bidirectional_download_realization="$(awk -v achieved="$bidirectional_download_kbps" -v candidate="$dl_base" 'BEGIN {
		if (candidate <= 0) exit 1
		printf "%.1f", achieved * 100 / candidate
	}')" || fail "Unable to calculate bidirectional download realization."
	bidirectional_upload_realization="$(awk -v achieved="$bidirectional_upload_kbps" -v candidate="$ul_base" 'BEGIN {
		if (candidate <= 0) exit 1
		printf "%.1f", achieved * 100 / candidate
	}')" || fail "Unable to calculate bidirectional upload realization."
	bidirectional_effective_delta_ms="$(maximum_number "$phase_icmp_delta_ms" "$phase_transport_delta_ms")"
	bidirectional_grade="$(quality_grade_for_delta "$bidirectional_effective_delta_ms")"
	bidirectional_latency_pass="$(awk -v actual="$bidirectional_effective_delta_ms" -v limit="$validation_delay_max_ms" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	bidirectional_loss_pass="$(awk -v actual="$phase_loss_percent" -v limit="$validation_loss_max_percent" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	bidirectional_realization_pass="$(awk -v dl="$bidirectional_download_realization" \
		-v ul="$bidirectional_upload_realization" -v minimum="$validation_candidate_realization_min_percent" 'BEGIN {
		print (dl >= minimum && ul >= minimum) ? "true" : "false"
	}')"
	bidirectional_realization_safety_pass="$(awk -v dl="$bidirectional_download_realization" \
		-v ul="$bidirectional_upload_realization" -v maximum="$validation_candidate_realization_max_percent" 'BEGIN {
		print (dl >= 50 && ul >= 50 && dl <= maximum && ul <= maximum) ? "true" : "false"
	}')"
	bidirectional_latency_review_pass="$(awk -v actual="$bidirectional_effective_delta_ms" \
		-v limit="$validation_manual_latency_review_max_ms" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	bidirectional_safety_pass=false
	[ "$bidirectional_loss_pass" = true ] && [ "$bidirectional_realization_safety_pass" = true ] &&
		[ "$bidirectional_latency_review_pass" = true ] &&
		bidirectional_safety_pass=true
	bidirectional_auto_apply_pass=false
	[ "$bidirectional_safety_pass" = true ] && [ "$bidirectional_latency_pass" = true ] &&
		[ "$bidirectional_realization_pass" = true ] &&
		bidirectional_auto_apply_pass=true
	bidirectional_cpu_warning="$(awk -v actual="$phase_cpu_peak" -v limit="$validation_cpu_max_percent" 'BEGIN {
		print (actual > limit) ? "true" : "false"
	}')"
	bidirectional_advisory=none
	if [ "$bidirectional_latency_pass" != true ]; then
		bidirectional_advisory=loaded-latency-target-missed
	elif [ "$bidirectional_loss_pass" != true ]; then
		bidirectional_advisory=packet-loss-limit-exceeded
	elif [ "$bidirectional_realization_pass" != true ]; then
		bidirectional_advisory=simultaneous-throughput-confidence-low
	elif [ "$bidirectional_cpu_warning" = true ]; then
		# CPU remains advisory by design: a short peak must never discard a
		# latency-safe proposal. It is still exposed prominently to Review.
		bidirectional_advisory=cpu-load-high
	fi
	bidirectional_confirmation_json="{\"tested\":true,\"safety_pass\":$bidirectional_safety_pass,\"auto_apply_pass\":$bidirectional_auto_apply_pass,\"grade\":\"$(json_escape "$bidirectional_grade")\",\"target_rates_kbps\":{\"download\":$dl_base,\"upload\":$ul_base},\"achieved_kbps\":{\"download\":$bidirectional_download_kbps,\"upload\":$bidirectional_upload_kbps},\"realization_percent\":{\"download\":$bidirectional_download_realization,\"upload\":$bidirectional_upload_realization},\"effective_delta_ms\":$bidirectional_effective_delta_ms,\"icmp_delta_ms\":$phase_icmp_delta_ms,\"transport_delta_ms\":$phase_transport_delta_ms,\"loss_percent\":$phase_loss_percent,\"cpu_peak_percent\":$phase_cpu_peak,\"cpu_warning\":$bidirectional_cpu_warning,\"advisory_reason\":\"$(json_escape "$bidirectional_advisory")\",\"observation\":$phase_observation_json}"
}

evaluate_upload_only_observation() {
	upload_only_effective_delta_ms="$(maximum_number "$phase_icmp_delta_ms" "$phase_transport_delta_ms")"
	upload_only_grade="$(quality_grade_for_delta "$upload_only_effective_delta_ms")"
	upload_only_ul_realization="$(awk -v achieved="$phase_achieved_ul_kbps" -v candidate="$ul_base" 'BEGIN {
		if (candidate <= 0) exit 1
		printf "%.1f", achieved * 100 / candidate
	}')" || fail "Unable to calculate upload-only upload realization."
	upload_only_dl_gain_percent="$(awk -v candidate="$phase_achieved_dl_kbps" -v shaped="$bidirectional_download_kbps" 'BEGIN {
		if (shaped <= 0) exit 1
		printf "%.1f", (candidate - shaped) * 100 / shaped
	}')" || fail "Unable to calculate upload-only download gain."
	upload_only_delay_improvement_ms="$(awk -v shaped="$bidirectional_effective_delta_ms" -v candidate="$upload_only_effective_delta_ms" 'BEGIN {
		printf "%.1f", shaped - candidate
	}')"
	upload_only_latency_pass="$(awk -v actual="$upload_only_effective_delta_ms" -v limit="$validation_delay_max_ms" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	upload_only_loss_pass="$(awk -v actual="$phase_loss_percent" -v limit="$validation_loss_max_percent" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	upload_only_realization_pass="$(awk -v actual="$upload_only_ul_realization" -v minimum="$validation_candidate_realization_min_percent" -v maximum="$validation_candidate_realization_max_percent" 'BEGIN {
		print (actual >= minimum && actual <= maximum) ? "true" : "false"
	}')"
	upload_only_realization_safety_pass="$(awk -v actual="$upload_only_ul_realization" -v maximum="$validation_candidate_realization_max_percent" 'BEGIN {
		print (actual >= 50 && actual <= maximum) ? "true" : "false"
	}')"
	upload_only_gain_pass="$(awk -v actual="$upload_only_dl_gain_percent" 'BEGIN {
		print (actual >= 10) ? "true" : "false"
	}')"
	upload_only_effect_pass=true
	if [ "$bidirectional_latency_pass" != true ]; then
		upload_only_effect_pass="$(awk -v actual="$upload_only_delay_improvement_ms" 'BEGIN {
			print (actual >= 5) ? "true" : "false"
		}')"
	elif [ "$bidirectional_loss_pass" != true ]; then
		upload_only_effect_pass="$(awk -v candidate="$upload_only_effective_delta_ms" -v shaped="$bidirectional_effective_delta_ms" 'BEGIN {
			print (candidate <= shaped + 5) ? "true" : "false"
		}')"
	else
		upload_only_effect_pass="$(awk -v candidate="$upload_only_effective_delta_ms" -v shaped="$bidirectional_effective_delta_ms" 'BEGIN {
			print (candidate <= shaped + 5) ? "true" : "false"
		}')"
	fi
	upload_only_observation_pass=false
	[ "$upload_only_latency_pass" = true ] && [ "$upload_only_loss_pass" = true ] &&
		[ "$upload_only_realization_pass" = true ] && [ "$upload_only_gain_pass" = true ] &&
		[ "$upload_only_effect_pass" = true ] && upload_only_observation_pass=true
	upload_only_manual_latency_pass="$(awk -v actual="$upload_only_effective_delta_ms" -v limit="$validation_manual_latency_review_max_ms" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	upload_only_material_benefit="$(awk -v gain="$upload_only_dl_gain_percent" -v delay="$upload_only_delay_improvement_ms" 'BEGIN {
		print (gain >= 2 && delay >= -5) ? "true" : "false"
	}')"
	upload_only_hard_safety_pass=false
	[ "$upload_only_loss_pass" = true ] && [ "$upload_only_realization_safety_pass" = true ] &&
		[ "$upload_only_manual_latency_pass" = true ] && upload_only_hard_safety_pass=true
	upload_only_candidate_pass=false
	[ "$upload_only_hard_safety_pass" = true ] && [ "$upload_only_material_benefit" = true ] &&
		upload_only_candidate_pass=true
	upload_only_evaluation_json="{\"pass\":$upload_only_observation_pass,\"candidate_pass\":$upload_only_candidate_pass,\"hard_safety_pass\":$upload_only_hard_safety_pass,\"profile_target_met\":$upload_only_latency_pass,\"material_benefit\":$upload_only_material_benefit,\"grade\":\"$(json_escape "$upload_only_grade")\",\"effective_delta_ms\":$upload_only_effective_delta_ms,\"delay_improvement_ms\":$upload_only_delay_improvement_ms,\"loss_percent\":$phase_loss_percent,\"download_gain_percent\":$upload_only_dl_gain_percent,\"upload_realization_percent\":$upload_only_ul_realization,\"gates\":{\"latency\":$upload_only_latency_pass,\"manual_latency\":$upload_only_manual_latency_pass,\"loss\":$upload_only_loss_pass,\"upload_realization\":$upload_only_realization_pass,\"upload_realization_safety\":$upload_only_realization_safety_pass,\"download_gain\":$upload_only_gain_pass,\"causal_effect\":$upload_only_effect_pass},\"observation\":$phase_observation_json}"
}

evaluate_download_only_observation() {
	download_only_effective_delta_ms="$(maximum_number "$phase_icmp_delta_ms" "$phase_transport_delta_ms")"
	download_only_grade="$(quality_grade_for_delta "$download_only_effective_delta_ms")"
	download_only_dl_realization="$(awk -v achieved="$phase_achieved_dl_kbps" -v candidate="$dl_base" 'BEGIN {
		if (candidate <= 0) exit 1
		printf "%.1f", achieved * 100 / candidate
	}')" || fail "Unable to calculate download-only download realization."
	download_only_ul_gain_percent="$(awk -v candidate="$phase_achieved_ul_kbps" -v shaped="$bidirectional_upload_kbps" 'BEGIN {
		if (shaped <= 0) exit 1
		printf "%.1f", (candidate - shaped) * 100 / shaped
	}')" || fail "Unable to calculate download-only upload gain."
	download_only_delay_improvement_ms="$(awk -v shaped="$bidirectional_effective_delta_ms" -v candidate="$download_only_effective_delta_ms" 'BEGIN {
		printf "%.1f", shaped - candidate
	}')"
	download_only_latency_pass="$(awk -v actual="$download_only_effective_delta_ms" -v limit="$validation_delay_max_ms" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	download_only_loss_pass="$(awk -v actual="$phase_loss_percent" -v limit="$validation_loss_max_percent" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	download_only_realization_pass="$(awk -v actual="$download_only_dl_realization" -v minimum="$validation_candidate_realization_min_percent" -v maximum="$validation_candidate_realization_max_percent" 'BEGIN {
		print (actual >= minimum && actual <= maximum) ? "true" : "false"
	}')"
	download_only_realization_safety_pass="$(awk -v actual="$download_only_dl_realization" -v maximum="$validation_candidate_realization_max_percent" 'BEGIN {
		print (actual >= 50 && actual <= maximum) ? "true" : "false"
	}')"
	download_only_gain_pass="$(awk -v actual="$download_only_ul_gain_percent" 'BEGIN {
		print (actual >= 10) ? "true" : "false"
	}')"
	download_only_effect_pass=true
	if [ "$bidirectional_latency_pass" != true ]; then
		download_only_effect_pass="$(awk -v actual="$download_only_delay_improvement_ms" 'BEGIN {
			print (actual >= 5) ? "true" : "false"
		}')"
	else
		download_only_effect_pass="$(awk -v candidate="$download_only_effective_delta_ms" -v shaped="$bidirectional_effective_delta_ms" 'BEGIN {
			print (candidate <= shaped + 5) ? "true" : "false"
		}')"
	fi
	download_only_observation_pass=false
	[ "$download_only_latency_pass" = true ] && [ "$download_only_loss_pass" = true ] &&
		[ "$download_only_realization_pass" = true ] && [ "$download_only_gain_pass" = true ] &&
		[ "$download_only_effect_pass" = true ] && download_only_observation_pass=true
	download_only_manual_latency_pass="$(awk -v actual="$download_only_effective_delta_ms" -v limit="$validation_manual_latency_review_max_ms" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	download_only_material_benefit="$(awk -v gain="$download_only_ul_gain_percent" -v delay="$download_only_delay_improvement_ms" 'BEGIN {
		print (gain >= 2 && delay >= -5) ? "true" : "false"
	}')"
	download_only_hard_safety_pass=false
	[ "$download_only_loss_pass" = true ] && [ "$download_only_realization_safety_pass" = true ] &&
		[ "$download_only_manual_latency_pass" = true ] && download_only_hard_safety_pass=true
	download_only_candidate_pass=false
	[ "$download_only_hard_safety_pass" = true ] && [ "$download_only_material_benefit" = true ] &&
		download_only_candidate_pass=true
	download_only_evaluation_json="{\"pass\":$download_only_observation_pass,\"candidate_pass\":$download_only_candidate_pass,\"hard_safety_pass\":$download_only_hard_safety_pass,\"profile_target_met\":$download_only_latency_pass,\"material_benefit\":$download_only_material_benefit,\"grade\":\"$(json_escape "$download_only_grade")\",\"effective_delta_ms\":$download_only_effective_delta_ms,\"delay_improvement_ms\":$download_only_delay_improvement_ms,\"loss_percent\":$phase_loss_percent,\"upload_gain_percent\":$download_only_ul_gain_percent,\"download_realization_percent\":$download_only_dl_realization,\"gates\":{\"latency\":$download_only_latency_pass,\"manual_latency\":$download_only_manual_latency_pass,\"loss\":$download_only_loss_pass,\"download_realization\":$download_only_realization_pass,\"download_realization_safety\":$download_only_realization_safety_pass,\"upload_gain\":$download_only_gain_pass,\"causal_effect\":$download_only_effect_pass},\"observation\":$phase_observation_json}"
}

build_directional_recommendation() {
	directional_recommendation_json="{\"tested\":false,\"current_topology\":\"both_shaped\",\"recommended_topology\":\"both_shaped\",\"manual_only\":false,\"reason\":\"both-shaped-confirmation-passed\",\"confidence_percent\":100,\"observations\":[]}"
	upload_only_recommendation_json=null
	download_only_recommendation_json=null
	directional_comparisons_json="{\"upload_only\":null,\"download_only\":null}"
	# A merely reviewable adjacent-grade result is not the end of a full-raw
	# calibration. Try the upload-only topology whenever the simultaneous pair
	# missed any Auto-Apply objective; it may recover the requested latency or
	# throughput without discarding the already safe shaped proposal.
	if [ "${bidirectional_auto_apply_pass:-false}" = true ] &&
	   [ "${validation_quality_target_met:-false}" = true ] &&
	   [ "${validation_profile_objectives_met:-false}" = true ]; then
		return 0
	fi

	if [ "$calibration_strategy" != full_raw ]; then
		directional_recommendation_json="{\"tested\":false,\"current_topology\":\"both_shaped\",\"recommended_topology\":\"manual_review\",\"manual_only\":true,\"reason\":\"directional-bypass-not-authorized\",\"confidence_percent\":0,\"observations\":[]}"
		return 0
	fi

	write_status confirmation 95 "Comparing the selected pair with download ingress bypassed; no topology change will be applied"
	run_validation_direction_phase both "$((bidirectional_attempt + 1))" upload_only_shaped
	evaluate_upload_only_observation
	upload_only_first_pass="$upload_only_candidate_pass"
	upload_only_first_dl="$phase_achieved_dl_kbps"
	upload_only_first_ul="$phase_achieved_ul_kbps"
	upload_only_first_delta="$upload_only_effective_delta_ms"
	upload_only_first_json="$upload_only_evaluation_json"

	run_validation_direction_phase both "$((bidirectional_attempt + 2))" upload_only_shaped
	evaluate_upload_only_observation
	upload_only_second_pass="$upload_only_candidate_pass"
	upload_only_second_dl="$phase_achieved_dl_kbps"
	upload_only_second_ul="$phase_achieved_ul_kbps"
	upload_only_second_delta="$upload_only_effective_delta_ms"
	upload_only_second_json="$upload_only_evaluation_json"
	upload_only_repeatable="$(awk \
		-v dl1="$upload_only_first_dl" -v dl2="$upload_only_second_dl" \
		-v ul1="$upload_only_first_ul" -v ul2="$upload_only_second_ul" \
		-v delay1="$upload_only_first_delta" -v delay2="$upload_only_second_delta" 'BEGIN {
		dlmax = (dl1 > dl2) ? dl1 : dl2
		ulmax = (ul1 > ul2) ? ul1 : ul2
		dldiff = (dlmax > 0) ? ((dl1 > dl2 ? dl1 - dl2 : dl2 - dl1) * 100 / dlmax) : 100
		uldiff = (ulmax > 0) ? ((ul1 > ul2 ? ul1 - ul2 : ul2 - ul1) * 100 / ulmax) : 100
		delaydiff = (delay1 > delay2) ? delay1 - delay2 : delay2 - delay1
		print (dldiff <= 15 && uldiff <= 15 && delaydiff <= 10) ? "true" : "false"
	}')"

	if [ "$upload_only_first_pass" = true ] && [ "$upload_only_second_pass" = true ] &&
	   [ "$upload_only_repeatable" = true ]; then
		upload_only_recommendation_confidence=75
		[ "$(extract_json "$upload_only_first_json" '@.pass')" = true ] &&
			[ "$(extract_json "$upload_only_second_json" '@.pass')" = true ] &&
			upload_only_recommendation_confidence=90
		upload_only_recommendation_json="{\"tested\":true,\"current_topology\":\"both_shaped\",\"recommended_topology\":\"upload_only_shaped\",\"manual_only\":true,\"reason\":\"repeatable-download-bypass-benefit\",\"confidence_percent\":$upload_only_recommendation_confidence,\"repeatable\":true,\"thresholds\":{\"minimum_download_gain_percent\":2,\"minimum_latency_improvement_ms\":-5,\"maximum_repeat_throughput_spread_percent\":15,\"maximum_repeat_delay_spread_ms\":10},\"observations\":[$upload_only_first_json,$upload_only_second_json]}"
	else
		upload_only_recommendation_json="{\"tested\":true,\"current_topology\":\"both_shaped\",\"recommended_topology\":\"manual_review\",\"manual_only\":true,\"reason\":\"upload-only-benefit-not-repeatable\",\"confidence_percent\":40,\"repeatable\":$upload_only_repeatable,\"thresholds\":{\"minimum_download_gain_percent\":2,\"minimum_latency_improvement_ms\":-5,\"maximum_repeat_throughput_spread_percent\":15,\"maximum_repeat_delay_spread_ms\":10},\"observations\":[$upload_only_first_json,$upload_only_second_json]}"
	fi

	write_status confirmation 96 "Comparing the selected pair with upload egress bypassed; no topology change will be applied"
	run_validation_direction_phase both "$((bidirectional_attempt + 3))" download_only_shaped
	evaluate_download_only_observation
	download_only_first_pass="$download_only_candidate_pass"
	download_only_first_dl="$phase_achieved_dl_kbps"
	download_only_first_ul="$phase_achieved_ul_kbps"
	download_only_first_delta="$download_only_effective_delta_ms"
	download_only_first_json="$download_only_evaluation_json"

	run_validation_direction_phase both "$((bidirectional_attempt + 4))" download_only_shaped
	evaluate_download_only_observation
	download_only_second_pass="$download_only_candidate_pass"
	download_only_second_dl="$phase_achieved_dl_kbps"
	download_only_second_ul="$phase_achieved_ul_kbps"
	download_only_second_delta="$download_only_effective_delta_ms"
	download_only_second_json="$download_only_evaluation_json"
	download_only_repeatable="$(awk \
		-v dl1="$download_only_first_dl" -v dl2="$download_only_second_dl" \
		-v ul1="$download_only_first_ul" -v ul2="$download_only_second_ul" \
		-v delay1="$download_only_first_delta" -v delay2="$download_only_second_delta" 'BEGIN {
		dlmax = (dl1 > dl2) ? dl1 : dl2
		ulmax = (ul1 > ul2) ? ul1 : ul2
		dldiff = (dlmax > 0) ? ((dl1 > dl2 ? dl1 - dl2 : dl2 - dl1) * 100 / dlmax) : 100
		uldiff = (ulmax > 0) ? ((ul1 > ul2 ? ul1 - ul2 : ul2 - ul1) * 100 / ulmax) : 100
		delaydiff = (delay1 > delay2) ? delay1 - delay2 : delay2 - delay1
		print (dldiff <= 15 && uldiff <= 15 && delaydiff <= 10) ? "true" : "false"
	}')"

	if [ "$download_only_first_pass" = true ] && [ "$download_only_second_pass" = true ] &&
	   [ "$download_only_repeatable" = true ]; then
		download_only_recommendation_confidence=75
		[ "$(extract_json "$download_only_first_json" '@.pass')" = true ] &&
			[ "$(extract_json "$download_only_second_json" '@.pass')" = true ] &&
			download_only_recommendation_confidence=90
		download_only_recommendation_json="{\"tested\":true,\"current_topology\":\"both_shaped\",\"recommended_topology\":\"download_only_shaped\",\"manual_only\":true,\"reason\":\"repeatable-upload-bypass-benefit\",\"confidence_percent\":$download_only_recommendation_confidence,\"repeatable\":true,\"thresholds\":{\"minimum_upload_gain_percent\":2,\"minimum_latency_improvement_ms\":-5,\"maximum_repeat_throughput_spread_percent\":15,\"maximum_repeat_delay_spread_ms\":10},\"observations\":[$download_only_first_json,$download_only_second_json]}"
	else
		download_only_recommendation_json="{\"tested\":true,\"current_topology\":\"both_shaped\",\"recommended_topology\":\"manual_review\",\"manual_only\":true,\"reason\":\"download-only-benefit-not-repeatable\",\"confidence_percent\":40,\"repeatable\":$download_only_repeatable,\"thresholds\":{\"minimum_upload_gain_percent\":2,\"minimum_latency_improvement_ms\":-5,\"maximum_repeat_throughput_spread_percent\":15,\"maximum_repeat_delay_spread_ms\":10},\"observations\":[$download_only_first_json,$download_only_second_json]}"
	fi
	directional_comparisons_json="{\"upload_only\":$upload_only_recommendation_json,\"download_only\":$download_only_recommendation_json}"

	upload_only_recommended=false
	download_only_recommended=false
	[ "$(extract_json "$upload_only_recommendation_json" '@.recommended_topology')" = upload_only_shaped ] &&
		upload_only_recommended=true
	[ "$(extract_json "$download_only_recommendation_json" '@.recommended_topology')" = download_only_shaped ] &&
		download_only_recommended=true
	case "$upload_only_recommended:$download_only_recommended" in
		true:false) directional_recommendation_json="$upload_only_recommendation_json" ;;
		false:true) directional_recommendation_json="$download_only_recommendation_json" ;;
		true:true)
			# First prefer the topology which met the full profile gates in both
			# repeats (90% rather than manual-only 75% confidence), then the lower
			# worst loaded delay. Stable ties keep upload shaping because ingress
			# bypass is the older, more widely exercised runtime topology.
			if awk -v upload_confidence="$upload_only_recommendation_confidence" \
				-v download_confidence="$download_only_recommendation_confidence" \
				-v upload_delay="$(maximum_number "$upload_only_first_delta" "$upload_only_second_delta")" \
				-v download_delay="$(maximum_number "$download_only_first_delta" "$download_only_second_delta")" \
				'BEGIN {
					exit(download_confidence > upload_confidence ||
					    (download_confidence == upload_confidence && download_delay < upload_delay) ? 0 : 1)
				}'; then
				directional_recommendation_json="$download_only_recommendation_json"
			else
				directional_recommendation_json="$upload_only_recommendation_json"
			fi
			;;
		*)
			directional_recommendation_json="{\"tested\":true,\"current_topology\":\"both_shaped\",\"recommended_topology\":\"manual_review\",\"manual_only\":true,\"reason\":\"one-sided-benefit-not-repeatable\",\"confidence_percent\":40,\"repeatable\":false,\"observations\":[]}"
			;;
	esac
}

proposal_identity() {
	proposal_identity_topology="$1"
	proposal_identity_action="$2"
	proposal_identity_payload="$3"
	proposal_identity_digest="$(printf '%s\n' \
		"${worker_token:-unknown}|$proposal_identity_topology|$proposal_identity_action|$proposal_identity_payload" |
		sha256sum 2>/dev/null | awk 'NR == 1 { print $1; exit }')"
	case "$proposal_identity_digest" in
		????????????????????????????????????????????????????????????????)
			case "$proposal_identity_digest" in *[!0-9a-f]*) return 1 ;; esac
			printf 'p-%s\n' "$(printf '%s' "$proposal_identity_digest" | cut -c1-24)"
			;;
		*) return 1 ;;
	esac
}

append_unmet_objective() {
	unmet_objective="$1"
	escaped_unmet_objective="$(json_escape "$unmet_objective")"
	if [ -n "${proposal_unmet_objectives:-}" ]; then
		proposal_unmet_objectives="$proposal_unmet_objectives,\"$escaped_unmet_objective\""
	else
		proposal_unmet_objectives="\"$escaped_unmet_objective\""
	fi
}

build_result_proposals() {
	# Schema 1 is intentionally embedded in the current terminal envelope first.
	# LuCI and apply-guard can validate it before the terminal schema is advanced,
	# avoiding a release which displays a topology it cannot safely apply.
	proposals_json=""
	proposal_count=0
	shaped_candidate=""
	upload_only_candidate=""
	download_only_candidate=""
	no_sqm_candidate=""
	no_sqm_target_met=false
	proposal_effective_delta_ms="$(maximum_number "$effective_loaded_delta_ms" "$bidirectional_effective_delta_ms")"
	proposal_unmet_objectives=""
	[ "$profile_target_met" = true ] || append_unmet_objective profile-target
	[ "$profile_capacity_floor_met" = true ] || append_unmet_objective retention-objective
	[ "$bidirectional_realization_pass" = true ] || append_unmet_objective candidate-realization
	[ "$confidence_mode" = normal ] || append_unmet_objective measurement-confidence

	shaped_hard_safety_pass=false
	[ "$validation_safety_pass" = true ] && [ "$bidirectional_safety_pass" = true ] &&
		[ "$profile_floor_infeasible" != true ] &&
		[ "${dl_runtime_minimum_valid:-true}" = true ] &&
		[ "${ul_runtime_minimum_valid:-true}" = true ] &&
		[ "$phase_evidence_complete" = true ] && shaped_hard_safety_pass=true
	if [ "$shaped_hard_safety_pass" = true ]; then
		shaped_proposal_id="$(proposal_identity both_shaped apply_sqm \
			"$proposal|$validation_json|$bidirectional_confirmation_json")" ||
			fail "Unable to bind the shaped proposal to its measurement evidence."
		shaped_candidate="{\"schema_version\":1,\"proposal_id\":\"$shaped_proposal_id\",\"rank\":0,\"action\":\"apply_sqm\",\"topology\":\"both_shaped\",\"is_primary\":false,\"applicable\":true,\"hard_safety_pass\":true,\"profile_target_met\":$profile_target_met,\"profile_objectives_met\":$([ "$profile_target_met" = true ] && [ "$profile_capacity_floor_met" = true ] && printf true || printf false),\"grade\":\"$(json_escape "$profile_actual_grade")\",\"effective_delta_ms\":$proposal_effective_delta_ms,\"confidence_percent\":$overall_confidence_percent,\"unmet_objectives\":[${proposal_unmet_objectives:-}],\"evidence\":{\"validation\":\"validation\",\"confirmation\":\"bidirectional_confirmation\"},\"configuration\":$proposal}"
	fi

	if [ "$phase_evidence_complete" = true ] &&
	   [ "${ul_runtime_minimum_valid:-true}" = true ] &&
	   [ "$(extract_json "$upload_only_recommendation_json" '@.tested' 2>/dev/null || true)" = true ] &&
	   { [ "$(extract_json "$upload_only_recommendation_json" '@.repeatable' 2>/dev/null || true)" = true ] ||
	     { [ "$(extract_json "$upload_only_recommendation_json" '@.observations[0].pass' 2>/dev/null || true)" = true ] &&
	       [ "$(extract_json "$upload_only_recommendation_json" '@.observations[1].pass' 2>/dev/null || true)" = true ]; }; } &&
	   [ "$(extract_json "$upload_only_recommendation_json" '@.observations[0].hard_safety_pass' 2>/dev/null || true)" = true ] &&
	   [ "$(extract_json "$upload_only_recommendation_json" '@.observations[1].hard_safety_pass' 2>/dev/null || true)" = true ]; then
		upload_only_first_delta="$(extract_json "$upload_only_recommendation_json" '@.observations[0].effective_delta_ms')" ||
			fail "The upload-only proposal lost its first delay observation."
		upload_only_second_delta="$(extract_json "$upload_only_recommendation_json" '@.observations[1].effective_delta_ms')" ||
			fail "The upload-only proposal lost its repeated delay observation."
		upload_only_delta="$(maximum_number "$upload_only_first_delta" "$upload_only_second_delta")"
		upload_only_grade="$(quality_grade_for_delta "$upload_only_delta")"
		upload_only_target_met="$(awk -v actual="$upload_only_delta" -v limit="$validation_delay_max_ms" 'BEGIN {
			print (actual <= limit) ? "true" : "false"
		}')"
		upload_only_first_dl="$(extract_json "$upload_only_recommendation_json" '@.observations[0].observation.throughput_kbps.download_kbps')" ||
			fail "The upload-only proposal lost its first download observation."
		upload_only_second_dl="$(extract_json "$upload_only_recommendation_json" '@.observations[1].observation.throughput_kbps.download_kbps')" ||
			fail "The upload-only proposal lost its repeated download observation."
		upload_only_first_ul="$(extract_json "$upload_only_recommendation_json" '@.observations[0].observation.throughput_kbps.upload_kbps')" ||
			fail "The upload-only proposal lost its first upload observation."
		upload_only_second_ul="$(extract_json "$upload_only_recommendation_json" '@.observations[1].observation.throughput_kbps.upload_kbps')" ||
			fail "The upload-only proposal lost its repeated upload observation."
		upload_only_capacity_met="$(awk \
			-v dl1="$upload_only_first_dl" -v dl2="$upload_only_second_dl" \
			-v ul1="$upload_only_first_ul" -v ul2="$upload_only_second_ul" \
			-v raw_dl="$raw_dl_low" -v raw_ul="$raw_ul_low" \
			-v floor="$profile_capacity_floor" 'BEGIN {
			dl = (dl1 < dl2) ? dl1 : dl2
			ul = (ul1 < ul2) ? ul1 : ul2
			print (raw_dl > 0 && raw_ul > 0 && dl * 100 / raw_dl >= floor && ul * 100 / raw_ul >= floor) ? "true" : "false"
		}')"
		upload_only_unmet_objectives=""
		proposal_unmet_objectives=""
		[ "$upload_only_target_met" = true ] || append_unmet_objective profile-target
		[ "$upload_only_capacity_met" = true ] || append_unmet_objective retention-objective
		upload_only_first_realization="$(extract_json "$upload_only_recommendation_json" '@.observations[0].upload_realization_percent')" ||
			fail "The upload-only proposal lost its first realization observation."
		upload_only_second_realization="$(extract_json "$upload_only_recommendation_json" '@.observations[1].upload_realization_percent')" ||
			fail "The upload-only proposal lost its repeated realization observation."
		if awk -v first="$upload_only_first_realization" -v second="$upload_only_second_realization" \
			-v objective="$validation_candidate_realization_min_percent" 'BEGIN {
				exit(first < objective || second < objective ? 0 : 1)
			}'; then
			append_unmet_objective candidate-realization
		fi
		if [ "$(extract_json "$upload_only_recommendation_json" '@.observations[0].material_benefit')" != true ] ||
		   [ "$(extract_json "$upload_only_recommendation_json" '@.observations[1].material_benefit')" != true ]; then
			append_unmet_objective throughput-benefit-unproven
		fi
		if awk -v candidate="$upload_only_delta" -v shaped="$proposal_effective_delta_ms" 'BEGIN {
			exit(candidate > shaped + 10 ? 0 : 1)
		}'; then
			append_unmet_objective latency-worse-than-shaped
		fi
		[ "$(extract_json "$upload_only_recommendation_json" '@.repeatable')" = true ] ||
			append_unmet_objective measurement-confidence
		append_unmet_objective download-sqm-disabled
		upload_only_unmet_objectives="$proposal_unmet_objectives"
		if [ "$(extract_json "$upload_only_recommendation_json" '@.repeatable')" = true ]; then
			upload_only_directional_confidence=75
			[ "$(extract_json "$upload_only_recommendation_json" '@.observations[0].pass')" = true ] &&
				[ "$(extract_json "$upload_only_recommendation_json" '@.observations[1].pass')" = true ] &&
				upload_only_directional_confidence=90
		else
			upload_only_directional_confidence=40
		fi
		upload_only_confidence="$(awk -v overall="$overall_confidence_percent" -v directional="$upload_only_directional_confidence" 'BEGIN {
			printf "%d", (overall < directional) ? overall : directional
		}')"
		upload_only_proposal_id="$(proposal_identity upload_only_shaped apply_sqm \
			"$proposal|$upload_only_recommendation_json")" ||
			fail "Unable to bind the upload-only proposal to its measurement evidence."
		upload_only_candidate="{\"schema_version\":1,\"proposal_id\":\"$upload_only_proposal_id\",\"rank\":0,\"action\":\"apply_sqm\",\"topology\":\"upload_only_shaped\",\"is_primary\":false,\"applicable\":true,\"hard_safety_pass\":true,\"profile_target_met\":$upload_only_target_met,\"profile_objectives_met\":$([ "$upload_only_target_met" = true ] && [ "$upload_only_capacity_met" = true ] && printf true || printf false),\"grade\":\"$(json_escape "$upload_only_grade")\",\"effective_delta_ms\":$upload_only_delta,\"confidence_percent\":$upload_only_confidence,\"unmet_objectives\":[${upload_only_unmet_objectives:-}],\"evidence\":{\"recommendation\":\"directional_comparisons.upload_only\"},\"configuration\":$proposal}"
	fi

	if [ "$phase_evidence_complete" = true ] &&
	   [ "${dl_runtime_minimum_valid:-true}" = true ] &&
	   [ "$(extract_json "$download_only_recommendation_json" '@.tested' 2>/dev/null || true)" = true ] &&
	   { [ "$(extract_json "$download_only_recommendation_json" '@.repeatable' 2>/dev/null || true)" = true ] ||
	     { [ "$(extract_json "$download_only_recommendation_json" '@.observations[0].pass' 2>/dev/null || true)" = true ] &&
	       [ "$(extract_json "$download_only_recommendation_json" '@.observations[1].pass' 2>/dev/null || true)" = true ]; }; } &&
	   [ "$(extract_json "$download_only_recommendation_json" '@.observations[0].hard_safety_pass' 2>/dev/null || true)" = true ] &&
	   [ "$(extract_json "$download_only_recommendation_json" '@.observations[1].hard_safety_pass' 2>/dev/null || true)" = true ]; then
		download_only_first_delta="$(extract_json "$download_only_recommendation_json" '@.observations[0].effective_delta_ms')" ||
			fail "The download-only proposal lost its first delay observation."
		download_only_second_delta="$(extract_json "$download_only_recommendation_json" '@.observations[1].effective_delta_ms')" ||
			fail "The download-only proposal lost its repeated delay observation."
		download_only_delta="$(maximum_number "$download_only_first_delta" "$download_only_second_delta")"
		download_only_grade="$(quality_grade_for_delta "$download_only_delta")"
		download_only_target_met="$(awk -v actual="$download_only_delta" -v limit="$validation_delay_max_ms" 'BEGIN {
			print (actual <= limit) ? "true" : "false"
		}')"
		download_only_first_dl="$(extract_json "$download_only_recommendation_json" '@.observations[0].observation.throughput_kbps.download_kbps')" ||
			fail "The download-only proposal lost its first download observation."
		download_only_second_dl="$(extract_json "$download_only_recommendation_json" '@.observations[1].observation.throughput_kbps.download_kbps')" ||
			fail "The download-only proposal lost its repeated download observation."
		download_only_first_ul="$(extract_json "$download_only_recommendation_json" '@.observations[0].observation.throughput_kbps.upload_kbps')" ||
			fail "The download-only proposal lost its first upload observation."
		download_only_second_ul="$(extract_json "$download_only_recommendation_json" '@.observations[1].observation.throughput_kbps.upload_kbps')" ||
			fail "The download-only proposal lost its repeated upload observation."
		download_only_capacity_met="$(awk \
			-v dl1="$download_only_first_dl" -v dl2="$download_only_second_dl" \
			-v ul1="$download_only_first_ul" -v ul2="$download_only_second_ul" \
			-v raw_dl="$raw_dl_low" -v raw_ul="$raw_ul_low" \
			-v floor="$profile_capacity_floor" 'BEGIN {
			dl = (dl1 < dl2) ? dl1 : dl2
			ul = (ul1 < ul2) ? ul1 : ul2
			print (raw_dl > 0 && raw_ul > 0 && dl * 100 / raw_dl >= floor && ul * 100 / raw_ul >= floor) ? "true" : "false"
		}')"
		proposal_unmet_objectives=""
		[ "$download_only_target_met" = true ] || append_unmet_objective profile-target
		[ "$download_only_capacity_met" = true ] || append_unmet_objective retention-objective
		download_only_first_realization="$(extract_json "$download_only_recommendation_json" '@.observations[0].download_realization_percent')" ||
			fail "The download-only proposal lost its first realization observation."
		download_only_second_realization="$(extract_json "$download_only_recommendation_json" '@.observations[1].download_realization_percent')" ||
			fail "The download-only proposal lost its repeated realization observation."
		if awk -v first="$download_only_first_realization" -v second="$download_only_second_realization" \
			-v objective="$validation_candidate_realization_min_percent" 'BEGIN {
				exit(first < objective || second < objective ? 0 : 1)
			}'; then
			append_unmet_objective candidate-realization
		fi
		if [ "$(extract_json "$download_only_recommendation_json" '@.observations[0].material_benefit')" != true ] ||
		   [ "$(extract_json "$download_only_recommendation_json" '@.observations[1].material_benefit')" != true ]; then
			append_unmet_objective throughput-benefit-unproven
		fi
		if awk -v candidate="$download_only_delta" -v shaped="$proposal_effective_delta_ms" 'BEGIN {
			exit(candidate > shaped + 10 ? 0 : 1)
		}'; then
			append_unmet_objective latency-worse-than-shaped
		fi
		[ "$(extract_json "$download_only_recommendation_json" '@.repeatable')" = true ] ||
			append_unmet_objective measurement-confidence
		append_unmet_objective upload-sqm-disabled
		download_only_unmet_objectives="$proposal_unmet_objectives"
		if [ "$(extract_json "$download_only_recommendation_json" '@.repeatable')" = true ]; then
			download_only_directional_confidence=75
			[ "$(extract_json "$download_only_recommendation_json" '@.observations[0].pass')" = true ] &&
				[ "$(extract_json "$download_only_recommendation_json" '@.observations[1].pass')" = true ] &&
				download_only_directional_confidence=90
		else
			download_only_directional_confidence=40
		fi
		download_only_confidence="$(awk -v overall="$overall_confidence_percent" -v directional="$download_only_directional_confidence" 'BEGIN {
			printf "%d", (overall < directional) ? overall : directional
		}')"
		download_only_proposal_id="$(proposal_identity download_only_shaped apply_sqm \
			"$proposal|$download_only_recommendation_json")" ||
			fail "Unable to bind the download-only proposal to its measurement evidence."
		download_only_candidate="{\"schema_version\":1,\"proposal_id\":\"$download_only_proposal_id\",\"rank\":0,\"action\":\"apply_sqm\",\"topology\":\"download_only_shaped\",\"is_primary\":false,\"applicable\":true,\"hard_safety_pass\":true,\"profile_target_met\":$download_only_target_met,\"profile_objectives_met\":$([ "$download_only_target_met" = true ] && [ "$download_only_capacity_met" = true ] && printf true || printf false),\"grade\":\"$(json_escape "$download_only_grade")\",\"effective_delta_ms\":$download_only_delta,\"confidence_percent\":$download_only_confidence,\"unmet_objectives\":[${download_only_unmet_objectives:-}],\"evidence\":{\"recommendation\":\"directional_comparisons.download_only\"},\"configuration\":$proposal}"
	fi

	no_sqm_source=""
	no_sqm_evidence_path=""
	if [ "$calibration_strategy" = full_raw ] && raw_control_hard_safety "$raw_control_json"; then
		no_sqm_source="$raw_control_json"
		no_sqm_evidence_path=raw_control
	elif [ "$autotune_profile" = fair ] && [ "${fair_disable_available:-false}" = true ] &&
	     raw_control_hard_safety "$fair_control_json"; then
		# Compatibility path for a typed Fair control retained separately from the
		# generic raw-control field by an older producer.
		no_sqm_source="$fair_control_json"
		no_sqm_evidence_path=fair_outcome.no_sqm_control
	fi
	if [ -n "$no_sqm_source" ]; then
		no_sqm_proposal_id="$(proposal_identity no_sqm disable_sqm "$no_sqm_source")" ||
			fail "Unable to bind the no-SQM proposal to its measurement evidence."
		no_sqm_grade="$(extract_json "$no_sqm_source" '@.grade')" ||
			fail "The no-SQM proposal lost its measured grade."
		no_sqm_delta="$(extract_json "$no_sqm_source" '@.effective_delta_ms')" ||
			fail "The no-SQM proposal lost its measured delay."
		case "$autotune_profile:$no_sqm_grade" in
			fair:A+|fair:A|fair:B|fair:C) no_sqm_target_met=true ;;
			gaming:A+|gaming_extreme:A+) no_sqm_target_met=true ;;
			best_overall:A+|best_overall:A) no_sqm_target_met=true ;;
			variable_link:A+|variable_link:A|variable_link:B) no_sqm_target_met=true ;;
			*) no_sqm_target_met=false ;;
		esac
		proposal_unmet_objectives=""
		[ "$no_sqm_target_met" = true ] || append_unmet_objective profile-target
		no_sqm_raw_dl="$(extract_json "$no_sqm_source" '@.throughput.download_kbps')"
		no_sqm_raw_ul="$(extract_json "$no_sqm_source" '@.throughput.upload_kbps')"
		no_sqm_dl_gain="$(awk -v raw="$no_sqm_raw_dl" -v shaped="${shaped_dl:-0}" 'BEGIN {
			if (raw <= 0 || shaped <= 0) { print -100; exit }
			printf "%.3f", (raw / shaped - 1) * 100
		}')"
		no_sqm_ul_gain="$(awk -v raw="$no_sqm_raw_ul" -v shaped="${shaped_ul:-0}" 'BEGIN {
			if (raw <= 0 || shaped <= 0) { print -100; exit }
			printf "%.3f", (raw / shaped - 1) * 100
		}')"
		awk -v dl="$no_sqm_dl_gain" -v ul="$no_sqm_ul_gain" 'BEGIN { exit(dl >= 2 && ul >= 2 ? 0 : 1) }' ||
			append_unmet_objective throughput-benefit-unproven
		if awk -v raw_delta="$no_sqm_delta" -v shaped_delta="${proposal_effective_delta_ms:-}" 'BEGIN {
			number = "^[0-9]+([.][0-9]+)?$"
			exit(raw_delta ~ number && shaped_delta ~ number && raw_delta > shaped_delta + 10 ? 0 : 1)
		}'; then
			append_unmet_objective latency-worse-than-shaped
		fi
		no_sqm_unmet="$proposal_unmet_objectives"
		no_sqm_candidate="{\"schema_version\":1,\"proposal_id\":\"$no_sqm_proposal_id\",\"rank\":0,\"action\":\"disable_sqm\",\"topology\":\"no_sqm\",\"is_primary\":false,\"applicable\":true,\"hard_safety_pass\":true,\"profile_target_met\":$no_sqm_target_met,\"profile_objectives_met\":$no_sqm_target_met,\"grade\":\"$(json_escape "$no_sqm_grade")\",\"effective_delta_ms\":$no_sqm_delta,\"confidence_percent\":$overall_confidence_percent,\"unmet_objectives\":[${no_sqm_unmet:-}],\"evidence\":{\"control\":\"$no_sqm_evidence_path\"},\"configuration\":null}"
	fi

	# Rank only after every independently evidenced topology is known. A clean
	# Fair no-SQM recommendation is throughput-first; otherwise a repeatable
	# one-sided recommendation outranks the both-shaped comparison it improved.
	if [ "$autotune_profile" = fair ] && [ "${fair_recommended_action:-}" = disable_sqm ] &&
	   [ -n "$no_sqm_candidate" ]; then
		proposal_order="no_sqm upload_only download_only shaped"
	elif [ "$autotune_profile" = variable_link ] && [ "$dl_search_no_cake_effect" = true ] &&
	     [ "$ul_search_no_cake_effect" = true ] && [ -n "$no_sqm_candidate" ]; then
		proposal_order="no_sqm upload_only download_only shaped"
	elif [ "${no_sqm_target_met:-false}" = true ] && [ "${profile_target_met:-false}" != true ] &&
	     [ -n "$no_sqm_candidate" ]; then
		proposal_order="no_sqm upload_only download_only shaped"
	else
		case "$(extract_json "$directional_recommendation_json" '@.recommended_topology' 2>/dev/null || true)" in
			upload_only_shaped) proposal_order="upload_only download_only shaped no_sqm" ;;
			download_only_shaped) proposal_order="download_only upload_only shaped no_sqm" ;;
			*) proposal_order="shaped upload_only download_only no_sqm" ;;
		esac
	fi
	for candidate_name in $proposal_order; do
		case "$candidate_name" in
			shaped) ranked_candidate="$shaped_candidate" ;;
			upload_only) ranked_candidate="$upload_only_candidate" ;;
			download_only) ranked_candidate="$download_only_candidate" ;;
			no_sqm) ranked_candidate="$no_sqm_candidate" ;;
		esac
		[ -n "$ranked_candidate" ] || continue
		proposal_count=$((proposal_count + 1))
		[ "$proposal_count" -le 4 ] || break
		candidate_primary=false
		[ "$proposal_count" -eq 1 ] && candidate_primary=true
		ranked_candidate="$(printf '%s\n' "$ranked_candidate" |
			sed "s/\"rank\":0/\"rank\":$proposal_count/;s/\"is_primary\":false/\"is_primary\":$candidate_primary/")"
		proposals_json="${proposals_json:+$proposals_json,}$ranked_candidate"
	done
	if [ "$proposal_count" -gt 0 ]; then
		manual_apply_eligible=true
	else
		manual_apply_eligible=false
		auto_apply_eligible=false
	fi
	[ "$proposal_count" -le 4 ] || fail "Full Auto-Tune produced too many review proposals."
	proposals_json="[$proposals_json]"
}

stage_complete_result() {
	stage_terminal_json result "{\"state\":\"complete\",\"schema_version\":8,\"result_available\":true,\"result_class\":\"$result_class\",\"confidence\":$confidence_json,\"auto_apply_eligible\":$auto_apply_eligible,\"manual_apply_eligible\":$manual_apply_eligible,\"phase_evidence_complete\":$phase_evidence_complete,\"phase_contamination_seen\":$phase_contamination_seen,\"job_id\":\"$(json_escape "$job_name")\",\"target_interface\":\"$(json_escape "$target_if_input")\",\"resolved_interface\":\"$(json_escape "$target_if")\",\"source_ip\":\"$(json_escape "$source_ip")\",\"external_ip\":\"$(json_escape "$selected_external_ip")\",\"route_interface\":\"$(json_escape "$route_if")\",\"route_mode\":\"$(json_escape "$route_mode")\",\"mwan3_member\":\"$(json_escape "$mwan3_member")\",\"route_identity\":\"$(json_escape "$route_identity")\",\"link_kind\":\"$(json_escape "$link_kind")\",\"datapath\":$datapath_json,\"conservative\":$([ "$conservative_mode" = 1 ] && printf true || printf false),\"confidence_mode\":\"$confidence_mode\",\"background\":$(background_json),\"phase_background\":[$phase_background_runs_json],\"usable_directions\":{\"download\":${background_dl_usable:-true},\"upload\":${background_ul_usable:-true}},\"validation_thresholds\":{\"candidate_realization_min_percent\":$validation_candidate_realization_min_percent,\"candidate_realization_max_percent\":$validation_candidate_realization_max_percent,\"capacity_retention_min_percent\":$validation_capacity_retention_min_percent,\"throughput_safety_floor_percent\":50,\"delay_max_ms\":$validation_delay_max_ms,\"manual_latency_review_max_ms\":$validation_manual_latency_review_max_ms,\"loss_max_percent\":$validation_loss_max_percent,\"cpu_max_percent\":$validation_cpu_max_percent},\"baseline\":{\"median_ms\":$idle_median_ms,\"p95_ms\":$idle_p95_ms,\"samples\":$baseline_samples,\"transport_median_ms\":$transport_idle_median_ms,\"transport_p95_ms\":$transport_idle_p95_ms,\"transport_samples\":$transport_idle_samples,\"transport_backend\":\"$(json_escape "$transport_probe_backend")\",\"transport_endpoint\":\"$(json_escape "$transport_probe_endpoint")\"},\"runs\":[$runs_json],\"raw_control\":$raw_control_json,\"validation_attempts\":[$validation_attempts_json],\"validation\":$validation_json,\"bidirectional_confirmation\":$bidirectional_confirmation_json,\"directional_recommendation\":$directional_recommendation_json,\"directional_comparisons\":$directional_comparisons_json,\"profile_outcome\":$profile_outcome_json,\"profile_search\":{\"download\":$dl_search_json,\"upload\":$ul_search_json},\"fair_outcome\":$fair_outcome_json,\"pinger_plan\":$pinger_plan,\"proposal\":$proposal,\"proposals\":$proposals_json,\"configuration_written\":false}"
}

complete_raw_only_review() {
	raw_only_reason="$1"
	[ "$calibration_strategy" = full_raw ] || return 1
	raw_control_hard_safety "$raw_control_json" || return 1

	# No shaped rate is admitted here.  The reference proposal remains in the
	# envelope only to bind profile policy and immutable run identity; the sole
	# applicable candidate has configuration:null and is revalidated from raw.
	validation_safety_pass=false
	bidirectional_safety_pass=true
	bidirectional_realization_pass=true
	profile_floor_infeasible=true
	profile_target_met=false
	profile_capacity_floor_met=false
	dl_runtime_minimum_valid=false
	ul_runtime_minimum_valid=false
	profile_actual_grade="$(extract_json "$raw_control_json" '@.grade')" || return 1
	bidirectional_confirmation_json=null
	directional_recommendation_json=null
	directional_comparisons_json='{"upload_only":null,"download_only":null}'
	fair_outcome_json=null
	profile_target_grade="$(extract_json "$proposal" '@.target_grade')" || return 1
	profile_outcome_json="{\"mode\":\"raw-only-safe-review\",\"objective\":\"independent-no-sqm-fallback\",\"target_grade\":\"$(json_escape "$profile_target_grade")\",\"target_met\":false,\"actual_grade\":\"$(json_escape "$profile_actual_grade")\",\"capacity_floor_met\":false,\"throughput_safety_floor_met\":false,\"manual_only\":true,\"shaped_search_available\":false,\"infeasible_reason\":\"$(json_escape "$raw_only_reason")\",\"download\":$dl_search_json,\"upload\":$ul_search_json}"
	# The full-raw control itself is bidirectional, so missing shaped confirmation
	# does not lower its independent quality evidence.  Candidate admission below
	# still depends on the raw loss/latency/background/bypass hard gates.
	dl_candidate_realization=""
	ul_candidate_realization=""
	build_autotune_confidence
	confidence_mode=normal
	[ "$overall_confidence_percent" -ge 85 ] || confidence_mode=low
	auto_apply_eligible=false
	manual_apply_eligible=false
	build_result_proposals
	[ "$proposal_count" -eq 1 ] || return 1
	[ "$(extract_json "$proposals_json" '@[0].topology' 2>/dev/null || true)" = no_sqm ] || return 1
	stage_complete_result
}

append_profile_search_observation() {
	search_direction="$1"
	case "$search_direction" in
		download)
			search_record="$dl_base,$shaped_dl,$dl_icmp_delta_ms,$dl_transport_delta_ms,$dl_loss_percent,$dl_cpu_peak"
			if [ -n "${dl_search_observations:-}" ]; then
				dl_search_observations="$dl_search_observations;$search_record"
			else
				dl_search_observations="$search_record"
			fi
			;;
		upload)
			search_record="$ul_base,$shaped_ul,$ul_icmp_delta_ms,$ul_transport_delta_ms,$ul_loss_percent,$ul_cpu_peak"
			if [ -n "${ul_search_observations:-}" ]; then
				ul_search_observations="$ul_search_observations;$search_record"
			else
				ul_search_observations="$search_record"
			fi
			;;
		*) return 1 ;;
	esac
}

run_profile_direction_search() {
	search_direction="$1"
	case "$search_direction" in
		download)
			search_observed_low="$raw_dl_low"
			search_minimum="$dl_minimum"
			search_upper="$dl_maximum"
			[ "$search_upper" -le "$search_observed_low" ] 2>/dev/null || search_upper="$search_observed_low"
			search_observations="$dl_search_observations"
			;;
		upload)
			search_observed_low="$raw_ul_low"
			search_minimum="$ul_minimum"
			search_upper="$ul_maximum"
			[ "$search_upper" -le "$search_observed_low" ] 2>/dev/null || search_upper="$search_observed_low"
			search_observations="$ul_search_observations"
			;;
		*) return 1 ;;
	esac

	search_decision="$("$daemon_bin" --autotune-optimize-direction \
		--profile "$autotune_profile" \
		--direction "$search_direction" \
		--observed-low-kbps "$search_observed_low" \
		--minimum-kbps "$search_minimum" \
		--upper-kbps "$search_upper" \
		--observations "$search_observations" \
		--uncertainty-percent 1.5 \
		--max-attempts "$profile_search_max_attempts" \
		--candidate-realization-min-percent "$validation_candidate_realization_min_percent" \
		--candidate-realization-max-percent "$validation_candidate_realization_max_percent" \
		--capacity-retention-min-percent "$validation_capacity_retention_min_percent" \
		--loss-max-percent "$validation_loss_max_percent" \
		--cpu-max-percent "$validation_cpu_max_percent")" || return 1
	strict_single_json_object "$search_decision" || return 1
	search_schema="$(extract_json "$search_decision" '@.schema_version')" || return 1
	search_profile="$(extract_json "$search_decision" '@.profile')" || return 1
	search_result_direction="$(extract_json "$search_decision" '@.direction')" || return 1
	search_action="$(extract_json "$search_decision" '@.action')" || return 1
	search_reason="$(extract_json "$search_decision" '@.reason')" || return 1
	[ "$search_schema" = 2 ] && [ "$search_profile" = "$autotune_profile" ] &&
		[ "$search_result_direction" = "$search_direction" ] || return 1
	case "$search_action" in test|complete|fallback|inconclusive) ;; *) return 1 ;; esac

	search_next="$(extract_json "$search_decision" '@.next_candidate_kbps' 2>/dev/null || true)"
	search_selected="$(extract_json "$search_decision" '@.selected.candidate_kbps' 2>/dev/null || true)"
	search_selected_safety="$(extract_json "$search_decision" '@.selected.safety_pass' 2>/dev/null || true)"
	search_selected_manual_reviewable="$(extract_json "$search_decision" '@.selected.manual_reviewable' 2>/dev/null || true)"
	search_selected_realization="$(extract_json "$search_decision" '@.selected.realization_percent' 2>/dev/null || true)"
	search_selected_target="$(extract_json "$search_decision" '@.selected.target_met' 2>/dev/null || true)"
	search_selected_retention="$(extract_json "$search_decision" '@.selected.retention_percent' 2>/dev/null || true)"
	search_selected_grade="$(extract_json "$search_decision" '@.selected.grade' 2>/dev/null || true)"
	search_runtime_minimum="$(extract_json "$search_decision" '@.runtime_minimum_kbps' 2>/dev/null || true)"
	search_runtime_minimum_index="$(extract_json "$search_decision" '@.runtime_minimum_observation_index' 2>/dev/null || true)"
	search_knee_detected="$(extract_json "$search_decision" '@.knee_detected' 2>/dev/null || true)"
	search_no_cake_effect="$(extract_json "$search_decision" '@.no_cake_effect' 2>/dev/null || true)"
	search_noisy="$(extract_json "$search_decision" '@.noisy' 2>/dev/null || true)"
	search_inconclusive="$(extract_json "$search_decision" '@.inconclusive' 2>/dev/null || true)"
	for search_boolean in "$search_knee_detected" "$search_no_cake_effect" "$search_noisy" "$search_inconclusive"; do
		case "$search_boolean" in true|false) ;; *) return 1 ;; esac
	done
	[ "$search_knee_detected" != true ] || [ "$search_no_cake_effect" = false ] || return 1
	[ "$search_knee_detected" != true ] || [ "$search_noisy" = false ] || return 1
	case "$search_action" in
		test) is_positive_uint "$search_next" || return 1 ;;
		complete|fallback)
			is_positive_uint "$search_selected" || return 1
			case "$search_selected_safety" in true|false) ;; *) return 1 ;; esac
			case "$search_selected_manual_reviewable" in true|false) ;; *) return 1 ;; esac
			if [ "$search_selected_safety" != true ]; then
				[ "$search_action" = fallback ] || return 1
				case "$search_reason" in
					repeatable-compute-ceiling-below-capacity-floor|repeatable-shaper-ceiling-below-capacity-floor|repeatable-shaper-ceiling-below-safety-floor) ;;
					bounded-low-realization-review) [ "$autotune_profile" = variable_link ] || return 1 ;;
					*) return 1 ;;
				esac
			fi
			case "$search_selected_target" in true|false) ;; *) return 1 ;; esac
			case "$search_selected_grade" in A+|A|B|C|D|F) ;; *) return 1 ;; esac
			if [ "$autotune_profile" = variable_link ]; then
				is_positive_uint "$search_runtime_minimum" || return 1
				is_positive_uint "$search_runtime_minimum_index" || return 1
				search_runtime_evaluated_index=$((search_runtime_minimum_index - 1))
				search_runtime_evaluated_rate="$(extract_json "$search_decision" "@.evaluated[$search_runtime_evaluated_index].candidate_kbps" 2>/dev/null || true)"
				[ "$search_runtime_evaluated_rate" = "$search_runtime_minimum" ] || return 1
				if [ "$search_no_cake_effect" = true ]; then
					[ "$search_action" = fallback ] &&
						[ "$search_reason" = queue-outside-cake-control ] &&
						[ "$search_knee_detected" = false ] &&
						[ "$search_noisy" = false ] &&
						[ "$search_inconclusive" = false ] &&
						[ "$search_selected_target" = true ] &&
						[ "$search_runtime_minimum" = "$search_selected" ] || return 1
					LC_ALL=C awk -v value="$search_selected_retention" 'BEGIN {
						exit(value ~ /^[0-9]+([.][0-9]+)?$/ && value >= 50 && value <= 100 ? 0 : 1)
					}' || return 1
				elif [ "$search_reason" = exploration-floor-reached ]; then
					[ "$search_action" = fallback ] &&
						[ "$search_knee_detected" = false ] &&
						[ "$search_noisy" = false ] &&
						[ "$search_inconclusive" = false ] &&
						[ "$search_selected_target" = true ] &&
						[ "$search_runtime_minimum" = "$search_selected" ] || return 1
					LC_ALL=C awk -v value="$search_selected_retention" 'BEGIN {
						exit(value ~ /^[0-9]+([.][0-9]+)?$/ && value >= 50 && value <= 100 ? 0 : 1)
					}' || return 1
				elif [ "$search_reason" = noisy-link-safe-review ]; then
					[ "$search_action" = fallback ] &&
						[ "$search_knee_detected" = false ] &&
						[ "$search_no_cake_effect" = false ] &&
						[ "$search_noisy" = true ] &&
						[ "$search_inconclusive" = false ] &&
						[ "$search_runtime_minimum" = "$search_selected" ] || return 1
					LC_ALL=C awk -v value="$search_selected_retention" 'BEGIN {
						exit(value ~ /^[0-9]+([.][0-9]+)?$/ && value >= 50 && value <= 100 ? 0 : 1)
					}' || return 1
				elif [ "$search_reason" = bounded-low-realization-review ]; then
					[ "$search_action" = fallback ] &&
						[ "$search_selected_safety" = false ] &&
						[ "$search_selected_manual_reviewable" = true ] &&
						[ "$search_knee_detected" = false ] &&
						[ "$search_no_cake_effect" = false ] &&
						[ "$search_noisy" = false ] &&
						[ "$search_inconclusive" = false ] &&
						[ "$search_runtime_minimum" = "$search_selected" ] || return 1
					LC_ALL=C awk -v realization="$search_selected_realization" \
						-v retention="$search_selected_retention" \
						-v strict_min="$validation_candidate_realization_min_percent" \
						-v strict_max="$validation_candidate_realization_max_percent" 'BEGIN {
							number = "^[0-9]+([.][0-9]+)?$"
							exit(realization ~ number && retention ~ number && strict_min ~ number && strict_max ~ number &&
								realization >= 50 && realization < strict_min && realization <= strict_max &&
								retention >= 50 && retention <= 100 ? 0 : 1)
						}' || return 1
				else
					[ "$search_knee_detected" = true ] &&
						[ "$search_noisy" = false ] &&
						[ "$search_inconclusive" = false ] || return 1
				fi
			elif [ "$autotune_profile" = gaming_extreme ]; then
				is_positive_uint "$search_runtime_minimum" || return 1
				is_positive_uint "$search_runtime_minimum_index" || return 1
				search_runtime_evaluated_index=$((search_runtime_minimum_index - 1))
				search_runtime_evaluated_rate="$(extract_json "$search_decision" "@.evaluated[$search_runtime_evaluated_index].candidate_kbps" 2>/dev/null || true)"
				[ "$search_runtime_evaluated_rate" = "$search_runtime_minimum" ] || return 1
			fi
			;;
	esac

	case "$search_direction" in
		download)
			dl_search_json="$search_decision"
			dl_search_action="$search_action"
			dl_search_reason="$search_reason"
			dl_search_next="$search_next"
			dl_search_selected="$search_selected"
			dl_search_selected_safety="$search_selected_safety"
			dl_search_selected_manual_reviewable="$search_selected_manual_reviewable"
			dl_search_selected_target="$search_selected_target"
			dl_search_selected_grade="$search_selected_grade"
			dl_search_runtime_minimum="$search_runtime_minimum"
			dl_search_no_cake_effect="$search_no_cake_effect"
			case "$search_reason" in
				exploration-floor-reached|noisy-link-safe-review|bounded-low-realization-review) dl_search_manual_fallback=true ;;
				*) dl_search_manual_fallback=false ;;
			esac
			;;
		upload)
			ul_search_json="$search_decision"
			ul_search_action="$search_action"
			ul_search_reason="$search_reason"
			ul_search_next="$search_next"
			ul_search_selected="$search_selected"
			ul_search_selected_safety="$search_selected_safety"
			ul_search_selected_manual_reviewable="$search_selected_manual_reviewable"
			ul_search_selected_target="$search_selected_target"
			ul_search_selected_grade="$search_selected_grade"
			ul_search_runtime_minimum="$search_runtime_minimum"
			ul_search_no_cake_effect="$search_no_cake_effect"
			case "$search_reason" in
				exploration-floor-reached|noisy-link-safe-review|bounded-low-realization-review) ul_search_manual_fallback=true ;;
				*) ul_search_manual_fallback=false ;;
			esac
			;;
	esac
	worker_trace "optimizer direction=$search_direction action=$search_action reason=$(json_escape "$search_reason") next=${search_next:-none} selected=${search_selected:-none} grade=${search_selected_grade:-none}"
}

set_exact_profile_candidates() {
	desired_dl_kbps="$1"
	desired_ul_kbps="$2"
	desired_dl_runtime_minimum="${3:-}"
	desired_ul_runtime_minimum="${4:-}"
	dl_revision_scale="$(scale_for_reference_base "$desired_dl_kbps" "$reference_dl_base")" || return 1
	ul_revision_scale="$(scale_for_reference_base "$desired_ul_kbps" "$reference_ul_base")" || return 1
	proposal_candidate="$(calculate_proposal "$dl_revision_scale" "$ul_revision_scale" \
		"$desired_dl_runtime_minimum" "$desired_ul_runtime_minimum")" || return 1
	proposal_json_valid "$proposal_candidate" || return 1
	proposal="$proposal_candidate"
	realized_dl_candidate="$(extract_json "$proposal" '@.download.base_kbps')"
	realized_ul_candidate="$(extract_json "$proposal" '@.upload.base_kbps')"
	[ "$realized_dl_candidate" = "$desired_dl_kbps" ] &&
		[ "$realized_ul_candidate" = "$desired_ul_kbps" ]
}

journal_value() {
	journal_key="$1"
	[ -f "${recovery_journal:-}" ] && [ ! -L "$recovery_journal" ] || return 1
	awk -v key="$journal_key" '
		index($0, key "=") == 1 {
			count++
			value = substr($0, length(key) + 2)
		}
		END {
			if (count != 1) exit 1
			print value
		}
	' "$recovery_journal"
}

read_journalled_active_test() {
	journal_test_pgid="$(journal_value active_test_pgid 2>/dev/null)" || return 1
	journal_test_starttime="$(journal_value active_test_starttime 2>/dev/null)" || return 1
	case "$journal_test_pgid:$journal_test_starttime" in
		:) return 0 ;;
		*:*)
			is_positive_uint "$journal_test_pgid" && is_positive_uint "$journal_test_starttime" || return 1
			[ "$journal_test_pgid" != "$$" ] || return 1
			return 0
			;;
		*) return 1 ;;
	esac
}

terminate_journalled_active_test() {
	read_journalled_active_test || return 1
	[ -n "$journal_test_pgid" ] || return 0
	recovery_active_test_pgid="$journal_test_pgid"
	recovery_active_test_starttime="$journal_test_starttime"
	test_termination_grace_s="${CAKE_AUTORATE_AUTOTUNE_SPEEDTEST_TERM_GRACE_S:-3}"
	case "$test_termination_grace_s" in ''|*[!0-9]*) test_termination_grace_s=3 ;; esac
	[ "$test_termination_grace_s" -ge 1 ] 2>/dev/null || test_termination_grace_s=3
	[ "$test_termination_grace_s" -le 10 ] 2>/dev/null || test_termination_grace_s=10

	if process_group_contains_session "$journal_test_pgid"; then
		signal_test_group_until_gone "$journal_test_pgid" "$journal_test_starttime" || return 1
	fi
	# Cancellation can interrupt the child before exec(setsid).  In that narrow
	# state it is still a member of the owner's isolated group, so signal only
	# the exact PID/starttime recorded before CONT.
	if [ "$(proc_starttime "$journal_test_pgid" 2>/dev/null)" = "$journal_test_starttime" ]; then
		case "$(proc_state "$journal_test_pgid" 2>/dev/null)" in
			''|Z|z) ;;
			*)
				kill -TERM "$journal_test_pgid" 2>/dev/null || true
				cleanup_wait=0
				while [ "$cleanup_wait" -lt "$test_termination_grace_s" ] &&
				      [ "$(proc_starttime "$journal_test_pgid" 2>/dev/null)" = "$journal_test_starttime" ] &&
				      ! { case "$(proc_state "$journal_test_pgid" 2>/dev/null)" in ''|Z|z) true ;; *) false ;; esac; }; do
					cleanup_wait=$((cleanup_wait + 1))
					sleep 1
				done
				if [ "$(proc_starttime "$journal_test_pgid" 2>/dev/null)" = "$journal_test_starttime" ]; then
					case "$(proc_state "$journal_test_pgid" 2>/dev/null)" in
						''|Z|z) ;;
						*) kill -KILL "$journal_test_pgid" 2>/dev/null || true ;;
					esac
				fi
				cleanup_wait=0
				while [ "$cleanup_wait" -lt 3 ] &&
				      [ "$(proc_starttime "$journal_test_pgid" 2>/dev/null)" = "$journal_test_starttime" ]; do
					case "$(proc_state "$journal_test_pgid" 2>/dev/null)" in
						''|Z|z) break ;;
					esac
					cleanup_wait=$((cleanup_wait + 1))
					sleep 1
				done
				;;
		esac
	fi
	process_group_contains_session "$journal_test_pgid" && return 1
	if [ "$(proc_starttime "$journal_test_pgid" 2>/dev/null)" = "$journal_test_starttime" ]; then
		case "$(proc_state "$journal_test_pgid" 2>/dev/null)" in ''|Z|z) ;; *) return 1 ;; esac
	fi
	return 0
}

owner_session_has_live_children() {
	for proc_dir in /proc/[0-9]*; do
		[ -r "$proc_dir/stat" ] || continue
		member_pid="${proc_dir#/proc/}"
		[ "$member_pid" != "$$" ] || continue
		case "$(proc_state "$member_pid" 2>/dev/null)" in ''|Z|z) continue ;; esac
		[ "$(proc_group "$member_pid" 2>/dev/null)" = "$$" ] || continue
		[ "$(proc_session "$member_pid" 2>/dev/null)" = "$$" ] || continue
		return 0
	done
	return 1
}

signal_owner_session_children() {
	owner_signal="$1"
	for proc_dir in /proc/[0-9]*; do
		[ -r "$proc_dir/stat" ] || continue
		member_pid="${proc_dir#/proc/}"
		[ "$member_pid" != "$$" ] || continue
		case "$(proc_state "$member_pid" 2>/dev/null)" in ''|Z|z) continue ;; esac
		[ "$(proc_group "$member_pid" 2>/dev/null)" = "$$" ] || continue
		[ "$(proc_session "$member_pid" 2>/dev/null)" = "$$" ] || continue
		kill "-$owner_signal" "$member_pid" 2>/dev/null || true
	done
}

terminate_owner_session_children() {
	owner_session_has_live_children || return 0
	signal_owner_session_children TERM
	sleep 1
	owner_session_has_live_children || return 0
	signal_owner_session_children KILL
	sleep 1
	! owner_session_has_live_children
}

clear_terminated_active_test_journal() {
	read_journalled_active_test || return 1
	[ -n "$journal_test_pgid" ] || return 0
	process_group_contains_session "$journal_test_pgid" && return 1
	if [ "$(proc_starttime "$journal_test_pgid" 2>/dev/null)" = "$journal_test_starttime" ]; then
		case "$(proc_state "$journal_test_pgid" 2>/dev/null)" in ''|Z|z) ;; *) return 1 ;; esac
	fi
	recovery_active_test_pgid="$journal_test_pgid"
	recovery_active_test_starttime="$journal_test_starttime"
	clear_active_test_journal
}

worker_cleanup() {
	worker_rc="$1"
	[ "${cleanup_started:-0}" = 0 ] || return 0
	cleanup_started=1
	worker_exit_phase="${current_phase:-unknown}"
	trap - 0
	trap '' INT TERM HUP
	worker_trace "cleanup-enter rc=$worker_rc recovery_armed=${recovery_armed:-0}"
	[ -n "${recovery_heartbeat:-}" ] && [ -e "$recovery_heartbeat" ] && recovery_armed=1
	[ "${recovery_armed:-0}" = 1 ] &&
		write_status restoring 98 "Restoring and verifying SQM, autorate, and temporary calibration state" || true

	# No qdisc, nftables, SQM, or autorate mutation is allowed until every
	# journalled test and every monitor in the owner's session is proved gone.
	cleanup_runtime_ok=1
	if [ "${recovery_armed:-0}" = 1 ] && ! terminate_journalled_active_test; then
		cleanup_runtime_ok=0
	fi
	rm -f "${cpu_marker:-}" "${latency_marker:-}"
	stop_transport_latency_monitor || cleanup_runtime_ok=0
	terminate_owner_session_children || cleanup_runtime_ok=0
	if [ "${recovery_armed:-0}" = 1 ] && ! clear_terminated_active_test_journal; then
		cleanup_runtime_ok=0
	fi
	if [ "$cleanup_runtime_ok" = 1 ]; then
		cleanup_phase_background_counter
		cleanup_stale_phase_background_tables >/dev/null 2>&1 || true
		restore_temp_shaper || cleanup_runtime_ok=0
	fi

	if [ ! -s "$pending_result_file" ] && [ ! -s "$pending_error_file" ]; then
		if [ "$worker_rc" -eq 130 ] || [ -e "$cancel_file" ]; then
			stage_terminal_json error "{\"state\":\"cancelled\",\"schema_version\":7,\"stage\":\"$(json_escape "$worker_exit_phase")\",\"error\":\"Full Auto-Tune was cancelled; no configuration was written.\",\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"configuration_written\":false}" || true
		else
			stage_terminal_json error "{\"state\":\"failed\",\"schema_version\":7,\"stage\":\"$(json_escape "$worker_exit_phase")\",\"worker_exit_code\":$worker_rc,\"error\":\"Full Auto-Tune worker exited without a complete diagnostic result.\",\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"configuration_written\":false}" || true
		fi
	fi

	if [ "${recovery_armed:-0}" = 1 ]; then
		if [ "$cleanup_runtime_ok" = 1 ] && "$recovery_bin" finalize "$recovery_journal"; then
			recovery_armed=0
			publish_staged_terminal || true
		else
			# Keep pending diagnostics private.  The helper's recovery-failed
			# result, armed journal, and interface lock remain authoritative for
			# the detached watcher/procd retry after this owner exits. Preserve the
			# last status checkpoint as well: recovery uses it only when no valid
			# pending terminal exists, and removes it after terminal publication.
			true
		fi
	else
		# No network mutation is allowed before the heartbeat is armed.
		if release_autotune_interface_lock; then
			[ -z "${recovery_sqm_config_snapshot:-}" ] || rm -f "$recovery_sqm_config_snapshot" 2>/dev/null || true
			[ -n "${recovery_journal:-}" ] && rm -f "$recovery_journal" "${recovery_journal}.cleanup-done" 2>/dev/null || true
			publish_staged_terminal || true
		else
			# Keep the prepared journal for dead-owner garbage collection if a
			# partial lock reservation could not be removed synchronously.
			rm -f "$status_file"
		fi
	fi
	remove_own_worker_identity
	worker_trace "cleanup-complete rc=$worker_rc runtime_ok=$cleanup_runtime_ok"
	return 0
}

worker_exit_trap() {
	worker_exit_rc="$1"
	worker_trace "exit-trap rc=$worker_exit_rc"
	worker_cleanup "$worker_exit_rc"
}

run_job() {
	job_paths
