	safe_worker_token "$worker_token" ||
		fail "Full Auto-Tune worker identity token must be exactly 32 hexadecimal characters."
	registration_attempt=0
	worker_registered=false
	# This worker starts before its parent can publish the authenticated PID
	# record. The portable helper falls back to whole seconds on minimal
	# BusyBox builds instead of turning the bounded handshake into a busy-loop.
	while [ "$registration_attempt" -lt 15 ]; do
		if [ -s "$pid_file" ]; then
			read_worker_identity
			if [ "$identity_pid" = "$$" ] && [ "$identity_token" = "$worker_token" ] &&
			   [ "$identity_starttime" = "$(proc_starttime "$$" 2>/dev/null)" ] &&
