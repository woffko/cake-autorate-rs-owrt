capture_sqm_config_file() {
	snapshot_target="$runtime_lock_root/sqm-snapshot.autotune_$worker_token"
	snapshot_tmp="$runtime_lock_root/.sqm-snapshot.autotune_$worker_token.$$"
	case "$snapshot_target" in "$runtime_lock_root"/sqm-snapshot.*) ;; *) return 1 ;; esac
	[ -f "$sqm_config_file" ] && [ ! -L "$sqm_config_file" ] || return 1
	runtime_lock_path_owned_by_euid "$sqm_config_file" || return 1
	[ ! -e "$snapshot_target" ] && [ ! -L "$snapshot_target" ] || return 1
	[ ! -e "$snapshot_tmp" ] && [ ! -L "$snapshot_tmp" ] || return 1
	if ! cp "$sqm_config_file" "$snapshot_tmp" 2>/dev/null ||
	   ! owned_regular_file "$snapshot_tmp" ||
	   ! chmod 600 "$snapshot_tmp" 2>/dev/null ||
	   ! mv "$snapshot_tmp" "$snapshot_target" ||
	   ! owned_regular_file "$snapshot_target"; then
		rm -f "$snapshot_tmp" 2>/dev/null || true
		return 1
	fi
	[ "$(LC_ALL=C ls -ldn "$snapshot_target" 2>/dev/null | awk 'NR == 1 { print substr($1, 1, 10); exit }')" = '-rw-------' ] || {
		rm -f "$snapshot_target" 2>/dev/null || true
		return 1
	}
	# Re-check the source after the copy. A concurrent replacement cannot turn
	# a partially observed file into an authoritative recovery snapshot.
	[ -f "$sqm_config_file" ] && [ ! -L "$sqm_config_file" ] &&
		runtime_lock_path_owned_by_euid "$sqm_config_file" || {
		rm -f "$snapshot_target" 2>/dev/null || true
		return 1
	}
	printf '%s\n' "$snapshot_target"
}

prepare_recovery() {
	[ -x "$recovery_bin" ] || fail "Full Auto-Tune recovery helper is not installed."
	setsid_bin="$(command -v setsid 2>/dev/null)"
	[ -n "$setsid_bin" ] || fail "setsid is required for Full Auto-Tune recovery."
	secure_ram_directory "$recovery_root" || fail "Unsafe or foreign-owned Full Auto-Tune recovery directory."
	[ "$(proc_starttime "$$" 2>/dev/null)" = "$recovery_owner_starttime" ] ||
		fail "Full Auto-Tune owner identity changed before recovery was armed."
	[ "$(proc_group "$$")" = "$$" ] && [ "$(proc_session "$$")" = "$$" ] ||
		fail "Full Auto-Tune worker is not its isolated process-group leader."
	[ ! -e "$recovery_journal" ] && [ ! -e "$recovery_done_marker" ] && [ ! -e "$recovery_heartbeat" ] ||
		fail "A recovery record with this worker token already exists."
	recovery_prepared=1
	write_recovery_journal || fail "Unable to publish the initial recovery journal."
	# The watcher must not inherit either kernel flock.  It is deliberately
	# detached and acquires the journal-bound locks only after the owner dies.
	CAKE_AUTORATE_RUNTIME_GLOBAL_LOCK_FD= \
	CAKE_AUTORATE_INTERFACE_LOCK_FD= \
	CAKE_AUTORATE_INTERFACE_LOCK_OWNER= \
	CAKE_AUTORATE_INTERFACE_LOCK_STARTTIME= \
	CAKE_AUTORATE_INTERFACE_LOCK_TOKEN= \
	CAKE_AUTORATE_INTERFACE_LOCK_RECOVERY_JOURNAL= \
		"$setsid_bin" "$recovery_bin" watch "$recovery_journal" \
		</dev/null >/dev/null 2>&1 8>&- 9>&- &
	recovery_watcher_pid="$!"
	return 0
}

arm_recovery() {
	[ "${recovery_prepared:-0}" = 1 ] && [ -f "$recovery_journal" ] ||
		fail "Full Auto-Tune recovery journal disappeared before arming."
	runtime_lock_load_record "$autotune_interface_lock" &&
		[ "$runtime_record_pid" = "$$" ] &&
		[ "$runtime_record_starttime" = "$recovery_owner_starttime" ] &&
		[ "$runtime_record_token" = "$worker_token" ] &&
		[ "$runtime_record_journal" = "$recovery_journal" ] ||
		fail "Interface lock identity changed before Full Auto-Tune recovery was armed."
	heartbeat_tmp="$recovery_heartbeat.tmp.$$"
	: > "$heartbeat_tmp" && mv "$heartbeat_tmp" "$recovery_heartbeat" ||
		fail "Unable to arm Full Auto-Tune crash recovery."
	recovery_armed=1
}

compute_config_fingerprint() {
	command -v sha256sum >/dev/null 2>&1 || return 1
	safe_job_name "$job_name" || return 1
	fingerprint_cake_raw="$job_dir/config-fingerprint.cake.raw.$$"
	fingerprint_cake_sorted="$job_dir/config-fingerprint.cake.sorted.$$"
	fingerprint_sqm_raw="$job_dir/config-fingerprint.sqm.raw.$$"
	fingerprint_sqm_sorted="$job_dir/config-fingerprint.sqm.sorted.$$"
	fingerprint_rules_raw="$job_dir/config-fingerprint.rules.raw.$$"
	fingerprint_rules_sorted="$job_dir/config-fingerprint.rules.sorted.$$"
	fingerprint_input="$job_dir/config-fingerprint.input.$$"
	: > "$fingerprint_rules_raw" || return 1
	for fingerprint_rule_section in $(uci -q show cake-autorate 2>/dev/null |
		sed -n 's/^cake-autorate\.\([A-Za-z0-9_][A-Za-z0-9_]*\)=traffic_rule$/\1/p' |
		LC_ALL=C sort -u); do
		safe_job_name "$fingerprint_rule_section" || return 1
		[ "$(uci -q get "cake-autorate.$fingerprint_rule_section.instance" 2>/dev/null)" = "$job_name" ] ||
			continue
		uci -q show "cake-autorate.$fingerprint_rule_section" >> "$fingerprint_rules_raw" 2>/dev/null ||
			return 1
	done
	[ -s "$fingerprint_rules_raw" ] || printf '<none>\n' > "$fingerprint_rules_raw"
	if uci -q show "cake-autorate.$job_name" > "$fingerprint_cake_raw" 2>/dev/null &&
	   [ -s "$fingerprint_cake_raw" ]; then
		fingerprint_sqm_section="$(uci -q get "cake-autorate.$job_name.sqm_section" 2>/dev/null)"
		[ -n "$fingerprint_sqm_section" ] || fingerprint_sqm_section="cake_$job_name"
		safe_job_name "$fingerprint_sqm_section" || return 1
		[ "$(uci -q get "sqm.$fingerprint_sqm_section._cake_autorate_managed" 2>/dev/null)" = "$job_name" ] || return 1
		uci -q show "sqm.$fingerprint_sqm_section" > "$fingerprint_sqm_raw" 2>/dev/null &&
			[ -s "$fingerprint_sqm_raw" ] || return 1
	else
		# Create wizard: no instance exists yet.  Bind the result to that absence
		# and to the absence of its default SQM name; a foreign/same-name queue is
		# a conflict, not configuration to inherit.
		fingerprint_sqm_section="cake_$job_name"
		safe_job_name "$fingerprint_sqm_section" || return 1
		: > "$fingerprint_cake_raw"
		if uci -q show "sqm.$fingerprint_sqm_section" > "$fingerprint_sqm_raw" 2>/dev/null &&
		   [ -s "$fingerprint_sqm_raw" ]; then
			return 1
		fi
		printf '<absent>\n' > "$fingerprint_cake_raw"
		printf '<absent>\n' > "$fingerprint_sqm_raw"
	fi
	if [ ! -s "$fingerprint_cake_raw" ] || [ ! -s "$fingerprint_sqm_raw" ]; then
		rm -f "$fingerprint_cake_raw" "$fingerprint_cake_sorted" \
			"$fingerprint_sqm_raw" "$fingerprint_sqm_sorted" \
			"$fingerprint_rules_raw" "$fingerprint_rules_sorted" "$fingerprint_input"
		return 1
	fi
	LC_ALL=C sort "$fingerprint_cake_raw" > "$fingerprint_cake_sorted" || return 1
	LC_ALL=C sort "$fingerprint_sqm_raw" > "$fingerprint_sqm_sorted" || return 1
	LC_ALL=C sort "$fingerprint_rules_raw" > "$fingerprint_rules_sorted" || return 1
	{
		printf 'cake-autorate:%s\n' "$job_name"
		cat "$fingerprint_cake_sorted"
		printf 'sqm:%s\n' "$fingerprint_sqm_section"
		cat "$fingerprint_sqm_sorted"
		printf 'traffic-rules:%s\n' "$job_name"
		cat "$fingerprint_rules_sorted"
	} > "$fingerprint_input" || return 1
	fingerprint_digest="$(sha256sum "$fingerprint_input" 2>/dev/null | awk '{ print $1; exit }')"
	rm -f "$fingerprint_cake_raw" "$fingerprint_cake_sorted" \
		"$fingerprint_sqm_raw" "$fingerprint_sqm_sorted" \
		"$fingerprint_rules_raw" "$fingerprint_rules_sorted" "$fingerprint_input"
	case "$fingerprint_digest" in
		????????????????????????????????????????????????????????????????)
			case "$fingerprint_digest" in *[!0-9a-f]*) return 1 ;; esac
			printf 'sha256:%s\n' "$fingerprint_digest"
			;;
		*) return 1 ;;
	esac
}

capture_config_fingerprint() {
	config_fingerprint="$(compute_config_fingerprint)" ||
		fail "Unable to capture the managed UCI configuration fingerprint under the calibration lock."
	config_fingerprint_captured=true
}

config_fingerprint_matches() {
	[ "${config_fingerprint_captured:-false}" = true ] || return 1
	current_config_fingerprint="$(compute_config_fingerprint)" || return 1
	[ "$current_config_fingerprint" = "$config_fingerprint" ]
}

config_changed_inconclusive() {
	stage_terminal_json error "{\"state\":\"inconclusive\",\"schema_version\":7,\"stage\":\"config-changed\",\"error\":\"Managed CAKE Autorate/SQM configuration changed during calibration; all measurements are stale.\",\"reason\":\"config-changed\",\"retryable\":true,\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":false,\"configuration_written\":false}"
	exit 1
}

terminal_json_shape_valid() {
	terminal_candidate="$1"
	strict_single_json_object "$terminal_candidate" || return 1
	terminal_candidate_state="$(extract_json "$terminal_candidate" '@.state')" || return 1
	terminal_candidate_schema="$(extract_json "$terminal_candidate" '@.schema_version')" || return 1
	[ -n "$terminal_candidate_state" ] &&
		[ "$terminal_candidate_schema" = "$autotune_result_schema" ]
}

terminal_json_valid() {
	terminal_candidate="$1"
	terminal_json_shape_valid "$terminal_candidate" || return 1
	terminal_candidate_producer="$(extract_json "$terminal_candidate" '@.producer')" || return 1
	[ "$terminal_candidate_producer" = "$autotune_result_producer" ]
}

stage_terminal_json() {
	terminal_kind="$1"
	payload="$2"
	# Schema 8 adds evidence-derived confidence and result-class semantics. Keep
	# the numerous fail-closed terminal construction sites readable while
	# normalising their single top-level schema field at the publication gate.
	# Nested daemon/proposal schemas are deliberately left unchanged.
	payload="$(printf '%s\n' "$payload" | sed 's/"schema_version":7/"schema_version":8/')"
	if [ "${config_fingerprint_captured:-false}" = true ] &&
	   ! config_fingerprint_matches; then
		payload="{\"state\":\"inconclusive\",\"schema_version\":8,\"stage\":\"config-changed\",\"error\":\"Managed CAKE Autorate/SQM configuration changed during calibration; all measurements are stale.\",\"reason\":\"config-changed\",\"retryable\":true,\"auto_apply_eligible\":false,\"manual_apply_eligible\":false,\"phase_evidence_complete\":false,\"configuration_written\":false}"
		terminal_kind=error
	fi
	if [ "$terminal_kind" = result ]; then
		case "$payload" in
			*'"speedtest_retries":'*) ;;
			*'}') payload="${payload%?},\"speedtest_retries\":[${speedtest_retry_events_json:-}]}" ;;
			*) return 1 ;;
		esac
		case "$payload" in
			*'"traffic_budget":'*) ;;
			*'}') payload="${payload%?},\"traffic_budget\":$(traffic_budget_json)}" ;;
			*) return 1 ;;
		esac
	fi
	terminal_json_shape_valid "$payload" || return 1
	case "$payload" in
		*'}') payload="${payload%?},\"producer\":\"$autotune_result_producer\",\"profile\":\"$autotune_profile\",\"run_id\":\"$(json_escape "${worker_token:-unknown}")\",\"config_fingerprint\":\"$(json_escape "${config_fingerprint:-}")\",\"runtime_restored\":false,\"recovery_pending\":true}" ;;
		*) return 1 ;;
	esac
	terminal_json_valid "$payload" || return 1
	terminal_state="$(extract_json "$payload" '@.state')" || return 1
	case "$terminal_kind" in
		result)
			[ "$terminal_state" = complete ] || return 1
			rm -f "$pending_error_file"
			atomic_write "$pending_result_file" "$payload"
			;;
		error)
			[ "$terminal_state" != complete ] || return 1
			rm -f "$pending_result_file"
			atomic_write "$pending_error_file" "$payload"
			;;
		*) return 1 ;;
	esac
}

publish_staged_terminal() {
	if [ -s "$pending_result_file" ]; then
		pending_source="$pending_result_file"
		public_target="$result_file"
	elif [ -s "$pending_error_file" ]; then
		pending_source="$pending_error_file"
		public_target="$error_file"
	else
		return 1
	fi
	pending_payload="$(cat "$pending_source" 2>/dev/null)" || return 1
	terminal_json_valid "$pending_payload" || return 1
	case "$pending_payload" in *'"runtime_restored":false,"recovery_pending":true}') ;; *) return 1 ;; esac
	terminal_payload="$(printf '%s\n' "$pending_payload" |
		sed 's/,\"runtime_restored\":false,\"recovery_pending\":true}$/,"runtime_restored":true,"recovery_pending":false}/')"
	case "$terminal_payload" in
		*'"runtime_restored":true,"recovery_pending":false}') ;;
		*) return 1 ;;
	esac
	terminal_json_valid "$terminal_payload" || return 1
	rm -f "$terminal_integrity_file"
	atomic_write "$public_target" "$terminal_payload" || return 1
	if [ "$public_target" = "$result_file" ]; then
		rm -f "$error_file"
	else
		rm -f "$result_file"
	fi
	write_terminal_integrity "$public_target" || true
	rm -f "$pending_result_file" "$pending_error_file" "$status_file"
	return 0
}

emit_saved_terminal() {
	saved_terminal_file="$1"
	owned_regular_file "$saved_terminal_file" || {
		printf '{"state":"failed","schema_version":%s,"producer":"%s","error":"Saved Full Auto-Tune state is unsafe or unreadable; run calibration again.","auto_apply_eligible":false,"manual_apply_eligible":false,"configuration_written":false,"runtime_restored":true,"recovery_pending":false}\n' \
			"$autotune_result_schema" "$autotune_result_producer"
		return 0
	}
	if ensure_terminal_integrity "$saved_terminal_file"; then
		cat "$saved_terminal_file"
		return 0
	fi
	saved_terminal="$(cat "$saved_terminal_file" 2>/dev/null)" || saved_terminal=""
	if terminal_json_valid "$saved_terminal"; then
		printf '%s\n' "$saved_terminal"
		return 0
	fi
	if strict_single_json_object "$saved_terminal"; then
		saved_schema="$(extract_json "$saved_terminal" '@.schema_version' 2>/dev/null || true)"
		saved_state="$(extract_json "$saved_terminal" '@.state' 2>/dev/null || true)"
		printf '{"state":"legacy","schema_version":%s,"producer":"%s","legacy_schema_version":"%s","legacy_state":"%s","error":"Saved Full Auto-Tune diagnostics were created by an older result schema. They cannot be applied; run Full Auto-Tune again.","auto_apply_eligible":false,"manual_apply_eligible":false,"configuration_written":false,"runtime_restored":true,"recovery_pending":false,"legacy_result":%s}\n' \
			"$autotune_result_schema" "$autotune_result_producer" \
			"$(json_escape "${saved_schema:-unknown}")" \
			"$(json_escape "${saved_state:-unknown}")" "$saved_terminal"
		return 0
	fi
	printf '{"state":"failed","schema_version":%s,"producer":"%s","error":"Saved Full Auto-Tune diagnostics are malformed and were ignored; run calibration again.","auto_apply_eligible":false,"manual_apply_eligible":false,"configuration_written":false,"runtime_restored":true,"recovery_pending":false}\n' \
		"$autotune_result_schema" "$autotune_result_producer"
}

write_status() {
	phase="$1"
	progress="$2"
	message="$3"
	current_phase="$phase"
	worker_trace "status phase=$phase progress=$progress message=$(json_escape "$message")"
	atomic_write "$status_file" "{\"state\":\"running\",\"phase\":\"$(json_escape "$phase")\",\"progress\":$progress,\"message\":\"$(json_escape "$message")\",\"job_id\":\"$(json_escape "$job_name")\",\"run_id\":\"$(json_escape "${active_run_id:-${worker_token:-pending}}")\",\"requested_target_interface\":\"$(json_escape "$target_if_input")\",\"requested_backend\":\"$(json_escape "$backend_input")\",\"requested_route_mode\":\"$(json_escape "$route_mode_override")\",\"requested_mwan3_member\":\"$(json_escape "$mwan3_member_override")\",\"requested_profile\":\"$(json_escape "$autotune_profile")\",\"requested_conservative\":$([ "${conservative_mode:-0}" = 1 ] && printf true || printf false),\"requested_calibration_strategy\":\"$(json_escape "$calibration_strategy")\"}"
}

# A short, RAM-only breadcrumb stream is deliberately written to the worker's
# already-open job.log.  It contains no command output, secrets, or UCI values;
# its purpose is to retain the last completed state if the kernel or an external
# supervisor terminates the owner before the EXIT trap can stage diagnostics.
worker_trace() {
	[ "${mode:-}" = job-run ] || return 0
	trace_sequence=$(( ${trace_sequence:-0} + 1 ))
	printf 'autotune-trace seq=%s pid=%s phase=%s %s\n' \
		"$trace_sequence" "$$" "${current_phase:-starting}" "$*" >&2
}

nonnegative_delta() {
	awk -v loaded="${1:-0}" -v idle="${2:-0}" 'BEGIN {
		delta = loaded - idle
		if (delta < 0) delta = 0
		printf "%.1f", delta
	}'
}

maximum_number() {
	awk -v first="${1:-0}" -v second="${2:-0}" 'BEGIN {
		printf "%.3f", (first > second ? first : second)
	}'
}

configure_validation_thresholds() {
	validation_profile="$(extract_json "$proposal" '@.profile')" || return 1
	[ "$validation_profile" = "$autotune_profile" ] || return 1
	validation_candidate_realization_min_percent="$(extract_json "$proposal" '@.validation.candidate_realization_min_percent')" || return 1
	validation_candidate_realization_max_percent="$(extract_json "$proposal" '@.validation.candidate_realization_max_percent')" || return 1
	validation_capacity_retention_min_percent="$(extract_json "$proposal" '@.validation.capacity_retention_min_percent')" || return 1
	validation_icmp_delay_max_ms="$(extract_json "$proposal" '@.validation.icmp_delta_max_ms')" || return 1
	validation_transport_delay_max_ms="$(extract_json "$proposal" '@.validation.transport_delta_max_ms')" || return 1
	validation_loss_max_percent="$(extract_json "$proposal" '@.validation.loss_max_percent')" || return 1
	validation_cpu_max_percent="$(extract_json "$proposal" '@.validation.cpu_max_percent')" || return 1
	[ "$validation_icmp_delay_max_ms" = "$validation_transport_delay_max_ms" ] || return 1
	validation_delay_max_ms="$validation_transport_delay_max_ms"
	case "$autotune_profile" in
		gaming|gaming_extreme) validation_manual_latency_review_max_ms=30 ;;
		best_overall) validation_manual_latency_review_max_ms=60 ;;
		variable_link) validation_manual_latency_review_max_ms=200 ;;
		fair) validation_manual_latency_review_max_ms=400 ;;
		*) return 1 ;;
	esac
}

configured_rate_value() {
	direction="$1"
	case "$direction" in
		dl) keys="sqm_download base_dl_shaper_rate_kbps max_dl_shaper_rate_kbps" ;;
		ul) keys="sqm_upload base_ul_shaper_rate_kbps max_ul_shaper_rate_kbps" ;;
		*) return 1 ;;
	esac
	for key in $keys; do
		value="$(uci -q get "cake-autorate.$job_name.$key" 2>/dev/null)"
		if is_positive_uint "$value"; then
			printf '%s\n' "$value"
			return 0
		fi
	done
	return 1
}

phase_reference_rate() {
	direction="$1"
	case "$direction" in
		dl) measured="${calibration_capacity_dl_kbps:-}" ;;
		ul) measured="${calibration_capacity_ul_kbps:-}" ;;
		*) return 1 ;;
	esac
	if is_positive_uint "$measured"; then
		printf '%s\n' "$measured"
		return 0
	fi
	configured_rate_value "$direction" 2>/dev/null || printf '%s\n' 0
}

strict_background_limit() {
	reference="$1"
	percent="$2"
	minimum="${3:-1000}"
	awk -v r="$reference" -v p="$percent" -v m="$minimum" 'BEGIN { v=r*p; if(v<m)v=m; printf "%.0f",v }'
}

background_rate_exceeds() {
	actual="${1:-0}"
	limit="${2:-0}"
	[ "$actual" -gt "$limit" ] 2>/dev/null
}

background_share_percent() {
	actual="${1:-0}"
	reference="${2:-0}"
	if ! is_positive_uint "$reference"; then
		printf '%s\n' 0
		return 0
	fi
	awk -v a="$actual" -v r="$reference" 'BEGIN {
		p = (a + 0) * 100 / r
		if (p < 0) p = 0
		if (p > 999) p = 999
		printf "%.1f", p
	}'
}

capacity_confidence_for_share() {
	share="${1:-0}"
	awk -v p="$share" 'BEGIN {
		if (p <= 2) print 100
		else if (p <= 5) print 96
		else if (p <= 15) print 88
		else if (p <= 30) print 75
		else if (p <= 50) print 60
		else if (p <= 80) print 40
		else print 25
	}'
}

realization_confidence_percent() {
	awk -v p="${1:-0}" 'BEGIN {
		p += 0
		if (p < 0) p = 0
		if (p > 100) p = 100
		printf "%.0f", p
	}'
}

append_confidence_reason() {
	reason_code="$1"
	reason_scope="$2"
	reason_message="$3"
	reason_entry="{\"code\":\"$(json_escape "$reason_code")\",\"scope\":\"$(json_escape "$reason_scope")\",\"message\":\"$(json_escape "$reason_message")\"}"
	if [ -n "${confidence_reasons_json:-}" ]; then
		confidence_reasons_json="$confidence_reasons_json,$reason_entry"
	else
		confidence_reasons_json="$reason_entry"
	fi
}

build_autotune_confidence() {
	capacity_download_confidence_percent="$(capacity_confidence_for_share "${observed_background_dl_max_share_percent:-0}")"
	capacity_upload_confidence_percent="$(capacity_confidence_for_share "${observed_background_ul_max_share_percent:-0}")"
	quality_confidence_percent=100
	confidence_reasons_json=""

	[ "$capacity_download_confidence_percent" -eq 100 ] ||
		append_confidence_reason background-share-download download \
		"Concurrent download traffic reduced capacity confidence."
	[ "$capacity_upload_confidence_percent" -eq 100 ] ||
		append_confidence_reason background-share-upload upload \
		"Concurrent upload traffic reduced capacity confidence."

	# A clean low-realization observation can mean that a variable upstream
	# bottleneck moved below the selected CAKE rate.  It is weak capacity
	# evidence, not proof of unsafe latency/loss.  Preserve it for manual Review
	# while making the uncertainty visible and preventing trusted Auto-Apply.
	if [ -n "${dl_candidate_realization:-}" ] &&
	   awk -v actual="$dl_candidate_realization" \
	       -v minimum="${validation_candidate_realization_min_percent:-80}" \
	       'BEGIN { exit !((actual + 0) < (minimum + 0)) }'; then
		dl_realization_confidence="$(realization_confidence_percent "${dl_candidate_realization:-0}")"
		[ "$capacity_download_confidence_percent" -le "$dl_realization_confidence" ] ||
			capacity_download_confidence_percent="$dl_realization_confidence"
		append_confidence_reason candidate-realization-download download \
			"Achieved download throughput did not fully exercise the selected CAKE rate."
	fi
	if [ -n "${ul_candidate_realization:-}" ] &&
	   awk -v actual="$ul_candidate_realization" \
	       -v minimum="${validation_candidate_realization_min_percent:-80}" \
	       'BEGIN { exit !((actual + 0) < (minimum + 0)) }'; then
		ul_realization_confidence="$(realization_confidence_percent "${ul_candidate_realization:-0}")"
		[ "$capacity_upload_confidence_percent" -le "$ul_realization_confidence" ] ||
			capacity_upload_confidence_percent="$ul_realization_confidence"
		append_confidence_reason candidate-realization-upload upload \
			"Achieved upload throughput did not fully exercise the selected CAKE rate."
	fi

	if [ "${baseline_quality_provisional:-false}" = true ]; then
		[ "$quality_confidence_percent" -le 55 ] || quality_confidence_percent=55
		append_confidence_reason baseline-background quality \
			"Idle latency was measured while background traffic was present."
	fi
	if [ "${unresolved_background_contamination:-false}" = true ] ||
	   [ "${validation_contaminated:-false}" = true ]; then
		[ "$quality_confidence_percent" -le 70 ] || quality_confidence_percent=70
		append_confidence_reason background-contamination-accepted quality \
			"At least one accepted validation observation included background traffic."
	fi
	if [ "${phase_contamination_seen:-false}" = true ] &&
	   [ "${unresolved_background_contamination:-false}" != true ] &&
	   [ "${validation_contaminated:-false}" != true ]; then
		[ "$quality_confidence_percent" -le 84 ] || quality_confidence_percent=84
		append_confidence_reason background-contamination-resolved all \
			"Earlier background traffic was followed by clean repeated measurements."
	fi
	if [ "${bidirectional_realization_pass:-true}" != true ]; then
		bidi_dl_confidence="$(realization_confidence_percent "${bidirectional_download_realization:-0}")"
		bidi_ul_confidence="$(realization_confidence_percent "${bidirectional_upload_realization:-0}")"
		[ "$capacity_download_confidence_percent" -le "$bidi_dl_confidence" ] ||
			capacity_download_confidence_percent="$bidi_dl_confidence"
		[ "$capacity_upload_confidence_percent" -le "$bidi_ul_confidence" ] ||
			capacity_upload_confidence_percent="$bidi_ul_confidence"
		append_confidence_reason bidirectional-realization all \
			"Simultaneous download and upload did not fully exercise both selected CAKE rates."
	fi
	if [ "${bidirectional_safety_pass:-true}" != true ]; then
		[ "$quality_confidence_percent" -le 70 ] || quality_confidence_percent=70
		append_confidence_reason bidirectional-quality all \
			"Simultaneous download and upload missed the selected profile's latency or loss target."
	fi

	overall_confidence_percent="$capacity_download_confidence_percent"
	[ "$capacity_upload_confidence_percent" -ge "$overall_confidence_percent" ] ||
		overall_confidence_percent="$capacity_upload_confidence_percent"
	[ "$quality_confidence_percent" -ge "$overall_confidence_percent" ] ||
		overall_confidence_percent="$quality_confidence_percent"

	if [ "$overall_confidence_percent" -ge 85 ] &&
	   [ "${phase_contamination_seen:-false}" != true ] &&
	   [ "${baseline_quality_provisional:-false}" != true ] &&
	   [ "${unresolved_background_contamination:-false}" != true ] &&
	   [ "${validation_contaminated:-false}" != true ]; then
		result_class=trusted
	elif [ "$overall_confidence_percent" -ge 40 ]; then
		result_class=provisional
	else
		result_class=estimated
	fi
	confidence_json="{\"overall_percent\":$overall_confidence_percent,\"capacity_download_percent\":$capacity_download_confidence_percent,\"capacity_upload_percent\":$capacity_upload_confidence_percent,\"quality_percent\":$quality_confidence_percent,\"reasons\":[$confidence_reasons_json]}"
}

measure_background_traffic() {
	if [ "${CAKE_AUTORATE_AUTOTUNE_TEST_PREFLIGHT:-0}" = 1 ]; then
		background_dl_kbps="${CAKE_AUTORATE_AUTOTUNE_BACKGROUND_DL_KBPS:-0}"
		background_ul_kbps="${CAKE_AUTORATE_AUTOTUNE_BACKGROUND_UL_KBPS:-0}"
	else
		duration="${CAKE_AUTORATE_AUTOTUNE_BACKGROUND_SAMPLE_S:-3}"
		case "$duration" in ''|*[!0-9]*) duration=3 ;; esac
		[ "$duration" -ge 1 ] 2>/dev/null || duration=3
		rx_before="$(sed -n '1p' "/sys/class/net/$target_if/statistics/rx_bytes" 2>/dev/null)"
		tx_before="$(sed -n '1p' "/sys/class/net/$target_if/statistics/tx_bytes" 2>/dev/null)"
		sleep "$duration"
		rx_after="$(sed -n '1p' "/sys/class/net/$target_if/statistics/rx_bytes" 2>/dev/null)"
		tx_after="$(sed -n '1p' "/sys/class/net/$target_if/statistics/tx_bytes" 2>/dev/null)"
		background_dl_kbps="$(awk -v a="${rx_after:-0}" -v b="${rx_before:-0}" -v s="$duration" 'BEGIN { d=a-b; if (d<0)d=0; printf "%.0f", d*8/s/1000 }')"
		background_ul_kbps="$(awk -v a="${tx_after:-0}" -v b="${tx_before:-0}" -v s="$duration" 'BEGIN { d=a-b; if (d<0)d=0; printf "%.0f", d*8/s/1000 }')"
	fi

	dl_reference="$(phase_reference_rate dl)"
	ul_reference="$(phase_reference_rate ul)"
	background_dl_reference_known=false
	background_ul_reference_known=false
	background_reference_deferred=false
	if is_positive_uint "$dl_reference"; then
		background_dl_reference_known=true
		background_dl_limit="$(strict_background_limit "$dl_reference" 0.05)"
		background_dl_hard="$(strict_background_limit "$dl_reference" 0.35 5000)"
	else
		background_dl_limit=0
		background_dl_hard=0
		background_reference_deferred=true
	fi
	if is_positive_uint "$ul_reference"; then
		background_ul_reference_known=true
		background_ul_limit="$(strict_background_limit "$ul_reference" 0.05)"
		background_ul_hard="$(strict_background_limit "$ul_reference" 0.35 5000)"
	else
		background_ul_limit=0
		background_ul_hard=0
		background_reference_deferred=true
	fi
	background_blocked=false
	[ "$background_dl_reference_known" != true ] ||
		! background_rate_exceeds "$background_dl_kbps" "$background_dl_limit" || background_blocked=true
	[ "$background_ul_reference_known" != true ] ||
		! background_rate_exceeds "$background_ul_kbps" "$background_ul_limit" || background_blocked=true
	background_dl_usable=true
	background_ul_usable=true
	[ "$background_dl_reference_known" != true ] ||
		! background_rate_exceeds "$background_dl_kbps" "$background_dl_hard" || background_dl_usable=false
	[ "$background_ul_reference_known" != true ] ||
		! background_rate_exceeds "$background_ul_kbps" "$background_ul_hard" || background_ul_usable=false
	background_dl_share_percent="$(background_share_percent "$background_dl_kbps" "$dl_reference")"
	background_ul_share_percent="$(background_share_percent "$background_ul_kbps" "$ul_reference")"
	if awk -v a="$background_dl_share_percent" -v b="${observed_background_dl_max_share_percent:-0}" 'BEGIN { exit(a > b ? 0 : 1) }'; then
		observed_background_dl_max_share_percent="$background_dl_share_percent"
	fi
	if awk -v a="$background_ul_share_percent" -v b="${observed_background_ul_max_share_percent:-0}" 'BEGIN { exit(a > b ? 0 : 1) }'; then
		observed_background_ul_max_share_percent="$background_ul_share_percent"
	fi
}

background_json() {
	printf '{"download_kbps":%s,"upload_kbps":%s,"download_reference_kbps":%s,"upload_reference_kbps":%s,"download_reference_known":%s,"upload_reference_known":%s,"reference_deferred":%s,"strict_download_limit_kbps":%s,"strict_upload_limit_kbps":%s,"download_usable":%s,"upload_usable":%s,"download_share_percent":%s,"upload_share_percent":%s}' \
		"${background_dl_kbps:-0}" "${background_ul_kbps:-0}" \
		"${dl_reference:-0}" "${ul_reference:-0}" \
		"${background_dl_reference_known:-false}" "${background_ul_reference_known:-false}" \
		"${background_reference_deferred:-false}" \
		"${background_dl_limit:-0}" "${background_ul_limit:-0}" \
		"${background_dl_usable:-true}" "${background_ul_usable:-true}" \
		"${background_dl_share_percent:-0}" "${background_ul_share_percent:-0}"
