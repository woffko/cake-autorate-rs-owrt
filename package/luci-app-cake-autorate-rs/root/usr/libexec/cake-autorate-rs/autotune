		selected_external_ip=""
		fair_control_json=null
		raw_control_json=null
		fair_control_active=0
		run_measurement 1
		validate_deferred_baseline_capacity "$calibration_capacity_dl_kbps" "$calibration_capacity_ul_kbps"

		raw_series_control_rc=0
		run_directional_control download 1 || raw_series_control_rc="$?"
		[ "$raw_series_control_rc" -ne 0 ] || run_directional_control download 2 || raw_series_control_rc="$?"
		[ "$raw_series_control_rc" -ne 0 ] || run_directional_control upload 1 || raw_series_control_rc="$?"
		[ "$raw_series_control_rc" -ne 0 ] || run_directional_control upload 2 || raw_series_control_rc="$?"
		[ "$raw_series_control_rc" -ne 0 ] || break

		if [ "$raw_series_control_rc" -eq 75 ] &&
		   [ "$calibration_strategy" = full_raw ] &&
		   [ "$raw_series_attempt" -lt "$raw_series_max_attempts" ] &&
		   [ -z "$configured_speedtest_server_id" ] &&
		   is_positive_uint "$selected_server_id"; then
			speedtest_excluded_server_id="$selected_server_id"
			raw_series_attempt=$((raw_series_attempt + 1))
			current_progress=45
			speedtest_retry_backoff "The pinned server stalled repeatedly; restarting the complete raw-control series with another server"
			continue
		fi
		speedtest_timeout_inconclusive "directional-control" \
			"${speedtest_retry_exhausted_context:-direction-only speed-test control}"
	done
	if [ "$calibration_strategy" = reuse_trusted ]; then
		# The live shaped controls above attest route/server/SQM health. The
		# explicit trusted strategy then searches from the saved reference rather
		# than relabelling current shaped throughput as a new raw line capacity.
		download_samples="$trusted_capacity_dl_kbps,$trusted_capacity_dl_kbps"
		upload_samples="$trusted_capacity_ul_kbps,$trusted_capacity_ul_kbps"
		calibration_capacity_dl_kbps="$trusted_capacity_dl_kbps"
		calibration_capacity_ul_kbps="$trusted_capacity_ul_kbps"
	fi

	write_status proposal 80 "Calculating safe initial limits and adaptive ceiling bounds"
	reference_proposal_candidate="$(calculate_proposal 1.0 1.0)" || fail "Autotune reference proposal calculation failed."
	proposal_json_valid "$reference_proposal_candidate" || fail "Autotune reference proposal returned malformed JSON."
	reference_proposal="$reference_proposal_candidate"
	reference_dl_base="$(extract_json "$reference_proposal" '@.download.base_kbps')"
	reference_ul_base="$(extract_json "$reference_proposal" '@.upload.base_kbps')"
	is_positive_uint "$reference_dl_base" || fail "Reference proposal returned no download base."
	is_positive_uint "$reference_ul_base" || fail "Reference proposal returned no upload base."
	if [ "$conservative_mode" = 1 ]; then
		proposal_candidate="$(calculate_proposal 0.85 0.85)" || fail "Conservative autotune proposal calculation failed."
		proposal_json_valid "$proposal_candidate" || fail "Conservative autotune proposal returned malformed JSON."
		proposal="$proposal_candidate"
	else
		proposal="$reference_proposal"
	fi
	configure_validation_thresholds ||
		fail "Autotune proposal returned an invalid or mismatched profile policy."

	validation_attempt_number=1
	profile_search_max_attempts=8
	case "$autotune_profile" in variable_link|gaming_extreme) profile_search_max_attempts=12 ;; esac
	validation_attempts_json=""
	dl_search_observations=""
	ul_search_observations=""
	dl_search_active=true
	ul_search_active=true
	dl_search_json=null
	ul_search_json=null
	dl_search_selected_safety=""
	ul_search_selected_safety=""
	dl_search_selected_manual_reviewable=false
	ul_search_selected_manual_reviewable=false
	dl_search_no_cake_effect=false
	ul_search_no_cake_effect=false
	dl_search_manual_fallback=false
	ul_search_manual_fallback=false
	profile_search_inconclusive=false
	profile_search_inconclusive_reason=""
	fair_outcome_json=null
	while [ "$validation_attempt_number" -le "$profile_search_max_attempts" ]; do
		run_shaped_validation "$validation_attempt_number"
		write_status search 89 "Evaluating directional profile-search observation $validation_attempt_number"
		if [ -n "$validation_attempts_json" ]; then
			validation_attempts_json="$validation_attempts_json,$validation_json"
		else
			validation_attempts_json="$validation_json"
		fi

		if [ "$dl_search_active" = true ]; then
			append_profile_search_observation download || fail "Unable to record the download profile-search observation."
			run_profile_direction_search download || fail "The typed download profile optimizer rejected its evidence."
			case "$dl_search_action" in
				complete|fallback) dl_search_active=false ;;
				inconclusive)
					dl_search_active=false
					profile_search_inconclusive=true
					profile_search_inconclusive_reason="download:$dl_search_reason"
					;;
			esac
		fi
		if [ "$ul_search_active" = true ]; then
			append_profile_search_observation upload || fail "Unable to record the upload profile-search observation."
			run_profile_direction_search upload || fail "The typed upload profile optimizer rejected its evidence."
			case "$ul_search_action" in
				complete|fallback) ul_search_active=false ;;
				inconclusive)
					ul_search_active=false
					profile_search_inconclusive=true
					[ -n "$profile_search_inconclusive_reason" ] && profile_search_inconclusive_reason="$profile_search_inconclusive_reason;"
					profile_search_inconclusive_reason="${profile_search_inconclusive_reason}upload:$ul_search_reason"
					;;
			esac
		fi

		[ "$profile_search_inconclusive" = false ] || break
		if [ "$dl_search_active" = false ] && [ "$ul_search_active" = false ]; then
			break
		fi
		next_dl_candidate="$dl_search_selected"
		next_ul_candidate="$ul_search_selected"
		[ "$dl_search_active" = true ] && next_dl_candidate="$dl_search_next"
		[ "$ul_search_active" = true ] && next_ul_candidate="$ul_search_next"
		is_positive_uint "$next_dl_candidate" && is_positive_uint "$next_ul_candidate" ||
			fail "The profile optimizer did not return a bounded candidate pair."
		write_status search 90 "Testing the next bounded throughput and latency candidate"
		set_exact_profile_candidates "$next_dl_candidate" "$next_ul_candidate" ||
			fail "Proposal constraints could not realize the typed profile-search candidate exactly."
		validation_attempt_number=$((validation_attempt_number + 1))
	done
	if [ "$profile_search_inconclusive" = true ] || [ "$dl_search_active" = true ] || [ "$ul_search_active" = true ]; then
		profile_search_terminal_reason="profile-search-inconclusive:${profile_search_inconclusive_reason:-bounded-search-did-not-finish}"
		# Optimizer uncertainty is not phase corruption.  When the independent
		# full-raw control is clean, finish with that exact no-SQM topology rather
		# than discarding useful evidence or inventing a shaped rate.
		if complete_raw_only_review "$profile_search_terminal_reason"; then
			return 0
		fi
		phase_evidence_complete=false
		measurement_inconclusive validation "$profile_search_terminal_reason"
	fi

	selected_dl_candidate="$dl_search_selected"
	selected_ul_candidate="$ul_search_selected"
	is_positive_uint "$selected_dl_candidate" && is_positive_uint "$selected_ul_candidate" ||
		fail "The bounded profile search found no candidate above the configured capacity safety floor."
	profile_floor_infeasible=false
	profile_floor_infeasible_reason=""
	if [ "$dl_search_selected_safety" = false ] &&
	   [ "$dl_search_selected_manual_reviewable" != true ]; then
		profile_floor_infeasible=true
		profile_floor_infeasible_reason="download:$dl_search_reason"
	fi
	if [ "$ul_search_selected_safety" = false ] &&
	   [ "$ul_search_selected_manual_reviewable" != true ]; then
		profile_floor_infeasible=true
		[ -n "$profile_floor_infeasible_reason" ] &&
			profile_floor_infeasible_reason="$profile_floor_infeasible_reason;"
		profile_floor_infeasible_reason="${profile_floor_infeasible_reason}upload:$ul_search_reason"
	fi
	# A shaped search miss invalidates only the shaped topology. Keep collecting
	# independently attributable one-sided and raw evidence: on a variable radio
	# link those may be the only safe, useful review choices.
	current_dl_candidate="$(extract_json "$proposal" '@.download.base_kbps')"
	current_ul_candidate="$(extract_json "$proposal" '@.upload.base_kbps')"
	if [ "$current_dl_candidate" != "$selected_dl_candidate" ] ||
	   [ "$current_ul_candidate" != "$selected_ul_candidate" ]; then
		set_exact_profile_candidates "$selected_dl_candidate" "$selected_ul_candidate" ||
			fail "Unable to restore the selected profile-search candidate for confirmation."
		validation_attempt_number=$((validation_attempt_number + 1))
		write_status confirmation 94 "Confirming the selected download and upload candidate pair"
		run_shaped_validation "$validation_attempt_number"
		validation_attempts_json="$validation_attempts_json,$validation_json"
	fi
	if [ "$profile_floor_infeasible" != true ] && [ "$validation_safety_pass" != true ]; then
		validation_attempt_number=$((validation_attempt_number + 1))
		write_status confirmation 95 "Repeating the selected pair once because its safety confirmation was unstable"
		run_shaped_validation "$validation_attempt_number"
		validation_attempts_json="$validation_attempts_json,$validation_json"
	fi
	# A repeatable final shaped failure excludes both_shaped later. It is not a
	# terminal measurement failure and must not hide a topology with its own
	# clean, repeated safety proof.
	dl_runtime_minimum_valid=true
	ul_runtime_minimum_valid=true
	if [ "$autotune_profile" = variable_link ] || [ "$autotune_profile" = gaming_extreme ]; then
		dl_runtime_minimum_valid=false
		ul_runtime_minimum_valid=false
		is_positive_uint "$dl_search_runtime_minimum" && dl_runtime_minimum_valid=true
		is_positive_uint "$ul_search_runtime_minimum" && ul_runtime_minimum_valid=true
		if [ "$dl_runtime_minimum_valid" = true ] || [ "$ul_runtime_minimum_valid" = true ]; then
			final_dl_runtime_minimum=""
			final_ul_runtime_minimum=""
			[ "$dl_runtime_minimum_valid" = true ] && final_dl_runtime_minimum="$dl_search_runtime_minimum"
			[ "$ul_runtime_minimum_valid" = true ] && final_ul_runtime_minimum="$ul_search_runtime_minimum"
			set_exact_profile_candidates "$selected_dl_candidate" "$selected_ul_candidate" \
				"$final_dl_runtime_minimum" "$final_ul_runtime_minimum" ||
				fail "Unable to preserve the measured runtime minima."
			if [ "$dl_runtime_minimum_valid" = true ]; then
				[ "$(extract_json "$proposal" '@.download.minimum_kbps')" = "$dl_search_runtime_minimum" ] ||
					fail "The measured download runtime minimum was not written to the final proposal."
			fi
			if [ "$ul_runtime_minimum_valid" = true ]; then
				[ "$(extract_json "$proposal" '@.upload.minimum_kbps')" = "$ul_search_runtime_minimum" ] ||
					fail "The measured upload runtime minimum was not written to the final proposal."
			fi
		fi
	fi

	# Directional search intentionally isolates DL and UL so each frontier is
	# attributable. Confirm the chosen pair once under concurrent load to catch
	# ACK starvation, cross-direction interference, and joint bufferbloat without
	# multiplying the traffic cost of every search observation.
	run_bidirectional_confirmation "$((validation_attempt_number + 1))"
	build_directional_recommendation
	directional_safe_alternative=false
	case "$(extract_json "$directional_recommendation_json" '@.recommended_topology')" in
		upload_only_shaped|download_only_shaped)
			[ "$(extract_json "$directional_recommendation_json" '@.repeatable')" = true ] &&
				directional_safe_alternative=true
			;;
	esac
	# Do not terminate on an unsafe simultaneous shaped pair. Each candidate is
	# admitted below only by its own topology-specific safety evidence.

	profile_target_met="$validation_quality_target_met"
	[ "$bidirectional_latency_pass" = true ] || profile_target_met=false
	profile_manual_only=false
	profile_capacity_floor_met="$validation_profile_objectives_met"
	profile_deep_runtime_minimum=false
	profile_runtime_minimum_retention_json=null
	if [ "$autotune_profile" = gaming_extreme ] &&
	   [ "$dl_runtime_minimum_valid" = true ] &&
	   [ "$ul_runtime_minimum_valid" = true ]; then
		extreme_dl_runtime_retention="$(awk -v minimum="$dl_search_runtime_minimum" -v raw="$raw_dl_low" 'BEGIN {
			if (raw <= 0) exit 1
			printf "%.1f", minimum * 100 / raw
		}')" || fail "Unable to calculate the Extreme A+ download runtime retention."
		extreme_ul_runtime_retention="$(awk -v minimum="$ul_search_runtime_minimum" -v raw="$raw_ul_low" 'BEGIN {
			if (raw <= 0) exit 1
			printf "%.1f", minimum * 100 / raw
		}')" || fail "Unable to calculate the Extreme A+ upload runtime retention."
		profile_runtime_minimum_retention_json="{\"download_percent\":$extreme_dl_runtime_retention,\"upload_percent\":$extreme_ul_runtime_retention}"
		profile_deep_runtime_minimum="$(awk -v dl="$extreme_dl_runtime_retention" -v ul="$extreme_ul_runtime_retention" 'BEGIN {
			print (dl < 70 || ul < 70) ? "true" : "false"
		}')"
	fi
	# The 50% comparison is only a historical trust warning.  It must not make
	# a currently controlled 5G candidate unsafe: radio capacity can legitimately
	# move far below an earlier clean sample.  Excessive realization (shaper
	# bypass) and loss remain safety blockers; low realization is represented as
	# reduced confidence and a manual-only throughput advisory.
	profile_safety_floor_met="$(awk -v dl="$dl_retention" -v ul="$ul_retention" 'BEGIN {
		print (dl >= 50 && ul >= 50) ? "true" : "false"
	}')"
	if [ "$profile_floor_infeasible" = true ]; then
		profile_outcome_mode=safety-floor-infeasible
		profile_manual_only=true
	else
		case "$autotune_profile:$profile_target_met:$profile_capacity_floor_met" in
			gaming:true:true) profile_outcome_mode=target-a-plus-met ;;
			gaming:true:false) profile_outcome_mode=target-a-plus-throughput-advisory; profile_manual_only=true ;;
			gaming:false:true) profile_outcome_mode=best-attainable-quality-fallback; profile_manual_only=true ;;
			gaming:false:false) profile_outcome_mode=quality-and-throughput-advisory-review; profile_manual_only=true ;;
			gaming_extreme:true:true)
				if [ "$profile_deep_runtime_minimum" = true ]; then
					profile_outcome_mode=extreme-a-plus-throughput-sacrifice
					profile_manual_only=true
				else
					profile_outcome_mode=extreme-a-plus-met
				fi
				;;
			gaming_extreme:true:false) profile_outcome_mode=extreme-a-plus-throughput-sacrifice; profile_manual_only=true ;;
			gaming_extreme:false:true) profile_outcome_mode=extreme-best-attainable-quality-fallback; profile_manual_only=true ;;
			gaming_extreme:false:false) profile_outcome_mode=extreme-quality-and-throughput-review; profile_manual_only=true ;;
			best_overall:true:true) profile_outcome_mode=target-a-met ;;
			best_overall:true:false) profile_outcome_mode=target-a-throughput-advisory; profile_manual_only=true ;;
			best_overall:false:true) profile_outcome_mode=balanced-fallback; profile_manual_only=true ;;
			best_overall:false:false) profile_outcome_mode=quality-and-throughput-advisory-review; profile_manual_only=true ;;
			variable_link:true:true) profile_outcome_mode=target-b-measured-knee ;;
			variable_link:true:false) profile_outcome_mode=target-b-retention-advisory; profile_manual_only=true ;;
			variable_link:false:true) profile_outcome_mode=measured-knee-quality-fallback; profile_manual_only=true ;;
			variable_link:false:false) profile_outcome_mode=variable-link-review-required; profile_manual_only=true ;;
			fair:true:true) profile_outcome_mode=throughput-optimum-c-or-better ;;
			fair:true:false) profile_outcome_mode=latency-safe-throughput-advisory; profile_manual_only=true ;;
			fair:false:true) profile_outcome_mode=throughput-optimum-quality-fallback; profile_manual_only=true ;;
			fair:false:false) profile_outcome_mode=quality-and-throughput-advisory-review; profile_manual_only=true ;;
		esac
	fi
	if [ "$profile_floor_infeasible" != true ]; then
		if [ "$dl_search_no_cake_effect" = true ] || [ "$ul_search_no_cake_effect" = true ]; then
			profile_outcome_mode=directional-no-cake-effect-review
			profile_manual_only=true
		elif [ "$dl_search_manual_fallback" = true ] || [ "$ul_search_manual_fallback" = true ]; then
			profile_outcome_mode=variable-link-bounded-evidence-review
			profile_manual_only=true
		fi
	fi
	[ "$bidirectional_auto_apply_pass" = true ] || profile_manual_only=true
	profile_objective="$(extract_json "$dl_search_json" '@.objective')"
	profile_target_grade="$(extract_json "$proposal" '@.target_grade')"
	profile_capacity_floor="$(extract_json "$dl_search_json" '@.capacity_floor_percent')"
	profile_actual_grade="$validation_actual_grade"
	validation_grade_rank="$(quality_grade_rank "$validation_actual_grade")" || validation_grade_rank=99
	bidirectional_grade_rank="$(quality_grade_rank "$bidirectional_grade")" || bidirectional_grade_rank=99
	[ "$bidirectional_grade_rank" -le "$validation_grade_rank" ] || profile_actual_grade="$bidirectional_grade"
	profile_outcome_json="{\"mode\":\"$profile_outcome_mode\",\"objective\":\"$(json_escape "$profile_objective")\",\"target_grade\":\"$(json_escape "$profile_target_grade")\",\"target_met\":$profile_target_met,\"actual_grade\":\"$(json_escape "$profile_actual_grade")\",\"capacity_floor_percent\":$profile_capacity_floor,\"capacity_floor_met\":$profile_capacity_floor_met,\"throughput_safety_floor_percent\":50,\"throughput_safety_floor_met\":$profile_safety_floor_met,\"deep_runtime_minimum\":$profile_deep_runtime_minimum,\"runtime_minimum_retention\":$profile_runtime_minimum_retention_json,\"infeasible_reason\":\"$(json_escape "$profile_floor_infeasible_reason")\",\"manual_only\":$profile_manual_only,\"selected_pair\":{\"download_kbps\":$selected_dl_candidate,\"upload_kbps\":$selected_ul_candidate},\"bidirectional_confirmation\":$bidirectional_confirmation_json,\"directional_recommendation\":$directional_recommendation_json,\"directional_comparisons\":$directional_comparisons_json,\"download\":$dl_search_json,\"upload\":$ul_search_json}"
	if [ "$autotune_profile" = fair ]; then
		fair_actual_effective_delta_ms="$(maximum_number "$effective_loaded_delta_ms" "$bidirectional_effective_delta_ms")"
		fair_safety_state=safety-floor-met
		[ "$profile_safety_floor_met" = true ] || fair_safety_state=historical-trust-missed
		if [ "$profile_floor_infeasible" = true ]; then
			build_fair_outcome throughput-fallback safety-floor-infeasible capacity-objective-missed \
				"$profile_actual_grade" "$fair_actual_effective_delta_ms"
		elif [ "$profile_target_met" = true ]; then
			if [ "$profile_capacity_floor_met" = true ]; then
				build_fair_outcome quality-target-met "$fair_safety_state" capacity-objective-met \
					"$profile_actual_grade" "$fair_actual_effective_delta_ms"
			else
				build_fair_outcome quality-target-met "$fair_safety_state" capacity-objective-missed \
					"$profile_actual_grade" "$fair_actual_effective_delta_ms"
			fi
		else
			if [ "$profile_capacity_floor_met" = true ]; then
				build_fair_outcome throughput-fallback "$fair_safety_state" capacity-objective-met \
					"$profile_actual_grade" "$fair_actual_effective_delta_ms"
			else
				build_fair_outcome throughput-fallback "$fair_safety_state" capacity-objective-missed \
					"$profile_actual_grade" "$fair_actual_effective_delta_ms"
			fi
		fi
	fi

	write_status review 96 "Preparing validated review; no configuration has been written"
	build_autotune_confidence
	confidence_mode=normal
	[ "$overall_confidence_percent" -ge 85 ] || confidence_mode=low
	auto_apply_eligible=false
	manual_apply_eligible=false
	if [ "$phase_evidence_complete" = true ]; then
		if [ "$profile_floor_infeasible" = true ]; then
			# This only exposes fail-closed Review choices. apply_sqm is absent from
			# the typed Fair action list and disabling SQM still requires its own
			# clean bidirectional no-SQM proof in LuCI and apply-guard.
			manual_apply_eligible=true
		else
			# Historical raw capacity is volatile on radio links.  Missing its
			# 50% trust comparison lowers confidence and requires explicit Review,
			# but it is not a datapath safety failure when the currently tested
			# CAKE pair still passes loss, realization and loaded-latency safety.
			[ "$validation_safety_pass" = true ] &&
				[ "$bidirectional_safety_pass" = true ] && manual_apply_eligible=true
			# Fair can independently prove that disabling SQM is the safer choice.
			# A poor shaped confirmation must block applying that shaped proposal,
			# but it must not hide a clean, bidirectional no-SQM control which the
			# action-specific LuCI and apply-guard validators will verify again.
			if [ "$autotune_profile" = fair ] &&
			   [ "${fair_disable_available:-false}" = true ]; then
				manual_apply_eligible=true
			fi
			[ "$result_class" = trusted ] && [ "$validation_safety_pass" = true ] &&
				[ "$profile_target_met" = true ] &&
				[ "$validation_profile_objectives_met" = true ] &&
				[ "$profile_manual_only" = false ] &&
				auto_apply_eligible=true
		fi
	fi
	build_result_proposals
	stage_complete_result
}

job_recovery_pending() {
	recovery_scan_root="$job_root/recovery"
	for recovery_candidate in "$recovery_scan_root/${job_name}_"*.journal; do
		[ -f "$recovery_candidate" ] || continue
		return 0
	done
	return 1
}

start_job() {
	start_conservative="${1:-0}"
	[ -x "$procd_job_bin" ] || json_error "The procd job launcher is required for Full Auto-Tune."
	prepare_job_storage || json_error "Unsafe or foreign-owned Full Auto-Tune job directory."
	start_guard="$job_dir/start.guard"
	[ ! -L "$start_guard" ] || json_error "Unsafe Full Auto-Tune start lock."
	exec 6>>"$start_guard" || json_error "Unable to open the Full Auto-Tune start lock."
	start_flock_bin="${runtime_lock_flock_bin:-flock}"
	command -v "$start_flock_bin" >/dev/null 2>&1 || json_error "flock is required for Full Auto-Tune."
	"$start_flock_bin" 6 || json_error "Unable to serialize Full Auto-Tune startup."

	# A live registered worker owns its recovery journal by design.  Check it
	# before scanning journals so an idempotent second RPC returns current state
	# rather than misreporting the normal armed run as recovery-pending.
	if [ -s "$pid_file" ]; then
		if worker_identity_matches; then
			if worker_request_matches "$start_conservative"; then
				cat "$status_file" 2>/dev/null || printf '{"state":"running","phase":"starting","progress":0}\n'
				return 0
			fi
			json_error "A different Full Auto-Tune request is already running for this instance. Cancel it or wait for completion."
		fi
	fi
	job_recovery_pending && json_error "Full Auto-Tune recovery is still pending for $job_name; wait for runtime restoration before starting another test."

	archive_previous_terminal ||
		json_error "Unable to archive and bound the previous Full Auto-Tune diagnostics in RAM."
	new_token="$(new_unique_worker_token)" ||
		json_error "Unable to generate a unique 32-hex Full Auto-Tune worker identity from the kernel random UUID source."
	active_run_id="$new_token"
	rm -f "$pid_file" "$status_file" "$result_file" "$error_file" "$pending_result_file" \
		"$pending_error_file" "$cancel_file" "$log_file" "$terminal_integrity_file"
	write_status starting 0 "Starting Full Auto-Tune"
	procd_service_name="cake-autorate-autotune-$job_name"
	launch_result="$($procd_job_bin launch "$procd_service_name" worker "$log_file" "$0" \
		"$job_name" "$target_if_input" job-run "$backend" "$route_mode_override" \
		"$mwan3_member_override" "$autotune_profile" "$start_conservative" "$new_token" \
		"$traffic_budget_bytes" "$calibration_strategy" 2>/dev/null)" || {
		launch_error="$(extract_json "$launch_result" '@.error' 2>/dev/null || true)"
		json_error "${launch_error:-Unable to register the Full Auto-Tune worker with procd.}"
	}
	pid="$(extract_json "$launch_result" '@.pid' 2>/dev/null || true)"
	launch_starttime="$(extract_json "$launch_result" '@.starttime' 2>/dev/null || true)"
	if ! is_positive_uint "$pid" || ! is_positive_uint "$launch_starttime" ||
	   ! wait_for_launched_worker "$pid" "$launch_starttime" "$new_token"; then
		[ -n "$launch_starttime" ] && [ "$(proc_starttime "$pid" 2>/dev/null)" = "$launch_starttime" ] &&
			kill -TERM "$pid" 2>/dev/null || true
		json_error "Unable to establish an isolated Full Auto-Tune worker process group."
	fi
	worker_identity="$(printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s' \
		"$pid" "$launch_starttime" "$new_token" "$target_if_input" "$backend_input" \
		"$route_mode_override" "$mwan3_member_override" "$autotune_profile" "$start_conservative" \
		"$traffic_budget_bytes" "$calibration_strategy")"
	atomic_write "$pid_file" "$worker_identity" || {
		[ "$(proc_starttime "$pid" 2>/dev/null)" = "$launch_starttime" ] &&
			kill -TERM "$pid" 2>/dev/null || true
		json_error "Unable to publish the Full Auto-Tune worker identity."
	}
	cat "$status_file"
}

status_job() {
	# A verified live owner is authoritative.  Otherwise an armed recovery
	# journal outranks every settled-looking result/error: accepting that result
	# before runtime restoration is exactly how stale calibration escaped.
	if [ -s "$pid_file" ] && worker_identity_matches; then
		if worker_request_matches any; then
			cat "$status_file" 2>/dev/null || printf '{"state":"running","phase":"starting","progress":0}\n'
			return 0
		fi
		json_error "A different Full Auto-Tune request is running for this instance; its status was not attached to this uplink."
	fi
	if job_recovery_pending; then
		printf '{"state":"recovery-pending","recovery_pending":true,"auto_apply_eligible":false,"manual_apply_eligible":false,"error":"Full Auto-Tune runtime restoration is still pending; any settled result is withheld."}\n'
		return 0
	fi
	if [ -s "$result_file" ]; then
		emit_saved_terminal "$result_file"
	elif [ -s "$error_file" ]; then
		emit_saved_terminal "$error_file"
	elif [ -s "$pid_file" ]; then
		printf '{"state":"failed","error":"Autotune worker identity is stale or the worker exited without a result."}\n'
	else
		printf '{"state":"idle"}\n'
	fi
}

emit_terminal_summary() {
	terminal_summary_file="$1"
	terminal_summary_kind="$(terminal_file_kind "$terminal_summary_file" 2>/dev/null || true)"
	if ! ensure_terminal_integrity "$terminal_summary_file"; then
		printf '{"state":"legacy","terminal_available":true,"terminal_kind":"%s","runtime_restored":true,"recovery_pending":false}\n' \
			"$(json_escape "${terminal_summary_kind:-unknown}")"
		return 0
	fi
	terminal_summary_state="$("$jsonfilter_bin" -i "$terminal_summary_file" -e '@.state' 2>/dev/null | sed -n '1p')"
	terminal_summary_run_id="$("$jsonfilter_bin" -i "$terminal_summary_file" -e '@.run_id' 2>/dev/null | sed -n '1p')"
	terminal_summary_job_id="$("$jsonfilter_bin" -i "$terminal_summary_file" -e '@.job_id' 2>/dev/null | sed -n '1p')"
	terminal_summary_runtime="$("$jsonfilter_bin" -i "$terminal_summary_file" -e '@.runtime_restored' 2>/dev/null | sed -n '1p')"
	terminal_summary_recovery="$("$jsonfilter_bin" -i "$terminal_summary_file" -e '@.recovery_pending' 2>/dev/null | sed -n '1p')"
	case "$terminal_summary_runtime" in true|false) ;; *) terminal_summary_runtime=true ;; esac
	case "$terminal_summary_recovery" in true|false) ;; *) terminal_summary_recovery=false ;; esac
	printf '{"state":"%s","terminal_available":true,"terminal_kind":"%s","run_id":"%s","job_id":"%s","runtime_restored":%s,"recovery_pending":%s}\n' \
		"$(json_escape "${terminal_summary_state:-failed}")" \
		"$(json_escape "$terminal_summary_kind")" \
		"$(json_escape "$terminal_summary_run_id")" \
		"$(json_escape "$terminal_summary_job_id")" \
		"$terminal_summary_runtime" "$terminal_summary_recovery"
}

status_summary_job() {
	if [ -s "$pid_file" ] && worker_identity_matches; then
		if worker_request_matches any; then
			cat "$status_file" 2>/dev/null || printf '{"state":"running","phase":"starting","progress":0}\n'
			return 0
		fi
		json_error "A different Full Auto-Tune request is running for this instance; its status was not attached to this uplink."
	fi
	if job_recovery_pending; then
		printf '{"state":"recovery-pending","recovery_pending":true,"runtime_restored":false,"terminal_available":false}\n'
	elif [ -s "$result_file" ]; then
		emit_terminal_summary "$result_file"
	elif [ -s "$error_file" ]; then
		emit_terminal_summary "$error_file"
	elif [ -s "$pid_file" ]; then
		printf '{"state":"failed","terminal_available":false,"error":"Autotune worker identity is stale or the worker exited without a result."}\n'
	else
		printf '{"state":"idle","terminal_available":false}\n'
	fi
}

history_job() {
	printf '{"state":"ready","schema_version":1,"runs":['
	history_first=1
	if [ -d "$history_dir" ] && [ ! -L "$history_dir" ] &&
	   runtime_lock_path_owned_by_euid "$history_dir"; then
		for history_candidate in $(find "$history_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
			LC_ALL=C sort -r); do
			history_meta="$history_candidate/meta"
			owned_regular_file "$history_meta" || continue
			history_run_id="$(sed -n 's/^run_id=//p' "$history_meta")"
			history_state="$(sed -n 's/^state=//p' "$history_meta")"
			history_epoch="$(sed -n 's/^completed_epoch=//p' "$history_meta")"
			case "$history_run_id" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
			case "$history_state" in
				complete|failed|inconclusive|background-blocked|cancelled|legacy|unknown) ;;
				*) continue ;;
			esac
			is_positive_uint "$history_epoch" || continue
			[ "$history_first" = 1 ] || printf ','
			printf '{"run_id":"%s","state":"%s","completed_epoch":%s}' \
				"$(json_escape "$history_run_id")" "$(json_escape "$history_state")" "$history_epoch"
			history_first=0
		done
	fi
	printf ']}\n'
}

attest_job() {
	# Unlike status, this path never replays result.json. It recomputes both the
	# complete managed UCI fingerprint and the selected route/external address
	# immediately before LuCI stages a reviewed proposal.
	if [ -s "$pid_file" ]; then
		json_error "Full Auto-Tune state is not settled; live attestation is unavailable."
	fi
	job_recovery_pending &&
		json_error "Full Auto-Tune recovery is pending; live attestation is unavailable."
	mkdir -p "$job_dir" || json_error "Unable to create the Full Auto-Tune attestation directory."
	[ -d "$job_dir" ] && [ ! -L "$job_dir" ] || json_error "Unsafe Full Auto-Tune attestation directory."
	chmod 700 "$job_dir" 2>/dev/null || true

	attest_fingerprint_before="$(compute_config_fingerprint)" ||
		json_error "Unable to recompute the managed UCI configuration fingerprint."
	attest_route="$(CAKE_AUTORATE_ROUTE_STATUS_TIMEOUT_S=5 \
		"$speedtest_bin" "$job_name" "$target_if_input" route-status "${backend:-auto}" "" \
		"${route_mode_override:-}" "${mwan3_member_override:-}" 2>/dev/null)" ||
		json_error "Unable to attest the currently selected uplink route."
	attest_fingerprint_after="$(compute_config_fingerprint)" ||
		json_error "Unable to confirm the managed UCI configuration fingerprint."
	[ "$attest_fingerprint_before" = "$attest_fingerprint_after" ] ||
		json_error "Managed UCI configuration changed during live attestation."
	[ "$(extract_json "$attest_route" '@.state')" = ready ] &&
		[ "$(extract_json "$attest_route" '@.schema_version')" = 1 ] ||
		json_error "The route helper returned an invalid attestation."

	attest_target="$(extract_json "$attest_route" '@.target_interface')"
	attest_resolved="$(extract_json "$attest_route" '@.resolved_interface')"
	attest_route_if="$(extract_json "$attest_route" '@.route_interface')"
	attest_mode="$(extract_json "$attest_route" '@.route_mode')"
	attest_member="$(extract_json "$attest_route" '@.mwan3_member')"
	attest_source_ip="$(extract_json "$attest_route" '@.source_ip')"
	attest_external_ip="$(extract_json "$attest_route" '@.external_ip')"
	attest_identity="$(extract_json "$attest_route" '@.route_identity')"
	[ -n "$attest_target" ] && [ -n "$attest_resolved" ] && [ -n "$attest_route_if" ] &&
		[ -n "$attest_source_ip" ] && [ -n "$attest_external_ip" ] && [ -n "$attest_identity" ] ||
		json_error "The route helper returned incomplete identity fields."
	case "$attest_mode" in main) [ -z "$attest_member" ] || json_error "Main-route attestation unexpectedly names an mwan3 member." ;;
		mwan3) [ -n "$attest_member" ] || json_error "mwan3 attestation returned no member." ;;
		*) json_error "The route helper returned an invalid route mode." ;;
	esac

	printf '{"state":"ready","schema_version":1,"config_fingerprint":"%s","target_interface":"%s","resolved_interface":"%s","route_interface":"%s","route_mode":"%s","mwan3_member":"%s","source_ip":"%s","external_ip":"%s","route_identity":"%s"}\n' \
		"$(json_escape "$attest_fingerprint_before")" "$(json_escape "$attest_target")" \
		"$(json_escape "$attest_resolved")" "$(json_escape "$attest_route_if")" \
		"$(json_escape "$attest_mode")" "$(json_escape "$attest_member")" \
		"$(json_escape "$attest_source_ip")" "$(json_escape "$attest_external_ip")" \
		"$(json_escape "$attest_identity")"
}

cancel_job() {
	if [ -s "$pid_file" ]; then
		if worker_identity_matches; then
			pid="$identity_pid"
			# The cancelling RPC is a separate process and may omit the immutable
			# route/profile/strategy arguments.  Keep the authenticated worker
			# identity in status.json instead of publishing the cancel request's
			# defaults, otherwise an ambiguous browser retry can observe a hybrid
			# identity that never actually ran.
			target_if_input="$identity_target"
			backend_input="$identity_backend"
			route_mode_override="$identity_route_mode"
			mwan3_member_override="$identity_mwan3_member"
			autotune_profile="$identity_profile"
			conservative_mode="$identity_conservative"
			traffic_budget_bytes="$identity_traffic_budget"
			calibration_strategy="$identity_calibration_strategy"
			: > "$cancel_file"
			write_status cancelling 0 "Cancelling Full Auto-Tune and restoring temporary speed-test/SQM state"
			kill -TERM "$pid" 2>/dev/null || true
			cat "$status_file"
			return 0
		fi
		# Do not turn a stale worker identity into a synthetic idle state.  A
		# terminal file or an armed recovery journal remains authoritative, and
		# an unexplained stale PID must stay visibly unsettled.
		status_job
		return 0
	fi
	printf '{"state":"idle"}\n'
}

if [ "${CAKE_AUTORATE_AUTOTUNE_SOURCE_ONLY:-0}" = 1 ]; then
	return 0 2>/dev/null || exit 0
fi

safe_job_name "$job_name" || json_error "Invalid autotune job name."
safe_interface_name "$target_if_input" || json_error "Invalid target interface."
resolve_autotune_profile || json_error "Unsupported Full Auto-Tune profile."
resolve_calibration_strategy || json_error "Unsupported Full Auto-Tune calibration strategy."
case "$conservative_override" in 0|1) ;; *) json_error "Invalid conservative Full Auto-Tune flag." ;; esac
traffic_budget_bytes="$(uint53_normalize "$traffic_budget_bytes")" ||
	json_error "Invalid or out-of-range Full Auto-Tune traffic budget."
job_paths
prepare_job_storage || json_error "Unsafe or foreign-owned Full Auto-Tune state directory."

case "$mode" in
	start) start_job 0 ;;
	start-conservative) start_job 1 ;;
	status) status_job ;;
	status-summary) status_summary_job ;;
	result) status_job ;;
	history) history_job ;;
	attest) attest_job ;;
	cancel) cancel_job ;;
	job-run) run_job ;;
	*) json_error "Unsupported autotune mode." ;;
esac
