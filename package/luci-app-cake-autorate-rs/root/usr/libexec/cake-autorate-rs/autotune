wait_for_launched_worker() {
	launched_pid="$1"
	launched_starttime="$2"
	launched_token="$3"
	launched_attempt=0

	# OpenWrt BusyBox may be built without fractional-sleep support.  Five
	# one-second retries keep the RPC start path below its timeout while still
	# allowing procd's vfork/exec transition to settle on a busy router.
	while [ "$launched_attempt" -lt 5 ]; do
		[ "$(proc_starttime "$launched_pid" 2>/dev/null)" = "$launched_starttime" ] || return 1
		if [ "$(proc_group "$launched_pid" 2>/dev/null)" = "$launched_pid" ] &&
		   [ "$(proc_session "$launched_pid" 2>/dev/null)" = "$launched_pid" ] &&
		   proc_cmdline_has_arg "$launched_pid" job-run &&
		   proc_cmdline_has_arg "$launched_pid" "$launched_token"; then
			return 0
		fi
		launched_attempt=$((launched_attempt + 1))
		handshake_sleep
	done
	return 1
}

worker_request_matches() {
	expected_conservative="${1:-0}"
	# worker_identity_matches() has already read and authenticated one complete
	# identity snapshot at both call sites.  Re-reading pid_file here creates a
	# completion race: the verified owner may remove its identity between the
	# two reads, turning an ordinary terminal transition into a false request
	# mismatch.  Compare the authenticated snapshot instead.
	[ "$identity_target" = "$target_if_input" ] &&
		[ "$identity_backend" = "$backend_input" ] &&
		[ "$identity_route_mode" = "$route_mode_override" ] &&
		[ "$identity_mwan3_member" = "$mwan3_member_override" ] &&
		[ "$identity_profile" = "$autotune_profile" ] || return 1
	[ "$expected_conservative" = any ] && return 0
	[ "$identity_conservative" = "$expected_conservative" ] || return 1
	[ "$identity_traffic_budget" = "$traffic_budget_bytes" ] &&
		[ "$identity_calibration_strategy" = "$calibration_strategy" ]
}

