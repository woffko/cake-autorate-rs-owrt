build_expected_manifest() {
	job="$1"
	target="$2"
	route_mode="$3"
	member="$4"
	enabled="$5"
	disable_adaptive="$6"
	action="$7"
	fingerprint="$8"
	token="$9"
	shift 9
	expires="$1"
	boot_id="$2"
	resolved="$(require_result_value '@.resolved_interface')" ||
		die "The Full Auto-Tune result has no resolved interface."
	safe_interface "$resolved" || die "The resolved Full Auto-Tune interface is unsafe."

	sqm_section="$(original_get "$job" sqm_section "cake_$job")"
	safe_job "$sqm_section" || die "The managed SQM section name is unsafe."
	sqm_guard="$(sqm_guard_section "$job")" || die "The SQM rollback marker identity is unsafe."
	for expected_dir in "$token_dir/expected-pre" "$token_dir/expected"; do
		uci_at "$expected_dir" -q get "sqm.$sqm_guard" >/dev/null 2>&1 ||
			uci_at "$expected_dir" -q set "sqm.$sqm_guard=cake_autorate_apply_guard" || return 1
		uci_at "$expected_dir" -q set "sqm.$sqm_guard._autotune_apply_guard=1" || return 1
		uci_at "$expected_dir" -q set "sqm.$sqm_guard._autotune_apply_job=$job" || return 1
		uci_at "$expected_dir" -q set "sqm.$sqm_guard._autotune_apply_fingerprint=$fingerprint" || return 1
		uci_at "$expected_dir" -q set "sqm.$sqm_guard._autotune_apply_token=$token" || return 1
		uci_at "$expected_dir" -q commit sqm || return 1
	done

	if [ "$action" = disable_sqm ]; then
		uci_at "$token_dir/expected" -q get "cake-autorate.$job" >/dev/null 2>&1 ||
			die "SQM can be disabled only for an existing Auto-Tune instance."
		[ "$(uci_at "$token_dir/original" -q get "sqm.$sqm_section._cake_autorate_managed" 2>/dev/null)" = "$job" ] ||
			die "The existing SQM queue is not owned by this instance."
		expected_set "$job" enabled 0
		expected_set "$job" sqm_enabled 0
		expected_set "$job" sqm_direction_mode off
		write_expected_apply_markers "$job" "$target" "$backend" "$route_mode" "$member" \
			0 "$disable_adaptive" "$action" "$fingerprint" "$token" "$expires" "$boot_id"
		uci_at "$token_dir/expected" -q commit cake-autorate || return 1
		uci_at "$token_dir/expected" -q get "sqm.$sqm_section" >/dev/null 2>&1 ||
			die "The managed SQM queue disappeared before it could be disabled."
		uci_at "$token_dir/expected" -q set "sqm.$sqm_section._cake_autorate_managed=$job" || return 1
		uci_at "$token_dir/expected" -q set "sqm.$sqm_section.enabled=0" || return 1
		uci_at "$token_dir/expected" -q commit sqm || return 1
		printf '%s\n' "$sqm_section" > "$token_dir/sqm-section"
		chmod 600 "$token_dir/sqm-section"
		return 0
	fi

	load_profile_contract
	case "$selected_topology" in
		both_shaped)
			direction_mode=both
			adjust_dl=1
			adjust_ul=1
			sqm_dl_rate_path=download
			sqm_ul_rate_path=upload
			;;
		upload_only_shaped)
			direction_mode=upload_only
			adjust_dl=0
			adjust_ul=1
			sqm_dl_rate_path=disabled
			sqm_ul_rate_path=upload
			case "$(json_get "$result_copy" '@.directional_comparisons.upload_only.recommended_topology')" in
				upload_only_shaped|manual_review) ;;
				*) die "The selected upload-only topology is not backed by its directional evidence." ;;
			esac
			;;
		download_only_shaped)
			direction_mode=download_only
			adjust_dl=1
			adjust_ul=0
			sqm_dl_rate_path=download
			sqm_ul_rate_path=disabled
			case "$(json_get "$result_copy" '@.directional_comparisons.download_only.recommended_topology')" in
				download_only_shaped|manual_review) ;;
				*) die "The selected download-only topology is not backed by its directional evidence." ;;
			esac
			;;
		*) die "The selected SQM topology is unsupported." ;;
	esac
	# serde_json preserves integral floating-point policy values as e.g. 70.0
	# and 5.0, while JavaScript String() stages the same numbers as 70 and 5.
	# UCI compares strings, so canonicalize proposal policy numbers before
	# constructing the exact manifest.
	validation_retention_uci="$(normalized_number "$validation_retention" "$validation_retention")" ||
		die "The Full Auto-Tune capacity-retention policy cannot be normalized."
	validation_transport_uci="$(normalized_number "$validation_transport" "$validation_transport")" ||
		die "The Full Auto-Tune transport-latency policy cannot be normalized."

	dl_min="$(proposal_rate '@.proposal.download.minimum_kbps')" || die "The Full Auto-Tune proposal contains an invalid download minimum."
	dl_exploration_min="$(proposal_rate '@.proposal.download.exploration_minimum_kbps')" || die "The Full Auto-Tune proposal contains an invalid download exploration minimum."
	dl_runtime_min="$(json_get "$result_copy" '@.proposal.download.runtime_minimum_kbps' 2>/dev/null || true)"
	[ "$dl_runtime_min" = null ] && dl_runtime_min=""
	dl_base="$(proposal_rate '@.proposal.download.base_kbps')" || die "The Full Auto-Tune proposal contains an invalid download base."
	dl_max="$(proposal_rate '@.proposal.download.maximum_kbps')" || die "The Full Auto-Tune proposal contains an invalid download maximum."
	dl_tested_max="$(json_get "$result_copy" '@.proposal.download.tested_safe_maximum_kbps' 2>/dev/null || true)"
	[ "$dl_tested_max" = null ] && dl_tested_max=""
	dl_exploration_cap="$(proposal_rate '@.proposal.download.exploration_cap_kbps')" || die "The Full Auto-Tune proposal contains an invalid download exploration cap."
	dl_cap="$(proposal_rate '@.proposal.download.absolute_cap_kbps')" || die "The Full Auto-Tune proposal contains an invalid download cap."
	dl_service_cap="$(json_get "$result_copy" '@.proposal.download.service_hard_cap_kbps' 2>/dev/null || true)"
	[ "$dl_service_cap" = null ] && dl_service_cap=""
	dl_ceiling_evidence="$(require_result_value '@.proposal.download.ceiling_evidence')" || die "The Full Auto-Tune proposal has no download ceiling evidence."
	dl_cap_source="$(require_result_value '@.proposal.download.cap_source')" || die "The Full Auto-Tune proposal has no download cap source."
	dl_low="$(proposal_rate '@.proposal.download.observed_low_kbps')" || die "The Full Auto-Tune proposal contains an invalid download reference."
	dl_median="$(proposal_rate '@.proposal.download.observed_median_kbps')" || die "The Full Auto-Tune proposal contains an invalid download median."
	dl_high="$(proposal_rate '@.proposal.download.observed_high_kbps')" || die "The Full Auto-Tune proposal contains an invalid download high reference."
	ul_min="$(proposal_rate '@.proposal.upload.minimum_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload minimum."
	ul_exploration_min="$(proposal_rate '@.proposal.upload.exploration_minimum_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload exploration minimum."
	ul_runtime_min="$(json_get "$result_copy" '@.proposal.upload.runtime_minimum_kbps' 2>/dev/null || true)"
	[ "$ul_runtime_min" = null ] && ul_runtime_min=""
	ul_base="$(proposal_rate '@.proposal.upload.base_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload base."
	ul_max="$(proposal_rate '@.proposal.upload.maximum_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload maximum."
	ul_tested_max="$(json_get "$result_copy" '@.proposal.upload.tested_safe_maximum_kbps' 2>/dev/null || true)"
	[ "$ul_tested_max" = null ] && ul_tested_max=""
	ul_exploration_cap="$(proposal_rate '@.proposal.upload.exploration_cap_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload exploration cap."
	ul_cap="$(proposal_rate '@.proposal.upload.absolute_cap_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload cap."
	ul_service_cap="$(json_get "$result_copy" '@.proposal.upload.service_hard_cap_kbps' 2>/dev/null || true)"
	[ "$ul_service_cap" = null ] && ul_service_cap=""
	ul_ceiling_evidence="$(require_result_value '@.proposal.upload.ceiling_evidence')" || die "The Full Auto-Tune proposal has no upload ceiling evidence."
	ul_cap_source="$(require_result_value '@.proposal.upload.cap_source')" || die "The Full Auto-Tune proposal has no upload cap source."
	ul_low="$(proposal_rate '@.proposal.upload.observed_low_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload reference."
	ul_median="$(proposal_rate '@.proposal.upload.observed_median_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload median."
	ul_high="$(proposal_rate '@.proposal.upload.observed_high_kbps')" || die "The Full Auto-Tune proposal contains an invalid upload high reference."
	active_threshold="$(proposal_rate '@.proposal.active_threshold_kbps')" || die "The Full Auto-Tune proposal contains an invalid active threshold."
	[ "$dl_exploration_min" -le "$dl_min" ] && [ "$dl_min" -le "$dl_base" ] &&
		[ "$dl_base" -le "$dl_max" ] && [ "$dl_max" -le "$dl_cap" ] &&
		[ "$dl_cap" -le "$dl_exploration_cap" ] ||
		die "The Full Auto-Tune download bounds are not monotonic."
	[ "$ul_exploration_min" -le "$ul_min" ] && [ "$ul_min" -le "$ul_base" ] &&
		[ "$ul_base" -le "$ul_max" ] && [ "$ul_max" -le "$ul_cap" ] &&
		[ "$ul_cap" -le "$ul_exploration_cap" ] ||
		die "The Full Auto-Tune upload bounds are not monotonic."
	[ "$dl_low" -le "$dl_median" ] && [ "$dl_median" -le "$dl_high" ] ||
		die "The Full Auto-Tune download observations are not monotonic."
	[ "$ul_low" -le "$ul_median" ] && [ "$ul_median" -le "$ul_high" ] ||
		die "The Full Auto-Tune upload observations are not monotonic."
	for optional_rate in "$dl_runtime_min" "$dl_tested_max" "$dl_service_cap" \
		"$ul_runtime_min" "$ul_tested_max" "$ul_service_cap"; do
		[ -z "$optional_rate" ] || is_positive_rate "$optional_rate" ||
			die "The Full Auto-Tune proposal contains malformed optional ceiling evidence."
	done
	[ -z "$dl_runtime_min" ] || [ "$dl_runtime_min" = "$dl_min" ] ||
		die "The download runtime minimum is not the effective configured minimum."
	[ -z "$ul_runtime_min" ] || [ "$ul_runtime_min" = "$ul_min" ] ||
		die "The upload runtime minimum is not the effective configured minimum."
	[ -z "$dl_service_cap" ] || [ "$dl_cap" -le "$dl_service_cap" ] ||
		die "The download cap exceeds the declared service hard cap."
	[ -z "$ul_service_cap" ] || [ "$ul_cap" -le "$ul_service_cap" ] ||
		die "The upload cap exceeds the declared service hard cap."
	case "$dl_cap_source" in measured_raw|user_service_limit|retained_configuration) ;; *) die "The download cap source is invalid." ;; esac
	case "$ul_cap_source" in measured_raw|user_service_limit|retained_configuration) ;; *) die "The upload cap source is invalid." ;; esac
	[ "$dl_cap_source" = retained_configuration ] || [ "$dl_high" -le "$dl_exploration_cap" ] ||
		die "The download raw reference exceeds its declared exploration cap."
	[ "$ul_cap_source" = retained_configuration ] || [ "$ul_high" -le "$ul_exploration_cap" ] ||
		die "The upload raw reference exceeds its declared exploration cap."
	case "$dl_ceiling_evidence" in
		shaped_validation)
			[ -n "$dl_tested_max" ] && [ "$dl_tested_max" = "$dl_max" ] ||
				die "The download maximum is not bound to its exact shaped validation."
			;;
		retained_configuration)
			[ -n "$dl_tested_max" ] && [ "$dl_tested_max" = "$dl_max" ] ||
				die "The retained download maximum is malformed."
			if [ "$adjust_dl" = 1 ]; then
				[ "$(original_get "$job" min_dl_shaper_rate_kbps '')" = "$dl_min" ] &&
					[ "$(original_get "$job" base_dl_shaper_rate_kbps '')" = "$dl_base" ] &&
					[ "$(original_get "$job" max_dl_shaper_rate_kbps '')" = "$dl_max" ] &&
					[ "$(original_get "$job" adaptive_ceiling_dl_cap_kbps "$dl_max")" = "$dl_cap" ] ||
					die "A retained download ceiling may not change the live configuration."
			fi
			;;
		unvalidated_candidate)
			[ -z "$dl_tested_max" ] || die "An unvalidated download candidate claims a tested maximum."
			[ "$adjust_dl" = 0 ] || die "The selected shaped download has no tested-safe ceiling evidence."
			;;
		*) die "The download ceiling evidence is invalid." ;;
	esac
	case "$ul_ceiling_evidence" in
		shaped_validation)
			[ -n "$ul_tested_max" ] && [ "$ul_tested_max" = "$ul_max" ] ||
				die "The upload maximum is not bound to its exact shaped validation."
			;;
		retained_configuration)
			[ -n "$ul_tested_max" ] && [ "$ul_tested_max" = "$ul_max" ] ||
				die "The retained upload maximum is malformed."
			if [ "$adjust_ul" = 1 ]; then
				[ "$(original_get "$job" min_ul_shaper_rate_kbps '')" = "$ul_min" ] &&
					[ "$(original_get "$job" base_ul_shaper_rate_kbps '')" = "$ul_base" ] &&
					[ "$(original_get "$job" max_ul_shaper_rate_kbps '')" = "$ul_max" ] &&
					[ "$(original_get "$job" adaptive_ceiling_ul_cap_kbps "$ul_max")" = "$ul_cap" ] ||
					die "A retained upload ceiling may not change the live configuration."
			fi
			;;
		unvalidated_candidate)
			[ -z "$ul_tested_max" ] || die "An unvalidated upload candidate claims a tested maximum."
			[ "$adjust_ul" = 0 ] || die "The selected shaped upload has no tested-safe ceiling evidence."
			;;
		*) die "The upload ceiling evidence is invalid." ;;
	esac
	[ "$dl_cap_source" != retained_configuration ] || [ "$dl_ceiling_evidence" = retained_configuration ] ||
		die "The download cap claims retained provenance without retained limits."
	[ "$ul_cap_source" != retained_configuration ] || [ "$ul_ceiling_evidence" = retained_configuration ] ||
		die "The upload cap claims retained provenance without retained limits."
	[ "$dl_cap_source" != user_service_limit ] || [ -n "$dl_service_cap" ] ||
		die "The download service cap source has no declared hard cap."
	[ "$ul_cap_source" != user_service_limit ] || [ -n "$ul_service_cap" ] ||
		die "The upload service cap source has no declared hard cap."
	[ "$dl_cap_source" != user_service_limit ] || [ "$dl_cap" = "$dl_service_cap" ] ||
		die "The download service hard cap is not the effective proposal cap."
	[ "$ul_cap_source" != user_service_limit ] || [ "$ul_cap" = "$ul_service_cap" ] ||
		die "The upload service hard cap is not the effective proposal cap."
	if [ "$proposal_profile" = variable_link ]; then
		case "$dl_cap_source" in
			measured_raw)
				[ "$dl_cap" = "$dl_high" ] && [ "$dl_exploration_cap" = "$dl_high" ] ||
					die "The Variable Link download cap is not bound to measured raw capacity."
				;;
			user_service_limit)
				[ "$dl_exploration_cap" = "$dl_high" ] ||
					die "The Variable Link download service cap does not tighten measured capacity."
				;;
		esac
		case "$ul_cap_source" in
			measured_raw)
				[ "$ul_cap" = "$ul_high" ] && [ "$ul_exploration_cap" = "$ul_high" ] ||
					die "The Variable Link upload cap is not bound to measured raw capacity."
				;;
			user_service_limit)
				[ "$ul_exploration_cap" = "$ul_high" ] ||
					die "The Variable Link upload service cap does not tighten measured capacity."
				;;
		esac
	fi
	adjust_up="$(proposal_uint '@.proposal.thresholds_ms.adjust_up')" || die "The Full Auto-Tune proposal contains an invalid adjust-up threshold."
	delay="$(proposal_uint '@.proposal.thresholds_ms.delay')" || die "The Full Auto-Tune proposal contains an invalid delay threshold."
	adjust_down="$(proposal_uint '@.proposal.thresholds_ms.adjust_down')" || die "The Full Auto-Tune proposal contains an invalid adjust-down threshold."
	[ "$adjust_up" -le "$delay" ] && [ "$delay" -le "$adjust_down" ] ||
		die "The Full Auto-Tune delay thresholds are not monotonic."

	adaptive_enabled="$(json_get "$result_copy" '@.proposal.adaptive_ceiling.enabled')"
	case "$adaptive_enabled" in true|false) ;; *) die "The Full Auto-Tune adaptive-ceiling decision is invalid." ;; esac
	adaptive_hold="$(proposal_uint '@.proposal.adaptive_ceiling.hold_s')" || die "The Full Auto-Tune adaptive hold is invalid."
	adaptive_growth="$(proposal_uint '@.proposal.adaptive_ceiling.growth_percent')" || die "The Full Auto-Tune adaptive growth is invalid."
	adaptive_probe="$(proposal_uint '@.proposal.adaptive_ceiling.probe_s')" || die "The Full Auto-Tune adaptive probe duration is invalid."
	adaptive_cooldown="$(proposal_uint '@.proposal.adaptive_ceiling.cooldown_s')" || die "The Full Auto-Tune adaptive cooldown is invalid."
	adaptive_ttl="$(proposal_uint '@.proposal.adaptive_ceiling.failed_bound_ttl_s')" || die "The Full Auto-Tune adaptive failed-bound TTL is invalid."
	capacity_learning_policy="$(require_result_value '@.proposal.adaptive_ceiling.policy')" ||
		die "The Full Auto-Tune capacity-learning policy is missing."
	access_medium="$(require_result_value '@.proposal.access.medium')" ||
		die "The Full Auto-Tune access medium is missing."
	access_source="$(require_result_value '@.proposal.access.source')" ||
		die "The Full Auto-Tune access-medium source is missing."
	access_confidence="$(json_get "$result_copy" '@.proposal.access.confidence_percent')"
	case "$access_medium" in cellular|leo_satellite|geo_satellite|fixed_wireless|shared_wired|unknown) ;; *)
		die "The Full Auto-Tune access medium is invalid." ;;
	esac
	case "$access_source" in user_selected|network_protocol|device_type|interface_name|auto_inconclusive|legacy_default) ;; *)
		die "The Full Auto-Tune access-medium source is invalid." ;;
	esac
	is_uint "$access_confidence" && [ "$access_confidence" -le 100 ] 2>/dev/null ||
		die "The Full Auto-Tune access-medium confidence is invalid."
	case "$capacity_learning_policy:$adaptive_enabled" in
		passive_bounded:true|scheduled_active:true|verified_only:false|fixed_cap:false) ;;
		*) die "The Full Auto-Tune capacity-learning policy contradicts its adaptive-ceiling state." ;;
	esac
	if [ "$capacity_learning_policy" = fixed_cap ]; then
		[ -n "$dl_service_cap" ] && [ -n "$ul_service_cap" ] ||
			die "Fixed-cap learning requires both directional service hard caps."
	fi
	[ "$adaptive_hold" -gt 0 ] && [ "$adaptive_growth" -gt 0 ] && [ "$adaptive_probe" -gt 0 ] &&
		[ "$adaptive_cooldown" -gt 0 ] && [ "$adaptive_ttl" -gt 0 ] ||
		die "The Full Auto-Tune adaptive-ceiling timings must be positive."
	old_adaptive="$(original_get "$job" adaptive_ceiling_enabled 0)"
	if [ "$old_adaptive" = 1 ] && [ "$adaptive_enabled" = false ] && [ "$disable_adaptive" = 0 ]; then
		adaptive_flag=1
		effective_capacity_learning_policy=passive_bounded
		# Preserve the user's enabled mode and timing policy, but never carry an
		# old provenance-free cap into a freshly measured proposal.  Growth now
		# restarts from the exact tested-safe maximum and remains bounded by this
		# result's measured exploration cap.
		adaptive_hold="$(normalized_number "$(original_get "$job" adaptive_ceiling_hold_time_s '')" "$adaptive_hold")"
		adaptive_growth="$(normalized_number "$(original_get "$job" adaptive_ceiling_growth_percent '')" "$adaptive_growth")"
		adaptive_probe="$(normalized_number "$(original_get "$job" adaptive_ceiling_probe_duration_s '')" "$adaptive_probe")"
		adaptive_cooldown="$(normalized_number "$(original_get "$job" adaptive_ceiling_cooldown_s '')" "$adaptive_cooldown")"
		adaptive_ttl="$(normalized_number "$(original_get "$job" adaptive_ceiling_failed_bound_ttl_s '')" "$adaptive_ttl")"
	else
		[ "$adaptive_enabled" = true ] && adaptive_flag=1 || adaptive_flag=0
		effective_capacity_learning_policy="$capacity_learning_policy"
	fi

	link_layer="$(require_result_value '@.proposal.link.layer')" || die "The Full Auto-Tune link-layer proposal is missing."
	case "$link_layer" in none|ethernet|atm) ;; *) die "The Full Auto-Tune link-layer proposal is invalid." ;; esac
	overhead="$(json_get "$result_copy" '@.proposal.link.overhead')"
	is_uint "$overhead" && [ "$overhead" -le 1500 ] 2>/dev/null ||
		die "The Full Auto-Tune overhead proposal is invalid."
	mpu="$(proposal_uint '@.proposal.link.mpu')" || die "The Full Auto-Tune MPU proposal is invalid."
	[ "$link_layer" = none ] && link_advanced=0 || link_advanced=1

	pinger_method="$(require_result_value '@.pinger_plan.recommended_method')" || die "The reflector plan is missing its pinger method."
	case "$pinger_method" in fping|fping-ts|tsping|irtt|ping) ;; *) die "The reflector plan selected an unsupported pinger." ;; esac
	no_pingers="$(proposal_uint '@.pinger_plan.recommended_no_pingers')" || die "The reflector plan contains an invalid active count."
	reflectors="$(json_get "$result_copy" '@.pinger_plan.recommended_reflectors[*]')"
	[ -n "$reflectors" ] || die "The reflector plan contains no reflectors."
	reflector_count=0
	for reflector in $reflectors; do
		case "$reflector" in ''|-*|*[!0-9A-Za-z:.-]*) die "The reflector plan contains an unsafe reflector." ;; esac
		reflector_count=$((reflector_count + 1))
	done
	[ "$no_pingers" -gt 0 ] && [ "$no_pingers" -le "$reflector_count" ] ||
		die "The reflector plan active count exceeds its candidate list."

	run_backend="$(json_get "$result_copy" '@.runs[0].backend')"
	[ -n "$run_backend" ] || run_backend=speedtest-go
	[ "$run_backend" = speedtest-go ] || die "The Full Auto-Tune result does not identify its pinnable speed-test backend."
	server_id="$(json_get "$result_copy" '@.runs[0].server_id')"
	[ -z "$server_id" ] || is_uint "$server_id" || die "The Full Auto-Tune server identity is invalid."
	apply_percent="$(original_get "$job" speedtest_apply_percent 90)"
	is_uint "$apply_percent" && [ "$apply_percent" -ge 1 ] && [ "$apply_percent" -le 100 ] || apply_percent=90

	uci_at "$token_dir/expected" -q get "cake-autorate.$job" >/dev/null 2>&1 ||
		uci_at "$token_dir/expected" -q set "cake-autorate.$job=cake_autorate" || return 1
	# The create wizard gives every new instance an explicit, inert traffic
	# profile policy. Existing instances retain their original policy verbatim.
	# These three values are part of the exact proposal manifest even though
	# they do not enable the optional native classifier.
	if ! uci_at "$token_dir/original" -q get "cake-autorate.$job" >/dev/null 2>&1; then
