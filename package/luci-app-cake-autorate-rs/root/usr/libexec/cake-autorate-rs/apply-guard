	cp "$token_dir/expected/cake-autorate" "$token_dir/expected-final/cake-autorate" || return 1
	cp "$token_dir/expected/sqm" "$token_dir/expected-final/sqm" || return 1
	chmod 600 "$token_dir/expected-final/cake-autorate" "$token_dir/expected-final/sqm" || return 1
	for final_option in _autotune_apply_guard _autotune_apply_fingerprint _autotune_apply_target \
		_autotune_apply_backend _autotune_apply_route_mode _autotune_apply_mwan3_member \
		_autotune_apply_enabled _autotune_apply_disable_adaptive _autotune_apply_action _autotune_apply_proposal_id _autotune_apply_token \
		_autotune_apply_expires _autotune_apply_boot_id; do
		if uci_at "$token_dir/expected-final" -q get "cake-autorate.$job.$final_option" >/dev/null 2>&1; then
			uci_at "$token_dir/expected-final" -q delete "cake-autorate.$job.$final_option" || return 1
		fi
	done
	uci_at "$token_dir/expected-final" -q delete "sqm.$sqm_guard" || return 1
	uci_at "$token_dir/expected-final" -q commit cake-autorate || return 1
	uci_at "$token_dir/expected-final" -q commit sqm || return 1
}

attest_route() {
	job="$1"
	target="$2"
	backend="$3"
	route_mode="$4"
	member="$5"
	expected_fingerprint="$6"
	attestation="$token_dir/attestation.json"
	"$autotune_bin" "$job" "$target" attest "$backend" "$route_mode" "$member" > "$attestation" 2>/dev/null ||
		die "Live Full Auto-Tune route/configuration attestation failed."
	owned_regular "$attestation" && chmod 600 "$attestation" || die "The attestation file is unsafe."
	[ "$(json_get "$attestation" '@.state')" = ready ] || die "The live Full Auto-Tune attestation is not ready."
	[ "$(json_get "$attestation" '@.schema_version')" = 1 ] || die "The live Full Auto-Tune attestation schema is invalid."
	[ "$(json_get "$attestation" '@.config_fingerprint')" = "$expected_fingerprint" ] || die "The calibrated configuration changed before apply."
	for field in target_interface resolved_interface route_interface route_mode mwan3_member source_ip external_ip route_identity; do
		[ "$(json_get "$attestation" "@.$field")" = "$(json_get "$result_copy" "@.$field")" ] ||
			die "The calibrated route identity changed before apply."
	done
}

result_action_allowed() {
	allowed_action="$1"
	json_get "$result_copy" '@.fair_outcome.allowed_actions[*]' 2>/dev/null |
		grep -F -x -- "$allowed_action" >/dev/null 2>&1
}

selected_proposal_objective_count() {
	objective_code="$1"
	json_get "$result_copy" "$selected_proposal_path.unmet_objectives[*]" 2>/dev/null |
		awk -v expected="$objective_code" '$0 == expected { count++ } END { print count + 0 }'
}

require_selected_proposal_objective() {
	objective_code="$1"
	objective_expected="$2"
	objective_message="$3"
	objective_count="$(selected_proposal_objective_count "$objective_code")"
	case "$objective_expected:$objective_count" in
		true:1|false:0) ;;
		*) die "$objective_message" ;;
	esac
}

safe_run_id() {
	case "$1" in
		''|*[!A-Za-z0-9_-]*) return 1 ;;
	esac
	[ "${#1}" -le 128 ]
}

quality_grade_rank() {
	case "$1" in
		A+) printf '0\n' ;;
		A) printf '1\n' ;;
		B) printf '2\n' ;;
		C) printf '3\n' ;;
		D) printf '4\n' ;;
		F) printf '5\n' ;;
		*) return 1 ;;
	esac
}

quality_grade_for_delta() {
	LC_ALL=C awk -v delta="$1" 'BEGIN {
		if (delta < 5) print "A+"
		else if (delta < 30) print "A"
		else if (delta < 60) print "B"
		else if (delta < 200) print "C"
		else if (delta < 400) print "D"
		else print "F"
	}'
}

validate_profile_search_contract() {
	search_direction="$1"
	search_allow_unsafe="${2:-false}"
	case "$search_direction" in
		download) search_rate_path=download ;;
		upload) search_rate_path=upload ;;
		*) return 1 ;;
	esac
	search_root="@.profile_search.$search_direction"
	require_result_flag "$search_root.schema_version" 2 "The profile-search schema is invalid."
	require_result_flag "$search_root.profile" "$profile" "The profile-search profile changed."
	require_result_flag "$search_root.direction" "$search_direction" "The profile-search direction changed."
	search_action="$(require_result_value "$search_root.action")" ||
		die "The profile-search terminal action is missing."
	search_reason="$(json_get "$result_copy" "$search_root.reason")"
	case "$search_action" in complete|fallback) ;; *) die "The profile search still has a pending or inconclusive action." ;; esac
	search_selected_safety="$(require_result_value "$search_root.selected.safety_pass")" ||
		die "The selected direction safety state is missing."
	case "$search_selected_safety" in
		true) ;;
		false)
			[ -n "$search_reason" ] || die "The unsafe profile-search reason is missing."
			if [ "$profile" = variable_link ] &&
			   [ "$search_action" = fallback ] &&
			   [ "$search_reason" = bounded-low-realization-review ]; then
				require_result_flag "$search_root.selected.manual_reviewable" true \
					"The bounded low-realization direction lost its manual-review evidence."
			else
				[ "$search_allow_unsafe" = true ] && [ "$search_action" = fallback ] ||
					die "The selected direction did not preserve its safety floor."
				case "$search_reason" in
					repeatable-compute-ceiling-below-capacity-floor|repeatable-shaper-ceiling-below-capacity-floor|repeatable-shaper-ceiling-below-safety-floor) ;;
					*) die "The unsafe profile-search result has no proven repeatable ceiling." ;;
				esac
				profile_unsafe_direction_count=$((profile_unsafe_direction_count + 1))
			fi
			;;
		*) die "The selected direction safety state is invalid." ;;
	esac
	selected_rate="$(require_result_value "$search_root.selected.candidate_kbps")" ||
		die "The selected profile-search rate is missing."
	proposal_selected_rate="$(require_result_value "@.proposal.$search_rate_path.base_kbps")" ||
		die "The proposal base rate is missing."
	validation_selected_rate="$(require_result_value "@.validation.candidate_base.${search_direction}_kbps")" ||
		die "The confirmed validation rate is missing."
	is_positive_rate "$selected_rate" &&
		numbers_equal "$selected_rate" "$proposal_selected_rate" &&
		numbers_equal "$selected_rate" "$validation_selected_rate" ||
		die "The selected, proposed, and confirmed direction rates differ."
	if [ "$profile" = variable_link ]; then
		[ -n "$search_reason" ] || die "The Variable link terminal reason is missing."
		search_no_cake_effect="$(require_result_value "$search_root.no_cake_effect")" ||
			die "The Variable link CAKE-effect state is missing."
		case "$search_no_cake_effect" in true|false) ;; *) die "The Variable link CAKE-effect state is invalid." ;; esac
		if [ "$search_no_cake_effect" = true ]; then
			require_result_flag "$search_root.action" fallback "A no-effect direction must use the typed fallback action."
			require_result_flag "$search_root.reason" queue-outside-cake-control "The no-effect direction reason changed."
			require_result_flag "$search_root.knee_detected" false "A no-effect direction cannot also claim a measured knee."
			require_result_flag "$search_root.noisy" false "A no-effect direction remained noisy."
			require_result_flag "$search_root.inconclusive" false "A no-effect direction remained inconclusive."
			require_result_flag "$search_root.selected.target_met" true "The no-effect fallback did not meet its quality target."
			search_selected_retention="$(require_result_value "$search_root.selected.retention_percent")" ||
				die "The no-effect fallback retention is missing."
			is_percent "$search_selected_retention" &&
				LC_ALL=C awk -v value="$search_selected_retention" 'BEGIN { exit(value >= 50 ? 0 : 1) }' ||
				die "The no-effect fallback fell below the catastrophic throughput floor."
			profile_no_cake_effect_count=$((profile_no_cake_effect_count + 1))
		elif [ "$search_reason" = exploration-floor-reached ]; then
			require_result_flag "$search_root.action" fallback "The exploration-floor direction must use the typed fallback action."
			require_result_flag "$search_root.knee_detected" false "The exploration-floor direction cannot claim a measured knee."
			require_result_flag "$search_root.noisy" false "The exploration-floor direction unexpectedly remained noisy."
			require_result_flag "$search_root.inconclusive" false "The exploration-floor direction remained inconclusive."
			require_result_flag "$search_root.selected.target_met" true "The exploration-floor fallback did not meet its quality target."
			search_selected_retention="$(require_result_value "$search_root.selected.retention_percent")" ||
				die "The exploration-floor fallback retention is missing."
			is_percent "$search_selected_retention" &&
				LC_ALL=C awk -v value="$search_selected_retention" 'BEGIN { exit(value >= 50 ? 0 : 1) }' ||
				die "The exploration-floor fallback fell below the catastrophic throughput floor."
			profile_variable_manual_fallback_count=$((profile_variable_manual_fallback_count + 1))
		elif [ "$search_reason" = noisy-link-safe-review ]; then
			require_result_flag "$search_root.action" fallback "The noisy direction must use the typed fallback action."
			require_result_flag "$search_root.knee_detected" false "The noisy direction cannot claim a measured knee."
			require_result_flag "$search_root.noisy" true "The noisy direction lost its diagnostic flag."
			require_result_flag "$search_root.inconclusive" false "The noisy safe fallback remained inconclusive."
			search_selected_retention="$(require_result_value "$search_root.selected.retention_percent")" ||
				die "The noisy fallback retention is missing."
			is_percent "$search_selected_retention" &&
				LC_ALL=C awk -v value="$search_selected_retention" 'BEGIN { exit(value >= 50 ? 0 : 1) }' ||
				die "The noisy fallback fell below the catastrophic throughput floor."
			profile_variable_manual_fallback_count=$((profile_variable_manual_fallback_count + 1))
		elif [ "$search_reason" = bounded-low-realization-review ]; then
			require_result_flag "$search_root.action" fallback "The bounded low-realization direction must use the typed fallback action."
			require_result_flag "$search_root.selected.safety_pass" false "The bounded low-realization direction unexpectedly claims strict CAKE control."
			require_result_flag "$search_root.selected.manual_reviewable" true "The bounded low-realization direction is not manually reviewable."
			require_result_flag "$search_root.knee_detected" false "The bounded low-realization direction cannot claim a measured knee."
			require_result_flag "$search_root.no_cake_effect" false "The bounded low-realization direction cannot also claim no CAKE effect."
			require_result_flag "$search_root.noisy" false "The bounded low-realization direction remained noisy."
			require_result_flag "$search_root.inconclusive" false "The bounded low-realization direction remained inconclusive."
			search_selected_realization="$(require_result_value "$search_root.selected.realization_percent")" ||
				die "The bounded low-realization percentage is missing."
			search_selected_retention="$(require_result_value "$search_root.selected.retention_percent")" ||
				die "The bounded low-realization retention is missing."
			search_strict_min="$(require_result_value '@.validation_thresholds.candidate_realization_min_percent')" ||
				die "The strict realization threshold is missing."
			search_strict_max="$(require_result_value '@.validation_thresholds.candidate_realization_max_percent')" ||
				die "The maximum realization threshold is missing."
			is_percent "$search_selected_realization" && is_percent "$search_selected_retention" &&
				is_decimal "$search_strict_min" && is_decimal "$search_strict_max" &&
				LC_ALL=C awk -v realization="$search_selected_realization" \
					-v retention="$search_selected_retention" -v strict_min="$search_strict_min" \
					-v strict_max="$search_strict_max" 'BEGIN {
						exit(strict_min >= 0 && strict_min <= 100 && strict_max >= strict_min && strict_max <= 200 &&
							realization >= 50 && realization < strict_min && realization <= strict_max && retention >= 50 ? 0 : 1)
					}' || die "The bounded low-realization direction is outside the manual-review envelope."
			profile_variable_manual_fallback_count=$((profile_variable_manual_fallback_count + 1))
		else
			require_result_flag "$search_root.knee_detected" true "The Variable link result has no measured latency knee."
			require_result_flag "$search_root.noisy" false "The Variable link result remained noisy."
			require_result_flag "$search_root.inconclusive" false "The Variable link result remained inconclusive."
		fi
		runtime_minimum="$(require_result_value "$search_root.runtime_minimum_kbps")" ||
			die "The measured Variable link runtime minimum is missing."
		runtime_minimum_index="$(require_result_value "$search_root.runtime_minimum_observation_index")" ||
			die "The measured Variable link runtime observation is missing."
		is_uint "$runtime_minimum_index" && [ "$runtime_minimum_index" -gt 0 ] 2>/dev/null ||
			die "The measured Variable link runtime observation index is invalid."
		runtime_evaluated_index=$((runtime_minimum_index - 1))
		runtime_evaluated_rate="$(require_result_value "$search_root.evaluated[$runtime_evaluated_index].candidate_kbps")" ||
			die "The measured Variable link runtime observation is not present."
		exploration_minimum="$(require_result_value "$search_root.exploration_minimum_kbps")" ||
			die "The Variable link exploration minimum is missing."
		proposal_runtime_minimum="$(require_result_value "@.proposal.$search_rate_path.minimum_kbps")" ||
			die "The proposal runtime minimum is missing."
		is_positive_rate "$runtime_minimum" && is_positive_rate "$exploration_minimum" &&
			numbers_equal "$runtime_minimum" "$runtime_evaluated_rate" &&
			numbers_equal "$runtime_minimum" "$proposal_runtime_minimum" &&
			[ "$runtime_minimum" -ge "$exploration_minimum" ] &&
			[ "$runtime_minimum" -le "$selected_rate" ] ||
			die "The Variable link runtime minimum is not a tested, ordered search result."
		if [ "$search_no_cake_effect" = true ] ||
		   [ "$search_reason" = exploration-floor-reached ] ||
		   [ "$search_reason" = noisy-link-safe-review ] ||
		   [ "$search_reason" = bounded-low-realization-review ]; then
			numbers_equal "$runtime_minimum" "$selected_rate" ||
				die "The manual Variable link runtime minimum differs from its selected tested hold point."
		fi
	elif [ "$profile" = gaming_extreme ]; then
		require_result_flag "$search_root.inconclusive" false "The Extreme A+ result remained inconclusive."
		runtime_minimum="$(require_result_value "$search_root.runtime_minimum_kbps")" ||
			die "The tested Extreme A+ runtime minimum is missing."
		runtime_minimum_index="$(require_result_value "$search_root.runtime_minimum_observation_index")" ||
			die "The tested Extreme A+ runtime observation is missing."
		is_uint "$runtime_minimum_index" && [ "$runtime_minimum_index" -gt 0 ] 2>/dev/null ||
			die "The tested Extreme A+ runtime observation index is invalid."
		runtime_evaluated_index=$((runtime_minimum_index - 1))
		runtime_evaluated_rate="$(require_result_value "$search_root.evaluated[$runtime_evaluated_index].candidate_kbps")" ||
			die "The tested Extreme A+ runtime observation is not present."
		exploration_minimum="$(require_result_value "$search_root.exploration_minimum_kbps")" ||
			die "The Extreme A+ exploration minimum is missing."
		proposal_runtime_minimum="$(require_result_value "@.proposal.$search_rate_path.minimum_kbps")" ||
			die "The Extreme A+ proposal runtime minimum is missing."
		is_positive_rate "$runtime_minimum" && is_positive_rate "$exploration_minimum" &&
			numbers_equal "$runtime_minimum" "$runtime_evaluated_rate" &&
			numbers_equal "$runtime_minimum" "$proposal_runtime_minimum" &&
			[ "$runtime_minimum" -ge "$exploration_minimum" ] &&
			[ "$runtime_minimum" -le "$selected_rate" ] ||
			die "The Extreme A+ runtime minimum is not an actually tested A+ search rate."
	fi
}

validate_bidirectional_confirmation_contract() {
	require_result_flag '@.bidirectional_confirmation.tested' true \
		"The final bidirectional confirmation is missing."
	bidirectional_dl_target="$(require_result_value '@.bidirectional_confirmation.target_rates_kbps.download')" ||
		die "The final bidirectional download target is missing."
	bidirectional_ul_target="$(require_result_value '@.bidirectional_confirmation.target_rates_kbps.upload')" ||
		die "The final bidirectional upload target is missing."
	bidirectional_dl_achieved="$(require_result_value '@.bidirectional_confirmation.achieved_kbps.download')" ||
		die "The final bidirectional download result is missing."
	bidirectional_ul_achieved="$(require_result_value '@.bidirectional_confirmation.achieved_kbps.upload')" ||
		die "The final bidirectional upload result is missing."
	bidirectional_dl_realization="$(require_result_value '@.bidirectional_confirmation.realization_percent.download')" ||
		die "The final bidirectional download realization is missing."
	bidirectional_ul_realization="$(require_result_value '@.bidirectional_confirmation.realization_percent.upload')" ||
		die "The final bidirectional upload realization is missing."
	bidirectional_delta="$(require_result_value '@.bidirectional_confirmation.effective_delta_ms')" ||
		die "The final bidirectional loaded-latency result is missing."
	bidirectional_loss="$(require_result_value '@.bidirectional_confirmation.loss_percent')" ||
		die "The final bidirectional packet-loss result is missing."
	for bidirectional_number in "$bidirectional_dl_target" "$bidirectional_ul_target" \
		"$bidirectional_dl_achieved" "$bidirectional_ul_achieved" \
		"$bidirectional_dl_realization" "$bidirectional_ul_realization" \
		"$bidirectional_delta" "$bidirectional_loss"; do
		is_decimal "$bidirectional_number" ||
			die "The final bidirectional confirmation contains malformed numeric evidence."
	done
	proposal_dl_base="$(require_result_value '@.proposal.download.base_kbps')" ||
		die "The proposed download rate is missing."
	proposal_ul_base="$(require_result_value '@.proposal.upload.base_kbps')" ||
		die "The proposed upload rate is missing."
	numbers_equal "$bidirectional_dl_target" "$proposal_dl_base" &&
		numbers_equal "$bidirectional_ul_target" "$proposal_ul_base" ||
		die "The final bidirectional confirmation tested a different rate pair."
	LC_ALL=C awk -v target="$bidirectional_dl_target" -v achieved="$bidirectional_dl_achieved" \
		-v reported="$bidirectional_dl_realization" 'BEGIN {
			if (target <= 0 || achieved < 0) exit 1
			delta = reported - achieved * 100 / target
			if (delta < 0) delta = -delta
			exit(delta <= 0.2 ? 0 : 1)
		}' || die "The final bidirectional download realization does not match its measurement."
	LC_ALL=C awk -v target="$bidirectional_ul_target" -v achieved="$bidirectional_ul_achieved" \
		-v reported="$bidirectional_ul_realization" 'BEGIN {
			if (target <= 0 || achieved < 0) exit 1
			delta = reported - achieved * 100 / target
			if (delta < 0) delta = -delta
			exit(delta <= 0.2 ? 0 : 1)
		}' || die "The final bidirectional upload realization does not match its measurement."

	bidirectional_latency_pass="$(LC_ALL=C awk -v actual="$bidirectional_delta" -v limit="$validation_transport" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	bidirectional_loss_pass="$(LC_ALL=C awk -v actual="$bidirectional_loss" -v limit="$validation_loss" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	bidirectional_latency_review_pass="$(LC_ALL=C awk -v actual="$bidirectional_delta" \
		-v limit="$validation_manual_latency_review" 'BEGIN {
		print (actual <= limit) ? "true" : "false"
	}')"
	bidirectional_realization_safety_pass="$(LC_ALL=C awk -v dl="$bidirectional_dl_realization" \
		-v ul="$bidirectional_ul_realization" -v maximum="$validation_realization_max" 'BEGIN {
		print (dl >= 50 && ul >= 50 && dl <= maximum && ul <= maximum) ? "true" : "false"
	}')"
	bidirectional_safety_pass=false
	[ "$bidirectional_latency_review_pass" = true ] &&
		[ "$bidirectional_realization_safety_pass" = true ] &&
		[ "$bidirectional_loss_pass" = true ] &&
		bidirectional_safety_pass=true
	bidirectional_realization_pass="$(LC_ALL=C awk -v dl="$bidirectional_dl_realization" \
		-v ul="$bidirectional_ul_realization" -v minimum="$validation_realization_min" 'BEGIN {
		print (dl >= minimum && ul >= minimum) ? "true" : "false"
	}')"
	bidirectional_auto_apply_pass=false
	[ "$bidirectional_latency_pass" = true ] && [ "$bidirectional_realization_pass" = true ] &&
		bidirectional_auto_apply_pass=true
	require_result_flag '@.bidirectional_confirmation.safety_pass' "$bidirectional_safety_pass" \
		"The final bidirectional safety verdict does not match its hard evidence."
	require_result_flag '@.bidirectional_confirmation.auto_apply_pass' "$bidirectional_auto_apply_pass" \
		"The final bidirectional Auto-Apply verdict does not match its evidence."
	for confirmation_field in tested safety_pass auto_apply_pass effective_delta_ms loss_percent; do
		[ "$(json_get "$result_copy" "@.profile_outcome.bidirectional_confirmation.$confirmation_field")" = \
		  "$(json_get "$result_copy" "@.bidirectional_confirmation.$confirmation_field")" ] ||
			die "The profile outcome contains different final bidirectional evidence."
	done
}

validate_selected_configuration_contract() {
	# The proposal identity binds the candidate to the terminal result, but the
	# apply path still reads the canonical top-level proposal.  Require every
	# field which can reach UCI to be byte-for-byte identical before arming a
	# rollback token.  This prevents a valid directional evidence object from
	# selecting a different, unattested rate or CAKE policy.
	for configuration_path in \
		schema_version profile target_grade quality_target_required throughput_priority \
		download.minimum_kbps download.base_kbps download.maximum_kbps download.absolute_cap_kbps \
		download.observed_low_kbps download.observed_median_kbps \
		upload.minimum_kbps upload.base_kbps upload.maximum_kbps upload.absolute_cap_kbps \
		upload.observed_low_kbps upload.observed_median_kbps active_threshold_kbps \
		thresholds_ms.adjust_up thresholds_ms.delay thresholds_ms.adjust_down \
		adaptive_ceiling.enabled adaptive_ceiling.hold_s adaptive_ceiling.growth_percent \
		adaptive_ceiling.probe_s adaptive_ceiling.cooldown_s adaptive_ceiling.failed_bound_ttl_s \
		validation.candidate_realization_min_percent validation.candidate_realization_max_percent \
		validation.capacity_retention_min_percent validation.icmp_delta_max_ms \
		validation.transport_delta_max_ms validation.loss_max_percent validation.cpu_max_percent \
		sqm.qdisc sqm.script sqm.classification sqm.squash_dscp sqm.squash_ingress \
		sqm.ingress_ecn sqm.egress_ecn sqm.iqdisc_opts sqm.eqdisc_opts \
		link.layer link.overhead link.mpu; do
		configuration_terminal="$(json_get "$result_copy" "@.proposal.$configuration_path" 2>/dev/null)" ||
			die "The canonical Full Auto-Tune proposal is incomplete."
		configuration_selected="$(json_get "$result_copy" "$selected_proposal_path.configuration.$configuration_path" 2>/dev/null)" ||
			die "The selected Full Auto-Tune proposal configuration is incomplete."
		[ "$configuration_selected" = "$configuration_terminal" ] ||
			die "The selected Full Auto-Tune proposal configuration differs from its measured canonical proposal."
	done
}

validate_directional_proposal_contract() {
	directional_topology="$1"
	case "$directional_topology" in
		upload_only_shaped)
			directional_key=upload_only
			directional_label=upload-only
			directional_active=upload
			directional_gain_direction=download
			directional_realization_field=upload_realization_percent
			directional_gain_field=download_gain_percent
			directional_active_base="$proposal_ul_base"
			directional_shaped_gain="$bidirectional_dl_achieved"
			directional_bypass_mode=ingress-only-autotune
			;;
		download_only_shaped)
			directional_key=download_only
			directional_label=download-only
			directional_active=download
			directional_gain_direction=upload
			directional_realization_field=download_realization_percent
			directional_gain_field=upload_gain_percent
			directional_active_base="$proposal_dl_base"
			directional_shaped_gain="$bidirectional_ul_achieved"
			directional_bypass_mode=egress-only-autotune
			;;
		*) die "The selected proposal is not a directional topology." ;;
	esac
	directional_comparison_path="@.directional_comparisons.$directional_key"
	require_result_flag "$selected_proposal_path.evidence.recommendation" "directional_comparisons.$directional_key" \
		"The $directional_label proposal is not bound to its directional evidence."
	require_result_flag "$directional_comparison_path.tested" true \
		"The $directional_label proposal has no directional comparison."
	directional_repeatable="$(require_result_value "$directional_comparison_path.repeatable")" ||
		die "The $directional_label repeatability state is missing."
	case "$directional_repeatable" in true|false) ;; *) die "The $directional_label repeatability state is invalid." ;; esac
	directional_material_benefit_proven=true
	directional_realization_objective_met=true
	directional_all_strict_pass=true

	for directional_index in 0 1; do
		directional_path="$directional_comparison_path.observations[$directional_index]"
		require_result_flag "$directional_path.hard_safety_pass" true \
			"A $directional_label observation did not pass hard safety checks."
		require_result_flag "$directional_path.observation.topology" "$directional_topology" \
			"A $directional_label observation names a different topology."
		require_result_flag "$directional_path.observation.direction" both \
			"The $directional_label comparison did not load both directions."
		require_result_flag "$directional_path.observation.measurement_evidence.valid" true \
			"The $directional_label comparison contains invalid measurement evidence."
		require_result_flag "$directional_path.observation.measurement_evidence.shaper_bypassed" true \
			"The $directional_label comparison did not prove its one-sided bypass."
		require_result_flag "$directional_path.observation.measurement_evidence.sqm_paused" false \
			"The $directional_label comparison unexpectedly paused all SQM."
		require_result_flag "$directional_path.observation.measurement_evidence.sqm_bypass_mode" "$directional_bypass_mode" \
			"The $directional_label comparison has inconsistent bypass evidence."

		directional_delta="$(require_result_value "$directional_path.effective_delta_ms")" ||
			die "The $directional_label comparison delay is missing."
		directional_loss="$(require_result_value "$directional_path.loss_percent")" ||
			die "The $directional_label comparison loss is missing."
		directional_realization="$(require_result_value "$directional_path.$directional_realization_field")" ||
			die "The $directional_label realization is missing."
		directional_gain="$(require_result_value "$directional_path.$directional_gain_field")" ||
			die "The $directional_label opposite-direction gain is missing."
		directional_delay_improvement="$(require_result_value "$directional_path.delay_improvement_ms")" ||
			die "The $directional_label delay comparison is missing."
		directional_active_throughput="$(require_result_value "$directional_path.observation.throughput_kbps.${directional_active}_kbps")" ||
			die "The $directional_label active-direction measurement is missing."
		directional_gain_throughput="$(require_result_value "$directional_path.observation.throughput_kbps.${directional_gain_direction}_kbps")" ||
			die "The $directional_label opposite-direction measurement is missing."
		directional_grade="$(require_result_value "$directional_path.grade")" ||
			die "The $directional_label grade is missing."
		for directional_number in "$directional_delta" "$directional_loss" "$directional_realization" \
			"$directional_active_throughput" "$directional_gain_throughput"; do
			is_decimal "$directional_number" ||
				die "The $directional_label comparison contains malformed numeric evidence."
		done
		is_signed_decimal "$directional_gain" && is_signed_decimal "$directional_delay_improvement" ||
			die "The $directional_label comparison contains malformed signed utility evidence."
		is_positive_rate "$directional_active_throughput" && is_positive_rate "$directional_gain_throughput" ||
			die "The $directional_label comparison contains no usable throughput."
		directional_expected_grade="$(quality_grade_for_delta "$directional_delta")" ||
			die "The $directional_label grade cannot be calculated."
		[ "$directional_grade" = "$directional_expected_grade" ] ||
			die "The $directional_label grade differs from its measured delay."
		LC_ALL=C awk -v achieved="$directional_active_throughput" -v candidate="$directional_active_base" \
			-v reported="$directional_realization" 'BEGIN {
				if (candidate <= 0) exit 1
				expected = achieved * 100 / candidate
				exit((reported - expected < 0 ? expected - reported : reported - expected) <= 0.11 ? 0 : 1)
			}' || die "The $directional_label realization differs from its throughput evidence."
		LC_ALL=C awk -v achieved="$directional_gain_throughput" -v shaped="$directional_shaped_gain" \
			-v reported="$directional_gain" 'BEGIN {
				if (shaped <= 0) exit 1
				expected = (achieved - shaped) * 100 / shaped
				exit((reported - expected < 0 ? expected - reported : reported - expected) <= 0.11 ? 0 : 1)
			}' || die "The $directional_label gain differs from its throughput evidence."
		LC_ALL=C awk -v shaped="$bidirectional_delta" -v candidate="$directional_delta" \
			-v reported="$directional_delay_improvement" 'BEGIN {
				expected = shaped - candidate
				exit((reported - expected < 0 ? expected - reported : reported - expected) <= 0.11 ? 0 : 1)
			}' || die "The $directional_label delay improvement differs from its measurement evidence."
		LC_ALL=C awk -v delay="$directional_delta" -v delay_limit="$validation_manual_latency_review" \
			-v loss="$directional_loss" -v loss_limit="$validation_loss" \
			-v realization="$directional_realization" -v maximum="$validation_realization_max" 'BEGIN {
				exit(delay <= delay_limit && loss <= loss_limit && realization >= 50 && realization <= maximum ? 0 : 1)
			}' || die "The $directional_label comparison exceeds a non-overridable safety boundary."
		directional_material_benefit_expected="$(LC_ALL=C awk -v gain="$directional_gain" \
			-v improvement="$directional_delay_improvement" 'BEGIN {
				print (gain >= 2 && improvement >= -5) ? "true" : "false"
			}')"
		require_result_flag "$directional_path.material_benefit" "$directional_material_benefit_expected" \
			"The $directional_label material-benefit verdict does not match its evidence."
		require_result_flag "$directional_path.candidate_pass" "$directional_material_benefit_expected" \
			"The $directional_label candidate verdict does not match its hard-safe utility evidence."
		directional_observation_pass_expected="$(LC_ALL=C awk -v benefit="$directional_material_benefit_expected" \
			-v delay="$directional_delta" -v delay_limit="$validation_transport" \
			-v realization="$directional_realization" -v minimum="$validation_realization_min" 'BEGIN {
				print (benefit == "true" && delay <= delay_limit && realization >= minimum) ? "true" : "false"
			}')"
		require_result_flag "$directional_path.pass" "$directional_observation_pass_expected" \
			"The $directional_label strict profile verdict does not match its evidence."
		[ "$directional_observation_pass_expected" = true ] || directional_all_strict_pass=false
		[ "$directional_material_benefit_expected" = true ] || directional_material_benefit_proven=false
		LC_ALL=C awk -v realization="$directional_realization" -v minimum="$validation_realization_min" \
			'BEGIN { exit(realization >= minimum ? 0 : 1) }' || directional_realization_objective_met=false

		case "$directional_index" in
			0)
				directional_first_active="$directional_active_throughput"
				directional_first_gain="$directional_gain_throughput"
				directional_first_delta="$directional_delta"
				;;
			1)
				directional_second_active="$directional_active_throughput"
				directional_second_gain="$directional_gain_throughput"
				directional_second_delta="$directional_delta"
				;;
		esac
	done
	directional_spread_repeatable="$(LC_ALL=C awk -v dl1="$directional_first_active" -v dl2="$directional_second_active" \
		-v ul1="$directional_first_gain" -v ul2="$directional_second_gain" \
		-v delay1="$directional_first_delta" -v delay2="$directional_second_delta" 'BEGIN {
		dlmax = dl1 > dl2 ? dl1 : dl2; ulmax = ul1 > ul2 ? ul1 : ul2
		dldiff = dlmax > 0 ? ((dl1 > dl2 ? dl1 - dl2 : dl2 - dl1) * 100 / dlmax) : 100
		uldiff = ulmax > 0 ? ((ul1 > ul2 ? ul1 - ul2 : ul2 - ul1) * 100 / ulmax) : 100
		delaydiff = delay1 > delay2 ? delay1 - delay2 : delay2 - delay1
		print (dldiff <= 15 && uldiff <= 15 && delaydiff <= 10) ? "true" : "false"
	}')"
	[ "$directional_spread_repeatable" = "$directional_repeatable" ] ||
		die "The $directional_label repeatability flag does not match its repeated evidence."
	directional_worst_delta="$(LC_ALL=C awk -v a="$directional_first_delta" -v b="$directional_second_delta" 'BEGIN {
		print ((a + 0) > (b + 0) ? a : b)
	}')"
	directional_worst_grade="$(quality_grade_for_delta "$directional_worst_delta")" ||
		die "The selected $directional_label grade cannot be calculated."
	directional_expected_recommendation="$directional_topology"
	if [ "$directional_repeatable" = false ]; then
		[ "$directional_all_strict_pass" = true ] ||
			die "A non-repeatable $directional_label proposal did not pass both strict observations."
		directional_expected_recommendation=manual_review
		require_result_flag "$directional_comparison_path.reason" \
			"$([ "$directional_topology" = upload_only_shaped ] && printf upload-only-benefit-not-repeatable || printf download-only-benefit-not-repeatable)" \
			"The non-repeatable $directional_label reason is invalid."
		require_selected_proposal_objective measurement-confidence true \
			"A non-repeatable $directional_label proposal lacks its confidence acknowledgement."
		directional_candidate_confidence="$(require_result_value "$selected_proposal_path.confidence_percent")" ||
			die "The non-repeatable $directional_label confidence is missing."
		is_percent "$directional_candidate_confidence" &&
			LC_ALL=C awk -v value="$directional_candidate_confidence" 'BEGIN { exit(value <= 40 ? 0 : 1) }' ||
			die "A non-repeatable $directional_label proposal overstates its confidence."
	elif [ "$directional_material_benefit_proven" != true ]; then
		directional_expected_recommendation=manual_review
	fi
	require_result_flag "$directional_comparison_path.recommended_topology" "$directional_expected_recommendation" \
		"The selected $directional_label recommendation does not match its repeated evidence."
	directional_shaped_reference_delta="$(require_result_value '@.validation.effective_delta_ms')" ||
		die "The shaped directional validation delay is missing."
	is_decimal "$directional_shaped_reference_delta" ||
		die "The shaped directional validation delay is malformed."
	directional_shaped_reference_delta="$(LC_ALL=C awk -v directional="$directional_shaped_reference_delta" \
		-v simultaneous="$bidirectional_delta" 'BEGIN {
			print ((directional + 0) > (simultaneous + 0) ? directional : simultaneous)
		}')"
	directional_latency_utility_met="$(LC_ALL=C awk -v candidate="$directional_worst_delta" \
		-v shaped="$directional_shaped_reference_delta" 'BEGIN {
			print (candidate <= shaped + 10) ? "true" : "false"
		}')"
	require_selected_proposal_objective candidate-realization \
		"$([ "$directional_realization_objective_met" = true ] && printf false || printf true)" \
		"The selected $directional_label candidate-realization acknowledgement does not match its repeated evidence."
	require_selected_proposal_objective throughput-benefit-unproven \
		"$([ "$directional_material_benefit_proven" = true ] && printf false || printf true)" \
		"The selected $directional_label utility acknowledgement does not match its repeated evidence."
	require_selected_proposal_objective latency-worse-than-shaped \
		"$([ "$directional_latency_utility_met" = true ] && printf false || printf true)" \
		"The selected $directional_label latency acknowledgement does not match its shaped reference."
	require_result_flag "$selected_proposal_path.effective_delta_ms" "$directional_worst_delta" \
		"The selected $directional_label delay differs from its repeated evidence."
	require_result_flag "$selected_proposal_path.grade" "$directional_worst_grade" \
		"The selected $directional_label grade differs from its repeated evidence."
}

validate_raw_no_sqm_proposal_contract() {
	# A no-SQM proposal is a topology in its own right.  Its safety proof comes
	# from the clean, routed, bidirectional raw control; shaped validation is
	# neither a prerequisite nor a useful reference for this action.  In
	# particular, do not turn shaped realization, throughput gain, or a relative
	# delay comparison into hidden hard gates here.
	require_result_flag "$selected_proposal_path.evidence.control" raw_control \
		"The no-SQM proposal is not bound to its raw control."
	selected_configuration="$(json_get "$result_copy" "$selected_proposal_path.configuration" 2>/dev/null || true)"
	case "$selected_configuration" in
		''|null) ;;
		*) die "A no-SQM proposal must not contain an SQM configuration." ;;
	esac
	require_result_flag '@.raw_control.available' true "The raw no-SQM control is unavailable."
	require_result_flag '@.raw_control.measurement_evidence.valid' true "The raw no-SQM control evidence is invalid."
	require_result_flag '@.raw_control.measurement_evidence.reason' ok "The raw no-SQM control did not complete cleanly."
	require_result_flag '@.raw_control.measurement_evidence.test_direction' both "The raw no-SQM control was not bidirectional."
	require_result_flag '@.raw_control.measurement_evidence.shaper_bypassed' true "The raw no-SQM control did not prove SQM bypass."
	raw_bypass_mode="$(require_result_value '@.raw_control.measurement_evidence.sqm_bypass_mode')" ||
		die "The raw no-SQM control has no bypass mode."
	raw_sqm_paused="$(require_result_value '@.raw_control.measurement_evidence.sqm_paused')" ||
		die "The raw no-SQM control has no SQM pause evidence."
	case "$raw_bypass_mode:$raw_sqm_paused" in
		paused-managed:true|already-unshaped:false) ;;
		*) die "The raw no-SQM control bypass evidence is inconsistent." ;;
	esac

	require_result_flag '@.raw_control.forwarded_background.available' true "The raw no-SQM control has no traffic evidence."
	require_result_flag '@.raw_control.forwarded_background.contaminated' false "Background traffic contaminated the raw no-SQM control."
	raw_background_dl="$(require_result_value '@.raw_control.forwarded_background.download_kbps')" ||
		die "The raw no-SQM background download is missing."
	raw_background_ul="$(require_result_value '@.raw_control.forwarded_background.upload_kbps')" ||
		die "The raw no-SQM background upload is missing."
	raw_background_dl_limit="$(require_result_value '@.raw_control.forwarded_background.download_limit_kbps')" ||
		die "The raw no-SQM background download limit is missing."
	raw_background_ul_limit="$(require_result_value '@.raw_control.forwarded_background.upload_limit_kbps')" ||
		die "The raw no-SQM background upload limit is missing."
	raw_delta="$(require_result_value '@.raw_control.effective_delta_ms')" ||
		die "The raw no-SQM delay is missing."
	raw_loss="$(require_result_value '@.raw_control.icmp_latency.loss_percent')" ||
		die "The raw no-SQM packet-loss result is missing."
	raw_dl="$(require_result_value '@.raw_control.throughput.download_kbps')" ||
		die "The raw no-SQM download is missing."
	raw_ul="$(require_result_value '@.raw_control.throughput.upload_kbps')" ||
		die "The raw no-SQM upload is missing."
	raw_grade="$(require_result_value '@.raw_control.grade')" ||
		die "The raw no-SQM grade is missing."
	raw_expected_grade="$(quality_grade_for_delta "$raw_delta")" ||
		die "The raw no-SQM grade cannot be calculated."
	[ "$raw_grade" = "$raw_expected_grade" ] ||
		die "The raw no-SQM grade differs from its measured delay."
	require_result_flag "$selected_proposal_path.effective_delta_ms" "$raw_delta" \
		"The no-SQM proposal delay differs from its raw control."
	require_result_flag "$selected_proposal_path.grade" "$raw_grade" \
		"The no-SQM proposal grade differs from its raw control."
	require_result_flag "$selected_proposal_path.confidence_percent" "$confidence_overall" \
		"The no-SQM proposal confidence differs from its measured result."

	for raw_number in "$raw_background_dl" "$raw_background_ul" \
		"$raw_background_dl_limit" "$raw_background_ul_limit" "$raw_delta" "$raw_loss"; do
		is_decimal "$raw_number" || die "The raw no-SQM control contains malformed numeric evidence."
	done
	is_positive_rate "$raw_dl" && is_positive_rate "$raw_ul" ||
		die "The raw no-SQM control contains no usable bidirectional throughput."
	LC_ALL=C awk -v delta="$raw_delta" -v delay_limit="$validation_manual_latency_review" \
		-v loss="$raw_loss" -v loss_limit="$validation_loss" \
		-v bg_dl="$raw_background_dl" -v bg_ul="$raw_background_ul" \
		-v bg_dl_limit="$raw_background_dl_limit" -v bg_ul_limit="$raw_background_ul_limit" 'BEGIN {
			exit(delta <= delay_limit && loss <= loss_limit &&
				bg_dl <= bg_dl_limit && bg_ul <= bg_ul_limit ? 0 : 1)
		}' || die "The raw no-SQM control exceeds a non-overridable safety boundary."

	# Bind the raw phase to the same calibrated route identity that is attested
	# live immediately before the token is armed.  The raw-control object is
	# produced only after the speed-test supervisor checked this route.
	raw_resolved="$(require_result_value '@.resolved_interface')" ||
		die "The raw no-SQM result has no resolved interface."
	raw_route_interface="$(require_result_value '@.route_interface')" ||
		die "The raw no-SQM result has no route interface."
	raw_source_ip="$(require_result_value '@.source_ip')" ||
		die "The raw no-SQM result has no source address."
	raw_external_ip="$(require_result_value '@.external_ip')" ||
		die "The raw no-SQM result has no external address."
	raw_route_identity="$(require_result_value '@.route_identity')" ||
		die "The raw no-SQM result has no route identity."
	safe_interface "$raw_resolved" && safe_interface "$raw_route_interface" ||
		die "The raw no-SQM route interface is unsafe."
	[ "$raw_route_interface" = "$raw_resolved" ] ||
		die "The raw no-SQM control used a different resolved route interface."
	case "$raw_route_identity" in
		"$route_mode|$member|$raw_route_interface|$raw_source_ip|"*) ;;
		*) die "The raw no-SQM route identity is inconsistent." ;;
	esac
}

arm_guard() {
	job="${1:-}"
	target="${2:-}"
	backend="${3:-}"
	route_mode="${4:-}"
	member="${5:-}"
	enabled="${6:-}"
	disable_adaptive="${7:-}"
	action="${8:-}"
	fingerprint="${9:-}"
	shift 9
	proposal_id="${1:-}"

	safe_job "$job" || die "Unsafe Full Auto-Tune instance name."
	safe_interface "$target" || die "Unsafe Full Auto-Tune target interface."
	safe_backend "$backend" || die "Unsupported Full Auto-Tune apply backend."
	case "$route_mode" in main) [ -z "$member" ] || die "Main routing cannot name an mwan3 member." ;; mwan3) safe_interface "$member" || die "Unsafe mwan3 member." ;; *) die "Unsupported Full Auto-Tune route mode." ;; esac
	case "$enabled:$disable_adaptive" in 0:0|0:1|1:0|1:1) ;; *) die "Invalid Full Auto-Tune review decisions." ;; esac
	case "$action:$enabled" in
		apply_sqm:1|disable_sqm:0) ;;
		*) die "The Full Auto-Tune review action and enabled state are inconsistent." ;;
	esac
	safe_fingerprint "$fingerprint" || die "Invalid Full Auto-Tune result fingerprint."
	safe_proposal_id "$proposal_id" || die "Invalid Full Auto-Tune proposal identity."
	is_uint "$token_ttl_s" && [ "$token_ttl_s" -ge 30 ] && [ "$token_ttl_s" -le 900 ] || die "Invalid apply-guard TTL."
	is_uint "$rollback_timeout_s" && [ "$rollback_timeout_s" -ge 10 ] && [ "$rollback_timeout_s" -le 120 ] ||
		die "Invalid apply rollback timeout."
	is_uint "$orphan_age_s" && [ "$orphan_age_s" -ge 60 ] && [ "$orphan_age_s" -le 86400 ] || die "Invalid abandoned-token GC age."
	prepare_root
	guard_capacity_check || die "Too many unsafe or abandoned Full Auto-Tune apply tokens exist."
	sqm_guard="$(sqm_guard_section "$job")" || die "The SQM rollback marker identity is unsafe."
	if uci -q get "sqm.$sqm_guard" >/dev/null 2>&1; then
		die "The reserved SQM rollback section already exists; reconcile or remove it before applying."
	fi
	if uci -q show cake-autorate 2>/dev/null | grep -q '\._autotune_apply_'; then
		die "A persistent Full Auto-Tune apply marker already exists; reconcile it before applying another proposal."
	fi

	result="$autotune_root/$job/result.json"
	bounded_regular_file "$result" 1048576 || die "The validated Full Auto-Tune result is missing, unsafe, or too large."
	if command -v hexdump >/dev/null 2>&1; then
		token="$(hexdump -vn32 -e '32/1 "%02x"' /dev/urandom 2>/dev/null)"
	else
		token="$(od -An -N32 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
	fi
	safe_token "$token" || die "Unable to create a secure Full Auto-Tune apply token."
	token_dir="$guard_root/$token"
	[ ! -e "$token_dir" ] && [ ! -L "$token_dir" ] || die "The Full Auto-Tune apply token already exists."
	mkdir "$token_dir" && chmod 700 "$token_dir" || die "Unable to create the Full Auto-Tune apply token."
	arm_cleanup_dir="$token_dir"
	cp "$result" "$token_dir/result.json" || die "Unable to bind the Full Auto-Tune result to its apply token."
	chmod 600 "$token_dir/result.json" || die "Unable to protect the Full Auto-Tune result copy."
	result_copy="$token_dir/result.json"
	owned_regular "$result_copy" || die "The Full Auto-Tune result copy is unsafe."

	require_result_flag '@.state' complete "Only a complete Full Auto-Tune result can be applied."
	require_result_flag '@.schema_version' 8 "Only the background-aware fail-closed Full Auto-Tune schema can be applied."
	require_result_flag '@.producer' "$autotune_result_producer" "The Full Auto-Tune result producer is invalid."
	require_result_flag '@.result_available' true "The Full Auto-Tune result contains no reviewable measurement."
	require_result_flag '@.manual_apply_eligible' true "This Full Auto-Tune result is not eligible for explicit review and apply."
	require_result_flag '@.phase_evidence_complete' true "This Full Auto-Tune result has incomplete phase evidence."
	require_result_flag '@.runtime_restored' true "Full Auto-Tune runtime recovery is incomplete."
	require_result_flag '@.recovery_pending' false "Full Auto-Tune recovery is still pending."
	require_result_flag '@.configuration_written' false "The Full Auto-Tune result has unexpected write state."
	selected_proposal_index=
	proposal_index=0
	while [ "$proposal_index" -lt 4 ]; do
		candidate_id="$(json_get "$result_copy" "@.proposals[$proposal_index].proposal_id" 2>/dev/null || true)"
		if [ "$candidate_id" = "$proposal_id" ]; then
			[ -z "$selected_proposal_index" ] || die "The selected Full Auto-Tune proposal identity is duplicated."
			selected_proposal_index="$proposal_index"
		fi
		proposal_index=$((proposal_index + 1))
	done
	[ -n "$selected_proposal_index" ] || die "The selected Full Auto-Tune proposal is not present in the result."
	[ -z "$(json_get "$result_copy" '@.proposals[4].proposal_id' 2>/dev/null || true)" ] ||
		die "The Full Auto-Tune result contains too many proposals."
	selected_proposal_path="@.proposals[$selected_proposal_index]"
	require_result_flag "$selected_proposal_path.schema_version" 1 "The selected proposal schema is invalid."
	require_result_flag "$selected_proposal_path.proposal_id" "$proposal_id" "The selected proposal identity changed."
	require_result_flag "$selected_proposal_path.action" "$action" "The selected proposal action changed."
	require_result_flag "$selected_proposal_path.applicable" true "The selected proposal is not applicable."
	require_result_flag "$selected_proposal_path.hard_safety_pass" true "The selected proposal did not pass hard safety checks."
	selected_topology="$(require_result_value "$selected_proposal_path.topology")" ||
		die "The selected proposal topology is missing."
	case "$selected_topology:$action" in
		both_shaped:apply_sqm|upload_only_shaped:apply_sqm|download_only_shaped:apply_sqm|no_sqm:disable_sqm) ;;
		*) die "The selected Full Auto-Tune proposal topology and action are inconsistent." ;;
	esac
	result_class="$(require_result_value '@.result_class')" ||
		die "The Full Auto-Tune result class is missing."
	case "$result_class" in trusted|provisional|estimated) ;;
		*) die "The Full Auto-Tune result class is invalid." ;;
	esac
	confidence_overall="$(require_result_value '@.confidence.overall_percent')" ||
		die "The overall Full Auto-Tune confidence is missing."
	confidence_dl="$(require_result_value '@.confidence.capacity_download_percent')" ||
		die "The download-capacity confidence is missing."
	confidence_ul="$(require_result_value '@.confidence.capacity_upload_percent')" ||
		die "The upload-capacity confidence is missing."
	confidence_quality="$(require_result_value '@.confidence.quality_percent')" ||
		die "The quality confidence is missing."
	for confidence_value in "$confidence_overall" "$confidence_dl" "$confidence_ul" "$confidence_quality"; do
		is_percent "$confidence_value" || die "The Full Auto-Tune confidence evidence is malformed."
	done
	confidence_min="$(LC_ALL=C awk -v a="$confidence_dl" -v b="$confidence_ul" -v c="$confidence_quality" 'BEGIN {
		min = a + 0; if (b + 0 < min) min = b + 0; if (c + 0 < min) min = c + 0;
		printf "%.15g\n", min
	}')"
	numbers_equal "$confidence_overall" "$confidence_min" ||
		die "The overall confidence is not the weakest reported confidence dimension."
	validation_contaminated="$(require_result_value '@.validation.contaminated')" ||
		die "The validation contamination state is missing."
	phase_contamination_seen="$(require_result_value '@.phase_contamination_seen')" ||
		die "The phase contamination state is missing."
	case "$validation_contaminated:$phase_contamination_seen" in
		true:true|true:false|false:true|false:false) ;;
		*) die "The background contamination evidence is malformed." ;;
	esac
	case "$result_class" in
		trusted)
			LC_ALL=C awk -v value="$confidence_overall" 'BEGIN { exit(value >= 85 ? 0 : 1) }' ||
				die "A trusted result reported less than 85 percent confidence."
			require_result_flag '@.validation.contaminated' false "A trusted validation cannot be contaminated."
			require_result_flag '@.phase_contamination_seen' false "A trusted result cannot retain phase contamination."
		;;
		provisional)
			LC_ALL=C awk -v value="$confidence_overall" 'BEGIN { exit(value >= 40 && value < 85 ? 0 : 1) }' ||
				die "A provisional result must report at least 40 and less than 85 percent confidence."
			require_result_flag '@.auto_apply_eligible' false "A non-trusted result must remain manual-only."
		;;
		estimated)
			LC_ALL=C awk -v value="$confidence_overall" 'BEGIN { exit(value < 40 ? 0 : 1) }' ||
				die "An estimated result must report less than 40 percent confidence."
			require_result_flag '@.auto_apply_eligible' false "A non-trusted result must remain manual-only."
		;;
	esac
	run_id="$(require_result_value '@.run_id')" || die "The Full Auto-Tune run identity is missing."
	safe_run_id "$run_id" || die "The Full Auto-Tune run identity is unsafe."
	load_profile_contract
	raw_control_selected=false
	if [ "$selected_topology" = no_sqm ] &&
	   [ "$(json_get "$result_copy" "$selected_proposal_path.evidence.control" 2>/dev/null || true)" = raw_control ]; then
		validate_raw_no_sqm_proposal_contract
		raw_control_selected=true
	fi
	if [ "$raw_control_selected" != true ]; then
	validate_bidirectional_confirmation_contract
	if [ "$action" = apply_sqm ]; then
		validate_selected_configuration_contract
		case "$selected_topology" in
			upload_only_shaped|download_only_shaped)
				validate_directional_proposal_contract "$selected_topology"
				;;
		esac
	fi
	require_result_flag '@.validation.profile' "$profile" "The terminal validation profile differs from the proposal."
	profile_outcome_mode="$(require_result_value '@.profile_outcome.mode')" ||
		die "The profile outcome mode is missing."
	profile_floor_infeasible=false
	if [ "$profile_outcome_mode" = safety-floor-infeasible ]; then
		case "$selected_topology:$action:$profile" in
			upload_only_shaped:apply_sqm:*|download_only_shaped:apply_sqm:*|no_sqm:disable_sqm:fair) ;;
			*) die "An infeasible capacity floor has no independently safe selected fallback." ;;
		esac
		profile_floor_infeasible=true
		require_result_flag '@.validation.safety_pass' false "The capacity-floor fallback unexpectedly claims to be safe."
		require_result_flag '@.profile_outcome.manual_only' true "The capacity-floor fallback must be manual-only."
		require_result_flag '@.auto_apply_eligible' false "A capacity-floor fallback must never auto-apply."
		profile_infeasible_reason="$(require_result_value '@.profile_outcome.infeasible_reason')" ||
			die "The capacity-floor fallback reason is missing."
	else
		require_result_flag '@.validation.safety_pass' true "The selected candidate failed a safety gate."
	fi
	profile_historical_trust_met="$(require_result_value '@.profile_outcome.throughput_safety_floor_met')" ||
		die "The historical throughput trust state is missing."
	case "$profile_historical_trust_met" in true|false) ;; *) die "The historical throughput trust state is invalid." ;; esac
	require_result_flag '@.profile_outcome.throughput_safety_floor_percent' 50 "The catastrophic throughput floor changed."
	require_result_flag '@.profile_outcome.target_grade' "$target_grade" "The profile outcome target changed."
	profile_outcome_floor="$(require_result_value '@.profile_outcome.capacity_floor_percent')" ||
		die "The profile outcome capacity floor is missing."
	numbers_equal "$profile_outcome_floor" "$validation_retention" ||
		die "The profile outcome and proposal capacity floors differ."
	profile_target_met="$(require_result_value '@.profile_outcome.target_met')" ||
		die "The profile outcome target state is missing."
	validation_target_met="$(require_result_value '@.validation.quality_target_met')" ||
		die "The directional validation target state is missing."
	case "$validation_target_met" in true|false) ;; *) die "The directional validation target state is invalid." ;; esac
	expected_profile_target_met="$validation_target_met"
	[ "$bidirectional_latency_pass" = true ] || expected_profile_target_met=false
	[ "$profile_target_met" = "$expected_profile_target_met" ] ||
		die "The profile outcome target state does not match directional and final bidirectional latency evidence."
	profile_objectives_met="$(require_result_value '@.validation.profile_objectives_met')" ||
		die "The profile objective state is missing."
	[ "$profile_objectives_met" = "$(json_get "$result_copy" '@.profile_outcome.capacity_floor_met')" ] ||
		die "The profile outcome and validation retention-objective states differ."
	if [ "$profile" = fair ]; then
	validation_effective_delta="$(require_result_value '@.validation.effective_delta_ms')" ||
		die "The directional validation delay is missing."
	is_decimal "$validation_effective_delta" ||
		die "The directional validation delay is malformed."
	validation_actual_grade="$(require_result_value '@.validation.actual_grade')" ||
		die "The directional validation grade is missing."
	expected_validation_grade="$(quality_grade_for_delta "$validation_effective_delta")" ||
		die "The directional validation grade cannot be calculated."
	[ "$validation_actual_grade" = "$expected_validation_grade" ] ||
		die "The directional validation grade does not match its measured delay."
	bidirectional_actual_grade="$(require_result_value '@.bidirectional_confirmation.grade')" ||
		die "The final bidirectional grade is missing."
	expected_bidirectional_grade="$(quality_grade_for_delta "$bidirectional_delta")" ||
		die "The final bidirectional grade cannot be calculated."
	[ "$bidirectional_actual_grade" = "$expected_bidirectional_grade" ] ||
		die "The final bidirectional grade does not match its measured delay."
	validation_grade_rank="$(quality_grade_rank "$validation_actual_grade")" ||
		die "The directional validation grade is invalid."
	bidirectional_grade_rank="$(quality_grade_rank "$bidirectional_actual_grade")" ||
		die "The final bidirectional grade is invalid."
	authoritative_actual_grade="$validation_actual_grade"
	[ "$bidirectional_grade_rank" -le "$validation_grade_rank" ] ||
		authoritative_actual_grade="$bidirectional_actual_grade"
	require_result_flag '@.profile_outcome.actual_grade' "$authoritative_actual_grade" \
		"The profile outcome does not report the worst measured line grade."
		fair_actual_grade="$(require_result_value '@.fair_outcome.actual_grade')" ||
			die "The Fair outcome grade is missing."
		[ "$fair_actual_grade" = "$authoritative_actual_grade" ] ||
			die "The Fair outcome does not report the authoritative final grade."
		fair_actual_delta="$(require_result_value '@.fair_outcome.actual_effective_delta_ms')" ||
			die "The Fair outcome delay is missing."
		authoritative_actual_delta="$(LC_ALL=C awk -v directional="$validation_effective_delta" \
			-v simultaneous="$bidirectional_delta" 'BEGIN {
			print (((directional + 0) > (simultaneous + 0)) ? directional : simultaneous)
			}')"
		is_decimal "$fair_actual_delta" &&
			numbers_equal "$fair_actual_delta" "$authoritative_actual_delta" ||
			die "The Fair outcome does not report the worst measured loaded delay."
		require_result_flag '@.fair_outcome.capacity_floor_met' "$profile_objectives_met" \
			"The Fair outcome and profile retention states differ."
		require_result_flag '@.fair_outcome.throughput_safety_floor_met' "$profile_historical_trust_met" \
			"The Fair outcome and profile historical-throughput states differ."
		fair_mode="$(require_result_value '@.fair_outcome.mode')" ||
			die "The Fair outcome mode is missing."
		if [ "$profile_floor_infeasible" = true ]; then
			case "$fair_mode" in throughput-fallback|sqm-disable-recommended) ;;
				*) die "An infeasible Fair candidate has no recognized fail-closed outcome." ;;
			esac
		elif [ "$profile_target_met" = true ]; then
			[ "$fair_mode" = quality-target-met ] ||
				die "The Fair outcome mode ignores a proven final quality target."
		else
			case "$fair_mode" in throughput-fallback|sqm-disable-recommended) ;;
				*) die "The Fair outcome mode ignores the final bidirectional quality miss." ;;
			esac
		fi
	fi
	profile_deep_runtime_minimum="$(require_result_value '@.profile_outcome.deep_runtime_minimum')" ||
		die "The runtime-minimum retention state is missing."
	case "$profile_deep_runtime_minimum" in true|false) ;; *) die "The runtime-minimum retention state is invalid." ;; esac
	if [ "$profile" = gaming_extreme ] && [ "$selected_topology" = both_shaped ]; then
		extreme_dl_runtime_retention="$(require_result_value '@.profile_outcome.runtime_minimum_retention.download_percent')" ||
			die "The Extreme A+ download runtime retention is missing."
		extreme_ul_runtime_retention="$(require_result_value '@.profile_outcome.runtime_minimum_retention.upload_percent')" ||
			die "The Extreme A+ upload runtime retention is missing."
		expected_deep_runtime_minimum="$(LC_ALL=C awk -v dl="$extreme_dl_runtime_retention" -v ul="$extreme_ul_runtime_retention" 'BEGIN {
			if (dl < 0 || ul < 0) exit 1
			print (dl < 70 || ul < 70) ? "true" : "false"
		}')" || die "The Extreme A+ runtime retention is invalid."
		[ "$profile_deep_runtime_minimum" = "$expected_deep_runtime_minimum" ] ||
			die "The Extreme A+ deep-runtime state does not match its measured retention."
		for extreme_direction in download upload; do
			case "$extreme_direction" in
				download) extreme_reported_retention="$extreme_dl_runtime_retention" ;;
				upload) extreme_reported_retention="$extreme_ul_runtime_retention" ;;
			esac
			extreme_runtime_minimum="$(require_result_value "@.profile_search.$extreme_direction.runtime_minimum_kbps")" ||
				die "The Extreme A+ runtime minimum is missing."
			extreme_observed_low="$(require_result_value "@.proposal.$extreme_direction.observed_low_kbps")" ||
				die "The Extreme A+ observed-low reference is missing."
			extreme_expected_retention="$(LC_ALL=C awk -v minimum="$extreme_runtime_minimum" -v raw="$extreme_observed_low" 'BEGIN {
				if (minimum <= 0 || raw <= 0) exit 1
				printf "%.1f", minimum * 100 / raw
			}')" || die "The Extreme A+ runtime-retention evidence is invalid."
			numbers_equal "$extreme_reported_retention" "$extreme_expected_retention" ||
				die "The Extreme A+ runtime-retention evidence does not match its tested rate."
		done
	elif [ "$profile" = gaming_extreme ] && [ "$selected_topology" = no_sqm ]; then
		[ "$profile_deep_runtime_minimum" = false ] ||
			die "A raw no-SQM proposal cannot claim an untested Extreme runtime minimum."
		case "$(json_get "$result_copy" '@.profile_outcome.runtime_minimum_retention')" in
			''|null) ;;
			*) die "A raw no-SQM proposal contains unneeded Extreme runtime-retention evidence." ;;
		esac
	elif [ "$profile" = gaming_extreme ]; then
		case "$selected_topology" in
			upload_only_shaped) extreme_active_direction=upload ;;
			download_only_shaped) extreme_active_direction=download ;;
			*) die "The Extreme A+ proposal topology is invalid." ;;
		esac
		extreme_runtime_retention="$(json_get "$result_copy" "@.profile_outcome.runtime_minimum_retention.${extreme_active_direction}_percent" 2>/dev/null || true)"
		case "$extreme_runtime_retention" in
			''|null)
				[ "$profile_deep_runtime_minimum" = false ] ||
					die "A one-sided Extreme A+ proposal claims an unattested deep runtime minimum."
				case "$(json_get "$result_copy" '@.profile_outcome.runtime_minimum_retention')" in
					''|null) ;;
					*) die "The one-sided Extreme A+ runtime-retention evidence is incomplete." ;;
				esac
				;;
			*)
				is_decimal "$extreme_runtime_retention" ||
					die "The one-sided Extreme A+ runtime retention is malformed."
				extreme_runtime_minimum="$(require_result_value "@.profile_search.$extreme_active_direction.runtime_minimum_kbps")" ||
					die "The one-sided Extreme A+ runtime minimum is missing."
				extreme_observed_low="$(require_result_value "@.proposal.$extreme_active_direction.observed_low_kbps")" ||
					die "The one-sided Extreme A+ observed-low reference is missing."
				extreme_expected_retention="$(LC_ALL=C awk -v minimum="$extreme_runtime_minimum" \
					-v raw="$extreme_observed_low" 'BEGIN {
						if (minimum <= 0 || raw <= 0) exit 1
						printf "%.1f", minimum * 100 / raw
					}')" || die "The one-sided Extreme A+ runtime-retention evidence is invalid."
				numbers_equal "$extreme_runtime_retention" "$extreme_expected_retention" ||
					die "The one-sided Extreme A+ runtime retention does not match its tested rate."
				;;
		esac
	else
		[ "$profile_deep_runtime_minimum" = false ] ||
			die "A non-Extreme profile claims an Extreme runtime minimum."
		case "$(json_get "$result_copy" '@.profile_outcome.runtime_minimum_retention')" in
			''|null) ;;
			*) die "A non-Extreme profile contains Extreme runtime-retention evidence." ;;
		esac
	fi
	profile_unsafe_direction_count=0
	profile_no_cake_effect_count=0
	profile_variable_manual_fallback_count=0
	case "$selected_topology" in
		both_shaped)
			validate_profile_search_contract download "$profile_floor_infeasible"
			validate_profile_search_contract upload "$profile_floor_infeasible"
			;;
		upload_only_shaped)
			validate_profile_search_contract upload false
			;;
		download_only_shaped)
			validate_profile_search_contract download false
			;;
	esac
	if [ "$selected_topology" = both_shaped ]; then
		if [ "$profile_floor_infeasible" = true ] && [ "$profile_unsafe_direction_count" -lt 1 ]; then
			die "The capacity-floor fallback contains no direction with a proven repeatable ceiling."
		fi
	fi
	if [ "$profile_no_cake_effect_count" -gt 0 ]; then
		[ "$profile" = variable_link ] && { [ "$action" = apply_sqm ] || [ "$action" = disable_sqm ]; } ||
			die "A directional no-effect result may only review a Variable link SQM proposal."
		require_result_flag '@.profile_outcome.mode' directional-no-cake-effect-review "The directional no-effect outcome mode changed."
		require_result_flag '@.profile_outcome.manual_only' true "A directional no-effect result must remain manual-only."
		require_result_flag '@.auto_apply_eligible' false "A directional no-effect result must never auto-apply."
		require_result_flag '@.bidirectional_confirmation.tested' true "The directional no-effect result lacks simultaneous confirmation."
		require_result_flag '@.profile_outcome.bidirectional_confirmation.tested' true "The outcome lost simultaneous confirmation."
		if [ "$selected_topology" = both_shaped ]; then
			require_result_flag '@.bidirectional_confirmation.safety_pass' true "The directional no-effect final pair is unsafe."
			require_result_flag '@.profile_outcome.bidirectional_confirmation.safety_pass' true "The outcome contains an unsafe final pair."
		fi
	fi
	if [ "$profile_variable_manual_fallback_count" -gt 0 ] &&
	   [ "$profile_no_cake_effect_count" -eq 0 ]; then
		[ "$profile" = variable_link ] && [ "$action" = apply_sqm ] ||
			die "A bounded Variable link fallback may only review an SQM proposal."
		require_result_flag '@.profile_outcome.mode' variable-link-bounded-evidence-review "The bounded Variable link outcome mode changed."
		require_result_flag '@.profile_outcome.manual_only' true "A bounded Variable link fallback must remain manual-only."
		require_result_flag '@.auto_apply_eligible' false "A bounded Variable link fallback must never auto-apply."
		require_result_flag '@.bidirectional_confirmation.tested' true "The bounded Variable link fallback lacks simultaneous confirmation."
		require_result_flag '@.profile_outcome.bidirectional_confirmation.tested' true "The outcome lost simultaneous confirmation."
		if [ "$selected_topology" = both_shaped ]; then
			require_result_flag '@.bidirectional_confirmation.safety_pass' true "The bounded Variable link final pair is unsafe."
			require_result_flag '@.profile_outcome.bidirectional_confirmation.safety_pass' true "The outcome contains an unsafe final pair."
		fi
	fi
	case "$action" in
		apply_sqm)
			# A directional proposal is independently attested above.  Requiring
			# the old both-shaped topology to be safe would erase the very
			# fallback that the comparison proved.  Only the both-shaped proposal
			# is bound to the simultaneous both-shaped safety verdict.
			if [ "$selected_topology" = both_shaped ]; then
				[ "$bidirectional_safety_pass" = true ] ||
					die "The final bidirectional confirmation is outside the non-overridable SQM proposal boundaries."
			fi
			if [ "$profile_floor_infeasible" = true ] &&
			   { [ "$selected_topology" = upload_only_shaped ] || [ "$selected_topology" = download_only_shaped ]; }; then
				require_result_flag '@.auto_apply_eligible' false "An independently safe capacity-floor fallback must never auto-apply."
				require_result_flag '@.profile_outcome.manual_only' true "An independently safe capacity-floor fallback must remain manual-only."
			elif [ "$profile_no_cake_effect_count" -gt 0 ] ||
			   [ "$profile_variable_manual_fallback_count" -gt 0 ]; then
				: # The typed directional no-effect contract above is always explicit-review only.
		elif [ "$profile_target_met" = true ] && [ "$profile_objectives_met" = true ] &&
		   [ "$profile_deep_runtime_minimum" = false ] &&
		   [ "$bidirectional_auto_apply_pass" = true ]; then
				require_result_flag '@.profile_outcome.manual_only' false "A target-meeting outcome was marked manual-only."
				if [ "$result_class" = trusted ]; then
					require_result_flag '@.auto_apply_eligible' true "A trusted, fully passing proposal unexpectedly requires manual-only apply."
				else
					require_result_flag '@.auto_apply_eligible' false "A non-trusted result must never auto-apply."
				fi
			else
				require_result_flag '@.auto_apply_eligible' false "A profile fallback must never be auto-applied."
				require_result_flag '@.profile_outcome.manual_only' true "A below-target fallback was not marked manual-only."
				profile_outcome_mode="$(require_result_value '@.profile_outcome.mode')" ||
					die "The profile fallback outcome is missing."
				case "$profile:$profile_outcome_mode" in
					gaming:target-a-plus-met|gaming_extreme:extreme-a-plus-met|best_overall:target-a-met|variable_link:target-b-measured-knee|fair:throughput-optimum-c-or-better)
						[ "$profile_target_met" = true ] &&
							[ "$profile_objectives_met" = true ] &&
							[ "$bidirectional_realization_pass" = false ] ||
							die "A target-meeting manual proposal has no final bidirectional realization shortfall."
						;;
					gaming:best-attainable-quality-fallback|best_overall:balanced-fallback|variable_link:measured-knee-quality-fallback) ;;
					gaming:target-a-plus-throughput-advisory|best_overall:target-a-throughput-advisory) ;;
					gaming_extreme:extreme-a-plus-throughput-sacrifice|gaming_extreme:extreme-best-attainable-quality-fallback|gaming_extreme:extreme-quality-and-throughput-review) ;;
					variable_link:target-b-retention-advisory) ;;
					gaming:quality-and-throughput-advisory-review|best_overall:quality-and-throughput-advisory-review|variable_link:variable-link-review-required) ;;
					fair:latency-safe-throughput-advisory|fair:quality-and-throughput-advisory-review)
						result_action_allowed apply_sqm ||
							die "The Fair advisory result does not allow applying its safe SQM candidate."
						;;
					fair:throughput-optimum-quality-fallback)
						fair_mode="$(json_get "$result_copy" '@.fair_outcome.mode')"
						case "$fair_mode" in throughput-fallback|sqm-disable-recommended) ;;
							*) die "The Fair throughput fallback is missing its typed outcome." ;;
						esac
						result_action_allowed apply_sqm ||
							die "The Fair outcome does not allow applying its best safe SQM candidate."
						;;
					*) die "The below-target result has no recognized typed fallback." ;;
				esac
			fi
			;;
		disable_sqm)
			if [ "$(json_get "$result_copy" "$selected_proposal_path.evidence.control")" = raw_control ]; then
				require_result_flag "$selected_proposal_path.evidence.control" raw_control \
					"The no-SQM proposal is not bound to its raw control."
				case "$profile" in gaming|gaming_extreme|best_overall|variable_link) ;;
					*) die "This calibration profile cannot use a generic raw no-SQM proposal." ;;
				esac
				require_result_flag '@.raw_control.available' true "The raw no-SQM control is unavailable."
				require_result_flag '@.raw_control.measurement_evidence.valid' true "The raw no-SQM control evidence is invalid."
				require_result_flag '@.raw_control.measurement_evidence.test_direction' both "The raw no-SQM control was not bidirectional."
				require_result_flag '@.raw_control.measurement_evidence.shaper_bypassed' true "The raw no-SQM control did not prove SQM bypass."
				raw_bypass_mode="$(require_result_value '@.raw_control.measurement_evidence.sqm_bypass_mode')" ||
					die "The Variable link raw control has no bypass mode."
				raw_sqm_paused="$(require_result_value '@.raw_control.measurement_evidence.sqm_paused')" ||
					die "The Variable link raw control has no SQM pause evidence."
				case "$raw_bypass_mode:$raw_sqm_paused" in paused-managed:true|already-unshaped:false) ;; *) die "The raw no-SQM control bypass evidence is inconsistent." ;; esac
				require_result_flag '@.raw_control.forwarded_background.available' true "The raw no-SQM control has no traffic evidence."
				require_result_flag '@.raw_control.forwarded_background.contaminated' false "Background traffic contaminated the raw no-SQM control."
				raw_background_dl="$(require_result_value '@.raw_control.forwarded_background.download_kbps')" || die "The Variable link raw background download is missing."
				raw_background_ul="$(require_result_value '@.raw_control.forwarded_background.upload_kbps')" || die "The Variable link raw background upload is missing."
				raw_background_dl_limit="$(require_result_value '@.raw_control.forwarded_background.download_limit_kbps')" || die "The Variable link raw background download limit is missing."
				raw_background_ul_limit="$(require_result_value '@.raw_control.forwarded_background.upload_limit_kbps')" || die "The Variable link raw background upload limit is missing."
				raw_delta="$(require_result_value '@.raw_control.effective_delta_ms')" || die "The Variable link raw delay is missing."
				require_result_flag "$selected_proposal_path.effective_delta_ms" "$raw_delta" "The no-SQM proposal delay differs from its raw control."
				raw_grade="$(require_result_value '@.raw_control.grade')" || die "The raw no-SQM grade is missing."
				require_result_flag "$selected_proposal_path.grade" "$raw_grade" "The no-SQM proposal grade differs from its raw control."
				raw_loss="$(require_result_value '@.raw_control.icmp_latency.loss_percent')" || die "The Variable link raw loss is missing."
				raw_dl="$(require_result_value '@.raw_control.throughput.download_kbps')" || die "The Variable link raw download is missing."
				raw_ul="$(require_result_value '@.raw_control.throughput.upload_kbps')" || die "The Variable link raw upload is missing."
				shaped_directional_delta="$(require_result_value '@.validation.effective_delta_ms')" ||
					die "The shaped comparison delay is missing."
				shaped_review_delta="$(LC_ALL=C awk -v directional="$shaped_directional_delta" \
					-v simultaneous="$bidirectional_delta" 'BEGIN {
						if (directional !~ /^[0-9]+([.][0-9]+)?$/ || simultaneous !~ /^[0-9]+([.][0-9]+)?$/) exit 1
						print (((directional + 0) > (simultaneous + 0)) ? directional : simultaneous)
					}')" || die "The shaped comparison delay is malformed."
				shaped_dl="$(require_result_value '@.validation.throughput.download_kbps')" ||
					die "The shaped comparison download is missing."
				shaped_ul="$(require_result_value '@.validation.throughput.upload_kbps')" ||
					die "The shaped comparison upload is missing."
				is_decimal "$raw_delta" && is_decimal "$raw_loss" &&
					is_positive_rate "$raw_dl" && is_positive_rate "$raw_ul" &&
					is_positive_rate "$shaped_dl" && is_positive_rate "$shaped_ul" &&
					is_decimal "$raw_background_dl" && is_decimal "$raw_background_ul" &&
					is_decimal "$raw_background_dl_limit" && is_decimal "$raw_background_ul_limit" &&
					awk -v delta="$raw_delta" -v delay_limit="$validation_manual_latency_review" \
						-v loss="$raw_loss" -v loss_limit="$validation_loss" \
						-v shaped_delta="$shaped_review_delta" -v raw_dl="$raw_dl" -v raw_ul="$raw_ul" \
						-v shaped_dl="$shaped_dl" -v shaped_ul="$shaped_ul" \
						-v bg_dl="$raw_background_dl" -v bg_ul="$raw_background_ul" \
						-v bg_dl_limit="$raw_background_dl_limit" -v bg_ul_limit="$raw_background_ul_limit" \
						'BEGIN {
							exit(delta > delay_limit || loss > loss_limit || bg_dl > bg_dl_limit || bg_ul > bg_ul_limit ||
								delta > shaped_delta + 10 || raw_dl < shaped_dl * 1.02 || raw_ul < shaped_ul * 1.02)
						}' ||
					die "The raw no-SQM control exceeds its manual safety boundary."
			else
				[ "$profile" = fair ] || die "Only a measured raw or Fair comparison may recommend disabling SQM."
			if [ "$profile_floor_infeasible" = true ]; then
				require_result_flag '@.validation.hard_pass' false "The infeasible Fair result unexpectedly passed all hard gates."
				require_result_flag '@.fair_outcome.apply_sqm_available' false "The unsafe shaped candidate must not be applyable."
			else
				require_result_flag '@.validation.hard_pass' true "The Fair comparison has no safe shaped reference candidate."
				require_result_flag '@.validation.quality_target_met' false "SQM disable is not available when the Fair quality target was met."
				require_result_flag '@.fair_outcome.apply_sqm_available' true "The safe shaped comparison candidate disappeared."
			fi
			require_result_flag '@.fair_outcome.throughput_safety_floor_met' "$profile_historical_trust_met" "The Fair historical throughput trust state changed."
			require_result_flag '@.fair_outcome.mode' sqm-disable-recommended "The Fair result did not recommend disabling SQM."
			require_result_flag '@.fair_outcome.target_grade' C "The Fair comparison target changed."
			require_result_flag '@.fair_outcome.target_delta_ms' 200 "The Fair comparison delay target changed."
			require_result_flag '@.fair_outcome.capacity_floor_percent' 90 "The Fair comparison throughput floor changed."
			require_result_flag '@.fair_outcome.throughput_safety_floor_percent' 50 "The Fair comparison safety floor changed."
			require_result_flag '@.fair_outcome.recommended_action' disable_sqm "The Fair recommendation changed."
			require_result_flag '@.fair_outcome.disable_sqm_available' true "The no-SQM choice is not supported by complete evidence."
			require_result_flag '@.fair_outcome.comparison_reason' no-material-latency-benefit-with-throughput-cost "The Fair comparison reason changed."
			require_result_flag '@.fair_outcome.no_sqm_control.available' true "The no-SQM control is unavailable."
			require_result_flag '@.fair_outcome.no_sqm_control.measurement_evidence.valid' true "The no-SQM control evidence is invalid."
				require_result_flag '@.fair_outcome.no_sqm_control.measurement_evidence.test_direction' both "The no-SQM control was not bidirectional."
				require_result_flag '@.fair_outcome.no_sqm_control.measurement_evidence.shaper_bypassed' true "The control did not prove that shaping was bypassed."
				fair_bypass_mode="$(require_result_value '@.fair_outcome.no_sqm_control.measurement_evidence.sqm_bypass_mode')" ||
					die "The no-SQM control has no typed bypass evidence."
				fair_sqm_paused="$(require_result_value '@.fair_outcome.no_sqm_control.measurement_evidence.sqm_paused')" ||
					die "The no-SQM control has no SQM pause evidence."
				case "$fair_bypass_mode:$fair_sqm_paused" in
					paused-managed:true|already-unshaped:false) ;;
					*) die "The no-SQM control returned inconsistent typed bypass evidence." ;;
				esac
			require_result_flag '@.fair_outcome.no_sqm_control.forwarded_background.available' true "The no-SQM control has no forwarded-traffic evidence."
			require_result_flag '@.fair_outcome.no_sqm_control.forwarded_background.contaminated' false "Background traffic contaminated the no-SQM control."
			fair_background_dl="$(require_result_value '@.fair_outcome.no_sqm_control.forwarded_background.download_kbps')" ||
				die "The no-SQM background download measurement is missing."
			fair_background_ul="$(require_result_value '@.fair_outcome.no_sqm_control.forwarded_background.upload_kbps')" ||
				die "The no-SQM background upload measurement is missing."
			fair_background_dl_limit="$(require_result_value '@.fair_outcome.no_sqm_control.forwarded_background.download_limit_kbps')" ||
				die "The no-SQM background download limit is missing."
			fair_background_ul_limit="$(require_result_value '@.fair_outcome.no_sqm_control.forwarded_background.upload_limit_kbps')" ||
				die "The no-SQM background upload limit is missing."
			is_decimal "$fair_background_dl" && is_decimal "$fair_background_ul" &&
				is_decimal "$fair_background_dl_limit" && is_decimal "$fair_background_ul_limit" &&
				awk -v dl="$fair_background_dl" -v ul="$fair_background_ul" \
					-v dl_limit="$fair_background_dl_limit" -v ul_limit="$fair_background_ul_limit" \
					'BEGIN { exit(dl > dl_limit || ul > ul_limit) }' ||
				die "The no-SQM control exceeded its forwarded-traffic limits."
			result_action_allowed disable_sqm ||
				die "The Fair outcome does not allow disabling SQM."
			fair_shaped_grade="$(require_result_value '@.profile_outcome.actual_grade')" ||
				die "The authoritative shaped Fair grade is missing."
			fair_control_grade="$(require_result_value '@.fair_outcome.no_sqm_control.grade')" ||
				die "The no-SQM grade is missing."
			require_result_flag '@.fair_outcome.actual_grade' "$fair_shaped_grade" "The Fair outcome grade differs from the final profile verdict."
			fair_shaped_rank="$(quality_grade_rank "$fair_shaped_grade")" ||
				die "The shaped Fair grade is invalid."
			fair_control_rank="$(quality_grade_rank "$fair_control_grade")" ||
				die "The no-SQM grade is invalid."
			[ "$fair_control_rank" -le "$fair_shaped_rank" ] ||
				die "The no-SQM control grade is worse than the shaped candidate."
			fair_shaped_delta="$(require_result_value '@.fair_outcome.actual_effective_delta_ms')" ||
				die "The authoritative shaped Fair delay is missing."
			fair_control_delta="$(require_result_value '@.fair_outcome.no_sqm_control.effective_delta_ms')" ||
				die "The no-SQM delay is missing."
			fair_control_loss="$(require_result_value '@.fair_outcome.no_sqm_control.icmp_latency.loss_percent')" ||
				die "The no-SQM packet-loss result is missing."
			fair_outcome_delta="$(require_result_value '@.fair_outcome.actual_effective_delta_ms')" ||
				die "The Fair outcome delay is missing."
			is_decimal "$fair_shaped_delta" && is_decimal "$fair_control_delta" &&
				is_decimal "$fair_control_loss" &&
				is_decimal "$fair_outcome_delta" &&
				numbers_equal "$fair_outcome_delta" "$fair_shaped_delta" &&
				awk -v control="$fair_control_delta" -v shaped="$fair_shaped_delta" \
					-v loss="$fair_control_loss" -v loss_limit="$validation_loss" \
					'BEGIN { exit(control > shaped + 10 || loss > loss_limit) }' ||
				die "The no-SQM control exceeds its latency or packet-loss safety boundary."
			fair_control_dl="$(require_result_value '@.fair_outcome.no_sqm_control.throughput.download_kbps')" ||
				die "The no-SQM download measurement is missing."
			fair_control_ul="$(require_result_value '@.fair_outcome.no_sqm_control.throughput.upload_kbps')" ||
				die "The no-SQM upload measurement is missing."
			is_positive_rate "$fair_control_dl" && is_positive_rate "$fair_control_ul" ||
				die "The no-SQM throughput measurements are invalid."
			fair_dl_gain="$(require_result_value '@.fair_outcome.throughput_gain_without_sqm.download_percent')" ||
				die "The no-SQM download comparison is missing."
			fair_ul_gain="$(require_result_value '@.fair_outcome.throughput_gain_without_sqm.upload_percent')" ||
				die "The no-SQM upload comparison is missing."
			is_decimal "$fair_dl_gain" && is_decimal "$fair_ul_gain" &&
				awk -v dl="$fair_dl_gain" -v ul="$fair_ul_gain" 'BEGIN { exit(dl < 2 || ul < 2) }' ||
				die "The no-SQM throughput benefit is below the explicit recommendation threshold."
			fi
			;;
	esac
	fi
	[ "$(json_get "$result_copy" '@.job_id')" = "$job" ] || die "The Full Auto-Tune result belongs to a different instance."
	[ "$(json_get "$result_copy" '@.target_interface')" = "$target" ] || die "The Full Auto-Tune result targets a different interface."
	[ "$(json_get "$result_copy" '@.route_mode')" = "$route_mode" ] || die "The Full Auto-Tune result uses a different route mode."
	[ "$(json_get "$result_copy" '@.mwan3_member')" = "$member" ] || die "The Full Auto-Tune result uses a different mwan3 member."
	[ "$(json_get "$result_copy" '@.config_fingerprint')" = "$fingerprint" ] || die "The Full Auto-Tune result fingerprint changed."

	snapshot_configs || die "Unable to snapshot the pre-apply configuration into tmpfs."
	attest_route "$job" "$target" "$backend" "$route_mode" "$member" "$fingerprint"
	now="$(date +%s)"
	is_uint "$now" || die "Unable to establish the apply-token clock."
	expires=$((now + token_ttl_s))
	boot_id="$(current_boot_id)" || die "Unable to establish the current boot identity."
	original_daemon_identity="$(daemon_identity "$job")" || die "Unable to snapshot the pre-apply daemon generation."
	build_expected_manifest "$job" "$target" "$route_mode" "$member" "$enabled" "$disable_adaptive" "$action" "$fingerprint" "$token" "$expires" "$boot_id" ||
		die "Unable to build the exact Full Auto-Tune apply manifest."
	build_expected_final_manifest || die "Unable to build the marker-free Full Auto-Tune terminal manifest."
	expected_cake_fingerprint="$(snapshot_fingerprint "$token_dir/expected" cake-autorate)" || die "Unable to hash the expected CAKE manifest."
	expected_pre_sqm_fingerprint="$(snapshot_fingerprint "$token_dir/expected-pre" sqm)" || die "Unable to hash the pre-init SQM manifest."
	expected_sqm_fingerprint="$(snapshot_fingerprint "$token_dir/expected" sqm)" || die "Unable to hash the expected SQM manifest."
	expected_final_cake_fingerprint="$(snapshot_fingerprint "$token_dir/expected-final" cake-autorate)" || die "Unable to hash the terminal CAKE manifest."
	expected_final_sqm_fingerprint="$(snapshot_fingerprint "$token_dir/expected-final" sqm)" || die "Unable to hash the terminal SQM manifest."
	original_cake_fingerprint="$(snapshot_fingerprint "$token_dir/original" cake-autorate)" || die "Unable to hash the original CAKE snapshot."
	original_sqm_fingerprint="$(snapshot_fingerprint "$token_dir/original" sqm)" || die "Unable to hash the original SQM snapshot."
	{
		printf 'version=3\n'
		printf 'job=%s\n' "$job"
		printf 'target=%s\n' "$target"
		printf 'backend=%s\n' "$backend"
		printf 'route_mode=%s\n' "$route_mode"
		printf 'mwan3_member=%s\n' "$member"
		printf 'enabled=%s\n' "$enabled"
		printf 'disable_adaptive=%s\n' "$disable_adaptive"
		printf 'action=%s\n' "$action"
		printf 'proposal_id=%s\n' "$proposal_id"
		printf 'topology=%s\n' "$selected_topology"
		printf 'run_id=%s\n' "$run_id"
		printf 'result_fingerprint=%s\n' "$fingerprint"
		printf 'expected_cake_fingerprint=%s\n' "$expected_cake_fingerprint"
		printf 'expected_pre_sqm_fingerprint=%s\n' "$expected_pre_sqm_fingerprint"
		printf 'expected_sqm_fingerprint=%s\n' "$expected_sqm_fingerprint"
		printf 'expected_final_cake_fingerprint=%s\n' "$expected_final_cake_fingerprint"
		printf 'expected_final_sqm_fingerprint=%s\n' "$expected_final_sqm_fingerprint"
		printf 'original_cake_fingerprint=%s\n' "$original_cake_fingerprint"
		printf 'original_sqm_fingerprint=%s\n' "$original_sqm_fingerprint"
		printf 'original_daemon_identity=%s\n' "$original_daemon_identity"
		printf 'source_ip=%s\n' "$(json_get "$result_copy" '@.source_ip')"
		printf 'external_ip=%s\n' "$(json_get "$result_copy" '@.external_ip')"
		printf 'route_identity=%s\n' "$(json_get "$result_copy" '@.route_identity')"
		printf 'expires_epoch=%s\n' "$expires"
		printf 'boot_id=%s\n' "$boot_id"
		printf 'rollback_timeout_s=%s\n' "$rollback_timeout_s"
	} > "$token_dir/meta" || die "Unable to write the Full Auto-Tune token metadata."
	chmod 600 "$token_dir/meta" || die "Unable to protect the Full Auto-Tune token metadata."
	owned_regular "$token_dir/meta" || die "The Full Auto-Tune token metadata is unsafe."
	arm_cleanup_dir=""
	printf '{"state":"armed","schema_version":1,"token":"%s","expires_epoch":%s,"boot_id":"%s"}\n' "$token" "$expires" "$boot_id"
}

load_token() {
	token="$1"
	safe_token "$token" || die "Invalid Full Auto-Tune apply token."
	prepare_root
	token_dir="$guard_root/$token"
	require_secure_directory "$token_dir" || die "The Full Auto-Tune apply token is missing, foreign-owned, or unsafe."
	token_version="$(meta_get version "$token_dir")"
	case "$token_version" in 1|2|3) ;; *) die "Unsupported Full Auto-Tune apply-token schema." ;; esac
	job="$(meta_get job "$token_dir")"
	target="$(meta_get target "$token_dir")"
	backend="$(meta_get backend "$token_dir")"
	route_mode="$(meta_get route_mode "$token_dir")"
	member="$(meta_get mwan3_member "$token_dir")"
	enabled="$(meta_get enabled "$token_dir")"
	disable_adaptive="$(meta_get disable_adaptive "$token_dir")"
	action="$(meta_get action "$token_dir")"
	proposal_id="$(meta_get proposal_id "$token_dir" 2>/dev/null || true)"
	selected_topology="$(meta_get topology "$token_dir" 2>/dev/null || true)"
	run_id="$(meta_get run_id "$token_dir")"
	expires="$(meta_get expires_epoch "$token_dir")"
	token_boot_id="$(meta_get boot_id "$token_dir" 2>/dev/null || true)"
	safe_job "$job" && safe_interface "$target" && safe_backend "$backend" && is_uint "$expires" ||
		die "The Full Auto-Tune token metadata is invalid."
	case "$route_mode" in main) [ -z "$member" ] || die "The Full Auto-Tune token route is invalid." ;; mwan3) safe_interface "$member" || die "The Full Auto-Tune token member is invalid." ;; *) die "The Full Auto-Tune token route mode is invalid." ;; esac
	case "$enabled:$disable_adaptive:$action" in
		1:0:apply_sqm|1:1:apply_sqm|0:0:disable_sqm|0:1:disable_sqm) ;;
		*) die "The Full Auto-Tune token action metadata is invalid." ;;
	esac
	if [ "$token_version" = 3 ]; then
		safe_proposal_id "$proposal_id" || die "The Full Auto-Tune token proposal identity is invalid."
		case "$selected_topology:$action" in
			both_shaped:apply_sqm|upload_only_shaped:apply_sqm|download_only_shaped:apply_sqm|no_sqm:disable_sqm) ;;
			*) die "The Full Auto-Tune token topology is invalid." ;;
		esac
	fi
	safe_run_id "$run_id" || die "The Full Auto-Tune token run identity is invalid."
	if [ "$token_version" = 2 ] || [ "$token_version" = 3 ]; then
		safe_boot_id "$token_boot_id" || die "The Full Auto-Tune token boot identity is invalid."
		[ "$token_boot_id" = "$(current_boot_id)" ] ||
			die "The Full Auto-Tune token belongs to a previous boot."
	fi
	now="$(date +%s)"
	is_uint "$now" || die "Unable to establish the apply-token clock."
	if [ "$now" -le "$expires" ]; then token_expired=0; else token_expired=1; fi
	result_copy="$token_dir/result.json"
	owned_regular "$result_copy" || die "The token-bound Full Auto-Tune result is unsafe."
	require_secure_directory "$token_dir/original" && require_secure_directory "$token_dir/expected-pre" &&
		require_secure_directory "$token_dir/expected" && require_secure_directory "$token_dir/expected-final" ||
		die "The token-bound configuration snapshots are unsafe."
	owned_regular "$token_dir/sqm-section" || die "The token-bound SQM identity is unsafe."
	result_fingerprint="$(meta_get result_fingerprint "$token_dir")"
	safe_fingerprint "$result_fingerprint" &&
		[ "$(json_get "$result_copy" '@.config_fingerprint')" = "$result_fingerprint" ] ||
		die "The token-bound Full Auto-Tune result fingerprint is inconsistent."
	[ "$(json_get "$result_copy" '@.run_id')" = "$run_id" ] ||
		die "The token-bound Full Auto-Tune run identity is inconsistent."
	for fingerprint_spec in \
		"expected_cake_fingerprint:$token_dir/expected:cake-autorate" \
		"expected_pre_sqm_fingerprint:$token_dir/expected-pre:sqm" \
		"expected_sqm_fingerprint:$token_dir/expected:sqm" \
		"expected_final_cake_fingerprint:$token_dir/expected-final:cake-autorate" \
		"expected_final_sqm_fingerprint:$token_dir/expected-final:sqm" \
		"original_cake_fingerprint:$token_dir/original:cake-autorate" \
		"original_sqm_fingerprint:$token_dir/original:sqm"; do
		fingerprint_key="${fingerprint_spec%%:*}"
		fingerprint_rest="${fingerprint_spec#*:}"
		fingerprint_directory="${fingerprint_rest%:*}"
		fingerprint_config="${fingerprint_rest##*:}"
		stored_fingerprint="$(meta_get "$fingerprint_key" "$token_dir")"
		safe_fingerprint "$stored_fingerprint" || die "A token-bound manifest fingerprint is invalid."
		[ "$(snapshot_fingerprint "$fingerprint_directory" "$fingerprint_config")" = "$stored_fingerprint" ] ||
			die "A token-bound Full Auto-Tune snapshot changed."
	done
}

require_token_unexpired() {
	[ "${token_expired:-1}" -eq 0 ] || die "The Full Auto-Tune apply token expired. Run Auto-Tune again."
}

verify_marker() {
	marker_job="$1"
	marker_stage="${2:-pre}"
	marker_allow_expired="${3:-0}"
	marker_token="$(uci -q get "cake-autorate.$marker_job._autotune_apply_token" 2>/dev/null)"
	load_token "$marker_token"
	[ "$marker_allow_expired" = 1 ] || require_token_unexpired
	[ "$job" = "$marker_job" ] || die "The Full Auto-Tune marker/token instance does not match."
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_guard" 2>/dev/null)" = 1 ] || die "The Full Auto-Tune apply marker is malformed."
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_fingerprint" 2>/dev/null)" = "$(meta_get result_fingerprint "$token_dir")" ] || die "The Full Auto-Tune marker fingerprint does not match its token."
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_target" 2>/dev/null)" = "$target" ] || die "The Full Auto-Tune marker target does not match its token."
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_backend" 2>/dev/null)" = "$backend" ] || die "The Full Auto-Tune marker backend does not match its token."
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_route_mode" 2>/dev/null)" = "$route_mode" ] || die "The Full Auto-Tune marker route mode does not match its token."
	if [ "$route_mode" = mwan3 ]; then
		[ "$(uci -q get "cake-autorate.$job._autotune_apply_mwan3_member" 2>/dev/null)" = "$member" ] ||
			die "The Full Auto-Tune marker member does not match its token."
	elif uci -q get "cake-autorate.$job._autotune_apply_mwan3_member" >/dev/null 2>&1; then
		die "A main-route Full Auto-Tune marker unexpectedly names an mwan3 member."
	fi
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_enabled" 2>/dev/null)" = "$enabled" ] || die "The Full Auto-Tune marker enabled state does not match its token."
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_disable_adaptive" 2>/dev/null)" = "$disable_adaptive" ] || die "The Full Auto-Tune marker adaptive decision does not match its token."
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_action" 2>/dev/null)" = "$action" ] || die "The Full Auto-Tune marker action does not match its token."
	if [ "$token_version" = 3 ]; then
		[ "$(uci -q get "cake-autorate.$job._autotune_apply_proposal_id" 2>/dev/null)" = "$proposal_id" ] ||
			die "The Full Auto-Tune marker proposal identity does not match its token."
	fi
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_expires" 2>/dev/null)" = "$expires" ] || die "The Full Auto-Tune marker expiry does not match its token."
	if [ "$token_version" = 2 ] || [ "$token_version" = 3 ]; then
		[ "$(uci -q get "cake-autorate.$job._autotune_apply_boot_id" 2>/dev/null)" = "$token_boot_id" ] ||
			die "The Full Auto-Tune marker boot identity does not match its token."
	fi
	sqm_guard="$(sqm_guard_section "$job")" || die "The SQM rollback marker identity is unsafe."
	[ "$(uci -q get "sqm.$sqm_guard" 2>/dev/null)" = cake_autorate_apply_guard ] ||
		die "The SQM rollback marker has an unexpected section type."
	[ "$(uci -q get "sqm.$sqm_guard._autotune_apply_guard" 2>/dev/null)" = 1 ] ||
		die "The SQM package is not enrolled in the rollback transaction."
	[ "$(uci -q get "sqm.$sqm_guard._autotune_apply_job" 2>/dev/null)" = "$job" ] ||
		die "The SQM rollback marker belongs to a different instance."
	[ "$(uci -q get "sqm.$sqm_guard._autotune_apply_token" 2>/dev/null)" = "$marker_token" ] ||
		die "The SQM rollback marker does not match the apply token."

	expected_cake="$token_dir/check-expected-cake.$$"
	live_cake="$token_dir/check-live-cake.$$"
	canonical_package "$token_dir/expected" cake-autorate "$expected_cake"
	canonical_live_package cake-autorate "$live_cake"
	if ! same_files "$expected_cake" "$live_cake"; then
		local mismatch_option
		mismatch_option="$(manifest_key_mismatch "$expected_cake" "$live_cake")"
		rm -f "$expected_cake" "$live_cake"
		[ -n "$mismatch_option" ] && die "The applied CAKE Autorate package differs from the exact validated proposal manifest: $mismatch_option." || \
			die "The applied CAKE Autorate package differs from the exact validated proposal manifest."
	fi
	rm -f "$expected_cake" "$live_cake"

	if [ "$marker_stage" = pre ]; then
		# A config.change reload can run before the explicit guarded restart.
		# Therefore the protected queue may be either the exact arm-time value
		# or the exact manifest already materialized by that first reload. No
		# third/intermediate state is accepted.
		expected_pre_sqm="$token_dir/check-expected-pre-sqm.$$"
		expected_sqm="$token_dir/check-expected-sqm.$$"
		live_sqm="$token_dir/check-live-sqm.$$"
		canonical_package "$token_dir/expected-pre" sqm "$expected_pre_sqm"
		canonical_package "$token_dir/expected" sqm "$expected_sqm"
		canonical_live_package sqm "$live_sqm"
		if ! same_files "$expected_pre_sqm" "$live_sqm" &&
		   ! same_files "$expected_sqm" "$live_sqm"; then
			rm -f "$expected_pre_sqm" "$expected_sqm" "$live_sqm"
			die "The protected SQM package changed outside the validated proposal transaction."
		fi
		rm -f "$expected_pre_sqm" "$expected_sqm" "$live_sqm"
	fi

	verify_live_route
}

verify_live_route() {
	route_json="$token_dir/route-check.$$"
	"$speedtest_bin" "$job" "$target" route-status "$backend" "" "$route_mode" "$member" > "$route_json" 2>/dev/null ||
		die "Unable to attest the selected route during Full Auto-Tune apply."
	owned_regular "$route_json" && chmod 600 "$route_json" || die "The route attestation output is unsafe."
	[ "$(json_get "$route_json" '@.state')" = ready ] || die "The selected Full Auto-Tune route is no longer ready."
	[ "$(json_get "$route_json" '@.source_ip')" = "$(meta_get source_ip "$token_dir")" ] || die "The selected uplink source address changed during apply."
	[ "$(json_get "$route_json" '@.external_ip')" = "$(meta_get external_ip "$token_dir")" ] || die "The selected uplink external address changed during apply."
	[ "$(json_get "$route_json" '@.route_identity')" = "$(meta_get route_identity "$token_dir")" ] || die "The selected uplink route identity changed during apply."
	rm -f "$route_json"
}

guarded_jobs() {
	uci -q show cake-autorate 2>/dev/null |
		sed -n "s/^cake-autorate\.\([A-Za-z0-9_]*\)\._autotune_apply_[A-Za-z0-9_]*=.*/\1/p" |
		LC_ALL=C sort -u
}

guarded_sqm_jobs() {
	uci -q show sqm 2>/dev/null |
		sed -n "s/^sqm\.cake_autorate_apply_[A-Za-z0-9_]*\._autotune_apply_job='\([A-Za-z0-9_]*\)'$/\1/p" |
		LC_ALL=C sort -u
}

any_apply_marker_lines() {
	uci -q show cake-autorate 2>/dev/null | grep -q '\._autotune_apply_' && return 0
	uci -q show sqm 2>/dev/null | grep -q '\._autotune_apply_'
}

verify_init() {
	prepare_root
	jobs="$(guarded_jobs)"
	sqm_jobs="$(guarded_sqm_jobs)"
	if [ -z "$jobs$sqm_jobs" ]; then
		any_apply_marker_lines && die "An incomplete Full Auto-Tune apply marker exists."
		printf '{"state":"clear","schema_version":1}\n'
		return 0
	fi
	[ -n "$jobs" ] && [ -n "$sqm_jobs" ] && [ "$jobs" = "$sqm_jobs" ] ||
		die "The CAKE and SQM apply markers are not an exact pair."
	[ "$(printf '%s\n' $jobs | wc -l)" -eq 1 ] ||
		die "Only one Full Auto-Tune apply marker may be active in a transaction."
	count=0
	for marker_job in $jobs; do
		safe_job "$marker_job" || die "An unsafe Full Auto-Tune marker section exists."
		verify_marker "$marker_job" pre
		count=$((count + 1))
	done
	apply_started_file="$token_dir/apply-started"
	if [ ! -e "$apply_started_file" ]; then
		apply_started_tmp="$token_dir/apply-started.$$"
		date +%s > "$apply_started_tmp" || die "Unable to timestamp the guarded UCI apply."
		chmod 600 "$apply_started_tmp" || die "Unable to protect the guarded UCI apply timestamp."
		owned_regular "$apply_started_tmp" || die "The guarded UCI apply timestamp is unsafe."
		mv "$apply_started_tmp" "$apply_started_file" || die "Unable to publish the guarded UCI apply timestamp."
	fi
	owned_regular "$apply_started_file" || die "The guarded UCI apply timestamp is unsafe."
	printf '{"state":"verified","schema_version":1,"markers":%s,"token":"%s"}\n' "$count" "$marker_token"
}

persistent_uci() {
	[ -n "${recovery_cleanup_dir:-}" ] || return 1
	uci -c "$config_dir" -t "$recovery_cleanup_dir" -p "$recovery_cleanup_dir" "$@"
}

persistent_guarded_jobs() {
	persistent_uci -q show cake-autorate 2>/dev/null |
		sed -n "s/^cake-autorate\.\([A-Za-z0-9_]*\)\._autotune_apply_[A-Za-z0-9_]*=.*/\1/p" |
		LC_ALL=C sort -u
}

persistent_guarded_sqm_jobs() {
	persistent_uci -q show sqm 2>/dev/null |
		sed -n "s/^sqm\.cake_autorate_apply_[A-Za-z0-9_]*\._autotune_apply_job='\([A-Za-z0-9_]*\)'$/\1/p" |
		LC_ALL=C sort -u
}

persistent_marker_lines() {
	persistent_uci -q show cake-autorate 2>/dev/null | grep -q '\._autotune_apply_' && return 0
	persistent_uci -q show sqm 2>/dev/null | grep -q '\._autotune_apply_'
}

cleanup_recovery_dir() {
	[ -n "${recovery_cleanup_dir:-}" ] || return 0
	find "$recovery_cleanup_dir" -type f -exec rm -f {} \; 2>/dev/null || return 1
	find "$recovery_cleanup_dir" -depth -type d -exec rmdir {} \; 2>/dev/null || return 1
	recovery_cleanup_dir=""
}

recover_stale() {
	prepare_root
	recovery_cleanup_dir="$guard_root/recovery.$$"
	[ ! -e "$recovery_cleanup_dir" ] && mkdir "$recovery_cleanup_dir" &&
		chmod 700 "$recovery_cleanup_dir" ||
		die "Unable to create a private stale-marker recovery transaction."
	runtime_lock_path_owned_by_euid "$recovery_cleanup_dir" ||
		die "The stale-marker recovery transaction is not root-owned."

	recovery_jobs="$(persistent_guarded_jobs)"
	recovery_sqm_jobs="$(persistent_guarded_sqm_jobs)"
	if [ -z "$recovery_jobs$recovery_sqm_jobs" ]; then
		persistent_marker_lines && die "An incomplete persistent Full Auto-Tune marker exists."
		cleanup_recovery_dir || die "Unable to clean the stale-marker recovery transaction."
		printf '{"state":"clear","schema_version":1}\n'
		return 0
	fi
	[ -n "$recovery_jobs" ] && [ "$recovery_jobs" = "$recovery_sqm_jobs" ] ||
		die "The persistent CAKE and SQM markers are not an exact pair."
	[ "$(printf '%s\n' $recovery_jobs | wc -l)" -eq 1 ] ||
		die "Only one persistent Full Auto-Tune marker may be recovered at a time."
	recovery_job="$recovery_jobs"
	safe_job "$recovery_job" || die "The persistent Full Auto-Tune marker has an unsafe instance name."
	recovery_guard="$(sqm_guard_section "$recovery_job")" ||
		die "The persistent SQM marker identity is unsafe."
	recovery_token="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_token" 2>/dev/null)"
	safe_token "$recovery_token" || die "The persistent Full Auto-Tune marker has an invalid token."
	[ "$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_guard" 2>/dev/null)" = 1 ] ||
		die "The persistent Full Auto-Tune marker is malformed."
	recovery_fingerprint="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_fingerprint" 2>/dev/null)"
	safe_fingerprint "$recovery_fingerprint" || die "The persistent Full Auto-Tune marker fingerprint is invalid."
	safe_interface "$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_target" 2>/dev/null)" ||
		die "The persistent Full Auto-Tune marker target is invalid."
	safe_backend "$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_backend" 2>/dev/null)" ||
		die "The persistent Full Auto-Tune marker backend is invalid."
	recovery_route_mode="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_route_mode" 2>/dev/null)"
	case "$recovery_route_mode" in
		main)
			persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_mwan3_member" >/dev/null 2>&1 &&
				die "A persistent main-route marker unexpectedly names an mwan3 member."
			;;
		mwan3)
			safe_interface "$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_mwan3_member" 2>/dev/null)" ||
				die "The persistent Full Auto-Tune mwan3 member is invalid."
			;;
		*) die "The persistent Full Auto-Tune route mode is invalid." ;;
	esac
	recovery_enabled="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_enabled" 2>/dev/null)"
	recovery_disable_adaptive="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_disable_adaptive" 2>/dev/null)"
	recovery_action="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_action" 2>/dev/null)"
	recovery_proposal_id="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_proposal_id" 2>/dev/null || true)"
	[ -z "$recovery_proposal_id" ] || safe_proposal_id "$recovery_proposal_id" ||
		die "The persistent Full Auto-Tune proposal identity is invalid."
	case "$recovery_enabled:$recovery_disable_adaptive:$recovery_action" in
		1:0:apply_sqm|1:1:apply_sqm|0:0:disable_sqm|0:1:disable_sqm) ;;
		*) die "The persistent Full Auto-Tune marker action is inconsistent." ;;
	esac
	recovery_expires="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_expires" 2>/dev/null)"
	is_uint "$recovery_expires" || die "The persistent Full Auto-Tune marker expiry is invalid."
	[ "$(persistent_uci -q get "sqm.$recovery_guard" 2>/dev/null)" = cake_autorate_apply_guard ] ||
		die "The persistent SQM marker has an unexpected section type."
	[ "$(persistent_uci -q get "sqm.$recovery_guard._autotune_apply_guard" 2>/dev/null)" = 1 ] &&
		[ "$(persistent_uci -q get "sqm.$recovery_guard._autotune_apply_job" 2>/dev/null)" = "$recovery_job" ] &&
		[ "$(persistent_uci -q get "sqm.$recovery_guard._autotune_apply_fingerprint" 2>/dev/null)" = "$recovery_fingerprint" ] &&
		[ "$(persistent_uci -q get "sqm.$recovery_guard._autotune_apply_token" 2>/dev/null)" = "$recovery_token" ] ||
		die "The persistent SQM marker does not exactly match the CAKE marker."

	recovery_token_dir="$guard_root/$recovery_token"
	if [ -e "$recovery_token_dir" ] || [ -L "$recovery_token_dir" ]; then
		die "A persistent Full Auto-Tune marker still has runtime proof and is not stale."
	fi
	recovery_boot_id="$(persistent_uci -q get "cake-autorate.$recovery_job._autotune_apply_boot_id" 2>/dev/null || true)"
	if [ -z "$recovery_boot_id" ]; then
		recovery_reason=legacy-token-missing
	else
		safe_boot_id "$recovery_boot_id" || die "The persistent Full Auto-Tune marker boot identity is invalid."
		current_recovery_boot_id="$(current_boot_id)" ||
			die "Unable to establish the current boot identity during marker recovery."
		if [ "$recovery_boot_id" != "$current_recovery_boot_id" ]; then
			recovery_reason=boot-changed
		else
			recovery_now="$(date +%s)"
			is_uint "$recovery_now" || die "Unable to establish the stale-marker recovery clock."
			[ "$recovery_now" -gt "$recovery_expires" ] ||
				die "The tokenless Full Auto-Tune marker may still belong to an active same-boot transaction."
			recovery_reason=expired
		fi
	fi

	# rpcd keeps its rollback snapshots in tmpfs. A reboot, or loss of the
	# token after its same-boot deadline, means the proposal can no longer be
	# proven confirmed or restored exactly. Preserve all diagnostic settings,
	# but fail safe by making both owners inert before removing transaction
	# metadata. The normal Edit/Auto-Tune flow can explicitly enable them again.
	persistent_uci -q set "cake-autorate.$recovery_job.enabled=0" ||
		die "Unable to disable the unproven CAKE Autorate instance."
	persistent_uci -q set "cake-autorate.$recovery_job.sqm_enabled=0" ||
		die "Unable to disable SQM ownership for the unproven instance."
	for recovery_sqm_section in $(persistent_uci -q show sqm 2>/dev/null |
		sed -n "s/^sqm\.\([A-Za-z0-9_]*\)\._cake_autorate_managed='$recovery_job'$/\1/p" |
		LC_ALL=C sort -u); do
		safe_job "$recovery_sqm_section" ||
			die "An unproven managed SQM section has an unsafe name."
		persistent_uci -q set "sqm.$recovery_sqm_section.enabled=0" ||
			die "Unable to disable an unproven managed SQM queue."
	done

	persistent_uci -q delete "sqm.$recovery_guard" ||
		die "Unable to remove the stale SQM transaction marker."
	persistent_uci -q commit sqm || die "Unable to commit stale SQM marker cleanup."
	for recovery_option in _autotune_apply_guard _autotune_apply_fingerprint _autotune_apply_target \
		_autotune_apply_backend _autotune_apply_route_mode _autotune_apply_mwan3_member \
		_autotune_apply_enabled _autotune_apply_disable_adaptive _autotune_apply_action _autotune_apply_proposal_id \
		_autotune_apply_token _autotune_apply_expires _autotune_apply_boot_id; do
		if persistent_uci -q get "cake-autorate.$recovery_job.$recovery_option" >/dev/null 2>&1; then
			persistent_uci -q delete "cake-autorate.$recovery_job.$recovery_option" ||
				die "Unable to remove stale CAKE transaction metadata."
		fi
	done
	persistent_uci -q commit cake-autorate || die "Unable to commit stale CAKE marker cleanup."
	persistent_marker_lines && die "Persistent Full Auto-Tune metadata survived stale-marker recovery."
	cleanup_recovery_dir || die "Unable to clean the stale-marker recovery transaction."
	printf '{"state":"recovered","schema_version":1,"job":"%s","reason":"%s"}\n' \
		"$recovery_job" "$recovery_reason"
}

snapshot_state_matches() {
	state_directory="$1"
	state_cake="$token_dir/check-state-cake.$$"
	state_live_cake="$token_dir/check-state-live-cake.$$"
	state_sqm="$token_dir/check-state-sqm.$$"
	state_live_sqm="$token_dir/check-state-live-sqm.$$"
	state_match_rc=1
	if canonical_package "$state_directory" cake-autorate "$state_cake" &&
	   canonical_live_package cake-autorate "$state_live_cake" &&
	   canonical_package "$state_directory" sqm "$state_sqm" &&
	   canonical_live_package sqm "$state_live_sqm" &&
	   same_files "$state_cake" "$state_live_cake" &&
	   same_files "$state_sqm" "$state_live_sqm"; then
		state_match_rc=0
	fi
	rm -f "$state_cake" "$state_live_cake" "$state_sqm" "$state_live_sqm"
	return "$state_match_rc"
}

verify_rollback() {
	load_token "${1:-}"
	original_cake="$token_dir/check-rollback-original-cake.$$"
	live_cake="$token_dir/check-rollback-live-cake.$$"
	original_sqm="$token_dir/check-rollback-original-sqm.$$"
	live_sqm="$token_dir/check-rollback-live-sqm.$$"
	canonical_package "$token_dir/original" cake-autorate "$original_cake"
	canonical_live_package cake-autorate "$live_cake"
	canonical_package "$token_dir/original" sqm "$original_sqm"
	canonical_live_package sqm "$live_sqm"
	if ! same_files "$original_cake" "$live_cake" ||
	   ! same_files "$original_sqm" "$live_sqm"; then
		rm -f "$original_cake" "$live_cake" "$original_sqm" "$live_sqm"
		die "The rollback timer did not restore the exact pre-apply CAKE/SQM state."
	fi
	rm -f "$original_cake" "$live_cake" "$original_sqm" "$live_sqm"
	sqm_guard="$(sqm_guard_section "$job")" || die "The SQM rollback marker identity is unsafe."
	if uci -q get "sqm.$sqm_guard" >/dev/null 2>&1; then
		die "The SQM rollback marker survived the UCI rollback."
	fi
	printf '{"state":"rolled-back","schema_version":1,"token":"%s"}\n' "$token"
}

disabled_runtime_is_clean() {
	disabled_target="$1"
	disabled_ifb="$2"

	pgrep -f "^$daemon_bin --instance $job\$" >/dev/null 2>&1 && return 1
	disabled_target_qdisc="$("$tc_bin" qdisc show dev "$disabled_target" 2>/dev/null || true)"
	printf '%s\n' "$disabled_target_qdisc" | grep -Eq '(^|[[:space:]])qdisc[[:space:]]+cake([[:space:]]|$)' &&
		return 1
	printf '%s\n' "$disabled_target_qdisc" | grep -Eq '(^|[[:space:]])qdisc[[:space:]]+(ingress|clsact)([[:space:]]|$)' &&
		return 1
	if [ -e "$sys_class_net/$disabled_ifb" ]; then
		disabled_ifb_qdisc="$("$tc_bin" qdisc show dev "$disabled_ifb" 2>/dev/null || true)"
		printf '%s\n' "$disabled_ifb_qdisc" | grep -Eq '(^|[[:space:]])qdisc[[:space:]]+cake([[:space:]]|$)' &&
			return 1
		return 1
	fi
	disabled_filter_state="$(
		"$tc_bin" filter show dev "$disabled_target" parent ffff: 2>/dev/null || true
		"$tc_bin" filter show dev "$disabled_target" ingress 2>/dev/null || true
	)"
	printf '%s\n' "$disabled_filter_state" | grep -Ei '(mirred|redirect)' >/dev/null &&
		return 1
	return 0
}

postcheck() {
	is_uint "$postcheck_wait_s" && [ "$postcheck_wait_s" -ge 1 ] && [ "$postcheck_wait_s" -le 30 ] ||
		die "Invalid Full Auto-Tune postcheck wait bound."
	requested_token="${1:-}"
	load_token "$requested_token"
	require_token_unexpired
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_token" 2>/dev/null)" = "$requested_token" ] ||
		die "The requested postcheck token is not the live Full Auto-Tune token."
	verify_marker "$job" post
	expected_sqm="$token_dir/check-expected-sqm.$$"
	live_sqm="$token_dir/check-live-sqm.$$"
	canonical_package "$token_dir/expected" sqm "$expected_sqm"
	sqm_attempt=0
	while :; do
		canonical_live_package sqm "$live_sqm"
		same_files "$expected_sqm" "$live_sqm" && break
		sqm_attempt=$((sqm_attempt + 1))
		[ "$sqm_attempt" -lt "$postcheck_wait_s" ] || break
		sleep 1
	done
	if ! same_files "$expected_sqm" "$live_sqm"; then
		rm -f "$expected_sqm" "$live_sqm"
		die "The managed SQM package differs from the exact Full Auto-Tune manifest."
	fi
	rm -f "$expected_sqm" "$live_sqm"
	if [ "$enabled" = 1 ]; then
		runtime_attempt=0
		while ! pgrep -f "^$daemon_bin --instance $job\$" >/dev/null 2>&1; do
			runtime_attempt=$((runtime_attempt + 1))
			[ "$runtime_attempt" -lt 5 ] || die "The validated autorate instance did not start."
			sleep 1
		done
		resolved="$(json_get "$result_copy" '@.resolved_interface')"
		dl_if="$(uci -q get "cake-autorate.$job.dl_if" 2>/dev/null)"
		safe_interface "$resolved" && safe_interface "$dl_if" || die "The validated SQM runtime interfaces are invalid."
		[ -n "$tc_bin" ] && [ -x "$tc_bin" ] || die "tc is unavailable for the managed SQM runtime check."
		[ -d "$sys_class_net/$resolved" ] || die "The validated upload interface is not present after restart."
		expected_ul="$(json_get "$result_copy" '@.proposal.upload.base_kbps')"
		expected_dl="$(json_get "$result_copy" '@.proposal.download.base_kbps')"
		case "$selected_topology" in both_shaped|upload_only_shaped) upload_shaping=1 ;; *) upload_shaping=0 ;; esac
		case "$selected_topology" in both_shaped|download_only_shaped) download_shaping=1 ;; *) download_shaping=0 ;; esac
		if [ "$upload_shaping" = 1 ]; then
			"$tc_bin" qdisc show dev "$resolved" 2>/dev/null | grep -Eq '^qdisc cake | qdisc cake ' ||
				die "The validated upload CAKE qdisc is not active after restart."
			[ "$(cake_root_bandwidth_kbps "$resolved")" = "$expected_ul" ] ||
				die "The active upload CAKE bandwidth does not match the validated manifest."
		else
			! "$tc_bin" qdisc show dev "$resolved" 2>/dev/null | grep -Eq '^qdisc cake | qdisc cake ' ||
				die "Upload CAKE remained active although this topology disables it."
		fi
		if [ "$download_shaping" = 1 ]; then
			[ -d "$sys_class_net/$dl_if" ] || die "The validated download IFB is not present after restart."
			"$tc_bin" qdisc show dev "$dl_if" 2>/dev/null | grep -Eq '^qdisc cake | qdisc cake ' ||
				die "The validated download CAKE qdisc is not active after restart."
			[ "$(cake_root_bandwidth_kbps "$dl_if")" = "$expected_dl" ] ||
				die "The active download CAKE bandwidth does not match the validated manifest."
			"$tc_bin" filter show dev "$resolved" parent ffff: 2>/dev/null |
				grep -Ei "mirred.*redirect.*(dev|device) $dl_if([^A-Za-z0-9_.:@-]|$)" >/dev/null ||
				die "The validated ingress redirect does not target the expected IFB."
		else
			if [ -d "$sys_class_net/$dl_if" ]; then
				! "$tc_bin" qdisc show dev "$dl_if" 2>/dev/null | grep -Eq '^qdisc cake | qdisc cake ' ||
					die "Download CAKE remained active although this topology disables it."
			fi
			! "$tc_bin" filter show dev "$resolved" parent ffff: 2>/dev/null |
				grep -Ei "mirred.*redirect.*(dev|device) $dl_if([^A-Za-z0-9_.:@-]|$)" >/dev/null ||
				die "The managed download redirect remained active although this topology disables it."
		fi
		current_daemon_identity="$(daemon_identity "$job")" || die "Unable to identify the validated daemon generation."
		original_daemon_identity="$(meta_get original_daemon_identity "$token_dir")"
		[ "$current_daemon_identity" != none ] || die "The validated autorate daemon generation is missing."
		[ "$(daemon_identity_count "$current_daemon_identity")" -eq 1 ] ||
			die "The validated autorate instance has multiple daemon generations."
		! daemon_identities_intersect "$current_daemon_identity" "$original_daemon_identity" ||
			die "The postcheck observed a stale pre-apply daemon generation."
	else
		[ "$action" = disable_sqm ] || die "A disabled Full Auto-Tune transaction has no typed disable action."
		[ -n "$tc_bin" ] && [ -x "$tc_bin" ] || die "tc is unavailable for the disabled SQM runtime check."
		resolved="$(json_get "$result_copy" '@.resolved_interface')"
		dl_if="$(uci -q get "cake-autorate.$job.dl_if" 2>/dev/null)"
		safe_interface "$resolved" && safe_interface "$dl_if" || die "The disabled SQM runtime interfaces are invalid."
		runtime_attempt=0
		while ! disabled_runtime_is_clean "$resolved" "$dl_if"; do
			runtime_attempt=$((runtime_attempt + 1))
			[ "$runtime_attempt" -lt "$postcheck_wait_s" ] || break
			sleep 1
		done
		disabled_runtime_is_clean "$resolved" "$dl_if" ||
			die "Disabling SQM left a daemon, CAKE qdisc, ingress redirect, or managed IFB active."
	fi
	: > "$token_dir/postverified"
	chmod 600 "$token_dir/postverified"
	owned_regular "$token_dir/postverified" || die "Unable to record the post-apply verification."
	printf '{"state":"verified","schema_version":1,"token":"%s"}\n' "$token"
}

prepare_confirm() {
	requested_token="${1:-}"
	load_token "$requested_token"
	owned_regular "$token_dir/postverified" || die "The Full Auto-Tune transaction was not post-verified."
	sqm_guard="$(sqm_guard_section "$job")" || die "The SQM rollback marker identity is unsafe."
	if owned_regular "$token_dir/prepared"; then
		! token_live_referenced "$token" || die "A prepared transaction unexpectedly regained a live token marker."
		snapshot_state_matches "$token_dir/expected-final" || die "The prepared Full Auto-Tune terminal state changed."
		printf '{"state":"prepared","schema_version":1,"token":"%s"}\n' "$token"
		return 0
	fi
	[ "$(uci -q get "cake-autorate.$job._autotune_apply_token" 2>/dev/null)" = "$requested_token" ] ||
		die "The requested prepare-confirm token is not the live CAKE marker token."
	[ "$(uci -q get "sqm.$sqm_guard._autotune_apply_token" 2>/dev/null)" = "$requested_token" ] ||
		die "The requested prepare-confirm token is not the live SQM marker token."
	verify_marker "$job" post 1
	snapshot_state_matches "$token_dir/expected" || die "The post-verified configuration changed before prepare-confirm."

	# Remove the enrollment marker first and the CAKE marker last. Both commits
	# remain covered by rpcd's already armed rollback snapshot.
	live_uci_transaction -q delete "sqm.$sqm_guard" || die "Unable to remove the prepared SQM rollback marker."
	live_uci_transaction -q commit sqm || die "Unable to commit prepared SQM marker cleanup."
	for option in _autotune_apply_guard _autotune_apply_fingerprint _autotune_apply_target \
		_autotune_apply_backend _autotune_apply_route_mode _autotune_apply_mwan3_member \
		_autotune_apply_enabled _autotune_apply_disable_adaptive _autotune_apply_action _autotune_apply_proposal_id _autotune_apply_token \
		_autotune_apply_expires _autotune_apply_boot_id; do
		if uci -q get "cake-autorate.$job.$option" >/dev/null 2>&1; then
			live_uci_transaction -q delete "cake-autorate.$job.$option" ||
				die "Unable to remove a prepared Full Auto-Tune marker option."
		fi
	done
	live_uci_transaction -q commit cake-autorate || die "Unable to commit prepared CAKE marker cleanup."
	! token_live_referenced "$token" || die "A live token reference survived prepare-confirm."
	snapshot_state_matches "$token_dir/expected-final" || die "The marker-free Full Auto-Tune terminal manifest was not materialized exactly."
	: > "$token_dir/prepared"
	chmod 600 "$token_dir/prepared"
	owned_regular "$token_dir/prepared" || die "Unable to record the prepared Full Auto-Tune transaction."
	printf '{"state":"prepared","schema_version":1,"token":"%s"}\n' "$token"
}

reconcile() {
	load_token "${1:-}"
	owned_regular "$token_dir/prepared" || die "The Full Auto-Tune transaction was never prepared for confirmation."
	# A no-op proposal may make original and expected-final byte-identical. It
	# is safe and useful to classify that ambiguity as confirmed: the exact
	# validated terminal state is present either way. A materially different
	# original snapshot still falls through to the rollback result below.
	if snapshot_state_matches "$token_dir/expected-final"; then
		printf '{"state":"confirmed","schema_version":1,"token":"%s"}\n' "$token"
		return 0
	fi
	if snapshot_state_matches "$token_dir/original"; then
		printf '{"state":"rolled-back","schema_version":1,"token":"%s"}\n' "$token"
		return 0
	fi
	die "Neither exact rollback nor exact prepared-final state can be proven."
}

rpcd_rollback_transaction_closed() {
	local probe_rc

	[ -n "$ubus_bin" ] && [ -x "$ubus_bin" ] || return 1
	# rpcd rejects every UCI commit with PERMISSION_DENIED while apply_sid is
	# armed.  Probe a deliberately nonexistent, valid config name: when no
	# rollback transaction exists this is side-effect free and ubus reports
	# NOT_FOUND (shell status 256 - UBUS_STATUS_NOT_FOUND = 252). Any other
	# result is ambiguous and therefore fails closed.
	if "$ubus_bin" call uci commit '{"config":"cake_autorate_apply_guard_probe"}' >/dev/null 2>&1; then
		return 1
	else
		probe_rc=$?
	fi
	[ "$probe_rc" -eq 252 ]
}

cleanup_token_dir() {
	cleanup_dir="$1"
	case "$cleanup_dir" in "$guard_root"/*) ;; *) return 1 ;; esac
	[ -d "$cleanup_dir" ] && [ ! -L "$cleanup_dir" ] || return 1
	runtime_lock_path_owned_by_euid "$cleanup_dir" || return 1
	find "$cleanup_dir" -type f -exec rm -f {} \; 2>/dev/null || return 1
	find "$cleanup_dir" -depth -type d -exec rmdir {} \; 2>/dev/null || return 1
}

finalize() {
	load_token "${1:-}"
	owned_regular "$token_dir/postverified" && owned_regular "$token_dir/prepared" ||
		die "The Full Auto-Tune transaction was not prepared for confirmation."
	sqm_guard="$(sqm_guard_section "$job")" || die "The SQM rollback marker identity is unsafe."
	! token_live_referenced "$token" || die "A prepared Full Auto-Tune token is still referenced by persistent configuration."
	if uci -q show "cake-autorate.$job" 2>/dev/null | grep -q "^cake-autorate\.$job\._autotune_apply_" ||
	   uci -q get "sqm.$sqm_guard" >/dev/null 2>&1; then
		die "A persistent Full Auto-Tune marker survived prepare-confirm."
	fi
	rpcd_rollback_transaction_closed ||
		die "The rpcd UCI rollback transaction is still armed; refusing to finalize before session-bound confirmation."
	snapshot_state_matches "$token_dir/expected-final" || die "The confirmed Full Auto-Tune terminal state changed before finalize."
	if [ "$action" = apply_sqm ]; then
		[ -x "$sqm_init" ] || die "The SQM service cannot be enabled persistently after confirmation."
		"$sqm_init" enable >/dev/null 2>&1 || die "Unable to enable the confirmed SQM service persistently."
		"$sqm_init" enabled >/dev/null 2>&1 || die "The confirmed SQM service is not enabled persistently."
	fi
	write_receipt "$token" complete "The Full Auto-Tune configuration was verified and confirmed."
	cleanup_token_dir "$token_dir" || die "Unable to remove the completed Full Auto-Tune apply token."
	printf '{"state":"finalized","schema_version":1}\n'
}

guard_status() {
	local status_token="${1:-}"
	local status_receipt status_token_dir status_state
	safe_token "$status_token" || die "Invalid Full Auto-Tune apply token."
	prepare_receipt_root
	status_receipt="$receipt_root/$status_token.json"
	if [ -e "$status_receipt" ]; then
		bounded_regular_file "$status_receipt" 4096 ||
			die "The Full Auto-Tune apply receipt is unsafe."
		cat "$status_receipt"
		return 0
	fi
	prepare_root
	status_token_dir="$guard_root/$status_token"
	if [ -d "$status_token_dir" ] && [ ! -L "$status_token_dir" ]; then
		runtime_lock_path_owned_by_euid "$status_token_dir" ||
			die "The Full Auto-Tune apply token is foreign-owned."
		if [ -e "$status_token_dir/prepared" ]; then
			status_state=confirming
		elif [ -e "$status_token_dir/postverified" ]; then
			status_state=verified
		elif [ -e "$status_token_dir/apply-started" ]; then
			status_state=applying
		else
			status_state=armed
		fi
		printf '{"state":"%s","schema_version":1,"token":"%s"}\n' "$status_state" "$status_token"
		return 0
	fi
	die "No Full Auto-Tune apply transaction or receipt exists for this token."
}

wait_for_rollback_deadline() {
	supervisor_token_dir="$1"
	supervisor_started="$(sed -n '1p' "$supervisor_token_dir/apply-started" 2>/dev/null)"
	is_uint "$supervisor_started" || return 1
	supervisor_rollback_s="$(meta_get rollback_timeout_s "$supervisor_token_dir" 2>/dev/null || true)"
	is_uint "$supervisor_rollback_s" && [ "$supervisor_rollback_s" -ge 10 ] &&
		[ "$supervisor_rollback_s" -le 120 ] || return 1
	supervisor_deadline=$((supervisor_started + supervisor_rollback_s + 3))
	while :; do
		supervisor_now="$(date +%s)"
		is_uint "$supervisor_now" || return 1
		[ "$supervisor_now" -ge "$supervisor_deadline" ] && return 0
		sleep 1
	done
}

supervisor_rollback() {
	supervisor_token="$1"
	supervisor_error="$2"
	supervisor_token_dir="$guard_root/$supervisor_token"
	if wait_for_rollback_deadline "$supervisor_token_dir" &&
	   supervisor_rollback_output="$("$0" verify-rollback "$supervisor_token" 2>&1)" &&
	   printf '%s\n' "$supervisor_rollback_output" | grep -q '"state":"rolled-back"' &&
	   "$0" abort "$supervisor_token" >/dev/null 2>&1; then
		write_receipt "$supervisor_token" rolled-back "$supervisor_error"
		return 0
	fi
	write_receipt "$supervisor_token" indeterminate \
		"$supervisor_error; exact rpcd rollback could not be proven."
	return 1
}

supervise() {
	supervisor_token="${1:-}"
	safe_token "$supervisor_token" || die "Invalid Full Auto-Tune apply token."
	prepare_root
	supervisor_token_dir="$guard_root/$supervisor_token"
	require_secure_directory "$supervisor_token_dir" ||
		die "The Full Auto-Tune apply token is missing, foreign-owned, or unsafe."
	supervisor_lock="$supervisor_token_dir/supervisor.lock"
	if ! mkdir "$supervisor_lock" 2>/dev/null; then
		[ -d "$supervisor_lock" ] && [ ! -L "$supervisor_lock" ] &&
			runtime_lock_path_owned_by_euid "$supervisor_lock" ||
			die "The Full Auto-Tune supervisor lock is unsafe."
		printf '{"state":"running","schema_version":1,"token":"%s"}\n' "$supervisor_token"
		return 0
	fi
	chmod 700 "$supervisor_lock" || die "Unable to protect the Full Auto-Tune supervisor lock."

	if ! supervisor_output="$("$0" postcheck "$supervisor_token" 2>&1)"; then
		supervisor_rollback "$supervisor_token" "Post-apply verification failed: $supervisor_output" || true
		return 1
	fi
	if ! supervisor_output="$("$0" prepare-confirm "$supervisor_token" 2>&1)"; then
		supervisor_rollback "$supervisor_token" "Marker cleanup before confirmation failed: $supervisor_output" || true
		return 1
	fi
	# rpcd binds a rollback transaction to the LuCI ubus session which started
	# it. A detached root process cannot safely manufacture that session ID and
	# `ubus call uci confirm` without it is rejected. LuCI confirms with its own
	# authenticated RPC session. This independent service waits through the
	# rollback deadline and remains the authoritative recovery path if the
	# browser disappears or confirmation/finalization is interrupted.
	wait_for_rollback_deadline "$supervisor_token_dir" || {
		write_receipt "$supervisor_token" indeterminate \
			"Unable to establish the guarded UCI rollback deadline."
		return 1
	}
	if [ -f "$receipt_root/$supervisor_token.json" ]; then
		cat "$receipt_root/$supervisor_token.json"
		return 0
	fi
	if supervisor_reconcile="$("$0" reconcile "$supervisor_token" 2>&1)"; then
		case "$supervisor_reconcile" in
			*'"state":"confirmed"'*)
				"$0" finalize "$supervisor_token"
				return $?
				;;
			*'"state":"rolled-back"'*)
				"$0" abort "$supervisor_token" >/dev/null 2>&1 || true
				write_receipt "$supervisor_token" rolled-back \
					"LuCI did not confirm the transaction and rpcd restored the previous configuration."
				return 1
				;;
		esac
	fi
	write_receipt "$supervisor_token" indeterminate \
		"The guarded UCI transaction passed postcheck, but neither confirmation nor exact rollback could be proven."
	return 1
}

abort_guard() {
	token="${1:-}"
	safe_token "$token" || die "Invalid Full Auto-Tune apply token."
	prepare_root
	token_dir="$guard_root/$token"
	token_live_referenced "$token" && die "Refusing to abort a Full Auto-Tune token referenced by live configuration."
	if [ -d "$token_dir" ] && [ ! -L "$token_dir" ]; then
		runtime_lock_path_owned_by_euid "$token_dir" || die "Refusing to remove a foreign Full Auto-Tune token."
		if owned_regular "$token_dir/postverified" || owned_regular "$token_dir/prepared"; then
			load_token "$token"
			snapshot_state_matches "$token_dir/original" ||
				die "Refusing to abort post-verified state before exact rollback is proven."
		fi
		cleanup_token_dir "$token_dir" || die "Unable to invalidate the Full Auto-Tune token."
	fi
	printf '{"state":"aborted","schema_version":1}\n'
}

case "$mode" in
	arm) arm_guard "$@" ;;
	verify-init) verify_init ;;
	recover-stale) recover_stale ;;
	status) guard_status "$@" ;;
