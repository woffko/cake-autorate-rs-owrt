	expected_set "$job" access_medium_source "$access_source"
	expected_set "$job" access_medium_confidence_percent "$access_confidence"
	expected_set "$job" capacity_learning_policy "$effective_capacity_learning_policy"
	case "$effective_capacity_learning_policy" in
